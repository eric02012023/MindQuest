<%# ANNOTATED COPY FOR DEFENSE REVIEW | File: views/partials/flash-modal.ejs | Purpose: UI template/view used by the system. %>
<% if (flash) { %>
<div class="global-modal is-open" data-flash-modal>
  <div class="global-modal-card small">
    <button type="button" class="modal-close" data-close-modal>&times;</button>
    <div style="font-size:42px;line-height:1;margin-bottom:8px;">
      <%= flash.type === 'success' ? '✅' : 'ℹ️' %>
    </div>
    <h3><%= flash.type === 'success' ? 'Done' : 'Notice' %></h3>
    <p><%= flash.message %></p>
    <button type="button" class="btn btn-primary" data-close-modal>OK</button>
  </div>
</div>
<% } %>