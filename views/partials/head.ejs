<%# ANNOTATED COPY FOR DEFENSE REVIEW | File: views/partials/head.ejs | Purpose: UI template/view used by the system. %>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageTitle %> | MindQuest Tutorial Center</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <% const styles = Array.isArray(pageCss) ? pageCss : (pageCss ? [pageCss] : []); %>
  <% styles.forEach((stylePath) => { %>
    <link rel="stylesheet" href="<%= stylePath %>" />
  <% }); %>
</head>