<%# File: views/partials/install-app-button.ejs | Purpose: The "Install App" button on the landing page, the login page and the student's topbar. %>
<%#
  Hands out the student Android app (mindquest-mobile/). Pressing it does not
  download anything yet: /js/install-app.js first opens a dialog saying the app
  is for students only, and the download starts from that dialog's button.

  studentApp comes from app.locals (server.js) — the APK's link, version and
  size. With no APK on the server it is null, and the button is left out rather
  than offering a download that would fail.
%>
<% const installApp = typeof studentApp === 'undefined' ? null : studentApp; %>
<% if (installApp) { %>
<button
  type="button"
  class="mq-install-btn"
  data-install-app
  data-app-href="<%= installApp.href %>"
  data-app-version="<%= installApp.version %>"
  data-app-size="<%= installApp.sizeMb %>"
  title="Download the MindQuest app for students"
>
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M12 3v12" />
    <path d="m7 11 5 5 5-5" />
    <path d="M4 20h16" />
  </svg>
  <span class="mq-install-label">Install App</span>
</button>
<% } %>
