<%# ANNOTATED COPY FOR DEFENSE REVIEW | File: views/partials/dashboard-topbar.ejs | Purpose: UI template/view used by the system. %>
<header class="dashboard-topbar">
  <div class="dashboard-topbar-title-row">
    <button type="button" class="sidebar-mobile-toggle" data-sidebar-open aria-label="Open navigation">☰</button>
    <div class="dashboard-topbar-title"><h1><%= pageTitle %></h1></div>
  </div>
  <div class="dashboard-topbar-right">
    <% const canShowBell = ['/admin','/assistant','/student','/tutor'].includes(basePath); %>
    <% if (canShowBell) { %>
      <button type="button" class="notification-pill bell-button" data-modal-target="#topbar-notifications-modal">
        <span class="bell">&#128276;</span>
        <span class="count"><%= (inboxNotifications || []).length %></span>
      </button>
    <% } %>
    <div class="menu-wrap">
      <button type="button" class="menu-toggle" data-dropdown-toggle>☰</button>
      <div class="menu-panel" data-dropdown-panel>
        <% if (basePath === '/admin' || basePath === '/assistant') { %>
          <a href="<%= basePath %>/notifications/archive">View Archive Notification</a>
          <a href="<%= basePath %>/notifications/history">Notification History</a>
        <% } %>
        <form action="/logout" method="post"><button type="submit" class="dropdown-danger">Logout</button></form>
      </div>
    </div>
    <div class="topbar-user"><img src="<%= currentUser.image_path || '/assets/logo.jpeg' %>" alt="User" /><span><%= currentUser.first_name %></span></div>
  </div>
</header>

<% if (canShowBell) { %>
<div class="global-modal" id="topbar-notifications-modal">
  <div class="global-modal-card wide">
    <button type="button" class="modal-close" data-close-modal>&times;</button>
    <h3>Notifications</h3>
    <div class="list-stack modal-scroll-box">
      <% if (!(inboxNotifications || []).length) { %><p class="empty-state">No new notifications right now.</p><% } %>
      <% (inboxNotifications || []).forEach((item) => { %>
        <article class="list-card compact align-start">
          <div>
            <strong><%= item.notification_type === 'subject_enrollment_request' ? 'Subject Enrollment Request' : item.notification_type === 'schedule_request' ? 'Student Schedule Application' : item.notification_type === 'student_schedule_status' ? 'Schedule Update' : item.notification_type === 'assessment_request' ? '📋 Assessment Request' : (item.submission_type === 'tutor' ? 'Tutor Registration' : 'Learner Registration') %></strong>
            <p><%= formatDateTime(item.created_at || item.updated_at) %></p>
          </div>
          <div class="row-actions stack-mobile"><button class="btn btn-primary btn-sm" type="button" data-modal-target="#notification-view-<%= item.id %>">View</button></div>
        </article>
      <% }) %>
    </div>
  </div>
</div>

<% (inboxNotifications || []).forEach((item) => { %>
<div class="global-modal" id="notification-view-<%= item.id %>">
  <div class="global-modal-card wide">
    <button type="button" class="modal-close" data-close-modal>&times;</button>
    <% if (item.notification_type === 'subject_enrollment_request') { %>
      <h3>Subject Enrollment Request</h3>
      <div class="read-only-profile-grid">
        <div><strong>Student:</strong> <%= item.first_name %> <%= item.middle_name || '' %> <%= item.last_name %></div>
        <div><strong>Student ID:</strong> <%= item.user_id || '-' %></div>
        <div><strong>Subject:</strong> <%= item.subject_name || '-' %></div>
        <div><strong>Branch:</strong> <%= item.branch_name || '-' %></div>
        <div><strong>Year Level:</strong> <%= item.year_level || '-' %></div>
        <div><strong>Grade Level:</strong> <%= item.grade_level || '-' %></div>
        <div><strong>Email:</strong> <%= item.email || '-' %></div>
        <div><strong>Contact Number:</strong> <%= item.contact_number || '-' %></div>
      </div>
      <div class="form-actions right">
        <form method="post" action="<%= basePath %>/subject-requests/<%= item.id %>/accept" data-confirm-message="Accept this subject enrollment request?"><button class="btn btn-primary" type="submit">Accept</button></form>
        <form method="post" action="<%= basePath %>/subject-requests/<%= item.id %>/cancel" data-confirm-message="Cancel this subject enrollment request?"><button class="btn btn-secondary" type="submit">Cancel</button></form>
      </div>
    <% } else if (item.notification_type === 'schedule_request') { %>
      <h3>Student Schedule Application</h3>
      <div class="read-only-profile-grid">
        <div><strong>Student:</strong> <%= item.full_name %></div>
        <div><strong>Subject:</strong> <%= item.subject_name %></div>
        <div><strong>Time Slot:</strong> <%= item.time_slot %></div>
        <div><strong>Requested At:</strong> <%= formatDateTime(item.created_at) %></div>
      </div>
      <div class="form-actions right">
        <form method="post" action="/tutor/notifications/<%= item.id %>/accept" data-confirm-message="Accept this student schedule application?"><button class="btn btn-primary" type="submit">Accept</button></form>
        <form method="post" action="/tutor/notifications/<%= item.id %>/cancel" data-confirm-message="Cancel this student schedule application?"><button class="btn btn-secondary" type="submit">Cancel</button></form>
      </div>
    <% } else if (item.notification_type === 'student_schedule_status') { %>
      <h3>Schedule Update</h3>
      <div class="read-only-profile-grid">
        <div><strong>Tutor:</strong> <%= item.tutor_name %></div>
        <div><strong>Subject:</strong> <%= item.subject_name %></div>
        <div><strong>Time Slot:</strong> <%= item.time_slot %></div>
        <div><strong>Status:</strong> <%= item.status === 'accepted' ? 'Your schedule has been approved' : 'Your schedule request was cancelled' %></div>
      </div>
      <div class="form-actions right">
        <form method="post" action="/student/notifications/<%= item.id %>/read"><button class="btn btn-primary" type="submit">Mark as Read</button></form>
      </div>
    <% } else if (item.notification_type === 'assessment_request') { %>
      <h3>📋 Assessment Request</h3>
      <div class="read-only-profile-grid">
        <div><strong>Student:</strong> <%= item.student_first_name %> <%= item.student_last_name %></div>
        <div><strong>Subject:</strong> <%= item.subject_name || '-' %></div>
        <div><strong>Module:</strong> <%= item.module_title || 'N/A' %></div>
        <div><strong>Requested:</strong> <%= formatDateTime(item.requested_at || item.created_at) %></div>
      </div>
      <div class="form-actions right">
        <form method="post" action="/tutor/assessment-requests/<%= item.id %>/accept" data-confirm-message="Accept this assessment request?"><button class="btn btn-primary" type="submit">Accept</button></form>
        <form method="post" action="/tutor/assessment-requests/<%= item.id %>/decline" data-confirm-message="Decline this assessment request?"><button class="btn btn-secondary" type="submit">Decline</button></form>
      </div>
    <% } else { %>
      <h3><%= item.submission_type === 'tutor' ? 'Tutor Registration' : 'Learner Registration' %></h3>
      <div class="read-only-profile-grid">
        <div><strong>Name:</strong> <%= item.first_name %> <%= item.middle_name || '' %> <%= item.last_name %></div>
        <div><strong>Email:</strong> <%= item.extra?.email || item.email || '-' %></div>
        <div><strong>Password:</strong> ******</div>
        <div><strong>Branch:</strong> <%= item.branch_name || '-' %></div>
        <div><strong>Birth Date:</strong> <%= formatDate(item.birth_date) %></div>
        <div><strong>Age:</strong> <%= item.age || '-' %></div>
        <div><strong>Gender:</strong> <%= item.gender || '-' %></div>
        <div><strong>Contact Number:</strong> <%= item.contact_number || item.parent_contact_number || '-' %></div>
        <div><strong>Email:</strong> <%= item.email || item.parent_email || '-' %></div>
        <div><strong>Facebook:</strong> <%= item.facebook_account || item.parent_facebook || '-' %></div>
        <div><strong>Year Level:</strong> <%= item.year_level || '-' %></div>
        <div><strong>Grade Level:</strong> <%= item.grade_level || '-' %></div>
        <div class="full-width"><strong>Address:</strong> <%= item.address || '-' %></div>
        <div class="full-width"><strong>Subjects:</strong> <%= (item.subjects || []).join(', ') || '-' %></div>
        <div class="full-width"><strong>Additional Academic Support:</strong> <%= (item.supports || []).join(', ') || '-' %></div>
      </div>
      <div class="form-actions right">
        <form method="post" action="<%= basePath %>/notifications/<%= item.id %>/accept" data-confirm-message="Accept this registration?"><button class="btn btn-primary" type="submit">Accept</button></form>
        <form method="post" action="<%= basePath %>/notifications/<%= item.id %>/read" data-confirm-message="Cancel and mark this notification as read?"><button class="btn btn-secondary" type="submit">Cancel</button></form>
        <form method="post" action="<%= basePath %>/notifications/<%= item.id %>/archive" data-confirm-message="Archive this notification?"><button class="btn btn-secondary" type="submit">Archive</button></form>
      </div>
    <% } %>
  </div>
</div>
<% }) %>
<% } %>
