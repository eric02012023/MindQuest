<%# File: views/partials/dashboard-topbar.ejs
    Purpose: The topbar of every dashboard — the same for all four roles.

    From the right: the signed-in person, the ☰ menu (View Archived
    Notifications, Notification History, Log Out), and to its left the
    notification bell. The bell drops a list — who, what, when, and an × to put
    a notice away — with "See all" (the Notifications page) and "Mark all read"
    underneath. The list is built per role in lib/bell.js.

    Decisions (accepting a registration, a student's request for a tutor) are
    made on the Notifications page, not in this dropdown.

    Locals: basePath, pageTitle, currentUser, bellItems %>
<% const items = typeof bellItems === 'undefined' ? [] : (bellItems || []); %>
<header class="dashboard-topbar">
  <div class="dashboard-topbar-title-row">
    <button type="button" class="sidebar-mobile-toggle" data-sidebar-open aria-label="Open navigation">☰</button>
    <div class="dashboard-topbar-title"><h1><%= pageTitle %></h1></div>
  </div>
  <div class="dashboard-topbar-right">
    <%# Offered to all four roles. It stays hidden unless the browser can act on
        it, so on an already-installed app or an unsupported browser the topbar
        looks exactly as it did before. %>
    <%- include('install-app-button', { variant: '' }) %>

    <div class="menu-wrap mq-bell-wrap" data-bell>
      <button type="button" class="notification-pill bell-button" data-dropdown-toggle
              aria-label="Notifications<%= items.length ? ` (${items.length} new)` : '' %>" aria-haspopup="true">
        <span class="bell"><%- icon('bell', 20) %></span>
        <span class="count" data-notification-count <%= items.length ? '' : 'hidden' %>><%= items.length > 99 ? '99+' : items.length %></span>
      </button>
      <div class="menu-panel mq-bell-panel" data-dropdown-panel role="dialog" aria-label="Notifications">
        <div class="mq-bell-head">
          <strong>Notifications</strong>
          <span data-bell-new><%= items.length ? `${items.length} new` : '' %></span>
        </div>
        <div class="mq-bell-list" data-bell-list>
          <p class="mq-bell-empty" data-bell-empty <%= items.length ? 'hidden' : '' %>>You're all caught up. No new notifications.</p>
          <% items.forEach((item) => { %>
            <div class="mq-bell-item" data-bell-item>
              <a class="mq-bell-link" href="<%= item.href %>">
                <%- include('avatar', { avatarSrc: item.avatarSrc, avatarName: item.avatarName, avatarSize: 'sm' }) %>
                <span class="mq-bell-text">
                  <strong><%= item.title %></strong>
                  <span class="mq-bell-message"><%= item.text %></span>
                  <small><%= formatDateTime(item.createdAt) %></small>
                </span>
              </a>
              <% if (item.dismissUrl) { %>
                <button type="button" class="mq-bell-dismiss" data-bell-dismiss="<%= item.dismissUrl %>"
                        title="Mark as read" aria-label="Mark as read"><%- icon('close', 16) %></button>
              <% } %>
            </div>
          <% }) %>
        </div>
        <div class="mq-bell-foot">
          <a class="mq-bell-action" href="<%= basePath %>/notifications"><%- icon('view', 16) %> See all</a>
          <form method="post" action="<%= basePath %>/notifications/mark-all-read">
            <button type="submit" class="mq-bell-action" <%= items.some((item) => item.dismissUrl) ? '' : 'disabled' %>><%- icon('check', 16) %> Mark all read</button>
          </form>
        </div>
      </div>
    </div>

    <div class="menu-wrap">
      <button type="button" class="menu-toggle" data-dropdown-toggle aria-label="Menu" aria-haspopup="true">☰</button>
      <div class="menu-panel" data-dropdown-panel>
        <a href="<%= basePath %>/notifications/archive">View Archived Notifications</a>
        <a href="<%= basePath %>/notifications/history">Notification History</a>
        <form action="/logout" method="post"><button type="submit" class="dropdown-danger">Log Out</button></form>
      </div>
    </div>
    <div class="topbar-user"><%- include('avatar', { avatarSrc: currentUser.image_path, avatarName: [currentUser.first_name, currentUser.last_name].filter(Boolean).join(' '), avatarSize: 'md' }) %><span><%= currentUser.first_name %></span></div>
  </div>
</header>
