<%# File: views/content/student-path-module.ejs
    Purpose: The student's own copy of a module on their learning path
    (lib/learningPaths.js): the module as one PDF with their added pages, the
    topics added for each of their weak points, the module's assessment (score
    only), and the tutor's activities.
    Locals: row (learning_path_modules row + take_state, weakPoints), mod,
            assignment, activities, submissions, attempts, passLabel, viewOnly %>
<% const number = row.order_number || row.position; %>
<% const state = row.take_state; %>
<% const lastTake = attempts.length ? attempts[attempts.length - 1] : null; %>
<% const pct = (value) => `${Number(value || 0).toFixed(1)}%`; %>
<% const points = row.weakPoints || []; %>
<% const topicCount = points.reduce((sum, point) => sum + point.topics.length, 0); %>
<% const passRule = typeof passLabel === 'undefined' ? 'Advance (81%)' : passLabel; %>
<link rel="stylesheet" href="/css/level-modules.css" />
<section class="page-stack">
  <section class="panel-card">
    <div class="panel-card-head">
      <h2>Module <%= number %>: <%= row.module_title %></h2>
      <span class="badge <%= row.status === 'passed' ? 'badge-success' : 'badge-info' %>"><%= row.status === 'passed' ? 'Passed' : 'Open' %></span>
    </div>
    <p><strong>Subject:</strong> <%= assignment.subject_name %></p>
    <% if (row.additions_status === 'pending' || row.additions_status === 'generating') { %>
      <p class="table-note">Your added lessons are being prepared. Until they are ready, the module opens with its own pages only.</p>
    <% } %>
    <div class="pm-actions">
      <a class="btn btn-primary" href="/student/path-modules/<%= row.id %>/pdf" target="_blank" rel="noopener">Open Module (PDF)</a>
      <a class="btn btn-secondary" href="/student/subjects/<%= row.subject_id %>">Back to subject</a>
    </div>
  </section>

  <% if (points.length) { %>
    <section class="panel-card">
      <div class="panel-card-head">
        <h3>Added for You</h3>
        <% if (points.some((point) => !point.legacy)) { %>
          <span class="badge badge-info"><%= points.length %> weak point<%= points.length === 1 ? '' : 's' %> &middot; <%= topicCount %> topics</span>
        <% } else { %>
          <span class="badge badge-info"><%= points.length %></span>
        <% } %>
      </div>
      <div class="pm-points">
        <% points.forEach((point, index) => { %>
          <details class="pm-point" <%= index === 0 ? 'open' : '' %>>
            <summary>
              <strong><%= point.legacy ? point.title : `Weak point ${point.no}: ${point.title}` %></strong>
              <span class="module-card-meta">After page <%= point.after_page %><% if (!point.legacy) { %> &middot; <%= point.topics.length %> topics<% } %></span>
            </summary>
            <% if (point.focus) { %>
              <p class="pm-focus"><strong>What to learn:</strong> <%= point.focus %></p>
            <% } %>
            <div class="pm-topics">
              <% point.topics.forEach((topic, n) => { %>
                <article class="pm-topic">
                  <% if (!point.legacy) { %>
                    <h4>Topic <%= n + 1 %> of <%= point.topics.length %>: <%= topic.title %></h4>
                  <% } %>
                  <div class="pm-addition-text">
                    <% String(topic.text || '').split(/\n/).forEach((line) => { %>
                      <% const text = line.trim(); %>
                      <% if (!text) { %>
                      <% } else if (/^[-•*]\s+/.test(text)) { %>
                        <p class="pm-bullet">&bull; <%= text.replace(/^[-•*]\s+/, '') %></p>
                      <% } else if (/^(answer|sagot|try this|subukan mo ito|subukan)\s*:/i.test(text)) { %>
                        <p><strong><%= text.split(':')[0] %>:</strong><%= text.slice(text.indexOf(':') + 1) %></p>
                      <% } else { %>
                        <p><%= text %></p>
                      <% } %>
                    <% }) %>
                  </div>
                </article>
              <% }) %>
            </div>
          </details>
        <% }) %>
      </div>
    </section>
  <% } %>

  <section class="panel-card">
    <div class="panel-card-head">
      <h3>Module Assessment</h3>
      <% if (state === 'passed') { %>
        <span class="badge badge-success">Passed</span>
      <% } else if (state === 'can_take') { %>
        <span class="badge badge-success">Open</span>
      <% } else if (state === 'waiting_retake') { %>
        <span class="badge badge-warning">Not passed yet</span>
      <% } else if (state === 'waiting_tutor') { %>
        <span class="badge badge-info">Waiting for your tutor</span>
      <% } else { %>
        <span class="badge badge-info">Being prepared</span>
      <% } %>
    </div>

    <% if (state === 'can_take') { %>
      <% if (lastTake) { %>
        <p class="table-note">Not passed yet: <%= passRule %> passes. Take it again when you are ready — the questions come in a new order.</p>
      <% } %>
      <% if (viewOnly) { %>
        <p class="lock-note"><%= viewOnly %></p>
      <% } else { %>
        <a class="btn btn-primary" href="/student/path-modules/<%= row.id %>/assessment">
          <%= attempts.length ? `Take Again (Take ${attempts.length + 1})` : 'Take Assessment' %>
        </a>
      <% } %>
    <% } else if (state === 'waiting_retake') { %>
      <p class="table-note">Not passed yet: <%= passRule %> passes. Your tutor opens your next take when you are ready.</p>
    <% } else if (state === 'waiting_tutor') { %>
      <p class="table-note">Your tutor opens this assessment when you are ready for it.</p>
    <% } else if (state === 'preparing') { %>
      <p class="table-note">Your assessment for this module is being written.</p>
    <% } %>

    <% if (attempts.length) { %>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Take</th><th>Score</th><th>Level</th><th>Submitted</th></tr></thead>
          <tbody>
            <% attempts.forEach((attempt) => { %>
              <tr>
                <td><%= attempt.attempt_number %></td>
                <td><%= Number(attempt.score) %>/<%= Number(attempt.total_points) %> (<%= pct(attempt.percentage) %>)</td>
                <td><span class="lm-level lm-level-<%= String(attempt.level || 'beginner').toLowerCase() %>"><%= attempt.level %></span></td>
                <td><%= formatDateTime(attempt.submitted_at) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>

  <section class="panel-card">
    <div class="panel-card-head">
      <h3>Activities</h3>
      <span class="badge badge-info"><%= activities.length %></span>
    </div>
    <% if (!activities.length) { %>
      <p class="empty-state">No activities in this module yet.</p>
    <% } else { %>
      <div class="list-stack">
        <% activities.forEach((activity) => { %>
          <% const done = (submissions || []).find((s) => Number(s.assessment_id) === Number(activity.id)); %>
          <article class="list-card">
            <div>
              <strong><%= activity.title %></strong>
              <% if (done) { %>
                <span class="badge badge-success">Done &middot; <%= pct(done.percentage) %></span>
              <% } %>
            </div>
            <div>
              <% if (done) { %>
                <a class="btn btn-secondary btn-sm" href="/student/results/<%= done.id %>">View Result</a>
              <% } else if (!viewOnly) { %>
                <a class="btn btn-primary btn-sm" href="/student/tutor-assessments/<%= activity.id %>">Answer</a>
              <% } %>
            </div>
          </article>
        <% }) %>
      </div>
    <% } %>
  </section>
</section>

<style>
  .pm-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 12px; }
  .pm-points { display: grid; gap: 10px; }
  .pm-point { border: 1px solid var(--border, #d7e2ea); border-radius: 12px; padding: 12px 16px; background: #fff; }
  .pm-point summary { cursor: pointer; display: flex; flex-wrap: wrap; gap: 4px 12px; align-items: baseline; }
  .pm-point .module-card-meta { color: var(--text-soft, #5f7084); font-size: 12.5px; }
  .pm-focus { margin: 10px 0 0; }
  .pm-topics { display: grid; gap: 14px; margin-top: 12px; }
  .pm-topic h4 { margin: 0; font-size: 15px; }
  .pm-addition-text { margin-top: 8px; display: grid; gap: 6px; }
  .pm-addition-text p { margin: 0; line-height: 1.55; }
  .pm-addition-text .pm-bullet { padding-left: 14px; text-indent: -10px; }
</style>
