<%# ANNOTATED COPY FOR DEFENSE REVIEW | File: views/content/admin-dashboard.ejs | Purpose: UI template/view used by the system. %>
<%
  // The server runs in UTC; the centre is in Manila (UTC+8).
  const manilaNow = new Date(Date.now() + 8 * 60 * 60 * 1000);
  const manilaHour = manilaNow.getUTCHours();
  const greeting = manilaHour < 12 ? 'Good morning' : manilaHour < 18 ? 'Good afternoon' : 'Good evening';
  const todayLabel = manilaNow.toLocaleDateString('en-US', { timeZone: 'UTC', weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });
  const heroBranch = (branches || []).find((branch) => Number(branch.id) === Number(effectiveBranchId));
%>
<%# The admin and assistant dashboards now open like the tutor and student ones
    do: a welcome banner with the centre's motto, and the places an admin goes
    next. Notifications are reached from the bell in the topbar. It sits above
    the page-stack because that row is laid out as two columns of its own. %>
<article class="mq-hero">
  <div class="mq-hero-text">
    <span class="mq-hero-kicker"><%= greeting %> · <%= todayLabel %></span>
    <h2>Welcome back, <%= titleCaseName(currentUser.first_name) %>!</h2>
    <p>Unlocking minds, one quest at a time. Here is <%= heroBranch ? titleCaseName(heroBranch.name) : 'every branch' %> at a glance.</p>
    <div class="mq-hero-actions">
      <a class="mq-btn mq-btn-light" href="<%= basePath %>/users"><%- icon('user') %> User Management</a>
      <a class="mq-btn mq-btn-light" href="<%= basePath %>/billing"><%- icon('money') %> Student Bill</a>
    </div>
  </div>
  <div class="mq-hero-art"><%- include('../partials/hero-art') %></div>
</article>

<section class="page-stack">
  <div class="toolbar-card">
    <form class="inline-form" method="get" action="<%= basePath %>">
      <label>Branch
        <select name="branch_id" onchange="this.form.submit()" <%= currentUser.role === 'admin_assistant' ? 'disabled' : '' %>>
          <option value="all">All branches</option>
          <% branches.forEach((branch) => { %>
            <option value="<%= branch.id %>" <%= Number(effectiveBranchId) === Number(branch.id) ? 'selected' : '' %>><%= branch.name %></option>
          <% }) %>
        </select>
      </label>
    </form>
    
    <div class="stat-grid">
        <article class="stat-card gradient">
          <h3>Students</h3>
          <strong><%= counts.students %></strong>
        </article>
        <article class="stat-card gradient">
          <h3>Tutors</h3>
          <strong><%= counts.tutors %></strong>
        </article>
      </div>

  </div>

  <section class="panel-card scroll-panel medium-scroll">
    <div class="panel-card-head">
      <h2>Recent Registrations</h2>
      <p>Only the last 3 days stay in this list.</p>
    </div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Name</th>
            <th>Type</th>
            <th>Branch</th>
            <th>Status</th>
            <th>Submitted</th>
          </tr>
        </thead>
        <tbody>
          <% if (!recentSubmissions.length) { %>
            <tr><td colspan="5">No recent registrations.</td></tr>
          <% } %>
          <% recentSubmissions.forEach((row) => { %>
            <tr>
              <td><%= row.first_name %> <%= row.last_name %></td>
              <td><%= row.submission_type === 'tutor' ? 'Tutor' : 'Learner' %></td>
              <td><%= row.branch_name || '-' %></td>
              <td><%= row.status === 'cancelled' ? 'Declined' : String(row.status || '').charAt(0).toUpperCase() + String(row.status || '').slice(1) %></td>
              <td><%= formatDateTime(row.created_at) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>

</section>
