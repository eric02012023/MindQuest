<%# File: views/content/tutor-modules.ejs
    Purpose: The tutor's entry point into the module system — every assigned
    subject, its numbered modules, and the year levels each module is restricted
    to. Read-only: Admin owns modules and handouts; the tutor builds assessments
    on top of them. %>
<%# The page header card that used to sit here repeated the title already in the
    topbar and described what the subject panels below already show. %>
<section class="page-stack">
  <% if (!(subjectsWithModules || []).length) { %>
    <section class="panel-card">
      <p class="empty-state">You have no assigned subjects yet.</p>
    </section>
  <% } %>

  <% subjectsWithModules.forEach((subject) => { %>
    <section class="panel-card">
      <div class="panel-card-head">
        <h3><%= subject.subject_name %></h3>
        <span class="badge badge-info"><%= subject.modules.length %> module<%= subject.modules.length === 1 ? '' : 's' %></span>
      </div>

      <% if (!subject.modules.length) { %>
        <p class="empty-state">No modules for this subject yet. Admin adds them from the subject page.</p>
      <% } %>

      <div class="module-grid">
        <% subject.modules.forEach((mod) => { %>
          <article class="module-card">
            <div class="module-card-head">
              <span class="module-number">Module <%= mod.order_number %></span>
              <span class="badge <%= Number(mod.handout_count) ? 'badge-success' : 'badge-warning' %>">
                <%= mod.handout_count %> handout<%= Number(mod.handout_count) === 1 ? '' : 's' %>
              </span>
            </div>
            <h4><%= mod.title %></h4>
            <% if (mod.description) { %><p class="module-card-desc"><%= mod.description %></p><% } %>

            <div class="module-card-targets">
              <strong>Visible to</strong>
              <div class="target-chips">
                <% if (!mod.target_year_levels.length) { %>
                  <span class="target-chip target-chip-all">All year levels</span>
                <% } else { %>
                  <% mod.target_year_levels.forEach((lvl) => { %>
                    <span class="target-chip"><%= lvl %></span>
                  <% }) %>
                <% } %>
              </div>
            </div>

            <div class="module-card-foot">
              <span class="module-card-meta">
                <%= mod.assessment_count %> assessment<%= Number(mod.assessment_count) === 1 ? '' : 's' %>
              </span>
              <a class="btn btn-primary btn-sm" href="/tutor/modules/<%= mod.id %>">Open</a>
            </div>
          </article>
        <% }) %>
      </div>
    </section>
  <% }) %>
</section>
