<%# File: views/content/tutor-modules.ejs
    Purpose: Modules & Assessments — per subject the tutor teaches, one box per
    student of theirs who has taken its Pre-Assessment: the student's name, grade
    and the level of their modules. A box opens that student's own modules
    (Module 1, 2, 3, edited for them), where the tutor checks and opens their
    assessments and writes activities for them (tutor-student-modules.ejs).

    The admin's modules, unedited, are opened from My Subjects.

    Locals: subjectsWithBoxes [{ subject_id, subject_name, boxes: [{ studentId,
            subjectId, name, code, grade, level, imagePath, onPath, passed,
            total, toCheck, href }] }] (lib/learningPaths.js, tutorModuleBoxes) %>
<link rel="stylesheet" href="/css/level-modules.css" />
<% const subjects = typeof subjectsWithBoxes === 'undefined' ? [] : (subjectsWithBoxes || []); %>
<section class="page-stack">
  <% if (!subjects.length) { %>
    <section class="panel-card">
      <p class="empty-state">You have no assigned subjects yet.</p>
    </section>
  <% } %>

  <% subjects.forEach((subject) => { %>
    <section class="panel-card">
      <div class="panel-card-head">
        <h3><%= subject.subject_name %></h3>
        <span class="badge badge-info"><%= subject.boxes.length %> student<%= subject.boxes.length === 1 ? '' : 's' %></span>
      </div>

      <% if (!subject.boxes.length) { %>
        <p class="empty-state">No student of yours has taken the <%= subject.subject_name %> Pre-Assessment yet.</p>
      <% } else { %>
        <div class="tm-box-grid">
          <% subject.boxes.forEach((box) => { %>
            <a class="tm-box" href="<%= box.href %>">
              <div class="tm-box-who">
                <%- include('../partials/avatar', { avatarSrc: box.imagePath, avatarName: box.name, avatarSize: 'md' }) %>
                <div class="tm-box-name">
                  <strong><%= box.name %></strong>
                  <span><%= box.code %></span>
                </div>
                <% if (box.toCheck) { %>
                  <span class="badge badge-warning tm-box-flag"><%= box.toCheck %> to check</span>
                <% } %>
              </div>
              <div class="tm-box-facts">
                <span class="tm-box-fact"><small>Grade level</small><b><%= box.grade || '—' %></b></span>
                <span class="tm-box-fact"><small>Level of module</small><span class="lm-level lm-level-<%= String(box.level).toLowerCase() %>"><%= box.level %></span></span>
              </div>
            </a>
          <% }) %>
        </div>
      <% } %>
    </section>
  <% }) %>
</section>
