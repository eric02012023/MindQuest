<%# ANNOTATED COPY FOR DEFENSE REVIEW | File: views/content/student-dashboard.ejs | Purpose: UI template/view used by the system. %>
<section class="page-stack">
  <article class="hero-dashboard-card gradient">
    <div>
      <h2>Welcome, <%= dashboard.user.first_name %>!</h2>
    </div>
    <img src="<%= dashboard.user.image_path || '/assets/logo.png' %>" alt="Student avatar" class="profile-avatar large" />
  </article>

  <div class="dashboard-three-grid">
    <section class="panel-card">
      <div class="panel-card-head"><h3>Subject Tutors</h3></div>
      <div class="bubble-row">
        <%# A subject's tutor is that subject's own, so one tutor can appear for
            several subjects; each is listed once, with what they teach. %>
        <% const tutorList = [];
           (dashboard.assignments || []).filter((item) => item.tutor_internal_id).forEach((item) => {
             let entry = tutorList.find((t) => Number(t.id) === Number(item.tutor_internal_id));
             if (!entry) { entry = { id: item.tutor_internal_id, name: item.tutor_name, subjects: [] }; tutorList.push(entry); }
             entry.subjects.push(item.subject_name);
           }); %>
        <% if (!tutorList.length) { %><p class="empty-state">No tutor assigned yet.</p><% } %>
        <% tutorList.forEach((tutor) => { %>
          <div class="mini-bubble" title="<%= tutor.subjects.join(', ') %>"><span><%= tutor.name %> · <%= tutor.subjects.join(', ') %></span></div>
        <% }) %>
      </div>
    </section>
    <section class="panel-card">
      <div class="panel-card-head"><h3>Attendance Summary</h3></div>
      <div style="display: flex; flex-wrap: wrap; gap: 1.25rem 2rem; padding: 0.5rem 0;">
        <% [['Present', 'present', 'var(--success, #1a7a3a)'], ['Late', 'late', '#b7791f'], ['Absent', 'absent', 'var(--danger, #a43030)'], ['Excused', 'excused', '#0a6f8a']].forEach(([label, key, color]) => { %>
          <div>
            <span style="font-size: 0.875rem; color: var(--text-muted, #868e96);"><%= label %></span>
            <div style="font-size: 2rem; font-weight: 700; color: <%= color %>;"><%= dashboard.attendance[key] || 0 %></div>
          </div>
        <% }) %>
      </div>
    </section>
    <section class="panel-card">
      <div class="panel-card-head"><h3>Latest SOA</h3></div>
      <% if (dashboard.latestSoa) { %>
        <p><strong>Statement Date:</strong> <%= formatDateTime(dashboard.latestSoa.statement_date || dashboard.latestSoa.created_at) %></p>
        <p><strong>Full Bill:</strong> <%= money(dashboard.latestSoa.full_bill || 0) %></p>
        <p><strong>For Settlement:</strong> <%= money(dashboard.latestSoa.for_settlement || 0) %></p>
      <% } else { %>
        <p class="empty-state">No SOA posted yet.</p>
      <% } %>
    </section>
  </div>


  <section class="panel-card">
    <div class="panel-card-head"><h3>My Subjects</h3></div>
    <div class="subject-list-cards">
      <% if (!dashboard.assignments.length) { %>
        <p class="empty-state">No accepted subject assignments yet.</p>
      <% } %>
      <% dashboard.assignments.forEach((item) => { %>
        <a class="subject-list-card" href="/student/subjects/<%= item.subject_id %>">
          <div>
            <strong><%= item.subject_name %></strong>
            <span><%= item.tutor_name %></span>
          </div>
          <span>Enrolled: <%= formatDate(item.enrolled_at) %></span>
        </a>
      <% }) %>
    </div>
  </section>
</section>