<%# File: views/content/tutor-module-detail.ejs
    Purpose: One module as the tutor sees it — Admin's handouts (readable, not
    editable), the module written for each level (lib/levelModules.js), where
    the tutor writes activities now, and every assessment on the module. %>
<%
  const levelRows = typeof levelModules === 'undefined' ? {} : (levelModules || {});
  const levelNames = typeof levels === 'undefined' ? ['Beginner', 'Intermediate', 'Advance'] : levels;
  const statusText = (row) => !row ? 'Not made yet'
    : row.status === 'ready' ? 'Ready'
      : row.status === 'failed' ? 'Could not be written' : 'Being written';
%>
<link rel="stylesheet" href="/css/level-modules.css" />
<section class="page-stack">
  <div class="toolbar-card split">
    <div>
      <h2>Module <%= mod.order_number %> — <%= mod.title %></h2>
      <p class="res-subtitle">
        <%= mod.subject_name %>
        &middot; <%= mod.grade_level || 'no grade level set' %>
      </p>
    </div>
    <a class="btn btn-secondary" href="/tutor/modules">Back to Modules</a>
  </div>

  <% if (mod.description) { %>
    <section class="panel-card">
      <p class="module-card-desc"><%= mod.description %></p>
    </section>
  <% } %>

  <%# ---- Level modules: where the activities are written --------------------- %>
  <section class="panel-card">
    <div class="panel-card-head">
      <h3>Level Modules</h3>
    </div>
    <div class="lm-level-grid">
      <% levelNames.forEach((level) => { %>
        <% const row = levelRows[level] || null; %>
        <article class="lm-level-card">
          <div class="lm-level-card-head">
            <span class="lm-level lm-level-<%= level.toLowerCase() %>"><%= level %></span>
            <span class="lm-status lm-status-<%= row ? row.status : 'none' %>"><%= statusText(row) %></span>
          </div>
          <% if (row) { %>
            <p class="lm-level-card-meta">
              <%= Number(row.assessment_count || 0) %> activit<%= Number(row.assessment_count || 0) === 1 ? 'y' : 'ies' %>
              <% if (Number(row.section_count || 0)) { %>&middot; <%= row.section_count %> lesson part<%= Number(row.section_count) === 1 ? '' : 's' %><% } %>
            </p>
            <% if (row.status === 'failed' && row.error_message) { %>
              <p class="lm-level-card-error"><%= row.error_message %></p>
            <% } %>
          <% } %>
          <div class="lm-level-card-actions">
            <% if (row) { %>
              <a class="btn btn-primary btn-sm" href="/tutor/level-modules/<%= row.id %>">Open</a>
            <% } %>
            <% if (!row || row.status === 'failed') { %>
              <form method="post" action="/tutor/modules/<%= mod.id %>/levels/<%= level %>/make">
                <button class="btn btn-secondary btn-sm" type="submit"><%= row ? 'Try again' : 'Make' %></button>
              </form>
            <% } %>
          </div>
        </article>
      <% }) %>
    </div>
  </section>

  <%# ---- Handouts (Admin's, read-only) ------------------------------------ %>
  <section class="panel-card">
    <div class="panel-card-head">
      <h3>Handouts</h3>
      <span class="badge badge-info"><%= handouts.length %> file<%= handouts.length === 1 ? '' : 's' %></span>
    </div>

    <% if (!handouts.length) { %>
      <p class="empty-state">No handouts on this module yet.</p>
    <% } %>

    <div class="handout-grid">
      <% handouts.forEach((h) => { %>
        <article class="handout-card">
          <div class="handout-card-head">
            <span class="handout-ext"><%= ((h.file_original_name || '').split('.').pop() || 'file').toUpperCase() %></span>
            <% if (h.extracted_at) { %>
              <span class="badge badge-success">Text ready<%= h.extraction_method === 'ocr' ? ' (AI-read scan)' : '' %></span>
            <% } else { %>
              <span class="badge badge-warning">No text for questions</span>
            <% } %>
          </div>
          <h4><%= h.title || h.file_original_name %></h4>
          <p class="handout-meta">
            <%= h.file_size_bytes ? (Math.round(Number(h.file_size_bytes) / 1024) + ' KB') : 'size unknown' %>
            &middot; <%= formatDate(h.created_at) %>
          </p>
          <% if (!h.extracted_at && h.extraction_error) { %>
            <p class="handout-error"><%= h.extraction_error %></p>
          <% } %>
          <div class="handout-card-foot">
            <a class="btn btn-secondary btn-sm" href="<%= h.file_path %>" target="_blank" rel="noopener">Open</a>
          </div>
        </article>
      <% }) %>
    </div>
  </section>

  <%# ---- The tutor's assessments ------------------------------------------ %>
  <section class="panel-card">
    <div class="panel-card-head">
      <h3>Assessments for this Module</h3>
      <span class="badge badge-info"><%= assessments.length %></span>
    </div>


    <% if (!assessments.length) { %>
      <p class="empty-state">No assessments yet.</p>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Title</th>
              <th>Level</th>
              <th>Kind</th>
              <th>Type</th>
              <th>Items</th>
              <th>Answered</th>
              <th>Status</th>
              <th>Created</th>
              <th>Manage</th>
            </tr>
          </thead>
          <tbody>
            <% assessments.forEach((a) => { %>
              <tr>
                <td><strong><%= a.title %></strong></td>
                <td>
                  <% if (a.level_module_level) { %>
                    <span class="lm-level lm-level-<%= String(a.level_module_level).toLowerCase() %>"><%= a.level_module_level %></span>
                  <% } else { %>
                    Every level
                  <% } %>
                </td>
                <td>
                  <span class="badge badge-<%= a.assessment_kind === 'pre_assessment' ? 'info' : a.assessment_kind === 'post_assessment' ? 'success' : 'warning' %>">
                    <%= a.assessment_kind === 'pre_assessment' ? 'Pre-Assessment'
                      : a.assessment_kind === 'post_assessment' ? 'Post-Assessment' : 'Tutor Assessment' %>
                  </span>
                </td>
                <td><%= a.question_type === 'multiple_choice' ? 'Multiple Choice'
                      : a.question_type === 'true_false' ? 'True or False' : 'Mixed' %></td>
                <td><%= a.question_count %></td>
                <td><%= a.submission_count %></td>
                <td>
                  <span class="badge badge-<%= a.is_published ? 'success' : 'warning' %>">
                    <%= a.is_published ? 'Published' : 'Draft' %>
                  </span>
                </td>
                <td><%= formatDate(a.created_at) %></td>
                <td>
                  <a class="btn btn-secondary btn-sm"
                     href="/tutor/modules/<%= mod.id %>/assessments/<%= a.id %>/submissions">
                    Check Answers
                  </a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>

  <div class="row-actions">
    <a href="/tutor/modules" class="btn btn-secondary">Back to Modules</a>
  </div>
</section>
