<%# File: views/content/tutor-module-detail.ejs
    Purpose: One module as the tutor sees it — Admin's handouts (readable, not
    editable) and the assessments the tutor has built on them. %>
<section class="page-stack">
  <div class="toolbar-card split">
    <div>
      <h2>Module <%= mod.order_number %> — <%= mod.title %></h2>
      <p class="res-subtitle">
        <%= mod.subject_name %>
        <% if (mod.target_year_levels && mod.target_year_levels.length) { %>
          &middot; <%= mod.target_year_levels.join(', ') %>
        <% } else { %>
          &middot; all year levels
        <% } %>
      </p>
    </div>
    <a class="btn btn-primary" href="/tutor/modules/<%= mod.id %>/create-assessment">Create Assessment</a>
  </div>

  <% if (mod.description) { %>
    <section class="panel-card">
      <p class="module-card-desc"><%= mod.description %></p>
    </section>
  <% } %>

  <%# ---- Handouts (Admin's, read-only) ------------------------------------ %>
  <section class="panel-card">
    <div class="panel-card-head">
      <h3>Handouts</h3>
      <span class="badge badge-info"><%= handouts.length %> file<%= handouts.length === 1 ? '' : 's' %></span>
    </div>
    <p class="table-note">Uploaded by Admin. A handout with readable text can also be used to draft an assessment with AI.</p>

    <% if (!handouts.length) { %>
      <p class="empty-state">No handouts on this module yet.</p>
    <% } %>

    <div class="handout-grid">
      <% handouts.forEach((h) => { %>
        <article class="handout-card">
          <div class="handout-card-head">
            <span class="handout-ext"><%= ((h.file_original_name || '').split('.').pop() || 'file').toUpperCase() %></span>
            <% if (h.extracted_at) { %>
              <span class="badge badge-success">Text ready<%= h.extraction_method === 'ocr' ? ' (AI-read scan)' : '' %></span>
            <% } else { %>
              <span class="badge badge-warning">No text for questions</span>
            <% } %>
          </div>
          <h4><%= h.title || h.file_original_name %></h4>
          <p class="handout-meta">
            <%= h.file_size_bytes ? (Math.round(Number(h.file_size_bytes) / 1024) + ' KB') : 'size unknown' %>
            &middot; <%= formatDate(h.created_at) %>
          </p>
          <% if (!h.extracted_at && h.extraction_error) { %>
            <p class="handout-error"><%= h.extraction_error %></p>
          <% } %>
          <div class="handout-card-foot">
            <a class="btn btn-secondary btn-sm" href="<%= h.file_path %>" target="_blank" rel="noopener">Open</a>
          </div>
        </article>
      <% }) %>
    </div>
  </section>

  <%# ---- The tutor's assessments ------------------------------------------ %>
  <section class="panel-card">
    <div class="panel-card-head">
      <h3>Assessments for this Module</h3>
      <span class="badge badge-info"><%= assessments.length %></span>
    </div>

    <p class="table-note">
      An assessment you create here shows up inside this module for every student it
      is assigned to. Once they answer it, "Check Answers" opens their work.
    </p>

    <% if (!assessments.length) { %>
      <p class="empty-state">No assessments yet. "Create Assessment" builds one by hand, or drafts it from the handouts above.</p>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Title</th>
              <th>Kind</th>
              <th>Type</th>
              <th>Items</th>
              <th>Answered</th>
              <th>Status</th>
              <th>Created</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% assessments.forEach((a) => { %>
              <tr>
                <td><strong><%= a.title %></strong></td>
                <td>
                  <span class="badge badge-<%= a.assessment_kind === 'pre_assessment' ? 'info' : a.assessment_kind === 'post_assessment' ? 'success' : 'warning' %>">
                    <%= a.assessment_kind === 'pre_assessment' ? 'Pre-Assessment'
                      : a.assessment_kind === 'post_assessment' ? 'Post-Assessment' : 'Tutor Assessment' %>
                  </span>
                </td>
                <td><%= a.question_type === 'mixed' || !a.question_type ? 'Mixed'
                      : a.question_type === 'multiple_choice' ? 'Multiple Choice'
                      : a.question_type === 'true_false' ? 'True or False' : 'Essay' %></td>
                <td><%= a.question_count %></td>
                <td><%= a.submission_count %></td>
                <td>
                  <span class="badge badge-<%= a.is_published ? 'success' : 'warning' %>">
                    <%= a.is_published ? 'Published' : 'Draft' %>
                  </span>
                </td>
                <td><%= formatDate(a.created_at) %></td>
                <td>
                  <a class="btn btn-secondary btn-sm"
                     href="/tutor/modules/<%= mod.id %>/assessments/<%= a.id %>/submissions">
                    Check Answers
                  </a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>

  <div class="row-actions">
    <a href="/tutor/modules" class="btn btn-secondary">Back to Modules</a>
  </div>
</section>
