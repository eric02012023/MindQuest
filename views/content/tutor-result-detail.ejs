<%# Tutor Result Detail View — Shows individual student answers %>
<section class="page-stack">

  <%# Summary Card %>
  <section class="panel-card">
    <div class="panel-card-head">
      <h2>Result Detail</h2>
    </div>
    <div class="result-summary-grid">
      <div class="result-summary-item">
        <span class="result-label">Student</span>
        <span class="result-value"><%= submission.first_name %> <%= submission.last_name %></span>
      </div>
      <div class="result-summary-item">
        <span class="result-label">Assessment</span>
        <span class="result-value"><%= submission.assessment_title %></span>
      </div>
      <div class="result-summary-item">
        <span class="result-label">Subject</span>
        <span class="result-value"><%= submission.subject_name %></span>
      </div>
      <div class="result-summary-item">
        <span class="result-label">Level</span>
        <span class="result-value"><span class="level-badge <%= (submission.level || '').toLowerCase() %>"><%= submission.level %></span></span>
      </div>
      <div class="result-summary-item">
        <span class="result-label">Score</span>
        <span class="result-value score-big"><%= submission.score %>/<%= submission.total_points %> (<%= Number(submission.percentage).toFixed(1) %>%)</span>
      </div>
      <div class="result-summary-item">
        <span class="result-label">Submitted</span>
        <span class="result-value"><%= new Date(submission.submitted_at).toLocaleString() %></span>
      </div>
    </div>
  </section>

  <%# Answer Details %>
  <section class="panel-card">
    <div class="panel-card-head">
      <h2>Answers</h2>
    </div>
    <% (answers || []).forEach((a, i) => { %>
      <div class="answer-card <%= a.is_correct ? 'correct' : 'wrong' %>">
        <div class="answer-header">
          <span class="answer-num">Q<%= i + 1 %></span>
          <span class="answer-type"><%= a.question_type === 'multiple_choice' ? 'MCQ' : a.question_type === 'true_false' ? 'T/F' : 'Fill' %></span>
          <span class="answer-result <%= a.is_correct ? 'correct' : 'wrong' %>">
            <%= a.is_correct ? '✓ Correct' : '✗ Wrong' %> (<%= a.points_earned %>/<%= a.points %> pts)
          </span>
        </div>
        <p class="answer-question"><%= a.question_text %></p>
        <div class="answer-comparison">
          <div class="answer-col">
            <span class="answer-label">Student's Answer</span>
            <span class="answer-text <%= a.is_correct ? '' : 'wrong-text' %>"><%= a.student_answer || '(no answer)' %></span>
          </div>
          <div class="answer-col">
            <span class="answer-label">Correct Answer</span>
            <span class="answer-text correct-text"><%= a.correct_answer %></span>
          </div>
        </div>
        <% if (a.explanation) { %>
          <p class="answer-explanation">💡 <%= a.explanation %></p>
        <% } %>
      </div>
    <% }) %>
  </section>

  <a href="/tutor/student-results" class="btn btn-secondary" style="margin-top: 10px;">← Back to Results</a>
</section>

<style>
  .result-summary-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    padding: 16px 0;
  }
  .result-summary-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .result-label {
    font-size: 12px;
    color: var(--text-soft);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-weight: 600;
  }
  .result-value {
    font-size: 15px;
    font-weight: 600;
    color: var(--text);
  }
  .score-big {
    font-size: 18px;
    color: var(--primary-700);
  }
  .answer-card {
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 16px;
    margin-bottom: 14px;
    background: var(--surface-soft);
    border-left: 4px solid var(--border);
  }
  .answer-card.correct {
    border-left-color: var(--success);
  }
  .answer-card.wrong {
    border-left-color: var(--danger);
  }
  .answer-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
  }
  .answer-num {
    font-weight: 700;
    font-size: 13px;
    background: var(--gradient-main);
    color: #fff;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .answer-type {
    font-size: 12px;
    color: var(--text-soft);
    background: var(--surface-muted);
    padding: 2px 8px;
    border-radius: 999px;
  }
  .answer-result {
    margin-left: auto;
    font-weight: 600;
    font-size: 13px;
  }
  .answer-result.correct { color: var(--success); }
  .answer-result.wrong { color: var(--danger); }
  .answer-question {
    font-size: 14px;
    margin-bottom: 12px;
    line-height: 1.6;
  }
  .answer-comparison {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  .answer-col {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .answer-label {
    font-size: 11px;
    text-transform: uppercase;
    color: var(--text-soft);
    font-weight: 600;
  }
  .answer-text {
    font-weight: 600;
    padding: 8px 12px;
    border-radius: 8px;
    background: #fff;
    border: 1px solid var(--border);
  }
  .wrong-text {
    background: #fef2f2;
    border-color: #fecaca;
    color: var(--danger);
  }
  .correct-text {
    background: #f0fdf4;
    border-color: #bbf7d0;
    color: var(--success);
  }
  .answer-explanation {
    margin-top: 10px;
    font-size: 13px;
    color: var(--text-soft);
    font-style: italic;
  }
</style>
