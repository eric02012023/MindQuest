<%# File: views/content/level-module-detail.ejs
    Purpose: One level module (lib/levelModules.js) as staff see it — the lesson
    written for the level, the admin's handouts it was written from, and the
    activities a student of that level answers inside it: the level module's own
    and those written before level modules, which every level answers.

    The tutor writes activities here (routes/tutor.js); the admin can have the
    lesson written again (routes/adminFactory.js); an assistant admin views.

    Locals: levelModule (with source, sections, status, error_message, is_stale),
            handouts, assessments, viewerRole ('tutor' | 'admin' | 'admin_assistant'),
            moduleHref (the admin's module page for this viewer) %>
<%
  const lm = levelModule;
  const src = lm.source;
  const isTutor = viewerRole === 'tutor';
  const isAdmin = viewerRole === 'admin';
  const statusText = lm.status === 'ready' ? 'Ready'
    : lm.status === 'failed' ? 'Could not be written' : 'Being written';
  const typeLabel = (type) => type === 'multiple_choice' ? 'Multiple Choice'
    : type === 'true_false' ? 'True or False' : 'Mixed';
%>
<link rel="stylesheet" href="/css/level-modules.css" />
<section class="page-stack">
  <div class="toolbar-card split">
    <div>
      <h2>Module <%= src.order_number %> — <%= src.title %></h2>
      <p class="res-subtitle">
        <span class="lm-level lm-level-<%= lm.level.toLowerCase() %>"><%= lm.level %></span>
        &middot; <%= src.subject_name %> &middot; <%= src.grade_level || 'no grade level set' %>
      </p>
    </div>
    <div class="row-actions">
      <% if (isTutor) { %>
        <a class="btn btn-primary" href="/tutor/level-modules/<%= lm.id %>/create-assessment">Create Assessment</a>
      <% } %>
      <% if (isAdmin && lm.status !== 'generating') { %>
        <form method="post" action="<%= basePath %>/modules/<%= src.id %>/levels/<%= lm.level %>/make"
              data-confirm-message="Write the <%= lm.level %> lesson again from the module's handouts? It replaces the lesson students read now. Activities stay.">
          <button class="btn btn-secondary" type="submit">Write Again</button>
        </form>
      <% } %>
      <a class="btn btn-secondary" href="<%= moduleHref %>">Back to Module</a>
    </div>
  </div>

  <% if (lm.is_stale) { %>
    <p class="lm-state" role="note">The module's handouts changed after this lesson was written.</p>
  <% } %>

  <section class="panel-card">
    <div class="panel-card-head">
      <h3>Lesson</h3>
      <span class="lm-status lm-status-<%= lm.status %>"><%= statusText %></span>
    </div>
    <%- include('../partials/level-lesson', { levelModule: lm, viewer: 'staff' }) %>
  </section>

  <section class="panel-card">
    <div class="panel-card-head">
      <h3>Handouts</h3>
      <span class="badge badge-info"><%= handouts.length %> file<%= handouts.length === 1 ? '' : 's' %></span>
    </div>
    <% if (!handouts.length) { %>
      <p class="empty-state">No handouts on this module yet.</p>
    <% } %>
    <div class="handout-grid">
      <% handouts.forEach((h) => { %>
        <article class="handout-card">
          <div class="handout-card-head">
            <span class="handout-ext"><%= ((h.file_original_name || '').split('.').pop() || 'file').toUpperCase() %></span>
          </div>
          <h4><%= h.title || h.file_original_name %></h4>
          <div class="handout-card-foot">
            <a class="btn btn-secondary btn-sm" href="<%= h.file_path %>" target="_blank" rel="noopener">Open</a>
          </div>
        </article>
      <% }) %>
    </div>
  </section>

  <section class="panel-card">
    <div class="panel-card-head">
      <h3>Activities</h3>
      <span class="badge badge-info"><%= assessments.length %></span>
    </div>
    <% if (!assessments.length) { %>
      <p class="empty-state">No activities yet.</p>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Title</th>
              <th>Level</th>
              <th>Type</th>
              <th>Items</th>
              <th>Answered</th>
              <th>Created</th>
              <% if (isTutor) { %><th>Manage</th><% } %>
            </tr>
          </thead>
          <tbody>
            <% assessments.forEach((a) => { %>
              <tr>
                <td><strong><%= a.title %></strong><% if (!Number(a.is_published)) { %> <span class="badge badge-warning">Draft</span><% } %></td>
                <td>
                  <% if (a.level_module_level) { %>
                    <span class="lm-level lm-level-<%= String(a.level_module_level).toLowerCase() %>"><%= a.level_module_level %></span>
                  <% } else { %>
                    Every level
                  <% } %>
                </td>
                <td><%= typeLabel(a.question_type) %></td>
                <td><%= a.question_count %></td>
                <td><%= a.submission_count %></td>
                <td><%= formatDate(a.created_at) %></td>
                <% if (isTutor) { %>
                  <td>
                    <a class="btn btn-secondary btn-sm" href="/tutor/modules/<%= src.id %>/assessments/<%= a.id %>/submissions">Check Answers</a>
                  </td>
                <% } %>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
</section>
