<%# File: views/content/admin-income-report.ejs
    Purpose: Payment Collection — one row per transaction, plus the alerts that
    go with it.

    RENAMED FROM "INCOME REPORT" (Phase 7.3)
    This page reports money COLLECTED from students. It says nothing about what
    the centre spends, so calling it income invited staff to read it as a profit
    figure. The URL is still /income-report: old links and bookmarks resolve.

    WHAT WENT (Phase 7.3)
    The "Monthly income" and "Income per branch" charts, and the whole Chart.js
    bundle they needed. Both drew numbers that the summary bar and the rows
    already carry — filterable by date and branch, and to the peso rather than
    to the nearest pixel.

    WHAT ARRIVED (Phase 7.2)
    The notification section at the foot. Admin and Assistant Admin no longer
    have a topbar bell; their alerts are about money, so they sit beside the
    transactions they refer to.

    Every row is one payment_entries record, so the report and a student's ledger
    can never disagree: they are the same rows.

    Locals: rows (this page), allRows (the whole filtered set), summary, pager,
            filters, paymentMethods, paymentPurposes, alerts, inboxNotifications %>
<%
  const pagerState = typeof pager === 'undefined' ? null : pager;
  const currentQuery = typeof query === 'undefined' ? {} : query;
%>
<section class="mq-page">

  <div class="mq-summary">
    <div class="mq-summary-item is-positive">
      <span>Total collected</span><strong><%= money(summary.totalIncome) %></strong>
    </div>
    <div class="mq-summary-item">
      <span>Transactions</span><strong><%= summary.transactionCount %></strong>
    </div>
    <div class="mq-summary-item is-accent">
      <span>This month</span><strong><%= money(summary.monthIncome) %></strong>
    </div>
    <div class="mq-summary-item">
      <span>Paying students</span><strong><%= summary.payingStudents %></strong>
    </div>
    <div class="mq-summary-item is-negative">
      <span>Outstanding</span><strong><%= money(summary.outstanding) %></strong>
    </div>
  </div>

  <form class="mq-toolbar" method="get" action="<%= basePath %>/income-report">
    <div class="mq-filters">
      <label class="mq-field mq-field-search">
        <span>Search</span>
        <input type="search" name="search" value="<%= filters.search || '' %>" placeholder="Student, ID or reference" />
      </label>
      <label class="mq-field">
        <span>From</span>
        <input type="date" name="from" value="<%= filters.from || '' %>" />
      </label>
      <label class="mq-field">
        <span>To</span>
        <input type="date" name="to" value="<%= filters.to || '' %>" />
      </label>
      <% if (currentUser.role === 'admin' && (branches || []).length) { %>
        <label class="mq-field">
          <span>Branch</span>
          <select name="branch_id">
            <option value="all">All branches</option>
            <% (branches || []).forEach((branch) => { %>
              <option value="<%= branch.id %>" <%= String(selectedBranch) === String(branch.id) ? 'selected' : '' %>><%= branch.name %></option>
            <% }) %>
          </select>
        </label>
      <% } %>
      <label class="mq-field">
        <span>Method</span>
        <select name="method">
          <option value="all">All methods</option>
          <% (paymentMethods || []).forEach((method) => { %>
            <option value="<%= method.value %>" <%= filters.method === method.value ? 'selected' : '' %>><%= method.value %></option>
          <% }) %>
        </select>
      </label>
      <label class="mq-field">
        <span>Purpose</span>
        <select name="purpose">
          <option value="all">All purposes</option>
          <% (paymentPurposes || []).forEach((purpose) => { %>
            <option value="<%= purpose %>" <%= filters.purpose === purpose ? 'selected' : '' %>><%= purpose %></option>
          <% }) %>
        </select>
      </label>
      <button class="mq-btn mq-btn-primary" type="submit"><%- icon('search') %> Apply</button>
      <a class="mq-btn" href="<%= basePath %>/income-report">Clear</a>
    </div>

    <div class="mq-toolbar-actions">
      <button type="button" class="mq-btn" onclick="window.print()"><%- icon('print') %> Print</button>
    </div>
  </form>

  <section class="mq-panel">
    <div class="mq-panel-head">
      <div>
        <h2>Transactions</h2>
        <p>One row per payment received. Figures come straight from the student ledgers.</p>
      </div>
      <span class="mq-count"><%= summary.transactionCount %> record<%= summary.transactionCount === 1 ? '' : 's' %></span>
    </div>

    <div class="mq-table" style="--mq-min-width: 974px; --mq-cols: 150px minmax(170px, 2fr) 1fr 110px 110px 110px minmax(120px, 1fr);">
      <div class="mq-head">
        <span>Date &amp; time</span>
        <span>Student</span>
        <span>Branch</span>
        <span class="mq-num">Amount</span>
        <span>Method</span>
        <span>Purpose</span>
        <span>Recorded by</span>
      </div>

      <% if (!rows.length) { %>
        <div class="mq-empty">
          <strong>No transactions in this range</strong>
          Widen the date range, or clear the filters above.
        </div>
      <% } %>

      <% rows.forEach((row) => { %>
        <div class="mq-row">
          <span class="mq-cell mq-sub" data-label="Date"><%= formatDateTime(row.paid_at) %></span>

          <span class="mq-cell mq-cell-primary" data-label="Student">
            <a class="mq-name" href="<%= basePath %>/billing?info=<%= row.student_id %>"><%= titleCaseName(row.first_name) %> <%= titleCaseName(row.last_name) %></a>
            <span class="mq-sub"><%= row.user_id %><%= row.reference_no ? ` · ${row.reference_no}` : '' %></span>
          </span>

          <span class="mq-cell" data-label="Branch"><%= row.branch_name || '—' %></span>
          <span class="mq-cell mq-money mq-money-paid" data-label="Amount"><%= money(row.amount) %></span>
          <span class="mq-cell" data-label="Method"><span class="mq-chip"><%= row.payment_method || 'Cash' %></span></span>
          <span class="mq-cell mq-sub" data-label="Purpose"><%= row.purpose || 'Tuition' %></span>
          <span class="mq-cell mq-sub" data-label="Recorded by">
            <%= row.recorded_by_name
                || (row.recorder_first_name ? `${row.recorder_first_name} ${row.recorder_last_name || ''}` : 'System') %>
          </span>
        </div>
      <% }) %>

      <% if (pagerState) { %>
        <%- include('../partials/mq-pager', { pager: pagerState, baseUrl: `${basePath}/income-report`, params: currentQuery, noun: 'transaction' }) %>
      <% } %>
    </div>
  </section>

  <%# Phase 7.3: the "Monthly income" and "Income per branch" charts were here.
      Both are gone. Every figure they drew is already in the summary bar at the
      top and in the rows above, filterable by date and branch — the charts were
      a second, less precise rendering of the same numbers, and "income" was the
      wrong word for money collected from students in the first place. %>

  <%# ================================================== notifications (7.2)
      The topbar bell is gone for Admin and Assistant Admin (7.1). Their alerts
      are about money — a slip waiting at the counter, a payment just taken — so
      they belong here, next to the transactions they refer to, rather than in a
      dropdown that had to be opened to be read.
      ================================================================== %>
  <section class="mq-panel">
    <div class="mq-panel-head">
      <div>
        <h2>Notifications</h2>
        <p>Payment alerts and anything else waiting on you. Registrations and enrolment
           requests are worked through on the Notifications page.</p>
      </div>
      <span class="mq-count"><%= (alerts || []).length + (inboxNotifications || []).length %></span>
    </div>

    <% if (!(alerts || []).length && !(inboxNotifications || []).length) { %>
      <div class="mq-empty">
        <strong>Nothing waiting</strong>
        New payment slips and recorded POS payments appear here as they happen.
      </div>
    <% } %>

    <% if ((alerts || []).length) { %>
      <div class="mq-table" style="--mq-cols: 150px minmax(180px, 1.4fr) minmax(220px, 2fr) 150px 110px;">
        <div class="mq-head">
          <span>Type</span><span>What happened</span><span>Detail</span><span>When</span>
          <span style="text-align:right;">Action</span>
        </div>
        <% (alerts || []).forEach((alert) => {
             // Phase 7.4: the old "Cash payment request" alert is gone with the
             // flow it belonged to. Two POS-shaped alerts replace it — a slip
             // waiting to be paid, and a payment actually recorded.
             const label = alert.type === 'payment_slip' ? 'Pending payment slip'
               : alert.type === 'pos_payment' ? 'POS payment recorded'
               : alert.type === 'payment_request' ? 'Pending payment slip'
               : String(alert.type || 'Alert').replace(/_/g, ' ');
             const tone = alert.type === 'pos_payment' ? 'mq-status-paid'
               : alert.severity === 'warning' ? 'mq-status-partial' : 'mq-status-unpaid'; %>
          <div class="mq-row">
            <span class="mq-cell" data-label="Type"><span class="mq-status <%= tone %>"><%= label %></span></span>
            <span class="mq-cell mq-cell-primary" data-label="What happened">
              <span class="mq-name"><%= alert.title %></span>
            </span>
            <span class="mq-cell mq-sub" data-label="Detail"><%= alert.message || '—' %></span>
            <span class="mq-cell mq-sub" data-label="When"><%= formatDateTime(alert.created_at) %></span>
            <span class="mq-cell mq-cell-actions">
              <% if (alert.link_url) { %>
                <a class="mq-btn mq-btn-sm mq-btn-primary" href="<%= alert.link_url %>">Open</a>
              <% } %>
              <form method="post" action="<%= basePath %>/alerts/<%= alert.id %>/read">
                <button class="mq-btn mq-btn-sm" type="submit">Mark read</button>
              </form>
            </span>
          </div>
        <% }) %>
      </div>
    <% } %>

    <% if ((inboxNotifications || []).length) { %>
      <div class="mq-form-foot" style="padding:12px 16px;">
        <a class="mq-btn" href="<%= basePath %>/notifications">
          <%- icon('view') %>
          <%= inboxNotifications.length %> registration/enrolment request<%= inboxNotifications.length === 1 ? '' : 's' %> waiting
        </a>
      </div>
    <% } %>
  </section>

</section>

<%# The Chart.js bundle and the two chart builders that lived here were removed
    with the charts themselves (Phase 7.3). This page draws nothing now, so it no
    longer pulls a charting library it does not use. %>
