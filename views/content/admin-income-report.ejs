<%# File: views/content/admin-income-report.ejs
    Purpose: Income Report — one row per transaction.

    Rebuilt from four large gradient cards and a chart-first layout into the
    shared row system: a compact summary bar, a filter toolbar (search, date
    range, branch, method, purpose), the transaction rows, and the trend chart
    underneath rather than above — the numbers are what this page is for.

    Every row is one payment_entries record, so the report and a student's ledger
    can never disagree: they are the same rows.

    Locals: rows (this page), allRows (the whole filtered set, for the chart),
            summary, pager, filters, paymentMethods, paymentPurposes %>
<%
  const pagerState = typeof pager === 'undefined' ? null : pager;
  const currentQuery = typeof query === 'undefined' ? {} : query;
  const everyRow = allRows || [];

  // Chart series are built from the whole filtered set, not the visible page.
  const monthly = {};
  everyRow.forEach((row) => {
    const date = new Date(row.paid_at);
    if (Number.isNaN(date.getTime())) return;
    const key = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}`;
    if (!monthly[key]) monthly[key] = { income: 0, count: 0 };
    monthly[key].income += Number(row.amount || 0);
    monthly[key].count += 1;
  });
  const monthKeys = Object.keys(monthly).sort().slice(-12);
  const monthLabels = monthKeys.map((key) => {
    const [year, month] = key.split('-');
    return new Date(Number(year), Number(month) - 1).toLocaleString('en-US', { month: 'short', year: '2-digit' });
  });
  const monthValues = monthKeys.map((key) => Number(monthly[key].income.toFixed(2)));
  const monthCounts = monthKeys.map((key) => monthly[key].count);

  const byBranch = {};
  everyRow.forEach((row) => {
    const name = row.branch_name || 'Unassigned';
    byBranch[name] = (byBranch[name] || 0) + Number(row.amount || 0);
  });
  const branchLabels = Object.keys(byBranch);
  const branchValues = branchLabels.map((key) => Number(byBranch[key].toFixed(2)));
%>
<section class="mq-page">

  <div class="mq-summary">
    <div class="mq-summary-item is-positive">
      <span>Total income</span><strong><%= money(summary.totalIncome) %></strong>
    </div>
    <div class="mq-summary-item">
      <span>Transactions</span><strong><%= summary.transactionCount %></strong>
    </div>
    <div class="mq-summary-item is-accent">
      <span>This month</span><strong><%= money(summary.monthIncome) %></strong>
    </div>
    <div class="mq-summary-item">
      <span>Paying students</span><strong><%= summary.payingStudents %></strong>
    </div>
    <div class="mq-summary-item is-negative">
      <span>Outstanding</span><strong><%= money(summary.outstanding) %></strong>
    </div>
  </div>

  <form class="mq-toolbar" method="get" action="<%= basePath %>/income-report">
    <div class="mq-filters">
      <label class="mq-field mq-field-search">
        <span>Search</span>
        <input type="search" name="search" value="<%= filters.search || '' %>" placeholder="Student, ID or reference" />
      </label>
      <label class="mq-field">
        <span>From</span>
        <input type="date" name="from" value="<%= filters.from || '' %>" />
      </label>
      <label class="mq-field">
        <span>To</span>
        <input type="date" name="to" value="<%= filters.to || '' %>" />
      </label>
      <% if (currentUser.role === 'admin' && (branches || []).length) { %>
        <label class="mq-field">
          <span>Branch</span>
          <select name="branch_id">
            <option value="all">All branches</option>
            <% (branches || []).forEach((branch) => { %>
              <option value="<%= branch.id %>" <%= String(selectedBranch) === String(branch.id) ? 'selected' : '' %>><%= branch.name %></option>
            <% }) %>
          </select>
        </label>
      <% } %>
      <label class="mq-field">
        <span>Method</span>
        <select name="method">
          <option value="all">All methods</option>
          <% (paymentMethods || []).forEach((method) => { %>
            <option value="<%= method.value %>" <%= filters.method === method.value ? 'selected' : '' %>><%= method.value %></option>
          <% }) %>
        </select>
      </label>
      <label class="mq-field">
        <span>Purpose</span>
        <select name="purpose">
          <option value="all">All purposes</option>
          <% (paymentPurposes || []).forEach((purpose) => { %>
            <option value="<%= purpose %>" <%= filters.purpose === purpose ? 'selected' : '' %>><%= purpose %></option>
          <% }) %>
        </select>
      </label>
      <button class="mq-btn mq-btn-primary" type="submit"><%- icon('search') %> Apply</button>
      <a class="mq-btn" href="<%= basePath %>/income-report">Clear</a>
    </div>

    <div class="mq-toolbar-actions">
      <button type="button" class="mq-btn" onclick="window.print()"><%- icon('print') %> Print</button>
    </div>
  </form>

  <section class="mq-panel">
    <div class="mq-panel-head">
      <div>
        <h2>Transactions</h2>
        <p>One row per payment received. Figures come straight from the student ledgers.</p>
      </div>
      <span class="mq-count"><%= summary.transactionCount %> record<%= summary.transactionCount === 1 ? '' : 's' %></span>
    </div>

    <div class="mq-table" style="--mq-cols: 150px minmax(170px, 2fr) 1fr 110px 110px 110px minmax(120px, 1fr);">
      <div class="mq-head">
        <span>Date &amp; time</span>
        <span>Student</span>
        <span>Branch</span>
        <span class="mq-num">Amount</span>
        <span>Method</span>
        <span>Purpose</span>
        <span>Recorded by</span>
      </div>

      <% if (!rows.length) { %>
        <div class="mq-empty">
          <strong>No transactions in this range</strong>
          Widen the date range, or clear the filters above.
        </div>
      <% } %>

      <% rows.forEach((row) => { %>
        <div class="mq-row">
          <span class="mq-cell mq-sub" data-label="Date"><%= formatDateTime(row.paid_at) %></span>

          <span class="mq-cell mq-cell-primary" data-label="Student">
            <a class="mq-name" href="<%= basePath %>/billing?info=<%= row.student_id %>"><%= titleCaseName(row.first_name) %> <%= titleCaseName(row.last_name) %></a>
            <span class="mq-sub"><%= row.user_id %><%= row.reference_no ? ` · ${row.reference_no}` : '' %></span>
          </span>

          <span class="mq-cell" data-label="Branch"><%= row.branch_name || '—' %></span>
          <span class="mq-cell mq-money mq-money-paid" data-label="Amount"><%= money(row.amount) %></span>
          <span class="mq-cell" data-label="Method"><span class="mq-chip"><%= row.payment_method || 'Cash' %></span></span>
          <span class="mq-cell mq-sub" data-label="Purpose"><%= row.purpose || 'Tuition' %></span>
          <span class="mq-cell mq-sub" data-label="Recorded by">
            <%= row.recorded_by_name
                || (row.recorder_first_name ? `${row.recorder_first_name} ${row.recorder_last_name || ''}` : 'System') %>
          </span>
        </div>
      <% }) %>

      <% if (pagerState) { %>
        <%- include('../partials/mq-pager', { pager: pagerState, baseUrl: `${basePath}/income-report`, params: currentQuery, noun: 'transaction' }) %>
      <% } %>
    </div>
  </section>

  <% if (monthKeys.length) { %>
    <div class="mq-chart-grid">
      <section class="mq-panel">
        <div class="mq-panel-head"><h3>Monthly income</h3></div>
        <div class="mq-chart-box"><canvas id="incomeChart"></canvas></div>
      </section>

      <% if (currentUser.role === 'admin' && branchLabels.length > 1) { %>
        <section class="mq-panel">
          <div class="mq-panel-head"><h3>Income per branch</h3></div>
          <div class="mq-chart-box"><canvas id="branchChart"></canvas></div>
        </section>
      <% } %>
    </div>
  <% } %>

</section>

<script src="/js/vendor/chart.umd.min.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (typeof Chart === 'undefined') return;

    var monthCanvas = document.getElementById('incomeChart');
    if (monthCanvas) {
      new Chart(monthCanvas.getContext('2d'), {
        type: 'bar',
        data: {
          labels: <%- JSON.stringify(monthLabels) %>,
          datasets: [
            {
              label: 'Income',
              data: <%- JSON.stringify(monthValues) %>,
              backgroundColor: 'rgba(22, 168, 200, 0.75)',
              borderRadius: 4,
              borderSkipped: false
            },
            {
              label: 'Transactions',
              type: 'line',
              data: <%- JSON.stringify(monthCounts) %>,
              borderColor: '#d28a1f',
              backgroundColor: 'rgba(210, 138, 31, 0.12)',
              borderWidth: 2,
              pointRadius: 3,
              tension: 0.3,
              yAxisID: 'y1'
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          interaction: { mode: 'index', intersect: false },
          plugins: { legend: { position: 'bottom', labels: { usePointStyle: true, boxWidth: 8, font: { size: 11 } } } },
          scales: {
            y: { beginAtZero: true, ticks: { callback: function (v) { return '₱' + v.toLocaleString(); }, font: { size: 11 } }, grid: { color: 'rgba(0,0,0,0.05)' } },
            y1: { beginAtZero: true, position: 'right', grid: { drawOnChartArea: false }, ticks: { precision: 0, font: { size: 11 } } },
            x: { grid: { display: false }, ticks: { font: { size: 11 } } }
          }
        }
      });
    }

    var branchCanvas = document.getElementById('branchChart');
    if (branchCanvas) {
      new Chart(branchCanvas.getContext('2d'), {
        type: 'doughnut',
        data: {
          labels: <%- JSON.stringify(branchLabels) %>,
          datasets: [{
            data: <%- JSON.stringify(branchValues) %>,
            backgroundColor: ['#16a8c8', '#0f7ea0', '#32a65a', '#d28a1f', '#8e6bd5', '#d54c4c', '#5f7084', '#0b3b53'],
            borderWidth: 0
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          cutout: '62%',
          plugins: { legend: { position: 'bottom', labels: { usePointStyle: true, boxWidth: 8, padding: 10, font: { size: 11 } } } }
        }
      });
    }
  });
</script>
