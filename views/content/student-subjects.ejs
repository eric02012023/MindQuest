<%# File: views/content/student-subjects.ejs
    Purpose: The student's subjects, who teaches each, and picking a tutor.

    PICKING A TUTOR (one dialog per subject that has no tutor yet)
      0. If one of the student's current tutors also teaches this subject, the
         dialog first offers to keep them — the subject joins the sessions the
         student already has with that tutor. "Choose another tutor" goes on.
      1. The student picks the days (Weekdays or Weekend) and the time.
      2. Only then are tutors listed: the ones in the student's branch who teach
         this subject, teach the student's year level, and are free on those
         days at that time. Each has "View profile" before they are chosen —
         it opens the tutor's full profile in this same tab, where the student
         can "Select this tutor" or go "Back to tutors". Coming back
         (?pick=<subject>&days=&slot=) reopens this dialog on the same list.

    The chosen tutor takes every open subject they teach once they accept; a
    subject they do not teach stays open for another tutor.

    Locals: assignments (enrolled, with tutor_*), allSubjects,
            tutorChoices { subjects: [{ subject_id, subject_name, tutors, currentTutors }],
                           timeSlots, preferredDays },
            pendingRequests (the student's requests still waiting on a tutor) %>
<%
  const choices = (typeof tutorChoices !== 'undefined' && tutorChoices) || { subjects: [], timeSlots: [], preferredDays: [] };
  const waiting = typeof pendingRequests === 'undefined' ? [] : (pendingRequests || []);
  const choiceFor = (subjectId) => choices.subjects.find((s) => Number(s.subject_id) === Number(subjectId)) || null;
  // A waiting request covers the subject it named and every other open subject
  // its tutor teaches.
  const requestFor = (subjectId) => {
    const choice = choiceFor(subjectId);
    return waiting.find((r) => Number(r.subject_id) === Number(subjectId)
      || (choice && choice.tutors.some((t) => Number(t.id) === Number(r.tutor_id)))) || null;
  };
  const scheduleText = (days, slot) => [days, slot].filter(Boolean).join(', ');
%>
<section class="page-stack">
  <section class="panel-card">
    <div class="panel-card-head">
      <h2>Enrolled Subjects</h2>
    </div>
    <div class="subject-list-cards">
      <% if (!assignments.length) { %>
        <p class="empty-state">No enrolled subjects yet.</p>
      <% } %>
      <% assignments.forEach((assignment) => {
           const pending = assignment.tutor_internal_id ? null : requestFor(assignment.subject_id);
           const canChoose = !assignment.tutor_internal_id && !pending && choiceFor(assignment.subject_id); %>
        <div class="subject-list-card">
          <div>
            <strong><%= assignment.subject_name %></strong>
            <span>
              <% if (assignment.tutor_internal_id) { %>
                Tutor: <a href="/student/tutors/<%= assignment.tutor_internal_id %>"><%= assignment.tutor_name %></a><%= scheduleText(assignment.preferred_days, assignment.time_slot) ? ` · ${scheduleText(assignment.preferred_days, assignment.time_slot)}` : '' %>
              <% } else if (pending) { %>
                Waiting for <%= pending.first_name %> <%= pending.last_name %> to accept · <%= scheduleText(pending.preferred_days, pending.time_slot) %>
              <% } else { %>
                No tutor yet
              <% } %>
            </span>
          </div>
          <span>Enrolled <%= formatDate(assignment.enrolled_at) %></span>
          <div class="row-actions wrap-row-actions">
            <a class="btn btn-secondary btn-sm" href="/student/subjects/<%= assignment.subject_id %>">View Subject</a>
            <% if (canChoose) { %>
              <button type="button" class="btn btn-primary btn-sm" data-modal-target="#select-tutor-<%= assignment.subject_id %>">Select Tutor</button>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>
  </section>

  <%# ------------------------------------------------ one dialog per subject %>
  <% choices.subjects.forEach((subject) => { if (requestFor(subject.subject_id)) return; %>
  <div class="global-modal" id="select-tutor-<%= subject.subject_id %>">
    <div class="global-modal-card wide st-dialog" data-tutor-picker data-subject-id="<%= subject.subject_id %>">
      <button type="button" class="modal-close" data-close-modal>&times;</button>
      <h3>Select a tutor for <%= subject.subject_name %></h3>

      <% if (subject.currentTutors.length) { %>
        <%# Step 0 — keep a tutor the student already has. %>
        <div class="st-step" data-step="keep">
          <p class="st-lead">Your current tutor also teaches <strong><%= subject.subject_name %></strong>. Do you want to keep them for this subject, or choose a different tutor?</p>
          <div class="st-tutor-list">
            <% subject.currentTutors.forEach((kept) => { %>
              <article class="st-tutor-card">
                <%- include('../partials/avatar', { avatarSrc: kept.image_path, avatarName: kept.name, avatarSize: 'md' }) %>
                <div class="st-tutor-info">
                  <strong><%= kept.name %></strong>
                  <span>Teaches you <%= kept.subjects.join(', ') %></span>
                  <span>Your sessions: <%= scheduleText(kept.preferred_days, kept.time_slot) || 'not scheduled yet' %></span>
                </div>
                <div class="st-tutor-actions">
                  <a class="btn btn-secondary btn-sm" href="/student/tutors/<%= kept.tutor_id %>?subject=<%= subject.subject_id %>&amp;from=keep">View profile</a>
                  <form method="post" action="/student/subjects/<%= subject.subject_id %>/keep-tutor"
                        data-confirm-message="Keep <%= kept.name %> as your <%= subject.subject_name %> tutor<%= kept.time_slot ? `, in your ${scheduleText(kept.preferred_days, kept.time_slot)} sessions` : '' %>?">
                    <input type="hidden" name="tutor_id" value="<%= kept.tutor_id %>" />
                    <button class="btn btn-primary btn-sm" type="submit">Keep this tutor</button>
                  </form>
                </div>
              </article>
            <% }) %>
          </div>
          <div class="st-step-foot">
            <button type="button" class="btn btn-secondary" data-picker-go="when">Choose another tutor</button>
          </div>
        </div>
      <% } %>

      <%# Step 1 — the days and the time, before any tutor is shown. Not a
          <form>: nothing is sent yet, and the shell treats any form submit as
          a page load (its loading overlay). %>
      <div class="st-step" data-step="when" <%= subject.currentTutors.length ? 'hidden' : '' %> data-picker-when>
        <p class="st-lead"><strong>Step 1.</strong> When do you want your sessions?</p>
        <fieldset class="st-days">
          <legend>Preferred days</legend>
          <% choices.preferredDays.forEach((day) => { %>
            <label class="st-day-option">
              <input type="radio" name="preferred_days_<%= subject.subject_id %>" value="<%= day %>" />
              <span>
                <strong><%= day %></strong>
                <small><%= day === 'Weekdays' ? 'Monday to Friday' : 'Saturday and Sunday' %></small>
              </span>
            </label>
          <% }) %>
        </fieldset>
        <label class="st-time">Preferred time
          <select data-picker-slot>
            <option value="">Select a time</option>
            <% choices.timeSlots.forEach((slot) => { %>
              <option value="<%= slot %>"><%= slot %></option>
            <% }) %>
          </select>
        </label>
        <p class="st-error" data-picker-error hidden role="alert"></p>
        <div class="st-step-foot">
          <% if (subject.currentTutors.length) { %>
            <button type="button" class="btn btn-secondary" data-picker-go="keep">Back</button>
          <% } %>
          <button type="button" class="btn btn-primary" data-picker-find>Show available tutors</button>
        </div>
      </div>

      <%# Step 2 — filled in from the data below once a time is chosen. %>
      <div class="st-step" data-step="tutors" hidden>
        <p class="st-lead"><strong>Step 2.</strong> Tutors free on <strong data-picker-summary></strong> who teach <%= subject.subject_name %> at your year level:</p>
        <div class="st-tutor-list" data-picker-list></div>
        <div class="st-step-foot">
          <button type="button" class="btn btn-secondary" data-picker-go="when">Change days or time</button>
        </div>
      </div>
    </div>
  </div>
  <% }) %>

  <section class="panel-card">
    <div class="panel-card-head"><h2>All Subjects</h2></div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Subject</th>
            <th>Status</th>
            <th>Option</th>
          </tr>
        </thead>
        <tbody>
          <% if (!(allSubjects || []).length) { %>
            <tr><td colspan="3">No subjects available.</td></tr>
          <% } %>
          <% (allSubjects || []).forEach((subject) => { %>
            <tr>
              <td><strong><%= subject.name %></strong></td>
              <td>
                <% if (subject.is_enrolled) { %>
                  <span class="pill paid">Enrolled</span>
                <% } else if (subject.has_pending_request) { %>
                  <span class="pill partial">Pending Approval</span>
                <% } else { %>
                  <span class="pill unpaid">Not Enrolled</span>
                <% } %>
              </td>
              <td>
                <% if (subject.is_enrolled) { %>
                  <a class="btn btn-secondary btn-sm" href="/student/subjects/<%= subject.id %>">View Subject</a>
                <% } else if (subject.has_pending_request) { %>
                  <button type="button" class="btn btn-secondary btn-sm" disabled>Request Sent</button>
                <% } else { %>
                  <form method="post" action="/student/subjects/<%= subject.id %>/enroll" data-confirm-message="Send an enrollment request for <%= subject.name %>?">
                    <button class="btn btn-primary btn-sm" type="submit">Enroll Subject</button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
</section>

<%# The tutors per subject, read by the dialog script. JSON in a script tag is
    data, never run; "<" is escaped so a name cannot close the tag. %>
<script type="application/json" id="tutor-choices-data"><%- JSON.stringify(choices.subjects.map((s) => ({ subject_id: s.subject_id, subject_name: s.subject_name, tutors: s.tutors }))).replace(/</g, '\\u003c') %></script>

<script>
(function () {
  var dataNode = document.getElementById('tutor-choices-data');
  if (!dataNode) return;
  var subjects = [];
  try { subjects = JSON.parse(dataNode.textContent || '[]'); } catch (_e) { subjects = []; }

  function el(tag, className, text) {
    var node = document.createElement(tag);
    if (className) node.className = className;
    if (text != null) node.textContent = text;
    return node;
  }

  function avatar(tutor) {
    if (tutor.image_path) {
      var img = el('img', 'mq-avatar mq-avatar-md');
      img.src = tutor.image_path;
      img.alt = tutor.name;
      img.loading = 'lazy';
      return img;
    }
    var parts = String(tutor.name || '').trim().split(/\s+/).filter(Boolean);
    var initials = parts.length > 1 ? parts[0][0] + parts[parts.length - 1][0] : (parts[0] || 'MQ').slice(0, 2);
    var span = el('span', 'mq-avatar mq-avatar-md mq-avatar-initials', initials.toUpperCase());
    span.setAttribute('role', 'img');
    span.setAttribute('aria-label', tutor.name);
    return span;
  }

  function show(picker, step) {
    picker.querySelectorAll('[data-step]').forEach(function (node) {
      node.hidden = node.getAttribute('data-step') !== step;
    });
  }

  // The tutor's full profile, in this same tab. The address carries what the
  // student has chosen so the profile can offer "Select this tutor", and its
  // "Back to tutors" brings them back to this very list.
  function profileHref(tutor, subject, days, slot) {
    var params = new URLSearchParams({ subject: String(subject.subject_id), days: days, slot: slot });
    return '/student/tutors/' + tutor.id + '?' + params.toString();
  }

  function renderTutors(picker, subject, days, slot) {
    var list = picker.querySelector('[data-picker-list]');
    var summary = picker.querySelector('[data-picker-summary]');
    summary.textContent = days + ', ' + slot;
    list.innerHTML = '';
    var key = days + '|' + slot;
    var free = (subject.tutors || []).filter(function (t) { return (t.blocked || []).indexOf(key) === -1; });

    if (!free.length) {
      var empty = el('p', 'empty-state', 'No tutor who teaches ' + subject.subject_name
        + ' is free on ' + days.toLowerCase() + ' at ' + slot + '. Try another time or other days.');
      list.appendChild(empty);
    }

    free.forEach(function (tutor) {
      var card = el('article', 'st-tutor-card');
      card.appendChild(avatar(tutor));

      var info = el('div', 'st-tutor-info');
      info.appendChild(el('strong', '', tutor.name));
      info.appendChild(el('span', '', 'Year levels: ' + ((tutor.year_levels || []).join(', ') || 'All levels')));
      if ((tutor.also_teaches || []).length) {
        info.appendChild(el('span', 'st-also', 'Also teaches your ' + tutor.also_teaches.join(', ') + ' — they would take it too.'));
      }
      card.appendChild(info);

      var actions = el('div', 'st-tutor-actions');
      var view = el('a', 'btn btn-secondary btn-sm', 'View profile');
      view.href = profileHref(tutor, subject, days, slot);
      actions.appendChild(view);

      var form = el('form');
      form.method = 'post';
      form.action = '/student/apply-tutor';
      form.setAttribute('data-confirm-message', 'Ask ' + tutor.name + ' to be your ' + subject.subject_name
        + ' tutor on ' + days.toLowerCase() + ', ' + slot + '?');
      [['tutor_id', tutor.id], ['subject_id', subject.subject_id], ['time_slot', slot], ['preferred_days', days]]
        .forEach(function (pair) {
          var input = document.createElement('input');
          input.type = 'hidden';
          input.name = pair[0];
          input.value = pair[1];
          form.appendChild(input);
        });
      var choose = el('button', 'btn btn-primary btn-sm', 'Select tutor');
      choose.type = 'submit';
      form.appendChild(choose);
      actions.appendChild(form);

      card.appendChild(actions);
      list.appendChild(card);
    });
    show(picker, 'tutors');
  }

  // Back from a tutor's profile: /student/subjects?pick=<subject>&days=&slot=
  var back = new URLSearchParams(window.location.search);
  var reopen = Number(back.get('pick')) || 0;

  document.querySelectorAll('[data-tutor-picker]').forEach(function (picker) {
    var subjectId = Number(picker.getAttribute('data-subject-id'));
    var subject = subjects.find(function (s) { return Number(s.subject_id) === subjectId; });
    if (!subject) return;

    var when = picker.querySelector('[data-picker-when]');
    var error = when.querySelector('[data-picker-error]');

    picker.addEventListener('click', function (event) {
      var go = event.target.closest('[data-picker-go]');
      if (go) show(picker, go.getAttribute('data-picker-go'));

      if (event.target.closest('[data-picker-find]')) {
        var picked = when.querySelector('input[type="radio"]:checked');
        var days = picked ? picked.value : '';
        var slot = when.querySelector('[data-picker-slot]').value;
        var problem = !days && !slot ? 'Choose your preferred days and time first.'
          : !days ? 'Choose Weekdays or Weekend first.'
          : !slot ? 'Choose your preferred time first.' : '';
        error.textContent = problem;
        error.hidden = !problem;
        if (!problem) renderTutors(picker, subject, days, slot);
      }
    });

    if (reopen !== subjectId) return;
    // Put back the days and time they had chosen, and the list they were on.
    var days = back.get('days') || '';
    var slot = back.get('slot') || '';
    var radio = Array.prototype.find.call(when.querySelectorAll('input[type="radio"]'), function (r) { return r.value === days; });
    var select = when.querySelector('[data-picker-slot]');
    if (radio) radio.checked = true;
    if (select && Array.prototype.some.call(select.options, function (o) { return o.value === slot; })) select.value = slot;
    if (radio && select && select.value) renderTutors(picker, subject, days, slot);
    else if (!picker.querySelector('[data-step="keep"]') || days || slot) show(picker, 'when');
    // openModal lives in /js/main.js, which loads after this page's markup.
    var modal = picker.closest('.global-modal');
    var openIt = function () {
      if (!modal) return;
      if (typeof openModal === 'function') openModal(modal);
      else modal.classList.add('is-open');
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', openIt);
    else openIt();
    // A reload should not reopen it again.
    if (window.history && window.history.replaceState) window.history.replaceState(null, '', window.location.pathname);
  });
})();
</script>

<style>
  .st-dialog { max-height: 88vh; overflow: auto; }
  .st-dialog h3 { margin-bottom: 6px; }
  .st-step { display: grid; gap: 14px; margin-top: 8px; }
  .st-step[hidden] { display: none; }
  .st-lead { margin: 0; color: var(--text-soft, #5f7084); line-height: 1.5; }
  .st-days { border: 0; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 10px; }
  .st-days legend { font-weight: 700; margin-bottom: 8px; font-size: 14px; }
  .st-day-option {
    display: flex; align-items: center; gap: 10px; padding: 12px 14px; cursor: pointer;
    border: 1px solid var(--border, #d7e2ea); border-radius: 14px; background: #fff;
    transition: border-color .15s ease, box-shadow .15s ease;
  }
  .st-day-option:has(input:checked) { border-color: #1c9a22; box-shadow: 0 0 0 3px rgba(28, 154, 34, .15); }
  .st-day-option span { display: grid; gap: 2px; }
  .st-day-option small { color: var(--text-soft, #5f7084); font-weight: 500; }
  .st-time { display: grid; gap: 6px; font-weight: 700; font-size: 14px; max-width: 320px; }
  .st-error { margin: 0; color: #d54c4c; font-size: 13px; font-weight: 600; }
  .st-step-foot { display: flex; flex-wrap: wrap; gap: 10px; justify-content: flex-end; }
  .st-tutor-list { display: grid; gap: 10px; }
  .st-tutor-card {
    display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 14px;
    padding: 12px 14px; border: 1px solid var(--border, #d7e2ea); border-radius: 16px; background: #fff;
  }
  .st-tutor-info { display: grid; gap: 3px; min-width: 0; }
  .st-tutor-info span { color: var(--text-soft, #5f7084); font-size: 13px; overflow-wrap: anywhere; }
  .st-tutor-info .st-also { color: #1c7a22; font-weight: 600; }
  .st-tutor-actions { display: flex; flex-wrap: wrap; gap: 8px; justify-content: flex-end; }
  .st-tutor-actions form { margin: 0; }
  @media (max-width: 640px) {
    .st-tutor-card { grid-template-columns: auto 1fr; }
    .st-tutor-actions { grid-column: 1 / -1; justify-content: flex-start; }
  }
</style>
