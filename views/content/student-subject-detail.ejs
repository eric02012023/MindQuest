<%# ANNOTATED COPY FOR DEFENSE REVIEW | File: views/content/student-subject-detail.ejs | Purpose: UI template/view used by the system. %>
<section class="page-stack">
  <div class="panel-card">
    <div class="panel-card-head"><h2><%= assignment.subject_name %></h2></div>
    <p><strong>Tutor:</strong> <%= assignment.tutor_name %></p>
    <p><strong>Time Schedule:</strong> <%= assignment.time_slot || '-' %></p>
    <p><strong>Preferred Days:</strong> <%= assignment.preferred_days || '-' %></p>
    <%# Phase 4.2: this subject's own month, which is not the same as any other
        subject's — each runs from the day it was taken out. %>
    <% if (assignment.start_date || assignment.end_date) { %>
      <p>
        <strong>Enrollment period:</strong>
        <%= formatDate(assignment.start_date) %> &ndash; <%= formatDate(assignment.end_date) %>
      </p>
    <% } %>
    <% if (tutor) { %>
      <%# The tutor's photo as an avatar — it used to be a bare <img> with no size,
          so a tutor without a photo showed the centre's logo at full width. %>
      <a class="limited-profile-card st-tutor-chip" href="/student/tutors/<%= tutor.id %>">
        <%- include('../partials/avatar', { avatarSrc: tutor.image_path, avatarName: `${tutor.first_name} ${tutor.last_name}`, avatarSize: 'lg' }) %>
        <div>
          <strong><%= tutor.first_name %> <%= tutor.last_name %></strong>
          <p>Email: <%= tutor.email || '-' %></p>
          <p>Contact: <%= tutor.contact_number || '-' %></p>
          <span class="st-tutor-chip-link">View profile &rarr;</span>
        </div>
      </a>
    <% } %>
  </div>

  <%# Once the subject's month is over it stays as it was on its last day: what
      was left in it can still be answered (monthNote), and with nothing left it
      is view-only — its modules and results can be opened (routes/student.js,
      monthLeftMessage / viewOnlyMessage). %>
  <% const finishedNote = typeof viewOnly === 'undefined' ? '' : viewOnly; %>
  <% const leftNote = typeof monthNote === 'undefined' ? '' : monthNote; %>
  <% if (finishedNote) { %>
    <section class="panel-card lock-card" role="note">
      <div class="lock-head">
        <span class="lock-icon" aria-hidden="true">&#128274;</span>
        <div>
          <h3>View only</h3>
        </div>
      </div>
      <p class="lock-note"><%= finishedNote %></p>
    </section>
  <% } else if (leftNote) { %>
    <p class="pa-deadline" role="note"><%= leftNote %></p>
  <% } %>

  <%# ------------------------------------------------------------------------
      Modules (overhaul Phase 6). Everything here is gated by the subject's
      Pre-Assessment. The gate is enforced server-side in routes/student.js and on
      /uploads/handouts — this panel only reflects that state.
      ------------------------------------------------------------------------ %>
  <% if (!preAssessmentDone && !finishedNote) { %>
    <section class="panel-card lock-card">
      <div class="lock-head">
        <span class="lock-icon" aria-hidden="true">&#128274;</span>
        <div>
          <h3>Pre-Assessment required</h3>
        </div>
      </div>
      <%# Two things can hold the Pre-Assessment shut, and they are different
          problems with different fixes: the down payment is the student's to
          settle, a missing handout is the centre's. Saying which one applies is
          the whole point — "locked" on its own tells them nothing to act on.
          Both are enforced in routes/student.js; this only reports them. %>
      <% const downPaymentDue = typeof downPayment !== 'undefined' && downPayment && !downPayment.satisfied; %>
      <% const myGrade = typeof gradeLevel === 'undefined' ? '' : gradeLevel; %>
      <%# Modules — and so the Pre-Assessment — are per grade: another grade's
          modules in this subject do not open anything for this student. %>
      <% if (!myGrade) { %>
        <p class="lock-note">Your grade level is not on your profile yet, so no modules are assigned to you. Please ask the office to set it.</p>
      <% } else if (!newModules.length) { %>
        <p class="lock-note">There are no <strong><%= myGrade %></strong> modules in <%= assignment.subject_name %> yet. The Pre-Assessment opens once your modules are ready.</p>
      <% } else if (downPaymentDue) { %>
        <p class="lock-note">
          A down payment of at least <strong><%= money(downPayment.required) %></strong> is required
          before you can take the Pre-Assessment.
          <% if (downPayment.hasBill) { %>
            You have paid <%= money(downPayment.paid) %>, so <strong><%= money(downPayment.shortfall) %></strong>
            is still needed.
          <% } else { %>
            Your account has not been billed yet — please contact the office.
          <% } %>
        </p>
        <% if (downPayment.hasBill) { %>
          <a class="btn btn-primary" href="/student/billing">Go to Billing Data</a>
        <% } %>
      <% } else if (handoutsReady) { %>
        <a class="btn btn-primary" href="/student/subjects/<%= assignment.subject_id %>/pre-assessment">Start Pre-Assessment</a>
      <% } else { %>
        <p class="lock-note">Your <%= myGrade %> modules have no handout yet, so the Pre-Assessment is not ready. It opens once the office uploads them.</p>
      <% } %>
    </section>

    <%# The Post-Assessment is compared with the Pre-Assessment, so it waits for it. %>
    <section class="panel-card">
      <div class="panel-card-head">
        <h3>Post-Assessment</h3>
        <span class="badge badge-info">Not open yet</span>
      </div>
      <p class="table-note">Take the Pre-Assessment first: the Post-Assessment is compared with it.</p>
    </section>
  <% } else if (preAssessmentDone) { %>
    <%# Level modules (lib/levelModules.js): each module written again for the
        level the Pre-Assessment placed this student at. That is where they read
        and answer the activities; the office's modules below are to view. A
        module with no level module for them (their month ended before it was
        made) opens the office's module, activities and all, as it always did. %>
    <% const entries = typeof levelEntries === 'undefined' ? [] : (levelEntries || []); %>
    <% const myLevel = typeof placementLevel === 'undefined' ? null : placementLevel; %>
    <% const levelOf = new Map(entries.map((entry) => [Number(entry.module.id), entry.levelModule])); %>
    <% const lp = typeof learningPath === 'undefined' ? null : learningPath; %>
    <link rel="stylesheet" href="/css/level-modules.css" />
    <% if (lp) { %>
    <%# A learning path (lib/learningPaths.js): their own copy of every module,
        each opened when they pass the one before. %>
    <section class="panel-card">
      <div class="panel-card-head">
        <h3>Your Modules</h3>
        <span class="lm-level lm-level-<%= String(lp.path.placement_level || 'beginner').toLowerCase() %>"><%= lp.path.placement_level %></span>
      </div>
      <p class="table-note">
        Pre-Assessment done &mdash; <%= Number(preAssessmentDone.percentage).toFixed(1) %>%,
        <%= preAssessmentDone.level %>.
        <a href="/student/results/<%= preAssessmentDone.id %>">View your result and topic breakdown</a>
        &middot; <%= lp.passed %> of <%= lp.total %> module<%= lp.total === 1 ? '' : 's' %> passed
      </p>

      <% if (!lp.modules.length) { %>
        <p class="empty-state">No modules in this subject yet.</p>
      <% } %>

      <div class="module-grid">
        <% lp.modules.forEach((m, index) => { %>
          <% const before = index > 0 ? lp.modules[index - 1] : null; %>
          <article class="module-card<%= m.status === 'locked' ? ' lp-locked' : '' %>">
            <div class="module-card-head">
              <span class="module-number">Module <%= m.order_number || m.position %></span>
              <% if (m.status === 'passed') { %>
                <span class="badge badge-success">Passed</span>
              <% } else if (m.status === 'open') { %>
                <span class="badge badge-info">Open</span>
              <% } else { %>
                <span class="badge badge-warning">Locked</span>
              <% } %>
            </div>
            <h4><%= m.module_title %></h4>
            <% if (m.additions_status === 'pending' || m.additions_status === 'generating') { %>
              <p class="lm-level-card-meta">Added lessons being prepared</p>
            <% } else if (m.weak_point_count) { %>
              <p class="lm-level-card-meta"><%= m.weak_point_count %> weak point<%= m.weak_point_count === 1 ? '' : 's' %> &middot; <%= m.added_count %> topics added for you</p>
            <% } else if (m.added_count) { %>
              <p class="lm-level-card-meta"><%= m.added_count %> lesson<%= m.added_count === 1 ? '' : 's' %> added for you</p>
            <% } else if (m.additions_status === 'none' && Number(m.pre_total) > 0) { %>
              <p class="lm-level-card-meta">Nothing added: all its Pre-Assessment items were right</p>
            <% } %>
            <% if (m.status === 'open') { %>
              <p class="lm-level-card-meta">
                <%= m.take_state === 'can_take' ? (m.attempts && m.attempts.length ? 'Not passed yet — take it again' : 'Assessment open')
                  : m.take_state === 'waiting_retake' ? 'Not passed yet — waiting for your next take'
                  : m.take_state === 'waiting_tutor' ? 'Assessment waiting for your tutor'
                  : 'Assessment being prepared' %>
              </p>
            <% } %>
            <div class="module-card-foot">
              <% if (m.status === 'locked') { %>
                <span class="module-card-meta">Opens when you pass Module <%= before ? (before.order_number || before.position) : '' %></span>
              <% } else { %>
                <a class="btn btn-primary btn-sm" href="/student/path-modules/<%= m.id %>">Open Module</a>
              <% } %>
            </div>
          </article>
        <% }) %>
      </div>
    </section>
    <style>.lp-locked { opacity: .72; }</style>
    <% } else { %>
    <section class="panel-card">
      <div class="panel-card-head">
        <h3>Your Modules</h3>
        <% if (myLevel) { %>
          <span class="lm-level lm-level-<%= myLevel.toLowerCase() %>"><%= myLevel %></span>
        <% } else { %>
          <span class="badge badge-success">Unlocked</span>
        <% } %>
      </div>
      <p class="table-note">
        Pre-Assessment done &mdash; <%= Number(preAssessmentDone.percentage).toFixed(1) %>%,
        <%= preAssessmentDone.level %>.
        <a href="/student/results/<%= preAssessmentDone.id %>">View your result and topic breakdown</a>
      </p>

      <% if (!newModules.length) { %>
        <p class="empty-state">No <%= typeof gradeLevel !== 'undefined' && gradeLevel ? gradeLevel : 'grade-level' %> modules in this subject yet.</p>
      <% } %>

      <div class="module-grid">
        <% newModules.forEach((mod) => { %>
          <% const mine = levelOf.get(Number(mod.id)) || null; %>
          <article class="module-card">
            <div class="module-card-head">
              <span class="module-number">Module <%= mod.order_number %></span>
              <% if (mine) { %>
                <span class="lm-level lm-level-<%= mine.level.toLowerCase() %>"><%= mine.level %></span>
              <% } else { %>
                <span class="badge <%= (mod.handouts || []).length ? 'badge-success' : 'badge-warning' %>">
                  <%= (mod.handouts || []).length %> handout<%= (mod.handouts || []).length === 1 ? '' : 's' %>
                </span>
              <% } %>
            </div>
            <h4><%= mod.title %></h4>
            <% if (mod.description) { %><p class="module-card-desc"><%= mod.description %></p><% } %>

            <% if (mine && mine.status !== 'ready') { %>
              <p class="lm-level-card-meta"><%= mine.status === 'failed' ? 'Lesson not ready yet' : 'Lesson being prepared' %></p>
            <% } %>

            <div class="module-card-foot">
              <% if (mine) { %>
                <a class="btn btn-primary btn-sm" href="/student/level-modules/<%= mine.id %>">Open Module</a>
              <% } else { %>
                <a class="btn btn-secondary btn-sm" href="/student/modules/<%= mod.id %>">Open Module</a>
              <% } %>
            </div>
          </article>
        <% }) %>
      </div>
    </section>

    <% if (newModules.some((mod) => levelOf.get(Number(mod.id)))) { %>
      <section class="panel-card">
        <div class="panel-card-head">
          <h3>Module Handouts</h3>
          <span class="badge badge-info">View only</span>
        </div>
        <div class="module-grid">
          <% newModules.filter((mod) => levelOf.get(Number(mod.id))).forEach((mod) => { %>
            <article class="module-card">
              <div class="module-card-head">
                <span class="module-number">Module <%= mod.order_number %></span>
                <span class="badge <%= (mod.handouts || []).length ? 'badge-success' : 'badge-warning' %>">
                  <%= (mod.handouts || []).length %> handout<%= (mod.handouts || []).length === 1 ? '' : 's' %>
                </span>
              </div>
              <h4><%= mod.title %></h4>
              <div class="module-card-foot">
                <a class="btn btn-secondary btn-sm" href="/student/modules/<%= mod.id %>">View</a>
              </div>
            </article>
          <% }) %>
        </div>
      </section>
    <% } %>
    <% } %>

    <%# --------------------------------------------------------------------
        Post-Assessment (overhaul Phase 8). It opens when the student's tutor —
        or the main admin — opens it for them, once they have finished their
        modules, and stays open until they take it. The same rule is enforced
        server-side on the route; this only says where they stand.
        -------------------------------------------------------------------- %>
    <section class="panel-card">
      <div class="panel-card-head">
        <h3>Post-Assessment</h3>
        <% if (completion.postTaken) { %>
          <span class="badge badge-success">Done</span>
        <% } else if (completion.postStatus === 'open') { %>
          <span class="badge badge-success">Open now</span>
        <% } else { %>
          <span class="badge badge-info">Not open yet</span>
        <% } %>
      </div>

      <% if (completion.postTaken) { %>
        <p class="table-note">
          You scored <%= Number(completion.postSubmission.percentage).toFixed(1) %>%
          (<%= completion.postSubmission.level %>).
          <a href="/student/results/<%= completion.postSubmission.id %>">View your result and topic breakdown</a>
        </p>

        <%# On a learning path the comparison below this panel shows it, module by module too. %>
        <% if (comparison && comparison.pre_submission_id && !(lp && typeof pathScores !== 'undefined' && pathScores)) { %>
          <div class="prepost-compare">
            <div class="prepost-cell">
              <span class="prepost-cap">Before</span>
              <span class="prepost-pct"><%= Number(comparison.pre_percentage).toFixed(1) %>%</span>
              <span class="res-level res-level-<%= String(comparison.pre_level || '').toLowerCase() %>"><%= comparison.pre_level %></span>
            </div>
            <div class="prepost-arrow" aria-hidden="true">&rarr;</div>
            <div class="prepost-cell">
              <span class="prepost-cap">After</span>
              <span class="prepost-pct"><%= Number(comparison.post_percentage).toFixed(1) %>%</span>
              <span class="res-level res-level-<%= String(comparison.post_level || '').toLowerCase() %>"><%= comparison.post_level %></span>
            </div>
            <div class="prepost-delta <%= comparison.delta > 0 ? 'is-up' : comparison.delta < 0 ? 'is-down' : '' %>">
              <%= comparison.delta > 0 ? '+' : '' %><%= comparison.delta %> points
              <% if (comparison.level_changed) { %>
                <span class="prepost-move"><%= comparison.pre_level %> &rarr; <%= comparison.post_level %></span>
              <% } %>
            </div>
          </div>
        <% } %>

      <% } else if (completion.postStatus === 'open') { %>
        <p class="table-note">
          Your tutor opened your Post-Assessment.
          <%= lp && lp.post && !/same questions as your Pre-Assessment/i.test(String(lp.post.instructions || ''))
            ? 'Its questions come from your own modules,'
            : lp ? 'It repeats your Pre-Assessment, in a new order,' : 'It repeats your Pre-Assessment,' %>
          so you and your tutor can see how much you have improved.
        </p>
        <a class="btn btn-primary" href="/student/subjects/<%= assignment.subject_id %>/post-assessment">Start Post-Assessment</a>

      <% } else if (lp) { %>
        <p class="table-note">
          <% if (!lp.allPassed) { %>
            It opens after you pass all your modules (<%= lp.passed %> of <%= lp.total %> so far) and your tutor opens it.
          <% } else { %>
            You passed all your modules. Your tutor opens your Post-Assessment once it is ready.
          <% } %>
        </p>

      <% } else { %>
        <p class="table-note">Your tutor opens the Post-Assessment once you finish your modules.</p>
        <% if (completion.modulesOpened < completion.modulesTotal || completion.pendingAssessments.length) { %>
          <p class="table-note">Still to do:</p>
          <ul class="module-handout-list">
            <% if (completion.modulesOpened < completion.modulesTotal) { %>
              <li>Open all your modules (<%= completion.modulesOpened %> of <%= completion.modulesTotal %> so far)</li>
            <% } %>
            <% completion.pendingAssessments.forEach((a) => { %>
              <li><a href="/student/tutor-assessments/<%= a.id %>"><%= a.title %></a></li>
            <% }) %>
          </ul>
        <% } %>
      <% } %>
    </section>

    <%# A learning path: every score so far, and the Pre-Assessment against the Post. %>
    <% if (lp && typeof pathScores !== 'undefined' && pathScores) { %>
      <%- include('../partials/path-scores', { scores: pathScores, viewer: 'student', linkBase: '/student' }) %>
    <% } %>
  <% } %>
  <%# Phase 9: three panels were removed from here — the Gen 1 "Current Learning
      Cycle", the Gen 3 "Module Level System" gate, and the Gen 2 "Subject
      Assessments" pre/post block. All three answered the same question as the
      panels above ("what does this student do next in this subject?") from three
      different tables, and the page had to guess which one won. %>
  <%# ------------------------------------------------------------------------
      Legacy modules (Phase 9). These were uploaded under the previous module
      system and are kept read-only so existing student records still resolve.
      The lock branches that used to live here are gone: access is decided by the
      Pre-Assessment gate above and enforced server-side, not by this template.
      ------------------------------------------------------------------------ %>
  <% if ((modules || []).length) { %>
  <section class="panel-card">
    <div class="panel-card-head"><h3>Legacy Modules</h3></div>
    <div class="list-stack">
      <% modules.forEach((resource) => { %>
        <article class="list-card">
          <div>
            <strong><%= resource.title %></strong>
            <% if (resource.type_of_module) { %><span class="badge badge-info" style="margin-left:8px;"><%= resource.type_of_module %></span><% } %>
            <p><%= resource.description || 'No description' %></p>
            <% if (resource.file_path || resource.content_text) { %>
              <a href="/download/module/<%= resource.id %>" target="_blank">Open Module</a>
            <% } %>
          </div>
        </article>
      <% }) %>
    </div>
  </section>
  <% } %>

  <% if (typeof resources !== 'undefined' && resources.length) { %>
  <section class="panel-card">
    <div class="panel-card-head"><h3>Tutor-Shared Files</h3></div>
    <div class="list-stack">
      <% resources.forEach((resource) => { %>
        <article class="list-card">
          <div>
            <strong><%= resource.title %></strong>
            <p><%= resource.description || 'No description' %></p>
            <% if (resource.file_path || resource.content_text) { %>
              <a href="/download/module/<%= resource.id %>" target="_blank">Open Module</a>
            <% } %>
          </div>
        </article>
      <% }) %>
    </div>
  </section>
  <% } %>

  <section class="panel-card">
    <div class="panel-card-head"><h3>Attendance</h3></div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Date</th><th>Status</th><th>Tutor</th></tr></thead>
        <tbody>
          <% if (!(attendanceLogs || []).length) { %><tr><td colspan="3">No attendance record yet.</td></tr><% } %>
          <% (attendanceLogs || []).forEach((item) => { %>
          <tr>
            <td><%= formatDate(item.attendance_date) %></td>
            <td><span class="badge <%= attendanceBadge(item.status) %>"><%= attendanceLabel(item.status) %></span></td>
            <td><%= [item.tutor_first_name, item.tutor_middle_name, item.tutor_last_name].filter(Boolean).join(' ') || '-' %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
</section>

<style>
  /* The tutor, as a small card: photo or initials, name, how to reach them. */
  .st-tutor-chip {
    display: inline-flex; align-items: center; gap: 14px; margin-top: 12px; padding: 12px 16px;
    border: 1px solid var(--border, #d7e2ea); border-radius: 16px; background: #fff;
    color: inherit; text-decoration: none; max-width: 100%;
    transition: border-color .15s ease, box-shadow .15s ease;
  }
  .st-tutor-chip:hover { border-color: var(--primary-500, #1c9a22); box-shadow: 0 6px 18px rgba(16, 32, 51, .08); }
  .st-tutor-chip > div { display: grid; gap: 2px; min-width: 0; }
  .st-tutor-chip p { margin: 0; font-size: 13px; color: var(--text-soft, #5f7084); overflow-wrap: anywhere; }
  .st-tutor-chip-link { font-size: 13px; font-weight: 700; color: var(--primary-700, #1c7a22); }
</style>
