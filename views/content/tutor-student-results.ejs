<%# Tutor Student Results View %>
<section class="page-stack">
  <section class="panel-card">
    <div class="panel-card-head">
      <h2>Student Results</h2>
    </div>
    <% if (!(results || []).length) { %>
      <p class="empty-state">No student submissions yet.</p>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Student</th>
              <th>Assessment</th>
              <th>Subject</th>
              <th>Level</th>
              <th>Purpose</th>
              <th>Score</th>
              <th>Percentage</th>
              <th>Submitted</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% results.forEach(r => { %>
              <tr>
                <td><strong><%= r.first_name %> <%= r.last_name %></strong></td>
                <td><%= r.assessment_title %></td>
                <td><%= r.subject_name %></td>
                <td><span class="level-badge <%= (r.level || '').toLowerCase() %>"><%= r.level %></span></td>
                <td><span class="pill <%= r.purpose === 'pre' ? 'partial' : r.purpose === 'post' ? 'paid' : '' %>"><%= r.purpose || r.assessment_kind %></span></td>
                <td><%= r.score %>/<%= r.total_points %></td>
                <td>
                  <div class="result-bar-container">
                    <div class="result-bar" style="width: <%= r.percentage %>%"></div>
                    <span><%= Number(r.percentage).toFixed(1) %>%</span>
                  </div>
                </td>
                <td><%= new Date(r.submitted_at).toLocaleDateString() %></td>
                <td>
                  <%# The breakdown route works for every submission kind; the older
                      /tutor/student-results/:id review INNER JOINs modules and so
                      cannot render a subject-level Pre-Assessment. %>
                  <a class="btn btn-secondary btn-sm" href="/tutor/results/<%= r.id %>">View Breakdown</a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
</section>

<style>
  .result-bar-container {
    position: relative;
    background: #eef4f8;
    border-radius: 999px;
    height: 24px;
    min-width: 100px;
    overflow: hidden;
  }
  .result-bar {
    height: 100%;
    border-radius: 999px;
    background: var(--gradient-main);
    transition: width 0.5s ease;
  }
  .result-bar-container span {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    font-size: 12px;
    font-weight: 600;
    color: var(--text);
  }
</style>
