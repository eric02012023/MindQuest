<%# File: views/content/admin-pos.ejs
    Purpose: The counter. Where cash actually becomes a payment (Phase 3).

    WHY THIS PAGE EXISTS
    Cash used to be confirmed from the Notifications page: find the student's
    request among the alerts, press Complete. That put a money operation inside a
    message list, and it only worked if the student had filed a request first —
    a walk-in had no path at all.

    This page is the one place staff take money. It is laid out the way the desk
    works: the queue of slips waiting on the left of your attention, the payment
    being taken in front of you, and a search box that accepts whatever the
    student actually has — a slip code, their name, or their student ID.

    Nothing here can take a payment twice: a slip is completed and closed in one
    action, and a walk-in appends one ledger entry.

    Locals: openSlips, selected, matches, search, slipCode, paymentMethods,
            paymentPurposes %>
<%
  const sel = selected || null;
  const bill = sel ? (sel.ledger || null) : null;
  const totals = bill ? bill.totals : null;
  const nameOf = (row) => `${titleCaseName(row.first_name)} ${titleCaseName(row.middle_name || '')} ${titleCaseName(row.last_name)}`.replace(/\s+/g, ' ').trim();
%>
<section class="mq-page">

  <form class="mq-toolbar" method="get" action="<%= basePath %>/pos">
    <div class="mq-filters">
      <label class="mq-field mq-field-search">
        <span>Slip code, student name or student ID</span>
        <input type="search" name="search" value="<%= search || '' %>"
               placeholder="e.g. SLIP-000042, Juan Dela Cruz, STD-0014" autofocus />
      </label>
      <button class="mq-btn mq-btn-primary" type="submit"><%- icon('search') %> Find</button>
      <% if (search) { %><a class="mq-btn" href="<%= basePath %>/pos">Clear</a><% } %>
    </div>
    <div class="mq-toolbar-actions">
      <a class="mq-btn" href="<%= basePath %>/billing"><%- icon('money') %> Student Bill</a>
      <a class="mq-btn" href="<%= basePath %>/payments/history"><%- icon('receipt') %> Payment history</a>
    </div>
  </form>

  <%# ------------------------------------------------- ambiguous search result %>
  <% if (!sel && (matches || []).length) { %>
    <section class="mq-panel">
      <div class="mq-panel-head">
        <div><h2>Which student?</h2><p><%= matches.length %> accounts match “<%= search %>”.</p></div>
      </div>
      <div class="mq-table" style="--mq-cols: minmax(170px, 2fr) 1fr 120px 120px;">
        <div class="mq-head"><span>Student</span><span>Branch</span><span class="mq-num">Balance</span><span></span></div>
        <% matches.forEach((row) => { %>
          <div class="mq-row">
            <span class="mq-cell mq-cell-primary" data-label="Student">
              <span class="mq-name"><%= nameOf(row) %></span>
              <span class="mq-sub"><%= row.user_id %></span>
            </span>
            <span class="mq-cell" data-label="Branch"><%= row.branch_name || '—' %></span>
            <span class="mq-cell mq-money mq-money-due" data-label="Balance"><%= money(row.for_settlement) %></span>
            <span class="mq-cell mq-cell-actions">
              <a class="mq-btn mq-btn-sm" href="<%= basePath %>/pos?search=<%= encodeURIComponent(row.user_id) %>">Select</a>
            </span>
          </div>
        <% }) %>
      </div>
    </section>
  <% } %>

  <% if (!sel && search && !(matches || []).length) { %>
    <section class="mq-panel">
      <div class="mq-empty">
        <strong>Nothing found for “<%= search %>”</strong>
        Check the slip code, or search by the student's name or ID. An assistant admin only
        sees accounts from their own branch.
      </div>
    </section>
  <% } %>

  <%# ----------------------------------------------------- take the payment %>
  <% if (sel) { %>
    <%
      const isSlip = sel.kind === 'slip';
      const req = isSlip ? sel.request : null;
      const who = isSlip
        ? `${titleCaseName(req.first_name)} ${titleCaseName(req.last_name || '')}`.trim()
        : nameOf(sel.student);
      const studentId = isSlip ? req.student_id : sel.student.student_id;
      const studentCode = isSlip ? req.student_code : sel.student.user_id;
      const branchName = isSlip ? req.branch_name : sel.student.branch_name;
      const remaining = totals ? totals.remaining : 0;
      const declared = isSlip ? Number(req.amount || 0) : 0;
      // Default the cash drawer to what the slip says, but never above what is
      // owed — a slip issued before another payment landed can be stale.
      const suggested = isSlip ? Math.min(declared, remaining || declared) : remaining;
    %>
    <section class="mq-panel">
      <div class="mq-panel-head">
        <div>
          <h2>Record payment — <%= who %></h2>
          <p>
            <%= studentCode || '—' %> · <%= branchName || 'No branch' %>
            <% if (isSlip) { %> · <strong><%= slipCode(req.id) %></strong><% } else { %> · walk-in, no slip<% } %>
          </p>
        </div>
        <span class="mq-status <%= remaining > 0 ? 'mq-status-unpaid' : 'mq-status-paid' %>">
          <%= remaining > 0 ? `${money(remaining)} outstanding` : 'Fully settled' %>
        </span>
      </div>

      <% if (totals) { %>
        <div class="mq-summary" style="margin:0 16px 12px;">
          <div class="mq-summary-item"><span>Total billed</span><strong><%= money(totals.totalBilled) %></strong></div>
          <div class="mq-summary-item is-positive"><span>Total paid</span><strong><%= money(totals.totalPaid) %></strong></div>
          <div class="mq-summary-item is-negative"><span>Balance</span><strong><%= money(totals.remaining) %></strong></div>
          <div class="mq-summary-item"><span>Payments made</span><strong><%= totals.paymentCount %></strong></div>
        </div>
      <% } else { %>
        <div class="mq-empty">This student has no billing record, so there is nothing to pay against.</div>
      <% } %>

      <% if (totals) { %>
        <% if (isSlip) { %>
          <div class="mq-detail">
            <div class="mq-detail-item"><span>Slip says</span><strong><%= money(declared) %></strong></div>
            <div class="mq-detail-item"><span>Issued</span><strong><%= formatDateTime(req.created_at) %></strong></div>
            <div class="mq-detail-item"><span>Purpose</span><strong><%= req.purpose || 'Tuition' %></strong></div>
            <% if (req.reference_note) { %>
              <div class="mq-detail-item is-wide"><span>Student's note</span><strong><%= req.reference_note %></strong></div>
            <% } %>
          </div>
        <% } %>

        <form class="mq-form" method="post" action="<%= basePath %>/pos/record"
              data-confirm-message="Record this payment? Ledger entries cannot be edited or removed afterwards.">
          <% if (isSlip) { %><input type="hidden" name="request_id" value="<%= req.id %>" /><% } %>
          <input type="hidden" name="student_id" value="<%= studentId %>" />

          <%# The amount RECEIVED, which is not necessarily the amount the slip
              declared — a student who said ₱1,300 may arrive with ₱800. Both
              numbers are kept; this is the one that moves the balance. %>
          <label>Amount received
            <input type="number" name="amount" step="0.01" min="0.01" max="<%= remaining || undefined %>"
                   value="<%= suggested > 0 ? Number(suggested).toFixed(2) : '' %>" required autocomplete="off" autofocus />
          </label>

          <label>Payment method
            <select name="payment_method">
              <% (paymentMethods || []).forEach((method) => { %>
                <option value="<%= method.value %>" <%= method.value === 'Cash' ? 'selected' : '' %>><%= method.label %></option>
              <% }) %>
            </select>
          </label>

          <label>Purpose
            <select name="purpose">
              <% (paymentPurposes || []).forEach((purpose) => { %>
                <option value="<%= purpose %>" <%= isSlip && req.purpose === purpose ? 'selected' : '' %>><%= purpose %></option>
              <% }) %>
            </select>
          </label>

          <label>OR / reference number
            <input type="text" name="reference_no" placeholder="Optional — the receipt number you issued" autocomplete="off" />
          </label>

          <label class="is-wide">Notes
            <textarea name="note" rows="2" placeholder="Optional — anything the receipt should record"></textarea>
          </label>

          <p class="mq-form-note">
            This appends <strong>one</strong> entry to <%= who %>'s ledger, logged against
            <strong><%= titleCaseName(currentUser.first_name) %> <%= titleCaseName(currentUser.last_name || '') %></strong>
            (<%= currentUser.role === 'admin' ? 'Admin' : 'Assistant Admin' %>) with today's date and time.
            <% if (isSlip) { %><%= slipCode(req.id) %> is closed at the same time.<% } %>
            Entries cannot be edited or removed — a mistake is corrected by recording an adjustment.
          </p>

          <div class="mq-form-foot">
            <a class="mq-btn" href="<%= basePath %>/pos">Cancel</a>
            <button class="mq-btn mq-btn-primary" type="submit"><%- icon('check') %> Record payment</button>
          </div>
        </form>
      <% } %>
    </section>
  <% } %>

  <%# ------------------------------------------------------------- the queue %>
  <section class="mq-panel">
    <div class="mq-panel-head">
      <div>
        <h2>Payment slips waiting</h2>
        <p>Students who have generated a slip but not yet paid. Oldest first.</p>
      </div>
      <span class="mq-count"><%= openSlips.length %></span>
    </div>

    <div class="mq-table" style="--mq-cols: 130px minmax(160px, 1.6fr) 1fr 110px 150px 170px;">
      <div class="mq-head">
        <span>Slip</span><span>Student</span><span>Branch</span>
        <span class="mq-num">Slip says</span><span>Issued</span><span style="text-align:right;">Actions</span>
      </div>

      <% if (!openSlips.length) { %>
        <div class="mq-empty">
          <strong>No slips waiting</strong>
          A slip appears here as soon as a student generates one. You can still take a walk-in
          payment by searching for the student above.
        </div>
      <% } %>

      <% openSlips.forEach((slip) => { %>
        <div class="mq-row">
          <span class="mq-cell mq-cell-primary" data-label="Slip">
            <span class="mq-name"><%= slipCode(slip.id) %></span>
          </span>
          <span class="mq-cell" data-label="Student">
            <%= titleCaseName(slip.first_name) %> <%= titleCaseName(slip.last_name || '') %>
            <span class="mq-sub"><%= slip.student_code || '—' %></span>
          </span>
          <span class="mq-cell" data-label="Branch"><%= slip.branch_name || '—' %></span>
          <span class="mq-cell mq-money" data-label="Slip says"><%= money(slip.amount) %></span>
          <span class="mq-cell mq-sub" data-label="Issued"><%= formatDateTime(slip.created_at) %></span>
          <span class="mq-cell mq-cell-actions">
            <a class="mq-btn mq-btn-sm mq-btn-primary" href="<%= basePath %>/pos?slip=<%= slip.id %>">Take payment</a>
            <form method="post" action="<%= basePath %>/pos/<%= slip.id %>/cancel"
                  data-confirm-message="Void <%= slipCode(slip.id) %>? Nothing is added to the ledger.">
              <button class="mq-btn mq-btn-sm" type="submit">Void</button>
            </form>
          </span>
        </div>
      <% }) %>
    </div>
  </section>
</section>
