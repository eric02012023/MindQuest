<%# File: views/content/admin-student-analytics.ejs
    Purpose: One learner's analytics, a section per subject — opened by the
    admin / assistant (every subject the learner takes) and by a tutor (only the
    subjects that tutor teaches the learner).

    Each subject shows the figures, a score trend (a bar for every assessment
    taken, the same chart the student sees on their own Analytics & Reports),
    the assessment history and the modules opened.

    The figures come from getStudentAnalytics, which reads what the system
    records today; it used to read the retired first-generation tables, so
    every learner showed zero.

    Locals: student, analyticsList [getStudentAnalytics...], backUrl, backLabel %>
<%
  const list = typeof analyticsList !== 'undefined' ? (analyticsList || []) : [];
  const learner = typeof student !== 'undefined' && student ? student : (list[0] ? list[0].student : null);
  const learnerName = learner ? `${titleCaseName(learner.first_name)} ${titleCaseName(learner.last_name || '')}`.trim() : 'Learner';
  const kindLabel = (row) => (row.assessment_type === 'pre' ? 'Pre-Assessment'
    : row.assessment_type === 'post' ? 'Post-Assessment' : 'Module assessment');
  const levelStatus = (level) => (level === 'Advance' || level === 'Advanced' ? 'paid'
    : level === 'Intermediate' ? 'partial' : level === 'Beginner' ? 'unpaid' : 'info');
%>
<section class="mq-page">

  <div class="mq-panel">
    <div class="mq-panel-head">
      <div>
        <h2>Analytics: <%= learnerName %></h2>
        <p>
          <%= learner ? (learner.user_id || '') : '' %>
          <% if (learner && (learner.grade_level || learner.year_level)) { %> · <%= learner.grade_level || learner.year_level %><% } %>
          <% if (learner && learner.branch_name) { %> · <%= learner.branch_name %><% } %>
        </p>
      </div>
      <% if (typeof backUrl !== 'undefined' && backUrl) { %>
        <a class="mq-btn mq-btn-sm" href="<%= backUrl %>"><%= typeof backLabel !== 'undefined' && backLabel ? backLabel : 'Back' %></a>
      <% } %>
    </div>
  </div>

  <% if (!list.length) { %>
    <div class="mq-panel"><div class="mq-empty"><strong>No subjects to show</strong>This learner is not enrolled in a subject yet.</div></div>
  <% } %>

  <% list.forEach((analytics, index) => {
       const st = analytics.stats;
       const done = analytics.completion || {}; %>
    <div class="mq-report-group">
      <div>
        <h2><%= analytics.subject.name %></h2>
      </div>
      <span class="mq-status mq-status-<%= levelStatus(st.currentLevel) %>"><%= st.currentLevel %></span>
    </div>

    <div class="mq-kpis">
      <div class="mq-kpi"><span>Modules opened</span><strong><%= st.totalModulesRead %>/<%= st.totalModules %></strong></div>
      <div class="mq-kpi"><span>Activities done</span><strong><%= done.assessmentsDone || 0 %>/<%= done.assessmentsTotal || 0 %></strong></div>
      <div class="mq-kpi"><span>Assessments taken</span><strong><%= st.completedAssessments %></strong></div>
      <div class="mq-kpi"><span>Average score</span><strong><%= st.completedAssessments ? st.avgPercentage + '%' : '—' %></strong></div>
      <div class="mq-kpi">
        <span>Pre → Post</span>
        <strong>
          <%= st.preAssessment ? Number(st.preAssessment.percentage).toFixed(0) + '%' : '—' %>
          → <%= st.postAssessment ? Number(st.postAssessment.percentage).toFixed(0) + '%' : '—' %>
        </strong>
      </div>
      <div class="mq-kpi"><span>Violations</span><strong><%= st.totalViolations %></strong></div>
    </div>

    <section class="mq-panel">
      <div class="mq-panel-head">
        <h3>Score trend</h3>
        <span class="mq-count"><%= analytics.scoreTrend.length %> assessment<%= analytics.scoreTrend.length === 1 ? '' : 's' %></span>
      </div>
      <% if (!analytics.scoreTrend.length) { %>
        <div class="mq-empty">No assessment taken in this subject yet.</div>
      <% } else { %>
        <div class="mq-chart-box" style="height: 300px;"><canvas id="learnerTrend<%= index %>"></canvas></div>
      <% } %>
    </section>

    <section class="mq-panel">
      <div class="mq-panel-head">
        <h3>Assessment history</h3>
        <span class="mq-count"><%= analytics.assessments.length %></span>
      </div>
      <div class="mq-table" style="--mq-min-width: 760px; --mq-cols: minmax(180px, 2fr) 140px 100px 90px 110px 150px;">
        <div class="mq-head">
          <span data-search-col>Assessment</span><span>Type</span><span class="mq-num">Score</span>
          <span class="mq-num">Percent</span><span>Level</span><span>Taken</span>
        </div>
        <% if (!analytics.assessments.length) { %>
          <div class="mq-empty">No assessments yet.</div>
        <% } %>
        <% analytics.assessments.forEach((item) => { %>
          <div class="mq-row">
            <span class="mq-cell mq-cell-primary" data-label="Assessment">
              <% if (item.submission_id) { %>
                <a class="mq-name" href="<%= basePath %>/results/<%= item.submission_id %>"><%= item.title %></a>
              <% } else { %>
                <span class="mq-name"><%= item.title %></span>
              <% } %>
              <% if (item.source_module_title) { %><span class="mq-sub"><%= item.source_module_title %></span><% } %>
            </span>
            <span class="mq-cell mq-sub" data-label="Type"><%= kindLabel(item) %></span>
            <span class="mq-cell mq-num" data-label="Score"><%= item.score != null ? `${Number(item.score)}/${Number(item.total_questions)}` : '—' %></span>
            <span class="mq-cell mq-num" data-label="Percent"><%= item.percentage != null ? Number(item.percentage).toFixed(1) + '%' : '—' %></span>
            <span class="mq-cell" data-label="Level">
              <% if (item.level) { %><span class="mq-status mq-status-<%= levelStatus(item.level) %>"><%= item.level %></span><% } else { %>—<% } %>
            </span>
            <span class="mq-cell mq-sub" data-label="Taken"><%= item.taken_at ? formatDateTime(item.taken_at) : 'Not taken yet' %></span>
          </div>
        <% }) %>
      </div>
    </section>

    <section class="mq-panel">
      <div class="mq-panel-head">
        <h3>Modules opened</h3>
        <span class="mq-count"><%= analytics.moduleReads.length %></span>
      </div>
      <div class="mq-table" style="--mq-cols: minmax(200px, 2fr) 170px 170px;">
        <div class="mq-head"><span data-search-col>Module</span><span>First opened</span><span>Last opened</span></div>
        <% if (!analytics.moduleReads.length) { %>
          <div class="mq-empty">No module opened yet.</div>
        <% } %>
        <% analytics.moduleReads.forEach((item) => { %>
          <div class="mq-row">
            <span class="mq-cell mq-name" data-label="Module"><%= item.module_title %></span>
            <span class="mq-cell mq-sub" data-label="First opened"><%= formatDateTime(item.read_at) %></span>
            <span class="mq-cell mq-sub" data-label="Last opened"><%= formatDateTime(item.last_opened_at) %></span>
          </div>
        <% }) %>
      </div>
    </section>

    <% if (analytics.antiCheatLogs.length) { %>
      <section class="mq-panel">
        <div class="mq-panel-head">
          <h3>Anti-cheat violation log</h3>
          <span class="mq-count"><%= analytics.antiCheatLogs.length %></span>
        </div>
        <div class="mq-table" style="--mq-cols: 160px minmax(160px, 1.4fr) minmax(160px, 2fr) 70px;">
          <div class="mq-head"><span>When</span><span data-search-col>Assessment</span><span>Event</span><span class="mq-num">Strike</span></div>
          <% analytics.antiCheatLogs.forEach((log) => { %>
            <div class="mq-row">
              <span class="mq-cell mq-sub" data-label="When"><%= formatDateTime(log.created_at) %></span>
              <span class="mq-cell" data-label="Assessment"><%= log.title || '—' %></span>
              <span class="mq-cell mq-sub" data-label="Event"><%= log.event_type %><%= log.event_detail ? ` — ${log.event_detail}` : '' %></span>
              <span class="mq-cell mq-num" data-label="Strike"><%= log.violation_count %></span>
            </div>
          <% }) %>
        </div>
      </section>
    <% } %>
  <% }) %>
</section>

<script src="/js/vendor/chart.umd.min.js"></script>
<script src="/js/chart-zoom.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (typeof Chart === 'undefined') return;
    // "<" escaped so an assessment title can never close this script tag.
    var trends = <%- JSON.stringify(list.map((item) => item.scoreTrend.map((p) => ({ label: p.label, value: p.percentage })))).replace(/</g, '\\u003c') %>;
    trends.forEach(function (points, index) {
      var canvas = document.getElementById('learnerTrend' + index);
      if (!canvas || !points.length) return;
      var labels = points.map(function (p) { return p.label; });
      new Chart(canvas.getContext('2d'), {
        type: 'bar',
        data: {
          labels: labels,
          datasets: [{
            label: 'Score',
            data: points.map(function (p) { return p.value; }),
            backgroundColor: '#2ea9f4',
            hoverBackgroundColor: '#1488d6',
            borderRadius: 2,
            maxBarThickness: 46
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: {
              callbacks: {
                title: function (items) { return items.length ? labels[items[0].dataIndex] : ''; },
                label: function (item) { return 'Score: ' + item.parsed.y + '%'; }
              }
            }
          },
          scales: {
            y: {
              min: 0, max: 100,
              ticks: { stepSize: 50, font: { size: 11 } },
              title: { display: true, text: 'Score%', font: { size: 12 } },
              grid: { color: 'rgba(0,0,0,0.06)' }
            },
            x: {
              grid: { display: false },
              ticks: {
                maxRotation: 45, minRotation: 45, autoSkip: false, font: { size: 11 },
                callback: function (value) {
                  var label = String(this.getLabelForValue(value) || '');
                  return label.length > 16 ? label.slice(0, 14) + '…' : label;
                }
              }
            }
          }
        }
      });
    });
  });
</script>
