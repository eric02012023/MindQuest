<%# File: views/content/admin-student-analytics.ejs | Purpose: Student analytics page (used by admin and tutor) %>
<section class="page-stack">
  <div class="toolbar-card split">
    <h2>Analytics: <%= analytics.student.first_name %> <%= analytics.student.last_name %></h2>
    <span class="badge badge-info"><%= analytics.subject.name %></span>
  </div>

  <div class="billing-summary-grid">
    <article class="stat-card"><h3>Modules Read</h3><strong><%= analytics.stats.totalModulesRead %></strong></article>
    <article class="stat-card"><h3>Assessments</h3><strong><%= analytics.stats.completedAssessments %> / <%= analytics.stats.totalAssessments %></strong></article>
    <article class="stat-card gradient"><h3>Avg Score</h3><strong><%= analytics.stats.avgPercentage %>%</strong></article>
    <article class="stat-card"><h3>Current Level</h3><strong><%= analytics.stats.currentLevel %></strong></article>
    <article class="stat-card"><h3>Current Round</h3><strong><%= analytics.stats.currentRound %></strong></article>
    <article class="stat-card"><h3>Total Attempts</h3><strong><%= analytics.stats.totalAttempts %></strong></article>
    <article class="stat-card"><h3>Violations</h3><strong><%= analytics.stats.totalViolations %></strong></article>
  </div>

  <section class="panel-card">
    <div class="panel-card-head"><h3>Module Read History</h3></div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>#</th><th>Module Title</th><th>Read At</th></tr></thead>
        <tbody>
          <% if (!analytics.moduleReads.length) { %><tr><td colspan="3">No modules read yet.</td></tr><% } %>
          <% analytics.moduleReads.forEach((item, i) => { %>
            <tr>
              <td><%= i + 1 %></td>
              <td><%= item.module_title || '-' %></td>
              <td><%= formatDateTime(item.read_at) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="panel-card">
    <div class="panel-card-head"><h3>Assessment History</h3></div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Title</th><th>Type</th><th>Module</th><th>Score</th><th>Percentage</th><th>Level</th><th>Taken At</th></tr></thead>
        <tbody>
          <% if (!analytics.assessments.length) { %><tr><td colspan="7">No assessments yet.</td></tr><% } %>
          <% analytics.assessments.forEach((item) => { %>
            <tr>
              <td><%= item.title %></td>
              <td>
                <% if (item.assessment_type === 'pre') { %>
                  <span class="badge badge-info">Pre</span>
                <% } else if (item.assessment_type === 'post') { %>
                  <span class="badge badge-success">Post</span>
                <% } else if (item.assessment_origin === 'ai_generated') { %>
                  <span class="badge badge-warning">AI Generated</span>
                <% } else { %>
                  <span class="badge badge-info"><%= item.assessment_type || 'Standard' %></span>
                <% } %>
              </td>
              <td><%= item.source_module_title || '-' %></td>
              <td><%= item.score != null ? item.score + ' / ' + item.total_questions : '-' %></td>
              <td><%= item.percentage != null ? item.percentage + '%' : '-' %></td>
              <td><%= item.level || '-' %></td>
              <td><%= item.taken_at ? formatDateTime(item.taken_at) : 'Not taken' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>

  <% if (analytics.learningCycles.length) { %>
  <section class="panel-card">
    <div class="panel-card-head"><h3>Learning Cycles</h3></div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Round</th><th>Module</th><th>Assessment</th><th>Status</th><th>Level</th><th>Started</th></tr></thead>
        <tbody>
          <% analytics.learningCycles.forEach((cycle) => { %>
            <tr>
              <td><%= cycle.round_number %></td>
              <td><%= cycle.resource_title || '-' %></td>
              <td><%= cycle.assessment_title || '-' %></td>
              <td><span class="badge badge-<%= cycle.status === 'completed' ? 'success' : 'info' %>"><%= cycle.status %></span></td>
              <td><%= cycle.result_level || '-' %></td>
              <td><%= formatDateTime(cycle.started_at) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
  <% } %>

  <% if (analytics.antiCheatLogs.length) { %>
  <section class="panel-card">
    <div class="panel-card-head"><h3>Anti-Cheat Violation Log</h3></div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>#</th><th>Event</th><th>Detail</th><th>Count</th><th>Time</th></tr></thead>
        <tbody>
          <% analytics.antiCheatLogs.forEach((log, i) => { %>
            <tr>
              <td><%= i + 1 %></td>
              <td><%= log.event_type %></td>
              <td><%= log.event_detail || '-' %></td>
              <td><%= log.violation_count %></td>
              <td><%= formatDateTime(log.created_at) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
  <% } %>
</section>
