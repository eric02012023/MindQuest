<%# File: views/content/tutor-subjects.ejs
    Purpose: The subjects a tutor teaches, and their week — every one of the
    centre's time slots with the student who holds it, and the days that
    student chose (Weekdays or Weekend).

    The schedule is read from the enrolments (see getTutorScheduleOverview), so
    a slot an admin assigned shows as taken. A slot can appear twice: once for
    a weekday student and once for a weekend one. %>
<section class="panel-card">
  <div class="panel-card-head"><h2>My Subjects</h2></div>
  <div class="subject-list-cards">
    <% if (!subjects.length) { %><p class="empty-state">No subject assignment yet.</p><% } %>
    <% subjects.forEach((subject) => { %>
      <a class="subject-list-card" href="/tutor/subjects/<%= subject.subject_id %>">
        <div><strong><%= subject.subject_name %></strong><span><%= subject.total_students %> student<%= Number(subject.total_students) === 1 ? '' : 's' %></span></div>
      </a>
    <% }) %>
  </div>
</section>
<section class="panel-card">
  <div class="panel-card-head">
    <h3>My Time Schedule</h3>
    <% const takenCount = (scheduleOverview || []).filter((item) => item.raw_status === 'taken').length; %>
    <span class="badge badge-info"><%= takenCount %> session<%= takenCount === 1 ? '' : 's' %> scheduled</span>
  </div>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Time Slot</th><th>Status</th><th>Student</th><th>Subject</th><th>Preferred Days</th></tr></thead>
      <tbody>
        <% if (!(scheduleOverview || []).length) { %><tr><td colspan="5">No time schedule available yet.</td></tr><% } %>
        <% (scheduleOverview || []).forEach((item) => { %>
          <tr>
            <td><strong><%= item.time_slot %></strong></td>
            <td>
              <% if (item.raw_status === 'available') { %>
                <span class="badge badge-available">Available</span>
              <% } else if (item.raw_status === 'pending') { %>
                <span class="badge badge-warning">Requested</span>
              <% } else { %>
                <span class="badge badge-success">Taken</span>
              <% } %>
            </td>
            <td>
              <% if ((item.students || []).length && item.raw_status !== 'pending') { %>
                <% item.students.forEach((student, index) => { %><%= index ? ', ' : '' %><a href="/tutor/students/<%= student.id %>"><%= student.name %></a><% }) %>
              <% } else { %>
                <%= item.student_name || '-' %>
              <% } %>
            </td>
            <td><%= item.subject_name || '-' %></td>
            <td>
              <% if (item.raw_status === 'available') { %>
                -
              <% } else if (item.preferred_days) { %>
                <span class="badge <%= item.preferred_days === 'Weekend' ? 'badge-warning' : 'badge-info' %>"><%= item.preferred_days %></span>
              <% } else { %>
                <span class="table-note">Not chosen</span>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
