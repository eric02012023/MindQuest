<%# ANNOTATED COPY FOR DEFENSE REVIEW | File: views/content/tutor-profile.ejs | Purpose: UI template/view used by the system. %>
<%
const userSubjects = Array.isArray(profileUser.subjects) ? profileUser.subjects : safeJsonArray(profileUser.subjects_json || []);
const userSupports = Array.isArray(profileUser.supports) ? profileUser.supports : safeJsonArray(profileUser.support_json || []);
%>
<section class="page-stack">
  <section class="panel-card">
    <div class="profile-header-card">
      <img src="<%= profileUser.image_path || '/assets/logo.png' %>" alt="Profile image" class="profile-avatar large" />
      <div>
        <h2><%= profileUser.first_name %> <%= profileUser.middle_name || '' %> <%= profileUser.last_name %></h2>
        <p>User ID: <%= profileUser.user_id %> · <%= profileUser.branch_name || '-' %></p>
      </div>
    </div>
    <form method="post" action="/tutor/profile" enctype="multipart/form-data" class="form-grid three-col">
      <label>User ID<input type="text" value="<%= profileUser.user_id %>" readonly /></label>
      <label>Email<input type="text" value="<%= profileUser.email || '' %>" readonly /></label>
      <label>Branch<input type="text" value="<%= profileUser.branch_name || '' %>" readonly /></label>
      <label>First Name<input type="text" name="first_name" value="<%= profileUser.first_name %>" /></label>
      <label>Middle Name<input type="text" name="middle_name" value="<%= profileUser.middle_name || '' %>" /></label>
      <label>Last Name<input type="text" name="last_name" value="<%= profileUser.last_name %>" /></label>
      <label>Birth Date<input type="date" name="birth_date" value="<%= toInputDate(profileUser.birth_date) %>" /></label>
      <label>Age<input type="number" name="age" value="<%= profileUser.age || '' %>" /></label>
      <label>Gender<input type="text" name="gender" value="<%= profileUser.gender || '' %>" /></label>
      <label>Contact Number<input type="text" name="contact_number" value="<%= profileUser.contact_number || '' %>" /></label>
      <label>Email<input type="email" name="email" value="<%= profileUser.email || '' %>" /></label>
      <label>Facebook Account<input type="text" name="facebook_account" value="<%= profileUser.facebook_account || '' %>" /></label>
      <label>Year Level<input type="text" name="year_level" value="<%= profileUser.year_level || '' %>" /></label>
      <label class="full-width">Address<input type="text" name="address" value="<%= profileUser.address || '' %>" /></label>
      <label class="full-width">Subjects<textarea rows="4" readonly><%= userSubjects.join('\n') %></textarea></label>
      <label class="full-width">Additional Academic Support<textarea rows="3" readonly><%= userSupports.join('\n') %></textarea></label>
      <label>Upload Profile Image<input type="file" name="image" accept="image/*" /></label>
      <div class="form-actions right full-width"><button class="btn btn-primary" type="submit">Save Changes</button></div>
    </form>
  </section>

  <section class="panel-card">
    <div class="panel-card-head"><h3>My Students</h3></div>
    <div class="list-stack">
      <% if (!students.length) { %><p class="empty-state">Students will appear after admin assignment.</p><% } %>
      <% students.forEach((student) => { %>
        <article class="list-card compact"><strong><%= student.full_name %></strong><span><%= student.subject_name %></span></article>
      <% }) %>
    </div>
  </section>
</section>
