<%# File: views/content/admin-profile.ejs
    Purpose: One person's full record — identity, contacts, placement, who they
    work with — for Admin and Assistant Admin.

    Opens on the profile cover every profile page shares (css/mq-brand.css,
    "Profiles"): the person's photo, role, ID, branch and status, and the few
    figures an admin looks for first. The record follows in titled cards —
    personal, contact, placement, subjects — each a short grid of fields,
    instead of one long column of label-and-box rows. Who they work with shows
    faces, and each face opens that person's profile.

    Everything the edit behaviour depends on is unchanged: the form id, the
    [data-profile-editable] markers the toggle in public/js/main.js walks, the
    multi-select structure and the Manage Subject modal.

    Locals: profileUser, studentAssignments, tutorAssignments, subjectOptions,
            supportOptions, branches, assignableTutors, currentTutor,
            tutorSlotUsage, timeSlots %>
<%
// The parsed (and repaired) lists, not the raw JSON: an account whose list was
// damaged by the old profile save shows — and saves back — its real subjects.
const userSubjects = Array.isArray(profileUser.subjects) ? profileUser.subjects : safeJsonArray(profileUser.subjects_json || []);
const userSupports = Array.isArray(profileUser.supports) ? profileUser.supports : safeJsonArray(profileUser.support_json || []);
const archivedSubjects = safeJsonArray(profileUser.extra?.archived_subjects || []);
const isStudent = profileUser.role === 'student';
const isTutor = profileUser.role === 'tutor';
const canReassignBranch = currentUser.role === 'admin' && ['student', 'tutor'].includes(profileUser.role);
const activeBranches = (branches || []).filter((branch) => Number(branch.is_archived || 0) === 0);
const selectedBranchIds = [...new Set((isTutor ? [profileUser.branch_id, ...safeJsonArray(profileUser.extra?.branch_ids || [])] : [profileUser.branch_id]).map((id) => Number(id)).filter(Boolean))];
const selectedBranchNames = activeBranches.filter((branch) => selectedBranchIds.includes(Number(branch.id))).map((branch) => branch.name);
const branchLabel = selectedBranchNames.join(', ') || profileUser.branch_name || '';
// Tutors registered with "Preschool / Primary School / ...", so that is what the
// editor offers; the route has already mapped any older "Pre School Level"
// spelling onto it, so a tutor's real levels show up ticked.
const yearLevelOptions = (typeof tutorYearLevelOptions !== 'undefined' && tutorYearLevelOptions.length)
  ? tutorYearLevelOptions
  : ['Preschool', 'Primary School', 'Junior High School', 'Senior High School'];
const selectedYearLevels = isTutor
  ? ((typeof tutorYearLevels !== 'undefined' && tutorYearLevels.length)
      ? tutorYearLevels
      : [...new Set([...(profileUser.year_level || '').split(','), ...safeJsonArray(profileUser.extra?.year_levels || [])].map((item) => String(item || '').trim()).filter(Boolean))])
  : [profileUser.year_level || ''].filter(Boolean);
const fullName = [profileUser.first_name, profileUser.middle_name, profileUser.last_name].filter(Boolean).join(' ');
const assignments = isStudent ? (studentAssignments || []) : (tutorAssignments || []);
const isOwnAccount = Number(currentUser.id) === Number(profileUser.id);
const canChangePassword = isOwnAccount && ['admin', 'admin_assistant'].includes(currentUser.role);
// The admin's own record: an account, not a learner — no subjects, year level,
// support or "who they work with" to manage.
const isLearnerRecord = isStudent || isTutor;
const roleLabel = { student: 'Student', tutor: 'Tutor', admin: 'Admin', admin_assistant: 'Assistant Admin' }[profileUser.role] || profileUser.role;
const statusKey = profileUser.status === 'approved' ? 'approved' : profileUser.status === 'pending' ? 'pending' : 'rejected';
const learnerCount = new Set(assignments.map((item) => String(item.student_id))).size;
const tutorSlot = currentTutor && currentTutor.time_slot ? currentTutor.time_slot : '';
%>
<section class="mq-profile">

  <%# ------------------------------------------------------------- identity %>
  <section class="mq-profile-hero">
    <div class="mq-profile-cover" aria-hidden="true"></div>
    <div class="mq-profile-main">
      <div class="mq-profile-avatar-wrap" data-avatar-preview>
        <%- include('../partials/avatar', { avatarSrc: profileUser.image_path, avatarName: fullName, avatarSize: 'xl' }) %>
      </div>
      <div class="mq-profile-id">
        <h2><%= fullName %></h2>
        <div class="mq-profile-tags">
          <span class="mq-tag"><%- icon(isTutor ? 'award' : 'user', 14) %> <%= roleLabel %></span>
          <% if (profileUser.user_id) { %><span class="mq-tag"><%= profileUser.user_id %></span><% } %>
          <span class="mq-tag"><%- icon('building', 14) %> <%= branchLabel || 'No branch' %></span>
          <span class="mq-status mq-status-<%= statusKey %>"><%= profileUser.status || 'unknown' %></span>
        </div>
      </div>
      <div class="mq-profile-actions">
        <% if (isLearnerRecord) { %>
          <button type="button" class="mq-btn mq-btn-primary" data-modal-target="#manage-subjects-modal"><%- icon('book') %> Manage subjects</button>
        <% } %>
        <% if (canChangePassword) { %>
          <a class="mq-btn" href="#change-password"><%- icon('lock') %> Change password</a>
        <% } %>
      </div>
    </div>

    <div class="mq-profile-stats">
      <% if (isLearnerRecord) { %>
        <div class="mq-profile-stat">
          <span class="mq-card-icon"><%- icon('book', 18) %></span>
          <div><span>Subjects</span><strong><%= userSubjects.length %></strong></div>
        </div>
        <% if (isStudent) {
             // A subject's tutor is that subject's own, so a student can have more than one.
             const tutorNames = [...new Set(assignments.filter((item) => item.tutor_internal_id).map((item) => item.tutor_name))];
             const scheduleSlots = [...new Set(assignments.map((item) => item.time_slot).filter(Boolean))]; %>
          <div class="mq-profile-stat">
            <span class="mq-card-icon"><%- icon('award', 18) %></span>
            <div><span><%= tutorNames.length > 1 ? 'Tutors' : 'Tutor' %></span><b><%= tutorNames.join(', ') || 'Not yet assigned' %></b></div>
          </div>
          <div class="mq-profile-stat">
            <span class="mq-card-icon"><%- icon('calendar', 18) %></span>
            <div><span>Schedule</span><b><%= scheduleSlots.join(', ') || 'Not set yet' %></b></div>
          </div>
        <% } else { %>
          <div class="mq-profile-stat">
            <span class="mq-card-icon"><%- icon('users', 18) %></span>
            <div><span>Learners</span><strong><%= learnerCount %></strong></div>
          </div>
          <div class="mq-profile-stat">
            <span class="mq-card-icon"><%- icon('layers', 18) %></span>
            <div><span>Year levels</span><b><%= selectedYearLevels.join(', ') || 'Not set yet' %></b></div>
          </div>
        <% } %>
      <% } else { %>
        <div class="mq-profile-stat">
          <span class="mq-card-icon"><%- icon('phone', 18) %></span>
          <div><span>Email</span><b><%= profileUser.email || '—' %></b></div>
        </div>
        <div class="mq-profile-stat">
          <span class="mq-card-icon"><%- icon('user', 18) %></span>
          <div><span>Contact</span><b><%= profileUser.contact_number || '—' %></b></div>
        </div>
      <% } %>
      <div class="mq-profile-stat">
        <span class="mq-card-icon"><%- icon('calendar', 18) %></span>
        <div><span>Joined</span><b><%= formatDate(profileUser.created_at) %></b></div>
      </div>
    </div>
  </section>

  <%# -------------------------------------------------------------- details %>
  <form id="profile-form" method="post" action="<%= basePath %>/profile/<%= profileUser.id %>"
        enctype="multipart/form-data" class="mq-profile-form is-split">

    <section class="mq-card">
      <div class="mq-card-head">
        <span class="mq-card-icon"><%- icon('user', 18) %></span>
        <div><h3>Personal information</h3><p>Read-only until you press Edit.</p></div>
        <div class="mq-card-head-actions">
          <button type="button" class="mq-btn mq-btn-sm" data-profile-edit-toggle="#profile-form"><%- icon('edit') %> Edit</button>
        </div>
      </div>
      <div class="mq-card-body mq-fields">
        <label>First name<input data-profile-editable type="text" name="first_name" value="<%= profileUser.first_name %>" readonly /></label>
        <label>Middle name<input data-profile-editable type="text" name="middle_name" value="<%= profileUser.middle_name || '' %>" readonly /></label>
        <label>Last name<input data-profile-editable type="text" name="last_name" value="<%= profileUser.last_name %>" readonly /></label>
        <label>Birth date<input data-profile-editable type="date" name="birth_date" value="<%= toInputDate(profileUser.birth_date) %>" data-auto-age-birth readonly /></label>
        <label>Age<input data-profile-editable type="number" name="age" value="<%= profileUser.age || '' %>" data-auto-age-target readonly /></label>
        <label>Gender<input data-profile-editable type="text" name="gender" value="<%= profileUser.gender || '' %>" readonly /></label>
        <label class="is-wide">Profile photo<input data-profile-editable type="file" name="image" accept="image/*" disabled data-avatar-input /></label>
      </div>
    </section>

    <section class="mq-card">
      <div class="mq-card-head">
        <span class="mq-card-icon"><%- icon('phone', 18) %></span>
        <div><h3>Contact</h3><p><%= isStudent ? 'The student and their parent or guardian.' : 'How the office reaches them.' %></p></div>
      </div>
      <div class="mq-card-body mq-fields">
        <label>Login email<input type="text" value="<%= profileUser.email || '' %>" readonly /></label>
        <label>Contact number<input data-profile-editable type="text" name="contact_number" value="<%= profileUser.contact_number || profileUser.parent_contact_number || '' %>" readonly /></label>
        <% if (isStudent) { %>
          <label>Parent/student email<input data-profile-editable type="text" name="parent_email" value="<%= profileUser.parent_email || profileUser.email || '' %>" readonly /></label>
          <label>Parent/student Facebook<input data-profile-editable type="text" name="parent_facebook" value="<%= profileUser.parent_facebook || profileUser.facebook_account || '' %>" readonly /></label>
          <label>Parent/guardian name<input data-profile-editable type="text" name="parent_guardian_name" value="<%= profileUser.parent_guardian_name || '' %>" readonly /></label>
          <label>Parent contact<input data-profile-editable type="text" name="parent_contact_number" value="<%= profileUser.parent_contact_number || '' %>" readonly /></label>
        <% } else { %>
          <label>Facebook account<input data-profile-editable type="text" name="facebook_account" value="<%= profileUser.facebook_account || '' %>" readonly /></label>
        <% } %>
      </div>
    </section>

    <section class="mq-card<%= isLearnerRecord ? '' : ' is-full' %>">
      <div class="mq-card-head">
        <span class="mq-card-icon"><%- icon('building', 18) %></span>
        <div><h3>Placement</h3><p><%= isLearnerRecord ? 'Branch, level and address.' : 'Branch and address.' %></p></div>
      </div>
      <div class="mq-card-body mq-fields">
        <label>Branch
          <% if (canReassignBranch && isTutor) { %>
            <div class="multi-select" data-profile-editable data-multi-select data-placeholder="Select branch(es)">
              <button type="button" class="multi-select-trigger" data-multi-select-trigger disabled><span data-multi-select-label><%= branchLabel || 'Select branch(es)' %></span></button>
              <div class="multi-select-menu">
                <% activeBranches.forEach((branch) => { %>
                  <label><input type="checkbox" name="branch_ids" value="<%= branch.id %>" <%= selectedBranchIds.includes(Number(branch.id)) ? 'checked' : '' %> disabled /> <%= branch.name %></label>
                <% }) %>
              </div>
            </div>
            <input type="hidden" name="branch_id" value="<%= selectedBranchIds[0] || profileUser.branch_id || '' %>" data-primary-branch-input />
          <% } else if (canReassignBranch) { %>
            <select data-profile-editable name="branch_id" disabled>
              <% activeBranches.forEach((branch) => { %>
                <option value="<%= branch.id %>" <%= Number(profileUser.branch_id) === Number(branch.id) ? 'selected' : '' %>><%= branch.name %></option>
              <% }) %>
            </select>
          <% } else { %>
            <input type="text" value="<%= branchLabel %>" readonly />
          <% } %>
        </label>

        <% if (isLearnerRecord) { %>
          <label>Year level
            <% if (isTutor) { %>
              <div class="multi-select" data-profile-editable data-multi-select data-placeholder="Select year level(s)">
                <button type="button" class="multi-select-trigger" data-multi-select-trigger disabled><span data-multi-select-label><%= selectedYearLevels.join(', ') || 'Select year level(s)' %></span></button>
                <div class="multi-select-menu">
                  <% yearLevelOptions.forEach((level) => { %>
                    <label><input type="checkbox" name="year_levels" value="<%= level %>" <%= selectedYearLevels.includes(level) ? 'checked' : '' %> disabled /> <%= level %></label>
                  <% }) %>
                </div>
              </div>
              <input type="hidden" name="year_level" value="<%= selectedYearLevels.join(', ') %>" data-year-level-display-input />
            <% } else { %>
              <input data-profile-editable type="text" name="year_level" value="<%= profileUser.year_level || '' %>" readonly />
            <% } %>
          </label>
        <% } %>

        <% if (isStudent) { %>
          <label>Grade level<input data-profile-editable type="text" name="grade_level" value="<%= profileUser.grade_level || '' %>" readonly /></label>
        <% } %>

        <label class="is-wide">Address<input data-profile-editable type="text" name="address" value="<%= profileUser.address || '' %>" readonly /></label>
      </div>
    </section>

    <% if (isLearnerRecord) { %>
      <section class="mq-card">
        <div class="mq-card-head">
          <span class="mq-card-icon"><%- icon('book', 18) %></span>
          <div><h3>Subjects &amp; support</h3><p><%= isTutor ? 'What this tutor teaches.' : 'Change these with Manage subjects.' %></p></div>
        </div>
        <div class="mq-card-body mq-fields">
          <% if (isTutor) { %>
            <label class="is-wide">Subjects
              <div class="multi-select" data-profile-editable data-multi-select data-placeholder="Select subject(s)">
                <button type="button" class="multi-select-trigger" data-multi-select-trigger disabled><span data-multi-select-label><%= userSubjects.join(', ') || 'Select subject(s)' %></span></button>
                <div class="multi-select-menu tall">
                  <% (subjectOptions || []).forEach((subject) => { if (!archivedSubjects.includes(subject.name)) { %>
                    <label><input type="checkbox" name="subjects" value="<%= subject.name %>" <%= userSubjects.includes(subject.name) ? 'checked' : '' %> disabled /> <%= subject.name %></label>
                  <% } }) %>
                </div>
              </div>
            </label>
          <% } else { %>
            <div class="mq-field-block is-wide">
              <span>Subjects</span>
              <% if (userSubjects.length) { %>
                <div class="mq-chip-list"><% userSubjects.forEach((subjectName) => { %><span class="mq-subject-chip"><%= subjectName %></span><% }) %></div>
              <% } else { %><em>None yet</em><% } %>
            </div>
          <% } %>
          <div class="mq-field-block is-wide">
            <span>Additional academic support</span>
            <% if (userSupports.length) { %>
              <div class="mq-chip-list"><% userSupports.forEach((support) => { %><span class="mq-subject-chip"><%= support %></span><% }) %></div>
            <% } else { %><em>None</em><% } %>
          </div>
        </div>
      </section>
    <% } %>

    <% if (!canReassignBranch) { %><input type="hidden" name="branch_id" value="<%= profileUser.branch_id || '' %>" /><% } %>
    <% if (!isTutor) { %><input type="hidden" name="subjects" value="<%= userSubjects.join(',') %>" /><% } %>
    <input type="hidden" name="supports" value="<%= userSupports.join(',') %>" />

    <div class="mq-profile-savebar is-full">
      <span class="mq-card-foot-note" data-avatar-note>Press Edit, change what you need, then save.</span>
      <button class="mq-btn mq-btn-primary" type="submit"><%- icon('check') %> Save changes</button>
    </div>
  </form>

  <%# ---------------------------------------------------------- assignments %>
  <% if (isLearnerRecord) { %>
  <section class="mq-card">
    <div class="mq-card-head">
      <span class="mq-card-icon"><%- icon(isStudent ? 'award' : 'users', 18) %></span>
      <div>
        <h3><%= isStudent ? 'Tutors' : 'Learners' %></h3>
        <p><%= isStudent ? 'Who teaches this student, by subject.' : 'Who this tutor teaches, by subject.' %></p>
      </div>
      <span class="mq-count"><%= assignments.length %></span>
    </div>

    <%# Each subject shows its OWN month. They genuinely differ — English taken
        out on 3 June ends 3 July while Filipino added on the 6th ends 6 July —
        so one "enrolment period" for the student would be wrong for every
        subject but one. %>
    <div class="mq-table" style="--mq-min-width: 680px; --mq-cols: minmax(140px, 1.3fr) minmax(200px, 2fr) minmax(120px, 1fr) minmax(190px, 1.4fr);">
      <div class="mq-head">
        <span>Subject</span>
        <span><%= isStudent ? 'Tutor' : 'Learner' %></span>
        <span>Schedule</span>
        <span>Enrolment period</span>
      </div>

      <% if (!assignments.length) { %>
        <div class="mq-empty">
          <strong>Nothing assigned yet</strong>
          <%= isStudent ? 'A tutor appears here once an admin assigns one.' : 'Learners appear here once an admin assigns them.' %>
        </div>
      <% } %>

      <% assignments.forEach((item) => { %>
        <%
          const personId = isStudent ? item.tutor_internal_id : item.student_id;
          const personName = isStudent ? (item.tutor_internal_id ? item.tutor_name : '') : item.student_name;
          const personPhoto = isStudent ? item.tutor_image_path : item.student_image_path;
        %>
        <div class="mq-row">
          <span class="mq-cell mq-cell-primary" data-label="Subject">
            <span class="mq-name"><%= item.subject_name %></span>
          </span>
          <span class="mq-cell" data-label="<%= isStudent ? 'Tutor' : 'Learner' %>">
            <% if (personId && personName) { %>
              <a class="mq-person is-compact" href="<%= basePath %>/profile/<%= personId %>">
                <%- include('../partials/avatar', { avatarSrc: personPhoto, avatarName: personName, avatarSize: 'sm' }) %>
                <span class="mq-person-body"><strong><%= personName %></strong></span>
              </a>
            <% } else { %>—<% } %>
          </span>
          <span class="mq-cell mq-sub" data-label="Schedule"><%= item.time_slot || '—' %></span>
          <span class="mq-cell mq-sub" data-label="Enrolment period">
            <% if (item.start_date || item.end_date) { %>
              <%= formatDate(item.start_date) %> &ndash; <%= formatDate(item.end_date) %>
            <% } else { %>—<% } %>
          </span>
        </div>
      <% }) %>
    </div>
  </section>
  <% } %>

  <%# ------------------------------------------------ tutors & time schedule
      A tutor teaches only the subjects they teach. So each of the student's
      subjects has its own row here — its tutor and time — and the tutors
      offered for a row are only those who teach that subject at the student's
      branch. The quick form at the top gives one tutor every subject of this
      student's that they teach, and says which are left for another tutor.
      Admin and assistant only: a student cannot change a tutor once set. %>
  <% if (isStudent) { %>
    <%
      const slots = timeSlots || [];
      const usage = tutorSlotUsage || [];
      const bySubject = typeof tutorsBySubject !== 'undefined' ? (tutorsBySubject || {}) : {};
      const branchTutors = (assignableTutors || []).filter((tutor) => Object.values(bySubject).some((list) => list.some((t) => Number(t.id) === Number(tutor.id))));
      // Which slots each tutor already has with SOMEONE ELSE. Shown rather than
      // hidden, so an admin can see why a slot is not on offer.
      const takenByTutor = {};
      usage.forEach((row) => {
        if (Number(row.student_id) === Number(profileUser.id)) return;
        const key = String(row.tutor_id);
        (takenByTutor[key] = takenByTutor[key] || []).push(row.time_slot);
      });
      const tutorLabel = (tutor) => `${titleCaseName(tutor.first_name)} ${titleCaseName(tutor.last_name || '')}`.trim()
        + (tutor.matchesLevel === false ? ' (different year level)' : '');
      const openCount = assignments.filter((item) => !item.tutor_internal_id).length;
    %>
    <section class="mq-card" id="tutor-schedule">
      <div class="mq-card-head">
        <span class="mq-card-icon"><%- icon('calendar', 18) %></span>
        <div>
          <h3>Tutors &amp; time schedule</h3>
          <p>Each subject is taught by a tutor who teaches it.<%= openCount ? ` ${openCount} subject${openCount === 1 ? ' needs' : 's need'} a tutor.` : '' %></p>
        </div>
      </div>

      <% if (!assignments.length) { %>
        <div class="mq-empty">
          <strong>No active subjects</strong>
          Enrol this student in a subject first — there is nothing to assign a tutor to.
        </div>
      <% } else { %>
        <%# One tutor for every subject of this student's that they teach. %>
        <form method="post" action="<%= basePath %>/profile/<%= profileUser.id %>/tutor" data-tutor-form
              data-confirm-message="Assign this tutor and time to every subject of this student's that the tutor teaches?">
          <div class="mq-card-body mq-fields">
            <label class="is-wide">Tutor for every subject they teach
              <select name="tutor_id" data-tutor-select required>
                <option value="">— Choose a tutor —</option>
                <% branchTutors.forEach((tutor) => {
                     const teaches = assignments.filter((item) => (bySubject[String(item.subject_id)] || []).some((t) => Number(t.id) === Number(tutor.id))).map((item) => item.subject_name); %>
                  <option value="<%= tutor.id %>" data-taken="<%= (takenByTutor[String(tutor.id)] || []).join('|') %>">
                    <%= tutorLabel(tutor) %> — teaches <%= teaches.join(', ') %>
                  </option>
                <% }) %>
              </select>
            </label>
            <label>Time schedule
              <select name="time_slot" data-slot-select>
                <option value="">— No schedule set —</option>
                <% slots.forEach((slot) => { %><option value="<%= slot %>"><%= slot %></option><% }) %>
              </select>
              <small class="mq-field-hint" data-slot-note></small>
            </label>
          </div>
          <div class="mq-card-foot">
            <span class="mq-card-foot-note">A subject the tutor does not teach is left for another tutor below.</span>
            <button class="mq-btn mq-btn-primary" type="submit"><%- icon('check') %> Assign</button>
          </div>
        </form>

        <%# One row per subject: its tutor and time, changed on its own. %>
        <div class="mq-table" data-no-table-search style="--mq-min-width: 760px; --mq-cols: minmax(150px, 1.2fr) minmax(220px, 2fr) minmax(170px, 1.3fr) 110px;">
          <div class="mq-head">
            <span>Subject</span><span>Tutor</span><span>Time schedule</span><span style="text-align:right;">Save</span>
          </div>
          <% assignments.forEach((item) => {
               const options = bySubject[String(item.subject_id)] || [];
               const formId = `tutor-row-${item.subject_id}`;
               // This student's OTHER subjects' times, by tutor: a learner cannot be with two tutors at once.
               const ownTaken = assignments
                 .filter((other) => Number(other.subject_id) !== Number(item.subject_id) && other.tutor_internal_id && other.time_slot)
                 .map((other) => `${other.time_slot}=${other.tutor_internal_id}`)
                 .join('|'); %>
            <form class="mq-row" id="<%= formId %>" method="post" action="<%= basePath %>/profile/<%= profileUser.id %>/tutor"
                  data-tutor-form data-own-taken="<%= ownTaken %>"
                  data-confirm-message="Save the tutor and time for <%= item.subject_name %>?">
              <input type="hidden" name="subject_ids" value="<%= item.subject_id %>" />
              <span class="mq-cell mq-cell-primary" data-label="Subject">
                <span class="mq-name"><%= item.subject_name %></span>
                <span class="mq-sub"><%= item.tutor_internal_id ? `Now: ${item.tutor_name}` : 'No tutor yet' %></span>
              </span>
              <span class="mq-cell" data-label="Tutor">
                <% if (!options.length && !item.tutor_internal_id) { %>
                  <span class="mq-sub">No tutor at this branch teaches <%= item.subject_name %>.</span>
                  <input type="hidden" name="tutor_id" value="" />
                <% } else { %>
                  <select name="tutor_id" data-tutor-select aria-label="Tutor for <%= item.subject_name %>">
                    <option value="">— No tutor —</option>
                    <% options.forEach((tutor) => { %>
                      <option value="<%= tutor.id %>" <%= Number(item.tutor_internal_id) === Number(tutor.id) ? 'selected' : '' %>
                              data-taken="<%= (takenByTutor[String(tutor.id)] || []).join('|') %>"><%= tutorLabel(tutor) %></option>
                    <% }) %>
                    <% if (item.tutor_internal_id && !options.some((t) => Number(t.id) === Number(item.tutor_internal_id))) { %>
                      <option value="<%= item.tutor_internal_id %>" selected><%= item.tutor_name %> (does not teach <%= item.subject_name %>)</option>
                    <% } %>
                  </select>
                <% } %>
              </span>
              <span class="mq-cell" data-label="Time schedule">
                <select name="time_slot" data-slot-select aria-label="Time for <%= item.subject_name %>">
                  <option value="">— No schedule —</option>
                  <% slots.forEach((slot) => { %>
                    <option value="<%= slot %>" <%= item.time_slot === slot ? 'selected' : '' %>><%= slot %></option>
                  <% }) %>
                </select>
                <small class="mq-field-hint" data-slot-note></small>
              </span>
              <span class="mq-cell mq-cell-actions">
                <button class="mq-btn mq-btn-sm mq-btn-primary" type="submit"><%- icon('check') %> Save</button>
              </span>
            </form>
          <% }) %>
        </div>
      <% } %>
    </section>

    <script>
      // Grey out the slots the chosen tutor already teaches someone else at, and
      // the ones this student already spends with a DIFFERENT tutor. The server
      // refuses a clash regardless — this only saves the admin a round trip.
      (function () {
        document.querySelectorAll('[data-tutor-form]').forEach(function (form) {
          var tutorSelect = form.querySelector('[data-tutor-select]');
          var slotSelect = form.querySelector('[data-slot-select]');
          var note = form.querySelector('[data-slot-note]');
          if (!tutorSelect || !slotSelect) return;
          var own = (form.getAttribute('data-own-taken') || '').split('|').filter(Boolean).map(function (pair) {
            var parts = pair.split('=');
            return { slot: parts[0], tutor: parts[1] };
          });

          function refresh() {
            var option = tutorSelect.options[tutorSelect.selectedIndex];
            var tutorId = tutorSelect.value;
            var taken = (option && option.getAttribute('data-taken') || '').split('|').filter(Boolean);
            var busy = own.filter(function (o) { return tutorId && o.tutor !== tutorId; }).map(function (o) { return o.slot; });
            Array.prototype.forEach.call(slotSelect.options, function (slot) {
              if (!slot.value) return;
              var reason = taken.indexOf(slot.value) !== -1 ? ' — tutor already booked'
                : busy.indexOf(slot.value) !== -1 ? ' — student has another subject then' : '';
              slot.disabled = !!reason;
              slot.textContent = slot.value + reason;
            });
            if (slotSelect.selectedOptions[0] && slotSelect.selectedOptions[0].disabled) slotSelect.value = '';
            if (note) note.textContent = taken.length ? 'Booked at: ' + taken.join(', ') : '';
          }
          tutorSelect.addEventListener('change', refresh);
          refresh();
        });
      })();
    </script>
  <% } %>

  <%# ------------------------------------------------------- password (own) %>
  <% if (canChangePassword) { %>
    <section class="mq-card" id="change-password">
      <div class="mq-card-head">
        <span class="mq-card-icon"><%- icon('lock', 18) %></span>
        <div><h3>Change password</h3><p>Applies to your own account only.</p></div>
      </div>
      <form method="post" action="<%= basePath %>/profile/<%= profileUser.id %>/password">
        <div class="mq-card-body mq-fields">
          <label>Current password<input type="password" name="current_password" required /></label>
          <label>New password<input type="password" name="new_password" minlength="8" required /></label>
          <label>Confirm new password<input type="password" name="confirm_password" minlength="8" required /></label>
        </div>
        <div class="mq-card-foot">
          <span class="mq-card-foot-note">At least 8 characters.</span>
          <button class="mq-btn mq-btn-primary" type="submit"><%- icon('lock') %> Save new password</button>
        </div>
      </form>
    </section>
  <% } %>

  <%# ------------------------------------------------- manage subjects modal %>
  <% if (isLearnerRecord) { %>
  <div class="global-modal" id="manage-subjects-modal">
    <div class="global-modal-card wide modal-scroll-box" style="max-height:85vh;overflow:auto;">
      <button type="button" class="modal-close" data-close-modal>&times;</button>
      <h3>Manage subjects</h3>
      <form method="post" action="<%= basePath %>/profile/<%= profileUser.id %>" class="stack-form" data-confirm-message="Save subject changes for this user?">
        <%# The record is posted whole, so these carry the fields this form does
            not edit through unchanged rather than blanking them. %>
        <input type="hidden" name="first_name" value="<%= profileUser.first_name %>" />
        <input type="hidden" name="middle_name" value="<%= profileUser.middle_name || '' %>" />
        <input type="hidden" name="last_name" value="<%= profileUser.last_name %>" />
        <input type="hidden" name="birth_date" value="<%= toInputDate(profileUser.birth_date) %>" />
        <input type="hidden" name="age" value="<%= profileUser.age || '' %>" />
        <input type="hidden" name="gender" value="<%= profileUser.gender || '' %>" />
        <input type="hidden" name="contact_number" value="<%= profileUser.contact_number || profileUser.parent_contact_number || '' %>" />
        <input type="hidden" name="email" value="<%= profileUser.email || '' %>" />
        <input type="hidden" name="facebook_account" value="<%= profileUser.facebook_account || '' %>" />
        <input type="hidden" name="parent_guardian_name" value="<%= profileUser.parent_guardian_name || '' %>" />
        <input type="hidden" name="parent_contact_number" value="<%= profileUser.parent_contact_number || '' %>" />
        <input type="hidden" name="parent_email" value="<%= profileUser.parent_email || '' %>" />
        <input type="hidden" name="parent_facebook" value="<%= profileUser.parent_facebook || '' %>" />
        <input type="hidden" name="year_level" value="<%= selectedYearLevels.join(', ') || profileUser.year_level || '' %>" />
        <input type="hidden" name="grade_level" value="<%= profileUser.grade_level || '' %>" />
        <input type="hidden" name="address" value="<%= profileUser.address || '' %>" />

        <% if (canReassignBranch && isTutor) { %>
          <label>Branch</label>
          <div class="checkbox-list tall">
            <% activeBranches.forEach((branch) => { %>
              <label><input type="checkbox" name="branch_ids" value="<%= branch.id %>" <%= selectedBranchIds.includes(Number(branch.id)) ? 'checked' : '' %> /> <%= branch.name %></label>
            <% }) %>
          </div>
          <input type="hidden" name="branch_id" value="<%= selectedBranchIds[0] || profileUser.branch_id || '' %>" />
          <label>Year Level</label>
          <div class="checkbox-list tall">
            <% yearLevelOptions.forEach((level) => { %>
              <label><input type="checkbox" name="year_levels" value="<%= level %>" <%= selectedYearLevels.includes(level) ? 'checked' : '' %> /> <%= level %></label>
            <% }) %>
          </div>
        <% } else if (canReassignBranch) { %>
          <label>Branch
            <select name="branch_id" required>
              <% activeBranches.forEach((branch) => { %>
                <option value="<%= branch.id %>" <%= Number(profileUser.branch_id) === Number(branch.id) ? 'selected' : '' %>><%= branch.name %></option>
              <% }) %>
            </select>
          </label>
        <% } else { %>
          <input type="hidden" name="branch_id" value="<%= profileUser.branch_id || '' %>" />
        <% } %>

        <label>Subjects</label>
        <div class="checkbox-list tall">
          <% (subjectOptions || []).forEach((subject) => { if (!archivedSubjects.includes(subject.name)) { %>
            <label><input type="checkbox" name="subjects" value="<%= subject.name %>" <%= userSubjects.includes(subject.name) ? 'checked' : '' %> /> <%= subject.name %></label>
          <% } }) %>
        </div>

        <label>Additional Academic Support</label>
        <div class="checkbox-list tall">
          <% (supportOptions || []).forEach((support) => { %>
            <label><input type="checkbox" name="supports" value="<%= support %>" <%= userSupports.includes(support) ? 'checked' : '' %> /> <%= support %></label>
          <% }) %>
        </div>

        <div class="form-actions right"><button class="btn btn-primary" type="submit">Confirm</button></div>
      </form>
    </div>
  </div>
  <% } %>

</section>
