<%# File: views/content/admin-profile.ejs
    Purpose: One person's full record — identity, contacts, placement, who they
    work with — for Admin and Assistant Admin.

    Laid out as ROWS, one fact per line, rather than the three-column grid this
    page used to be. A profile is a record: an admin reads down it looking for
    one field, and a grid that reflows by viewport width puts that field
    somewhere different on every screen. Straight down, captions aligned, it can
    be scanned.

    Everything the edit behaviour depends on is unchanged: the form id, the
    [data-profile-editable] markers the toggle in public/js/main.js walks, the
    multi-select structure and the Manage Subject modal. Only the presentation
    moved to the mq-* system the rest of the dashboard uses.

    Locals: profileUser, studentAssignments, tutorAssignments, subjectOptions,
            supportOptions, branches %>
<%
const userSubjects = safeJsonArray(profileUser.subjects_json || profileUser.subjects || []);
const userSupports = safeJsonArray(profileUser.support_json || profileUser.supports || []);
const archivedSubjects = safeJsonArray(profileUser.extra?.archived_subjects || []);
const subjectRows = Math.max(2, userSubjects.length || 1);
const supportRows = Math.max(2, userSupports.length || 1);
const isStudent = profileUser.role === 'student';
const isTutor = profileUser.role === 'tutor';
const canReassignBranch = currentUser.role === 'admin' && ['student', 'tutor'].includes(profileUser.role);
const activeBranches = (branches || []).filter((branch) => Number(branch.is_archived || 0) === 0);
const selectedBranchIds = [...new Set((isTutor ? [profileUser.branch_id, ...safeJsonArray(profileUser.extra?.branch_ids || [])] : [profileUser.branch_id]).map((id) => Number(id)).filter(Boolean))];
const selectedBranchNames = activeBranches.filter((branch) => selectedBranchIds.includes(Number(branch.id))).map((branch) => branch.name);
const branchLabel = selectedBranchNames.join(', ') || profileUser.branch_name || '';
// Tutors registered with "Preschool / Primary School / ...", so that is what the
// editor offers; the route has already mapped any older "Pre School Level"
// spelling onto it, so a tutor's real levels show up ticked.
const yearLevelOptions = (typeof tutorYearLevelOptions !== 'undefined' && tutorYearLevelOptions.length)
  ? tutorYearLevelOptions
  : ['Preschool', 'Primary School', 'Junior High School', 'Senior High School'];
const selectedYearLevels = isTutor
  ? ((typeof tutorYearLevels !== 'undefined' && tutorYearLevels.length)
      ? tutorYearLevels
      : [...new Set([...(profileUser.year_level || '').split(','), ...safeJsonArray(profileUser.extra?.year_levels || [])].map((item) => String(item || '').trim()).filter(Boolean))])
  : [profileUser.year_level || ''].filter(Boolean);
const fullName = [profileUser.first_name, profileUser.middle_name, profileUser.last_name].filter(Boolean).join(' ');
const assignments = isStudent ? (studentAssignments || []) : (tutorAssignments || []);
const isOwnAccount = Number(currentUser.id) === Number(profileUser.id);
// The admin's own record: an account, not a learner — no subjects, year level,
// support or "who they work with" to manage.
const isLearnerRecord = isStudent || isTutor;
%>
<section class="mq-page">

  <%# ------------------------------------------------------------- identity %>
  <section class="mq-panel">
    <div class="mq-panel-head">
      <div>
        <h2><%= fullName %></h2>
        <p><%= profileUser.user_id || '—' %> · <%= branchLabel || 'No branch' %></p>
      </div>
      <span class="mq-chip mq-chip-role"><%= profileUser.role %></span>
    </div>

    <div class="mq-detail">
      <div class="mq-detail-item">
        <span>Status</span>
        <strong>
          <span class="mq-status mq-status-<%= profileUser.status === 'approved' ? 'approved' : profileUser.status === 'pending' ? 'pending' : 'rejected' %>"><%= profileUser.status || 'unknown' %></span>
        </strong>
      </div>
      <%# The "Tutors assigned" / "Learners assigned" count used to sit here. It
          said nothing the assignments panel further down does not say better:
          that panel names the tutor for each subject and carries the same count
          in its own header chip. Two places showing the same number is two
          places to disagree, so this one went. `assignments` is still read by
          that panel — it is not dead. %>
      <% if (isLearnerRecord) { %>
        <div class="mq-detail-item">
          <span>Subjects</span>
          <strong><%= userSubjects.length %></strong>
        </div>
      <% } %>
      <div class="mq-detail-item">
        <span>Joined</span>
        <strong><%= formatDate(profileUser.created_at) %></strong>
      </div>
    </div>
  </section>

  <%# -------------------------------------------------------------- details %>
  <section class="mq-panel">
    <div class="mq-panel-head">
      <div>
        <h3>Profile details</h3>
        <p>Read-only until you press Edit.</p>
      </div>
      <div class="mq-panel-head-actions">
        <button type="button" class="mq-btn mq-btn-sm" data-profile-edit-toggle="#profile-form">Edit</button>
        <% if (isLearnerRecord) { %>
          <button type="button" class="mq-btn mq-btn-sm mq-btn-primary" data-modal-target="#manage-subjects-modal">Manage subjects</button>
        <% } %>
      </div>
    </div>

    <form id="profile-form" method="post" action="<%= basePath %>/profile/<%= profileUser.id %>"
          enctype="multipart/form-data" class="mq-form mq-form-rows">

      <label>Branch
        <% if (canReassignBranch && isTutor) { %>
          <div class="multi-select" data-profile-editable data-multi-select data-placeholder="Select branch(es)">
            <button type="button" class="multi-select-trigger" data-multi-select-trigger disabled><span data-multi-select-label><%= branchLabel || 'Select branch(es)' %></span></button>
            <div class="multi-select-menu">
              <% activeBranches.forEach((branch) => { %>
                <label><input type="checkbox" name="branch_ids" value="<%= branch.id %>" <%= selectedBranchIds.includes(Number(branch.id)) ? 'checked' : '' %> disabled /> <%= branch.name %></label>
              <% }) %>
            </div>
          </div>
          <input type="hidden" name="branch_id" value="<%= selectedBranchIds[0] || profileUser.branch_id || '' %>" data-primary-branch-input />
        <% } else if (canReassignBranch) { %>
          <select data-profile-editable name="branch_id" disabled>
            <% activeBranches.forEach((branch) => { %>
              <option value="<%= branch.id %>" <%= Number(profileUser.branch_id) === Number(branch.id) ? 'selected' : '' %>><%= branch.name %></option>
            <% }) %>
          </select>
        <% } else { %>
          <input type="text" value="<%= branchLabel %>" readonly />
        <% } %>
      </label>

      <label>First name<input data-profile-editable type="text" name="first_name" value="<%= profileUser.first_name %>" readonly /></label>
      <label>Middle name<input data-profile-editable type="text" name="middle_name" value="<%= profileUser.middle_name || '' %>" readonly /></label>
      <label>Last name<input data-profile-editable type="text" name="last_name" value="<%= profileUser.last_name %>" readonly /></label>
      <label>Birth date<input data-profile-editable type="date" name="birth_date" value="<%= toInputDate(profileUser.birth_date) %>" data-auto-age-birth readonly /></label>
      <label>Age<input data-profile-editable type="number" name="age" value="<%= profileUser.age || '' %>" data-auto-age-target readonly /></label>
      <label>Gender<input data-profile-editable type="text" name="gender" value="<%= profileUser.gender || '' %>" readonly /></label>
      <label>Contact number<input data-profile-editable type="text" name="contact_number" value="<%= profileUser.contact_number || profileUser.parent_contact_number || '' %>" readonly /></label>

      <% if (isStudent) { %>
        <label>Parent/student email<input data-profile-editable type="text" name="parent_email" value="<%= profileUser.parent_email || profileUser.email || '' %>" readonly /></label>
        <label>Parent/student Facebook<input data-profile-editable type="text" name="parent_facebook" value="<%= profileUser.parent_facebook || profileUser.facebook_account || '' %>" readonly /></label>
        <label>Parent/guardian name<input data-profile-editable type="text" name="parent_guardian_name" value="<%= profileUser.parent_guardian_name || '' %>" readonly /></label>
        <label>Parent contact<input data-profile-editable type="text" name="parent_contact_number" value="<%= profileUser.parent_contact_number || '' %>" readonly /></label>
      <% } else { %>
        <label>Facebook account<input data-profile-editable type="text" name="facebook_account" value="<%= profileUser.facebook_account || '' %>" readonly /></label>
      <% } %>

      <% if (isLearnerRecord) { %>
      <label>Year level
        <% if (isTutor) { %>
          <div class="multi-select" data-profile-editable data-multi-select data-placeholder="Select year level(s)">
            <button type="button" class="multi-select-trigger" data-multi-select-trigger disabled><span data-multi-select-label><%= selectedYearLevels.join(', ') || 'Select year level(s)' %></span></button>
            <div class="multi-select-menu">
              <% yearLevelOptions.forEach((level) => { %>
                <label><input type="checkbox" name="year_levels" value="<%= level %>" <%= selectedYearLevels.includes(level) ? 'checked' : '' %> disabled /> <%= level %></label>
              <% }) %>
            </div>
          </div>
          <input type="hidden" name="year_level" value="<%= selectedYearLevels.join(', ') %>" data-year-level-display-input />
        <% } else { %>
          <input data-profile-editable type="text" name="year_level" value="<%= profileUser.year_level || '' %>" readonly />
        <% } %>
      </label>

      <% } %>

      <% if (isStudent) { %>
        <label>Grade level<input data-profile-editable type="text" name="grade_level" value="<%= profileUser.grade_level || '' %>" readonly /></label>
      <% } %>

      <label>Address<input data-profile-editable type="text" name="address" value="<%= profileUser.address || '' %>" readonly /></label>

      <% if (isLearnerRecord) { %>
      <label>Subjects
        <% if (isTutor) { %>
          <div class="multi-select" data-profile-editable data-multi-select data-placeholder="Select subject(s)">
            <button type="button" class="multi-select-trigger" data-multi-select-trigger disabled><span data-multi-select-label><%= userSubjects.join(', ') || 'Select subject(s)' %></span></button>
            <div class="multi-select-menu tall">
              <% (subjectOptions || []).forEach((subject) => { if (!archivedSubjects.includes(subject.name)) { %>
                <label><input type="checkbox" name="subjects" value="<%= subject.name %>" <%= userSubjects.includes(subject.name) ? 'checked' : '' %> disabled /> <%= subject.name %></label>
              <% } }) %>
            </div>
          </div>
        <% } else { %>
          <textarea class="expanding-display" data-auto-expand rows="<%= subjectRows %>" readonly><%= userSubjects.join('\n') %></textarea>
        <% } %>
      </label>

      <label>Additional academic support<textarea class="expanding-display" data-auto-expand rows="<%= supportRows %>" readonly><%= userSupports.join('\n') %></textarea></label>
      <% } %>

      <label>Profile image<input data-profile-editable type="file" name="image" accept="image/*" disabled /></label>

      <% if (!canReassignBranch) { %><input type="hidden" name="branch_id" value="<%= profileUser.branch_id || '' %>" /><% } %>
      <% if (!isTutor) { %><input type="hidden" name="subjects" value="<%= userSubjects.join(',') %>" /><% } %>
      <input type="hidden" name="supports" value="<%= userSupports.join(',') %>" />

      <div class="mq-form-foot">
        <button class="mq-btn mq-btn-primary" type="submit">Save changes</button>
      </div>
    </form>
  </section>

  <%# ---------------------------------------------------------- assignments %>
  <% if (isLearnerRecord) { %>
  <section class="mq-panel">
    <div class="mq-panel-head">
      <div>
        <h3><%= isStudent ? 'Tutors' : 'Learners' %></h3>
        <p><%= isStudent ? 'Who teaches this student, by subject.' : 'Who this tutor teaches, by subject.' %></p>
      </div>
      <span class="mq-count"><%= assignments.length %></span>
    </div>

    <%# Phase 4.2: each subject shows its OWN month. They genuinely differ —
        English taken out on 3 June ends 3 July while Filipino added on the 6th
        ends 6 July — so one "enrolment period" for the student would be wrong
        for every subject but one. %>
    <div class="mq-table" style="--mq-cols: minmax(160px, 2fr) minmax(160px, 2fr) minmax(190px, 1.6fr);">
      <div class="mq-head">
        <span>Subject</span>
        <span><%= isStudent ? 'Tutor' : 'Learner' %></span>
        <span>Enrolment period</span>
      </div>

      <% if (!assignments.length) { %>
        <div class="mq-empty">
          <strong>Nothing assigned yet</strong>
          <%= isStudent ? 'A tutor appears here once an admin assigns one.' : 'Learners appear here once an admin assigns them.' %>
        </div>
      <% } %>

      <% assignments.forEach((item) => { %>
        <div class="mq-row">
          <span class="mq-cell mq-cell-primary" data-label="Subject">
            <span class="mq-name"><%= item.subject_name %></span>
          </span>
          <span class="mq-cell" data-label="<%= isStudent ? 'Tutor' : 'Learner' %>">
            <%= (isStudent ? item.tutor_name : item.student_name) || '—' %>
          </span>
          <span class="mq-cell mq-sub" data-label="Enrolment period">
            <% if (item.start_date || item.end_date) { %>
              <%= formatDate(item.start_date) %> &ndash; <%= formatDate(item.end_date) %>
            <% } else { %>—<% } %>
          </span>
        </div>
      <% }) %>
    </div>
  </section>
  <% } %>

  <%# ------------------------------------------------ tutor & schedule (Phase 5)
      Admin-only, and deliberately ONE control for the whole student rather than
      one per subject: the centre runs one tutor per learner, so a per-subject
      picker would offer a combination it cannot timetable. The time slot sits in
      the same form because it moves with the tutor — a new tutor has a different
      diary — and because the student is not allowed to change either once set. %>
  <% if (isStudent) { %>
    <%
      const tutors = assignableTutors || [];
      const slots = timeSlots || [];
      const usage = tutorSlotUsage || [];
      // Which slots each tutor already has taken by SOMEONE ELSE. Shown rather
      // than hidden, so an admin can see why a slot is not on offer.
      const takenByTutor = {};
      usage.forEach((row) => {
        if (Number(row.student_id) === Number(profileUser.id)) return;
        const key = String(row.tutor_id);
        (takenByTutor[key] = takenByTutor[key] || []).push(row.time_slot);
      });
      const currentTutorId = currentTutor ? String(currentTutor.tutor_id) : '';
      const currentSlot = currentTutor ? (currentTutor.time_slot || '') : '';
    %>
    <section class="mq-panel">
      <div class="mq-panel-head">
        <div>
          <h3>Tutor &amp; time schedule</h3>
          <p>Applies to <strong>all <%= assignments.length %></strong> of this student's subjects — one tutor per student.</p>
        </div>
        <span class="mq-chip"><%= currentTutor ? currentTutor.tutor_name : 'No tutor assigned' %></span>
      </div>

      <% if (!assignments.length) { %>
        <div class="mq-empty">
          <strong>No active subjects</strong>
          Enrol this student in a subject first — there is nothing to assign a tutor to.
        </div>
      <% } else { %>
        <form class="mq-form mq-form-rows" method="post" action="<%= basePath %>/profile/<%= profileUser.id %>/tutor"
              data-confirm-message="Assign this tutor and schedule to every subject this student is enrolled in?">
          <label>Tutor
            <select name="tutor_id" data-tutor-select>
              <option value="">— No tutor assigned —</option>
              <% tutors.forEach((tutor) => { %>
                <option value="<%= tutor.id %>" <%= currentTutorId === String(tutor.id) ? 'selected' : '' %>
                        data-taken="<%= (takenByTutor[String(tutor.id)] || []).join('|') %>">
                  <%= titleCaseName(tutor.first_name) %> <%= titleCaseName(tutor.last_name || '') %><%= tutor.branch_name ? ` — ${tutor.branch_name}` : '' %>
                </option>
              <% }) %>
            </select>
          </label>

          <label>Time schedule
            <select name="time_slot" data-slot-select>
              <option value="">— No schedule set —</option>
              <% slots.forEach((slot) => { %>
                <option value="<%= slot %>" <%= currentSlot === slot ? 'selected' : '' %>><%= slot %></option>
              <% }) %>
            </select>
            <small class="mq-field-hint" data-slot-note></small>
          </label>

          <p class="mq-form-note">
            Saving writes this tutor to <strong>every</strong> subject this student is enrolled in —
            they cannot have a different tutor per subject. The student cannot change their tutor
            or schedule themselves; both are set here.
          </p>

          <div class="mq-form-foot">
            <button class="mq-btn mq-btn-primary" type="submit">Save tutor &amp; schedule</button>
          </div>
        </form>
      <% } %>
    </section>

    <script>
      // Grey out the slots the chosen tutor already teaches at, and say so. The
      // server refuses a clash regardless — this only stops the admin finding
      // out after a round trip.
      (function () {
        var tutorSelect = document.querySelector('[data-tutor-select]');
        var slotSelect = document.querySelector('[data-slot-select]');
        var note = document.querySelector('[data-slot-note]');
        if (!tutorSelect || !slotSelect) return;

        function refresh() {
          var option = tutorSelect.options[tutorSelect.selectedIndex];
          var taken = (option && option.getAttribute('data-taken') || '').split('|').filter(Boolean);
          Array.prototype.forEach.call(slotSelect.options, function (slot) {
            if (!slot.value) return;
            var clash = taken.indexOf(slot.value) !== -1;
            slot.disabled = clash;
            slot.textContent = clash ? slot.value + ' — already taken' : slot.value;
          });
          if (slotSelect.selectedOptions[0] && slotSelect.selectedOptions[0].disabled) slotSelect.value = '';
          if (note) {
            note.textContent = taken.length
              ? 'This tutor is already booked at: ' + taken.join(', ')
              : '';
          }
        }
        tutorSelect.addEventListener('change', refresh);
        refresh();
      })();
    </script>
  <% } %>

  <%# ------------------------------------------------------- password (own) %>
  <% if (isOwnAccount && ['admin','admin_assistant'].includes(currentUser.role)) { %>
    <section class="mq-panel">
      <div class="mq-panel-head">
        <div>
          <h3>Change password</h3>
          <p>Applies to your own account only.</p>
        </div>
      </div>
      <form method="post" action="<%= basePath %>/profile/<%= profileUser.id %>/password" class="mq-form mq-form-rows">
        <label>Current password<input type="password" name="current_password" required /></label>
        <label>New password<input type="password" name="new_password" minlength="8" required /></label>
        <label>Confirm new password<input type="password" name="confirm_password" minlength="8" required /></label>
        <div class="mq-form-foot">
          <button class="mq-btn mq-btn-primary" type="submit">Save new password</button>
        </div>
      </form>
    </section>
  <% } %>

  <%# ------------------------------------------------- manage subjects modal %>
  <% if (isLearnerRecord) { %>
  <div class="global-modal" id="manage-subjects-modal">
    <div class="global-modal-card wide modal-scroll-box" style="max-height:85vh;overflow:auto;">
      <button type="button" class="modal-close" data-close-modal>&times;</button>
      <h3>Manage subjects</h3>
      <form method="post" action="<%= basePath %>/profile/<%= profileUser.id %>" class="stack-form" data-confirm-message="Save subject changes for this user?">
        <%# The record is posted whole, so these carry the fields this form does
            not edit through unchanged rather than blanking them. %>
        <input type="hidden" name="first_name" value="<%= profileUser.first_name %>" />
        <input type="hidden" name="middle_name" value="<%= profileUser.middle_name || '' %>" />
        <input type="hidden" name="last_name" value="<%= profileUser.last_name %>" />
        <input type="hidden" name="birth_date" value="<%= toInputDate(profileUser.birth_date) %>" />
        <input type="hidden" name="age" value="<%= profileUser.age || '' %>" />
        <input type="hidden" name="gender" value="<%= profileUser.gender || '' %>" />
        <input type="hidden" name="contact_number" value="<%= profileUser.contact_number || profileUser.parent_contact_number || '' %>" />
        <input type="hidden" name="email" value="<%= profileUser.email || '' %>" />
        <input type="hidden" name="facebook_account" value="<%= profileUser.facebook_account || '' %>" />
        <input type="hidden" name="parent_guardian_name" value="<%= profileUser.parent_guardian_name || '' %>" />
        <input type="hidden" name="parent_contact_number" value="<%= profileUser.parent_contact_number || '' %>" />
        <input type="hidden" name="parent_email" value="<%= profileUser.parent_email || '' %>" />
        <input type="hidden" name="parent_facebook" value="<%= profileUser.parent_facebook || '' %>" />
        <input type="hidden" name="year_level" value="<%= selectedYearLevels.join(', ') || profileUser.year_level || '' %>" />
        <input type="hidden" name="grade_level" value="<%= profileUser.grade_level || '' %>" />
        <input type="hidden" name="address" value="<%= profileUser.address || '' %>" />

        <% if (canReassignBranch && isTutor) { %>
          <label>Branch</label>
          <div class="checkbox-list tall">
            <% activeBranches.forEach((branch) => { %>
              <label><input type="checkbox" name="branch_ids" value="<%= branch.id %>" <%= selectedBranchIds.includes(Number(branch.id)) ? 'checked' : '' %> /> <%= branch.name %></label>
            <% }) %>
          </div>
          <input type="hidden" name="branch_id" value="<%= selectedBranchIds[0] || profileUser.branch_id || '' %>" />
          <label>Year Level</label>
          <div class="checkbox-list tall">
            <% yearLevelOptions.forEach((level) => { %>
              <label><input type="checkbox" name="year_levels" value="<%= level %>" <%= selectedYearLevels.includes(level) ? 'checked' : '' %> /> <%= level %></label>
            <% }) %>
          </div>
        <% } else if (canReassignBranch) { %>
          <label>Branch
            <select name="branch_id" required>
              <% activeBranches.forEach((branch) => { %>
                <option value="<%= branch.id %>" <%= Number(profileUser.branch_id) === Number(branch.id) ? 'selected' : '' %>><%= branch.name %></option>
              <% }) %>
            </select>
          </label>
        <% } else { %>
          <input type="hidden" name="branch_id" value="<%= profileUser.branch_id || '' %>" />
        <% } %>

        <label>Subjects</label>
        <div class="checkbox-list tall">
          <% (subjectOptions || []).forEach((subject) => { if (!archivedSubjects.includes(subject.name)) { %>
            <label><input type="checkbox" name="subjects" value="<%= subject.name %>" <%= userSubjects.includes(subject.name) ? 'checked' : '' %> /> <%= subject.name %></label>
          <% } }) %>
        </div>

        <label>Additional Academic Support</label>
        <div class="checkbox-list tall">
          <% (supportOptions || []).forEach((support) => { %>
            <label><input type="checkbox" name="supports" value="<%= support %>" <%= userSupports.includes(support) ? 'checked' : '' %> /> <%= support %></label>
          <% }) %>
        </div>

        <div class="form-actions right"><button class="btn btn-primary" type="submit">Confirm</button></div>
      </form>
    </div>
  </div>
  <% } %>

</section>
