<%# File: views/content/admin-users.ejs
    Purpose: User Management, as a row list.

    One line per user, key facts only, icon actions on the right. The search /
    branch / role / status / From-To filters above the table narrow the list
    (From and To: the day an account joined, its Joined column); the table
    shows ten rows and scrolls (public/js/mq-tables.js).

    The heavy detail (full profile, subjects, guardian, documents) is one click
    away on the profile page rather than crammed into the row. %>
<%
  const currentQuery = typeof query === 'undefined' ? {} : query;
  const rosterOf = (assistant) => (typeof rosterCounts !== 'undefined' && rosterCounts && rosterCounts.get(Number(assistant.id)))
    || { currentTutors: 0, currentStudents: 0, ever: 0 };
  // Folders: everyone, or only the students still waiting for a tutor. A
  // folder link keeps the branch, search, status and dates.
  const activeFolder = typeof folder === 'undefined' ? 'all' : folder;
  const waitingCount = typeof needsTutorCount === 'undefined' ? 0 : needsTutorCount;
  const inNeedsTutor = activeFolder === 'needs-tutor';
  const joinedFrom = typeof selectedFrom === 'undefined' ? '' : selectedFrom;
  const joinedTo = typeof selectedTo === 'undefined' ? '' : selectedTo;
  const folderHref = (value) => {
    const params = new URLSearchParams();
    ['search', 'branch_id', 'status'].forEach((key) => {
      if (currentQuery[key] && currentQuery[key] !== 'all') params.set(key, currentQuery[key]);
    });
    if (joinedFrom) params.set('from', joinedFrom);
    if (joinedTo) params.set('to', joinedTo);
    if (value !== 'all') params.set('folder', value);
    const text = params.toString();
    return `${basePath}/users${text ? `?${text}` : ''}`;
  };
  // Registered Assistant Admins; the account form offers those with no login yet.
  const registered = typeof assistantProfiles === 'undefined' ? [] : (assistantProfiles || []);
  const awaitingAccount = registered.filter((profile) => !profile.has_account);
  // A form that failed validation opens again, so the admin can fix it.
  const reopen = typeof openModal === 'undefined' ? '' : openModal;
%>
<section class="mq-page">

  <nav class="mq-folders" aria-label="Folders">
    <a class="mq-folder<%= inNeedsTutor ? '' : ' is-active' %>" href="<%= folderHref('all') %>"<%- inNeedsTutor ? '' : ' aria-current="page"' %>>
      <%- icon('users', 18) %>
      <span>All users</span>
    </a>
    <a class="mq-folder is-waiting<%= inNeedsTutor ? ' is-active' : '' %>" href="<%= folderHref('needs-tutor') %>"<%- inNeedsTutor ? ' aria-current="page"' : '' %>>
      <%- icon('award', 18) %>
      <span>Needs a tutor</span>
      <b class="mq-folder-count<%= waitingCount ? ' has-items' : '' %>"><%= waitingCount %></b>
    </a>
  </nav>

  <form class="mq-toolbar" method="get" action="<%= basePath %>/users">
    <% if (inNeedsTutor) { %><input type="hidden" name="folder" value="needs-tutor" /><% } %>
    <div class="mq-filters">
      <label class="mq-field mq-field-search">
        <span>Search</span>
        <input type="search" name="search" value="<%= search || '' %>" placeholder="Name, ID, email or contact number" />
      </label>

      <% if (currentUser.role === 'admin') { %>
        <label class="mq-field">
          <span>Branch</span>
          <select name="branch_id" onchange="this.form.submit()">
            <option value="all">All branches</option>
            <% branches.forEach((branch) => { %>
              <option value="<%= branch.id %>" <%= Number(effectiveBranchId) === Number(branch.id) ? 'selected' : '' %>><%= branch.name %></option>
            <% }) %>
          </select>
        </label>
      <% } %>

      <%# The folder holds students only, so there is no role to pick in it. %>
      <% if (!inNeedsTutor) { %>
        <label class="mq-field">
          <span>Role</span>
          <select name="role" onchange="this.form.submit()">
            <option value="all" <%= selectedRole === 'all' ? 'selected' : '' %>>All roles</option>
            <option value="student" <%= selectedRole === 'student' ? 'selected' : '' %>>Student</option>
            <option value="tutor" <%= selectedRole === 'tutor' ? 'selected' : '' %>>Tutor</option>
          </select>
        </label>
      <% } %>

      <label class="mq-field">
        <span>Status</span>
        <select name="status" onchange="this.form.submit()">
          <option value="all" <%= selectedStatus === 'all' ? 'selected' : '' %>>All</option>
          <option value="approved" <%= selectedStatus === 'approved' ? 'selected' : '' %>>Approved</option>
          <option value="pending" <%= selectedStatus === 'pending' ? 'selected' : '' %>>Pending</option>
          <option value="rejected" <%= selectedStatus === 'rejected' ? 'selected' : '' %>>Rejected</option>
        </select>
      </label>

      <%# The day an account joined (the Joined column), both days included. %>
      <label class="mq-field"><span>From</span><input type="date" name="from" value="<%= joinedFrom %>" /></label>
      <label class="mq-field"><span>To</span><input type="date" name="to" value="<%= joinedTo %>" /></label>

      <button class="mq-btn" type="submit"><%- icon('search') %> Search</button>
    </div>

    <div class="mq-toolbar-actions">
      <button type="button" class="mq-btn" data-modal-target="#archived-users-modal"><%- icon('archive') %> Archive</button>
      <% if (currentUser.role === 'admin') { %>
        <button type="button" class="mq-btn" data-modal-target="#archived-assistant-modal">Archived assistant admins</button>
        <button type="button" class="mq-btn mq-btn-primary" data-modal-target="#assistant-choice-modal"><%- icon('add') %> Branch Assistant Admin Account</button>
      <% } %>
    </div>
  </form>

  <section class="mq-panel">
    <div class="mq-panel-head">
      <h2><%= inNeedsTutor ? 'Students who need a tutor' : 'All users' %></h2>
      <span class="mq-count"><%= users.length %> total</span>
    </div>

    <div class="mq-table" id="users-table"
         style="--mq-min-width: 930px; --mq-cols: 120px minmax(180px, 2fr) 1fr 110px 110px 110px 96px;">
      <div class="mq-head">
        <span>User ID</span>
        <span>Name</span>
        <span>Branch</span>
        <span><%= inNeedsTutor ? 'Tutor' : 'Role' %></span>
        <span>Status</span>
        <span>Joined</span>
        <span style="text-align:right;">Manage</span>
      </div>

      <% if (!users.length) { %>
        <div class="mq-empty">
          <% if (inNeedsTutor && !search && !joinedFrom && !joinedTo) { %>
            <strong>Every enrolled subject has a tutor</strong>
            A student appears here while any of their subjects has no tutor.
          <% } else { %>
            <strong>No users found</strong>
            Try a different search term, or clear the filters above.
          <% } %>
        </div>
      <% } %>

      <% users.forEach((user) => { %>
        <div class="mq-row">
          <span class="mq-cell mq-sub" data-label="User ID"><%= user.user_id %></span>

          <span class="mq-cell mq-cell-primary" data-label="Name">
            <a class="mq-name" href="<%= basePath %>/profile/<%= user.id %>"><%= titleCaseName(user.first_name) %> <%= titleCaseName(user.last_name) %></a>
            <% if (inNeedsTutor) { %>
              <span class="mq-sub"><%= (user.enrolled_subjects || []).join(', ') || '—' %></span>
            <% } else { %>
              <span class="mq-sub"><%= user.email || user.contact_number || '—' %></span>
            <% } %>
          </span>

          <span class="mq-cell" data-label="Branch"><%= user.branch_name || '—' %></span>

          <span class="mq-cell" data-label="<%= inNeedsTutor ? 'Tutor' : 'Role' %>">
            <% if (inNeedsTutor) { %>
              <span class="mq-status mq-status-pending"><%= (user.enrolled_subjects || []).length > 1 ? `${user.enrolled_subjects.length} subjects need one` : 'No tutor yet' %></span>
            <% } else { %>
              <span class="mq-chip mq-chip-role"><%= user.role === 'tutor' ? 'Tutor' : 'Student' %></span>
            <% } %>
          </span>

          <span class="mq-cell" data-label="Status">
            <span class="mq-status mq-status-<%= user.status === 'approved' ? 'approved' : user.status === 'pending' ? 'pending' : 'rejected' %>"><%= user.status === 'approved' ? 'Approved' : user.status === 'pending' ? 'Pending' : 'Rejected' %></span>
          </span>

          <span class="mq-cell mq-sub" data-label="Joined"><%= formatDate(user.created_at) %></span>

          <span class="mq-cell mq-cell-actions">
            <% if (inNeedsTutor) { %>
              <a class="mq-icon mq-icon-accent" href="<%= basePath %>/profile/<%= user.id %>#tutor-schedule" title="Assign a tutor" aria-label="Assign a tutor"><%- icon('award') %></a>
            <% } else { %>
              <a class="mq-icon" href="<%= basePath %>/profile/<%= user.id %>" title="View profile" aria-label="View profile"><%- icon('view') %></a>
            <% } %>
            <form method="post" action="<%= basePath %>/users/<%= user.id %>/archive" data-confirm-message="Archive <%= titleCaseName(user.first_name) %> <%= titleCaseName(user.last_name) %>? They will no longer be able to log in.">
              <button class="mq-icon mq-icon-danger" type="submit" title="Archive user" aria-label="Archive user"><%- icon('archive') %></button>
            </form>
          </span>
        </div>
      <% }) %>
    </div>
  </section>

  <% if (currentUser.role === 'admin') { %>
    <section class="mq-panel" id="assistant-admins">
      <div class="mq-panel-head">
        <h2>Branch Assistant Admin Accounts</h2>
        <span class="mq-count"><%= assistantAccounts.length %> account<%= assistantAccounts.length === 1 ? '' : 's' %></span>
      </div>

      <div class="mq-table" style="--mq-min-width: 860px; --mq-cols: minmax(160px, 2fr) minmax(170px, 2fr) 1fr minmax(150px, 1fr) 110px 96px;">
        <div class="mq-head">
          <span>Assistant Admin</span>
          <span>Email</span>
          <span>Branch</span>
          <span>Handles now</span>
          <span>Created</span>
          <span style="text-align:right;">Manage</span>
        </div>

        <% if (!assistantAccounts.length) { %>
          <div class="mq-empty"><strong>No assistant admin accounts yet</strong>Use "Branch Assistant Admin Account" above: register the assistant admin, then create their account.</div>
        <% } %>

        <% assistantAccounts.forEach((assistant) => { const counts = rosterOf(assistant); %>
          <div class="mq-row">
            <span class="mq-cell mq-cell-primary" data-label="Assistant Admin">
              <a class="mq-name" href="<%= basePath %>/profile/<%= assistant.id %>"><%= titleCaseName(assistant.extra?.assistant_name || assistant.first_name || assistant.email) %></a>
              <span class="mq-sub">Assistant Admin</span>
            </span>
            <span class="mq-cell mq-sub" data-label="Email"><%= assistant.email %></span>
            <span class="mq-cell" data-label="Branch"><%= assistant.branch_name || '—' %></span>
            <span class="mq-cell mq-sub" data-label="Handles now"><%= counts.currentTutors %> tutor<%= counts.currentTutors === 1 ? '' : 's' %> · <%= counts.currentStudents %> student<%= counts.currentStudents === 1 ? '' : 's' %></span>
            <span class="mq-cell mq-sub" data-label="Created"><%= formatDate(assistant.created_at) %></span>
            <span class="mq-cell mq-cell-actions">
              <a class="mq-icon" href="<%= basePath %>/profile/<%= assistant.id %>" title="View account and roster" aria-label="View account and roster"><%- icon('view') %></a>
              <form method="post" action="<%= basePath %>/assistant-accounts/<%= assistant.id %>/archive" data-confirm-message="Archive this assistant admin account?">
                <button class="mq-icon mq-icon-danger" type="submit" title="Archive account" aria-label="Archive account"><%- icon('archive') %></button>
              </form>
            </span>
          </div>
        <% }) %>
      </div>
    </section>

    <%# The people registered as Assistant Admins, with or without a login yet. %>
    <section class="mq-panel">
      <div class="mq-panel-head">
        <div>
          <h2>Registered Assistant Admins</h2>
        </div>
        <span class="mq-count"><%= registered.length %> registered</span>
      </div>

      <div class="mq-table" style="--mq-min-width: 900px; --mq-cols: minmax(170px, 2fr) 130px 120px 70px minmax(180px, 2fr) minmax(150px, 1.2fr);">
        <div class="mq-head">
          <span>Name</span>
          <span>Contact Number</span>
          <span>Birthdate</span>
          <span>Age</span>
          <span>Address</span>
          <span>Account</span>
        </div>

        <% if (!registered.length) { %>
          <div class="mq-empty"><strong>No one registered yet</strong>Register an assistant admin first, then create their account.</div>
        <% } %>

        <% registered.forEach((profile) => { %>
          <div class="mq-row">
            <span class="mq-cell mq-cell-primary" data-label="Name"><span class="mq-name"><%= profile.full_name %></span></span>
            <span class="mq-cell mq-sub" data-label="Contact Number"><%= profile.contact_number || '—' %></span>
            <span class="mq-cell mq-sub" data-label="Birthdate"><%= formatDate(profile.birth_date) %></span>
            <span class="mq-cell mq-sub" data-label="Age"><%= profile.age || '—' %></span>
            <span class="mq-cell mq-sub" data-label="Address"><%= profile.address || '—' %></span>
            <span class="mq-cell" data-label="Account">
              <% if (profile.has_account) { %>
                <a class="mq-status mq-status-approved" href="<%= basePath %>/profile/<%= profile.user_id %>"><%= profile.branch_name ? `Has account · ${profile.branch_name}` : 'Has account' %></a>
              <% } else { %>
                <span class="mq-status mq-status-pending">No account yet</span>
              <% } %>
            </span>
          </div>
        <% }) %>
      </div>
    </section>
  <% } %>

  <%# ---------------------------------------------------------------- modals %>

  <div class="global-modal" id="archived-users-modal">
    <div class="global-modal-card wide">
      <button type="button" class="modal-close" data-close-modal>&times;</button>
      <h3>Archived users</h3>
      <div class="mq-table" style="--mq-cols: 120px minmax(160px,2fr) 110px 96px;">
        <div class="mq-head">
          <span>User ID</span><span>Name</span><span>Role</span><span style="text-align:right;">Recover</span>
        </div>
        <% if (!archivedUsers.length) { %>
          <div class="mq-empty">No archived users.</div>
        <% } %>
        <% archivedUsers.forEach((user) => { %>
          <div class="mq-row">
            <span class="mq-cell mq-sub" data-label="User ID"><%= user.user_id %></span>
            <span class="mq-cell mq-name" data-label="Name"><%= titleCaseName(user.first_name) %> <%= titleCaseName(user.last_name) %></span>
            <span class="mq-cell" data-label="Role"><span class="mq-chip mq-chip-role"><%= user.role %></span></span>
            <span class="mq-cell mq-cell-actions">
              <form method="post" action="<%= basePath %>/users/<%= user.id %>/recover" data-confirm-message="Recover this archived user?">
                <button class="mq-icon" type="submit" title="Recover user" aria-label="Recover user"><%- icon('restore') %></button>
              </form>
            </span>
          </div>
        <% }) %>
      </div>
    </div>
  </div>

  <% if (currentUser.role === 'admin') { %>
    <div class="global-modal" id="archived-assistant-modal">
      <div class="global-modal-card wide">
        <button type="button" class="modal-close" data-close-modal>&times;</button>
        <h3>Archived Assistant Admin Accounts</h3>
        <div class="mq-table" style="--mq-cols: minmax(150px,2fr) minmax(150px,2fr) 1fr minmax(110px, 1fr) 96px;">
          <div class="mq-head">
            <span>Assistant Admin</span><span>Email</span><span>Branch</span><span>Handled</span><span style="text-align:right;">Manage</span>
          </div>
          <% if (!(archivedAssistantAccounts || []).length) { %>
            <div class="mq-empty">No archived assistant admin accounts.</div>
          <% } %>
          <% (archivedAssistantAccounts || []).forEach((assistant) => { const counts = rosterOf(assistant); %>
            <div class="mq-row">
              <span class="mq-cell mq-cell-primary" data-label="Assistant Admin">
                <a class="mq-name" href="<%= basePath %>/profile/<%= assistant.id %>"><%= titleCaseName(assistant.extra?.assistant_name || assistant.first_name || assistant.email) %></a>
              </span>
              <span class="mq-cell mq-sub" data-label="Email"><%= assistant.email %></span>
              <span class="mq-cell" data-label="Branch"><%= assistant.branch_name || '—' %></span>
              <span class="mq-cell mq-sub" data-label="Handled"><%= counts.ever %> <%= counts.ever === 1 ? 'person' : 'people' %></span>
              <span class="mq-cell mq-cell-actions">
                <a class="mq-icon" href="<%= basePath %>/profile/<%= assistant.id %>" title="View account and roster" aria-label="View account and roster"><%- icon('view') %></a>
                <form method="post" action="<%= basePath %>/assistant-accounts/<%= assistant.id %>/recover" data-confirm-message="Recover this archived assistant account?">
                  <button class="mq-icon" type="submit" title="Recover account" aria-label="Recover account"><%- icon('restore') %></button>
                </form>
              </span>
            </div>
          <% }) %>
        </div>
      </div>
    </div>

    <%# "Branch Assistant Admin Account": first, which of the two steps. %>
    <div class="global-modal" id="assistant-choice-modal">
      <div class="global-modal-card small">
        <button type="button" class="modal-close" data-close-modal>&times;</button>
        <h3>Branch Assistant Admin Account</h3>
        <div class="aa-choice">
          <button type="button" class="aa-choice-btn" data-modal-target="#register-assistant-modal" data-close-modal>
            <%- icon('user', 22) %>
            <span><strong>Register Assistant Admin</strong><small>Name, address, birthdate and contact number</small></span>
          </button>
          <button type="button" class="aa-choice-btn" data-modal-target="#assistant-modal" data-close-modal>
            <%- icon('lock', 22) %>
            <span><strong>Create Account for Assistant Admin</strong><small>Branch, email and password for a registered assistant admin</small></span>
          </button>
        </div>
      </div>
    </div>

    <%# Step 1 — register the person. Age is worked out from the birthdate. %>
    <div class="global-modal <%= reopen === 'register-assistant' ? 'is-open' : '' %>" id="register-assistant-modal" <%= reopen === 'register-assistant' ? 'data-force-open="true"' : '' %>>
      <div class="global-modal-card small">
        <button type="button" class="modal-close" data-close-modal>&times;</button>
        <h3>Register Assistant Admin</h3>
        <form method="post" action="<%= basePath %>/assistant-admins/register" class="mq-form"
              data-confirm-message="Register this assistant admin?">
          <label>First name<input type="text" name="first_name" maxlength="100" autocomplete="given-name" required /></label>
          <label>Middle name <small>(optional)</small><input type="text" name="middle_name" maxlength="100" autocomplete="additional-name" /></label>
          <label>Last name<input type="text" name="last_name" maxlength="100" autocomplete="family-name" required /></label>
          <label class="is-wide">Address<input type="text" name="address" maxlength="500" autocomplete="street-address" required /></label>
          <label>Birthdate<input type="date" name="birth_date" data-auto-age-birth max="<%= toInputDate(new Date()) %>" required /></label>
          <label>Age<input type="number" name="age" data-auto-age-target readonly tabindex="-1" placeholder="From the birthdate" /></label>
          <label>Contact number<input type="tel" name="contact_number" placeholder="09XXXXXXXXX" pattern="(\+?63|0)9[0-9]{9}" title="A mobile number like 09XXXXXXXXX" maxlength="13" required /></label>
          <div class="mq-form-foot">
            <button class="mq-btn mq-btn-primary" type="submit">Register</button>
          </div>
        </form>
      </div>
    </div>

    <%# Step 2 — the account. The same form as before, except the name is
        picked from the registered assistant admins who have no account yet. %>
    <div class="global-modal <%= reopen === 'create-assistant-account' ? 'is-open' : '' %>" id="assistant-modal" <%= reopen === 'create-assistant-account' ? 'data-force-open="true"' : '' %>>
      <div class="global-modal-card small">
        <button type="button" class="modal-close" data-close-modal>&times;</button>
        <h3>Create Account for Assistant Admin</h3>
        <% if (!awaitingAccount.length) { %>
          <p class="mq-form-note">Every registered assistant admin already has an account. Register the new assistant admin first.</p>
          <div class="mq-form-foot">
            <button type="button" class="mq-btn mq-btn-primary" data-modal-target="#register-assistant-modal" data-close-modal><%- icon('user') %> Register Assistant Admin</button>
          </div>
        <% } else { %>
          <form method="post" action="<%= basePath %>/assistant-accounts" class="mq-form"
                data-confirm-message="Create this assistant admin account?">
            <label>Assistant name
              <select name="assistant_profile_id" required>
                <option value="">Select a registered assistant admin</option>
                <% awaitingAccount.forEach((profile) => { %>
                  <option value="<%= profile.id %>"><%= profile.full_name %></option>
                <% }) %>
              </select>
            </label>
            <label>Branch
              <select name="branch_id" required>
                <% ((typeof availableAssistantBranches !== 'undefined' && availableAssistantBranches.length ? availableAssistantBranches : branches) || []).forEach((branch) => { %>
                  <option value="<%= branch.id %>"><%= branch.name %></option>
                <% }) %>
              </select>
            </label>
            <label>Email<input type="email" name="email" autocomplete="off" required /></label>
            <label>Password<input type="password" name="password" minlength="8" autocomplete="new-password" placeholder="8+ characters: A-Z, a-z, 0-9 and a symbol" required /></label>
            <div class="mq-form-foot">
              <button class="mq-btn mq-btn-primary" type="submit">Save account</button>
            </div>
          </form>
        <% } %>
      </div>
    </div>
  <% } %>

</section>

<style>
  .aa-choice { display: grid; gap: 10px; margin-top: 12px; }
  .aa-choice-btn {
    display: flex; align-items: center; gap: 14px; width: 100%; padding: 14px 16px; text-align: left;
    border: 1px solid var(--border, #d7e2ea); border-radius: 14px; background: #fff; cursor: pointer;
    font: inherit; color: inherit; transition: border-color .15s ease, box-shadow .15s ease;
  }
  .aa-choice-btn:hover { border-color: var(--primary, #0e7490); box-shadow: 0 6px 18px rgba(16, 32, 51, .08); }
  .aa-choice-btn span { display: grid; gap: 2px; }
  .aa-choice-btn small { color: var(--text-soft, #5f7084); font-size: 12.5px; }
</style>
