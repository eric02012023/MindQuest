<%# File: views/content/admin-users.ejs
    Purpose: User Management, as a row list.

    One line per user, key facts only, icon actions on the right. Every user is
    listed: the table shows ten rows and scrolls, and the search icon beside the
    "All users" heading finds anyone by anything in their row — name, ID, email,
    branch, role, status (public/js/mq-tables.js). The search / branch / role /
    status filters and the page numbers that used to sit around the table are
    gone.

    The heavy detail (full profile, subjects, guardian, documents) is one click
    away on the profile page rather than crammed into the row. %>
<%
  const rosterOf = (assistant) => (typeof rosterCounts !== 'undefined' && rosterCounts && rosterCounts.get(Number(assistant.id)))
    || { currentTutors: 0, currentStudents: 0, ever: 0 };
  // Folders: everyone, or only the students still waiting for a tutor.
  const activeFolder = typeof folder === 'undefined' ? 'all' : folder;
  const waitingCount = typeof needsTutorCount === 'undefined' ? 0 : needsTutorCount;
  const inNeedsTutor = activeFolder === 'needs-tutor';
  const folderHref = (value) => `${basePath}/users${value !== 'all' ? `?folder=${value}` : ''}`;
%>
<section class="mq-page">

  <nav class="mq-folders" aria-label="Folders">
    <a class="mq-folder<%= inNeedsTutor ? '' : ' is-active' %>" href="<%= folderHref('all') %>"<%- inNeedsTutor ? '' : ' aria-current="page"' %>>
      <%- icon('users', 18) %>
      <span>All users</span>
    </a>
    <a class="mq-folder is-waiting<%= inNeedsTutor ? ' is-active' : '' %>" href="<%= folderHref('needs-tutor') %>"<%- inNeedsTutor ? ' aria-current="page"' : '' %>>
      <%- icon('award', 18) %>
      <span>Needs a tutor</span>
      <b class="mq-folder-count<%= waitingCount ? ' has-items' : '' %>"><%= waitingCount %></b>
    </a>
  </nav>

  <%# The account actions stay; the search / branch / role / status filters
      that shared this bar are gone — the icon beside the heading below does
      their job inside the table. %>
  <div class="mq-toolbar">
    <div class="mq-toolbar-actions">
      <button type="button" class="mq-btn" data-modal-target="#archived-users-modal"><%- icon('archive') %> Archive</button>
      <% if (currentUser.role === 'admin') { %>
        <button type="button" class="mq-btn" data-modal-target="#archived-assistant-modal">Archived assistants</button>
        <button type="button" class="mq-btn mq-btn-primary" data-modal-target="#assistant-modal"><%- icon('add') %> Branch account</button>
      <% } %>
    </div>
  </div>

  <section class="mq-panel">
    <div class="mq-panel-head">
      <div class="mq-heading-search">
        <%# The search icon sits on the left, beside the heading, inside the
            table's own frame. It opens a box that searches every row. %>
        <h2><%= inNeedsTutor ? 'Students who need a tutor' : 'All users' %></h2>
        <button type="button" class="mq-th-search" data-table-search-for="users-table"
                title="Search this table" aria-label="Search <%= inNeedsTutor ? 'students who need a tutor' : 'all users' %>">
          <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2.2"/><path d="M20 20l-3.6-3.6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
        </button>
      </div>
      <span class="mq-count"><%= users.length %> total</span>
    </div>

    <div class="mq-table" id="users-table" data-search-anchor="external"
         style="--mq-min-width: 930px; --mq-cols: 120px minmax(180px, 2fr) 1fr 110px 110px 110px 96px;">
      <div class="mq-head">
        <span>User ID</span>
        <span>Name</span>
        <span>Branch</span>
        <span><%= inNeedsTutor ? 'Tutor' : 'Role' %></span>
        <span>Status</span>
        <span>Joined</span>
        <span style="text-align:right;">Actions</span>
      </div>

      <% if (!users.length) { %>
        <div class="mq-empty">
          <% if (inNeedsTutor) { %>
            <strong>Every enrolled subject has a tutor</strong>
            A student appears here while any of their subjects has no tutor.
          <% } else { %>
            <strong>No users yet</strong>
            Accepted registrations appear here.
          <% } %>
        </div>
      <% } %>

      <% users.forEach((user) => { %>
        <div class="mq-row">
          <span class="mq-cell mq-sub" data-label="User ID"><%= user.user_id %></span>

          <span class="mq-cell mq-cell-primary" data-label="Name">
            <a class="mq-name" href="<%= basePath %>/profile/<%= user.id %>"><%= titleCaseName(user.first_name) %> <%= titleCaseName(user.last_name) %></a>
            <% if (inNeedsTutor) { %>
              <span class="mq-sub"><%= (user.enrolled_subjects || []).join(', ') || '—' %></span>
            <% } else { %>
              <span class="mq-sub"><%= user.email || user.contact_number || '—' %></span>
            <% } %>
          </span>

          <span class="mq-cell" data-label="Branch"><%= user.branch_name || '—' %></span>

          <span class="mq-cell" data-label="<%= inNeedsTutor ? 'Tutor' : 'Role' %>">
            <% if (inNeedsTutor) { %>
              <span class="mq-status mq-status-pending"><%= (user.enrolled_subjects || []).length > 1 ? `${user.enrolled_subjects.length} subjects need one` : 'No tutor yet' %></span>
            <% } else { %>
              <span class="mq-chip mq-chip-role"><%= user.role %></span>
            <% } %>
          </span>

          <span class="mq-cell" data-label="Status">
            <span class="mq-status mq-status-<%= user.status === 'approved' ? 'approved' : user.status === 'pending' ? 'pending' : 'rejected' %>"><%= user.status %></span>
          </span>

          <span class="mq-cell mq-sub" data-label="Joined"><%= formatDate(user.created_at) %></span>

          <span class="mq-cell mq-cell-actions">
            <% if (inNeedsTutor) { %>
              <a class="mq-icon mq-icon-accent" href="<%= basePath %>/profile/<%= user.id %>#tutor-schedule" title="Assign a tutor" aria-label="Assign a tutor"><%- icon('award') %></a>
            <% } else { %>
              <a class="mq-icon" href="<%= basePath %>/profile/<%= user.id %>" title="View profile" aria-label="View profile"><%- icon('view') %></a>
            <% } %>
            <form method="post" action="<%= basePath %>/users/<%= user.id %>/archive" data-confirm-message="Archive <%= titleCaseName(user.first_name) %> <%= titleCaseName(user.last_name) %>? They will no longer be able to log in.">
              <button class="mq-icon mq-icon-danger" type="submit" title="Archive user" aria-label="Archive user"><%- icon('archive') %></button>
            </form>
          </span>
        </div>
      <% }) %>
    </div>
  </section>

  <% if (currentUser.role === 'admin') { %>
    <section class="mq-panel">
      <div class="mq-panel-head">
        <h2>Branch assistant accounts</h2>
        <span class="mq-count"><%= assistantAccounts.length %> account<%= assistantAccounts.length === 1 ? '' : 's' %></span>
      </div>

      <div class="mq-table" style="--mq-min-width: 860px; --mq-cols: minmax(160px, 2fr) minmax(170px, 2fr) 1fr minmax(150px, 1fr) 110px 96px;">
        <div class="mq-head">
          <span>Assistant</span>
          <span>Email</span>
          <span>Branch</span>
          <span>Handles now</span>
          <span>Created</span>
          <span style="text-align:right;">Actions</span>
        </div>

        <% if (!assistantAccounts.length) { %>
          <div class="mq-empty"><strong>No assistant accounts yet</strong>Create one with the button above.</div>
        <% } %>

        <% assistantAccounts.forEach((assistant) => { const counts = rosterOf(assistant); %>
          <div class="mq-row">
            <span class="mq-cell mq-cell-primary" data-label="Assistant">
              <a class="mq-name" href="<%= basePath %>/profile/<%= assistant.id %>"><%= titleCaseName(assistant.extra?.assistant_name || assistant.first_name || assistant.email) %></a>
              <span class="mq-sub">Admin Assistant</span>
            </span>
            <span class="mq-cell mq-sub" data-label="Email"><%= assistant.email %></span>
            <span class="mq-cell" data-label="Branch"><%= assistant.branch_name || '—' %></span>
            <span class="mq-cell mq-sub" data-label="Handles now"><%= counts.currentTutors %> tutor<%= counts.currentTutors === 1 ? '' : 's' %> · <%= counts.currentStudents %> student<%= counts.currentStudents === 1 ? '' : 's' %></span>
            <span class="mq-cell mq-sub" data-label="Created"><%= formatDate(assistant.created_at) %></span>
            <span class="mq-cell mq-cell-actions">
              <a class="mq-icon" href="<%= basePath %>/profile/<%= assistant.id %>" title="View account and roster" aria-label="View account and roster"><%- icon('view') %></a>
              <form method="post" action="<%= basePath %>/assistant-accounts/<%= assistant.id %>/archive" data-confirm-message="Archive this assistant account?">
                <button class="mq-icon mq-icon-danger" type="submit" title="Archive account" aria-label="Archive account"><%- icon('archive') %></button>
              </form>
            </span>
          </div>
        <% }) %>
      </div>
    </section>
  <% } %>

  <%# ---------------------------------------------------------------- modals %>

  <div class="global-modal" id="archived-users-modal">
    <div class="global-modal-card wide">
      <button type="button" class="modal-close" data-close-modal>&times;</button>
      <h3>Archived users</h3>
      <div class="mq-table" style="--mq-cols: 120px minmax(160px,2fr) 110px 96px;">
        <div class="mq-head">
          <span>User ID</span><span>Name</span><span>Role</span><span style="text-align:right;">Recover</span>
        </div>
        <% if (!archivedUsers.length) { %>
          <div class="mq-empty">No archived users.</div>
        <% } %>
        <% archivedUsers.forEach((user) => { %>
          <div class="mq-row">
            <span class="mq-cell mq-sub" data-label="User ID"><%= user.user_id %></span>
            <span class="mq-cell mq-name" data-label="Name"><%= titleCaseName(user.first_name) %> <%= titleCaseName(user.last_name) %></span>
            <span class="mq-cell" data-label="Role"><span class="mq-chip mq-chip-role"><%= user.role %></span></span>
            <span class="mq-cell mq-cell-actions">
              <form method="post" action="<%= basePath %>/users/<%= user.id %>/recover" data-confirm-message="Recover this archived user?">
                <button class="mq-icon" type="submit" title="Recover user" aria-label="Recover user"><%- icon('restore') %></button>
              </form>
            </span>
          </div>
        <% }) %>
      </div>
    </div>
  </div>

  <% if (currentUser.role === 'admin') { %>
    <div class="global-modal" id="archived-assistant-modal">
      <div class="global-modal-card wide">
        <button type="button" class="modal-close" data-close-modal>&times;</button>
        <h3>Archived assistant accounts</h3>
        <p class="mq-form-note">Open one to see every tutor and student who was under them.</p>
        <div class="mq-table" style="--mq-cols: minmax(150px,2fr) minmax(150px,2fr) 1fr minmax(110px, 1fr) 96px;">
          <div class="mq-head">
            <span>Assistant</span><span>Email</span><span>Branch</span><span>Handled</span><span style="text-align:right;">Actions</span>
          </div>
          <% if (!(archivedAssistantAccounts || []).length) { %>
            <div class="mq-empty">No archived assistant accounts.</div>
          <% } %>
          <% (archivedAssistantAccounts || []).forEach((assistant) => { const counts = rosterOf(assistant); %>
            <div class="mq-row">
              <span class="mq-cell mq-cell-primary" data-label="Assistant">
                <a class="mq-name" href="<%= basePath %>/profile/<%= assistant.id %>"><%= titleCaseName(assistant.extra?.assistant_name || assistant.first_name || assistant.email) %></a>
              </span>
              <span class="mq-cell mq-sub" data-label="Email"><%= assistant.email %></span>
              <span class="mq-cell" data-label="Branch"><%= assistant.branch_name || '—' %></span>
              <span class="mq-cell mq-sub" data-label="Handled"><%= counts.ever %> <%= counts.ever === 1 ? 'person' : 'people' %></span>
              <span class="mq-cell mq-cell-actions">
                <a class="mq-icon" href="<%= basePath %>/profile/<%= assistant.id %>" title="View account and roster" aria-label="View account and roster"><%- icon('view') %></a>
                <form method="post" action="<%= basePath %>/assistant-accounts/<%= assistant.id %>/recover" data-confirm-message="Recover this archived assistant account?">
                  <button class="mq-icon" type="submit" title="Recover account" aria-label="Recover account"><%- icon('restore') %></button>
                </form>
              </span>
            </div>
          <% }) %>
        </div>
      </div>
    </div>

    <div class="global-modal" id="assistant-modal">
      <div class="global-modal-card small">
        <button type="button" class="modal-close" data-close-modal>&times;</button>
        <h3>Create branch assistant account</h3>
        <form method="post" action="<%= basePath %>/assistant-accounts" class="mq-form">
          <label>Branch
            <select name="branch_id" required>
              <% ((typeof availableAssistantBranches !== 'undefined' && availableAssistantBranches.length ? availableAssistantBranches : branches) || []).forEach((branch) => { %>
                <option value="<%= branch.id %>"><%= branch.name %></option>
              <% }) %>
            </select>
          </label>
          <label>Assistant name<input type="text" name="assistant_name" required /></label>
          <label>Email<input type="email" name="email" required /></label>
          <label>Password<input type="password" name="password" required /></label>
          <div class="mq-form-foot">
            <button class="mq-btn mq-btn-primary" type="submit">Save account</button>
          </div>
        </form>
      </div>
    </div>
  <% } %>

</section>
