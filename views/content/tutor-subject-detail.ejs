<%# ANNOTATED COPY FOR DEFENSE REVIEW | File: views/content/tutor-subject-detail.ejs | Purpose: UI template/view used by the system. %>
<section class="page-stack">
  <section class="panel-card">
    <div class="panel-card-head">
      <h2>Enrolled Students</h2>
      <% const seenIds = new Set(); const myStudents = students.filter((student) => { const id = Number(student.student_id); if (seenIds.has(id)) return false; seenIds.add(id); return true; }); %>
      <span class="badge badge-info"><%= myStudents.length %> student<%= myStudents.length === 1 ? '' : 's' %></span>
    </div>
    <div class="table-wrap">
      <table>
        <thead><tr><th data-search-col>Student</th><th>Year / Grade</th><th>Time Schedule</th><th>Action</th></tr></thead>
        <tbody>
          <% if (!myStudents.length) { %><tr><td colspan="4">No students under this subject yet.</td></tr><% } %>
          <% myStudents.forEach((student) => { %>
            <tr>
              <td><a href="/tutor/students/<%= student.student_id %>"><strong><%= student.full_name %></strong></a> <span class="module-card-meta"><%= student.user_id || '' %></span></td>
              <td><%= [student.year_level, student.grade_level].filter(Boolean).join(' / ') || '-' %></td>
              <td><%= student.time_slot || '-' %></td>
              <td><a class="btn btn-secondary btn-sm" href="/tutor/students/<%= student.student_id %>/analytics">Analytics</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>

  <%# ------------------------------------------------------------------------
      Modules (overhaul Phase 6). Read-only for the tutor: Admin owns module
      creation and handouts. Shown here so the tutor can see what material the
      student has, and which year levels each module is restricted to.
      ------------------------------------------------------------------------ %>
  <section class="panel-card">
    <div class="panel-card-head">
      <h3>Modules</h3>
      <span class="badge badge-info"><%= modules.length %> module<%= modules.length === 1 ? '' : 's' %></span>
    </div>
    <p class="table-note">Set up by Admin. You can build assessments on top of these modules.</p>

    <% if (!modules.length) { %>
      <p class="empty-state">Admin has not added a module to this subject yet.</p>
    <% } %>

    <div class="module-grid">
      <% modules.forEach((mod) => { %>
        <article class="module-card">
          <div class="module-card-head">
            <span class="module-number">Module <%= mod.order_number %></span>
            <span class="badge <%= Number(mod.handout_count) ? 'badge-success' : 'badge-warning' %>">
              <%= mod.handout_count %> handout<%= Number(mod.handout_count) === 1 ? '' : 's' %>
            </span>
          </div>
          <h4><%= mod.title %></h4>
          <% if (mod.description) { %><p class="module-card-desc"><%= mod.description %></p><% } %>

          <div class="module-card-targets">
            <strong>Visible to</strong>
            <div class="target-chips">
              <% if (!mod.target_year_levels.length) { %>
                <span class="target-chip target-chip-all">All year levels</span>
              <% } else { %>
                <% mod.target_year_levels.forEach((lvl) => { %>
                  <span class="target-chip"><%= lvl %></span>
                <% }) %>
              <% } %>
            </div>
          </div>

          <div class="module-card-foot">
            <% if (Number(mod.assessment_count)) { %>
              <span class="module-card-meta"><%= mod.assessment_count %> assessment<%= Number(mod.assessment_count) === 1 ? '' : 's' %></span>
            <% } %>
            <a class="btn btn-secondary btn-sm" href="/tutor/modules/<%= mod.id %>/create-assessment">Create Assessment</a>
          </div>
        </article>
      <% }) %>
    </div>
  </section>

  <%# ------------------------------------------------------------------------
      Pre-Assessment results + weak areas (overhaul Phase 6, acceptance item 8).
      ------------------------------------------------------------------------ %>
  <section class="panel-card">
    <div class="panel-card-head">
      <h3>Pre-Assessment Results</h3>
      <span class="badge badge-info"><%= preResults.length %> submission<%= preResults.length === 1 ? '' : 's' %></span>
    </div>
    <p class="table-note">How each student scored on the Pre-Assessment generated from this subject's handouts. Open a row to see which module and handout the missed items came from.</p>

    <% if (!preResults.length) { %>
      <p class="empty-state">No student has taken the Pre-Assessment for this subject yet.</p>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Student</th>
              <th>Year Level</th>
              <th>Score</th>
              <th>Percentage</th>
              <th>Classification</th>
              <th>Submitted</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% preResults.forEach((r) => { %>
              <tr>
                <td>
                  <strong><%= r.first_name %> <%= r.last_name || '' %></strong>
                  <span class="module-card-meta"><%= r.student_code %></span>
                </td>
                <td><%= r.grade_level || r.year_level || '-' %></td>
                <td><%= Number(r.score) %>/<%= Number(r.total_points) %></td>
                <td><%= Number(r.percentage).toFixed(1) %>%</td>
                <td>
                  <span class="res-level res-level-<%= (r.level || 'beginner').toLowerCase() %>"><%= r.level %></span>
                </td>
                <td><%= formatDateTime(r.submitted_at) %></td>
                <td>
                  <a class="btn btn-secondary btn-sm" href="/tutor/results/<%= r.id %>">View Breakdown</a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>

  <%# ------------------------------------------------------------------------
      Post-Assessment (overhaul Phase 8, acceptance item 12).

      Readiness is per student (decision D5): the table shows who has finished,
      and the Post-Assessment opens for those students individually rather than
      making the whole class wait on its slowest member.
      ------------------------------------------------------------------------ %>
  <section class="panel-card">
    <div class="panel-card-head">
      <h3>Post-Assessment</h3>
      <% if (postAssessment) { %>
        <span class="badge badge-success">Open</span>
      <% } else { %>
        <span class="badge badge-info"><%= readiness.readyCount %> of <%= readiness.total %> ready</span>
      <% } %>
    </div>

    <% if (postAssessment) { %>
      <p class="table-note">
        Created from the Pre-Assessment with the same <%= postAssessment.item_count %> items.
        Each student sees it once they have opened every module and submitted every activity.
      </p>
    <% } else { %>
      <p class="table-note">
        This copies the subject's Pre-Assessment exactly — same questions, same answers — so the
        before-and-after comparison measures the student, not a different exam.
        It becomes available once a student has finished all their modules and activities.
      </p>
      <form method="post" action="/tutor/subjects/<%= subjectId %>/create-post-assessment"
            data-confirm-message="Create the Post-Assessment for this subject? It reuses the Pre-Assessment's items exactly.">
        <button type="submit" class="btn btn-primary" <%= readiness.readyCount ? '' : 'disabled' %>>
          Create Post Assessment
        </button>
      </form>
      <% if (!readiness.readyCount) { %>
        <p class="empty-state">No student has finished everything yet.</p>
      <% } %>
    <% } %>

    <% if (readiness.students.length) { %>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Student</th>
              <th>Modules</th>
              <th>Activities</th>
              <th>Pre</th>
              <th>Post</th>
              <th>Change</th>
            </tr>
          </thead>
          <tbody>
            <% readiness.students.forEach((r) => { %>
              <% const cmp = comparisons.find((c) => Number(c.student_id) === Number(r.id)) || {}; %>
              <tr>
                <td>
                  <strong><%= r.first_name %> <%= r.last_name || '' %></strong>
                  <span class="module-card-meta"><%= r.student_code %></span>
                </td>
                <td><%= r.modulesOpened %>/<%= r.modulesTotal %></td>
                <td><%= r.assessmentsDone %>/<%= r.assessmentsTotal %></td>
                <td>
                  <% if (cmp.pre_submission_id) { %>
                    <a href="/tutor/results/<%= cmp.pre_submission_id %>"><%= Number(cmp.pre_percentage).toFixed(1) %>%</a>
                    <span class="res-level res-level-<%= String(cmp.pre_level || '').toLowerCase() %>"><%= cmp.pre_level %></span>
                  <% } else { %>
                    <span class="module-card-meta">not taken</span>
                  <% } %>
                </td>
                <td>
                  <% if (cmp.post_submission_id) { %>
                    <a href="/tutor/results/<%= cmp.post_submission_id %>"><%= Number(cmp.post_percentage).toFixed(1) %>%</a>
                    <span class="res-level res-level-<%= String(cmp.post_level || '').toLowerCase() %>"><%= cmp.post_level %></span>
                  <% } else if (r.isComplete) { %>
                    <span class="module-card-meta"><%= postAssessment ? 'ready to take' : 'ready' %></span>
                  <% } else { %>
                    <span class="module-card-meta">&mdash;</span>
                  <% } %>
                </td>
                <td>
                  <% if (cmp.delta === null || cmp.delta === undefined) { %>
                    <span class="module-card-meta">&mdash;</span>
                  <% } else { %>
                    <span class="prepost-delta <%= cmp.delta > 0 ? 'is-up' : cmp.delta < 0 ? 'is-down' : '' %>">
                      <%= cmp.delta > 0 ? '+' : '' %><%= cmp.delta %>
                      <% if (cmp.level_changed) { %>
                        <span class="prepost-move"><%= cmp.pre_level %> &rarr; <%= cmp.post_level %></span>
                      <% } %>
                    </span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>

  <%# The Legacy Modules panel is gone: those pre-overhaul files can no longer
      be added or managed by the office, and every module now lives in Modules
      above. %>

</section>
