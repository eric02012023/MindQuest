<%# ANNOTATED COPY FOR DEFENSE REVIEW | File: views/content/tutor-subject-detail.ejs | Purpose: UI template/view used by the system. %>
<section class="page-stack">
  <section class="panel-card">
    <div class="panel-card-head"><h2>Enrolled Students</h2></div>
    <div class="list-stack">
      <% if (!students.length) { %><p class="empty-state">No students under this subject yet.</p><% } %>
      <% const seenIds = new Set(); %>
      <% students.forEach((student) => { %>
        <% if (!seenIds.has(Number(student.student_id))) { seenIds.add(Number(student.student_id)); %>
          <a class="list-card compact student-link-card" href="/tutor/students/<%= student.student_id %>/analytics">
            <div>
              <strong><%= student.full_name %></strong>
              <span><%= student.year_level %> <%= student.grade_level %></span>
            </div>
          </a>
        <% } %>
      <% }) %>
    </div>
  </section>

  <%# ------------------------------------------------------------------------
      Modules (overhaul Phase 6). Read-only for the tutor: Admin owns module
      creation and handouts. Shown here so the tutor can see what material the
      student has, and which year levels each module is restricted to.
      ------------------------------------------------------------------------ %>
  <section class="panel-card">
    <div class="panel-card-head">
      <h3>Modules</h3>
      <span class="badge badge-info"><%= modules.length %> module<%= modules.length === 1 ? '' : 's' %></span>
    </div>
    <p class="table-note">Set up by Admin. You can build assessments on top of these modules.</p>

    <% if (!modules.length) { %>
      <p class="empty-state">Admin has not added a module to this subject yet.</p>
    <% } %>

    <div class="module-grid">
      <% modules.forEach((mod) => { %>
        <article class="module-card">
          <div class="module-card-head">
            <span class="module-number">Module <%= mod.order_number %></span>
            <span class="badge <%= Number(mod.handout_count) ? 'badge-success' : 'badge-warning' %>">
              <%= mod.handout_count %> handout<%= Number(mod.handout_count) === 1 ? '' : 's' %>
            </span>
          </div>
          <h4><%= mod.title %></h4>
          <% if (mod.description) { %><p class="module-card-desc"><%= mod.description %></p><% } %>

          <div class="module-card-targets">
            <strong>Visible to</strong>
            <div class="target-chips">
              <% if (!mod.target_year_levels.length) { %>
                <span class="target-chip target-chip-all">All year levels</span>
              <% } else { %>
                <% mod.target_year_levels.forEach((lvl) => { %>
                  <span class="target-chip"><%= lvl %></span>
                <% }) %>
              <% } %>
            </div>
          </div>

          <div class="module-card-foot">
            <% if (Number(mod.assessment_count)) { %>
              <span class="module-card-meta"><%= mod.assessment_count %> assessment<%= Number(mod.assessment_count) === 1 ? '' : 's' %></span>
            <% } %>
            <a class="btn btn-secondary btn-sm" href="/tutor/modules/<%= mod.id %>/create-assessment">Create Assessment</a>
          </div>
        </article>
      <% }) %>
    </div>
  </section>

  <%# ------------------------------------------------------------------------
      Pre-Assessment results + weak areas (overhaul Phase 6, acceptance item 8).
      ------------------------------------------------------------------------ %>
  <section class="panel-card">
    <div class="panel-card-head">
      <h3>Pre-Assessment Results</h3>
      <span class="badge badge-info"><%= preResults.length %> submission<%= preResults.length === 1 ? '' : 's' %></span>
    </div>
    <p class="table-note">How each student scored on the Pre-Assessment generated from this subject's handouts. Open a row to see which module and handout the missed items came from.</p>

    <% if (!preResults.length) { %>
      <p class="empty-state">No student has taken the Pre-Assessment for this subject yet.</p>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Student</th>
              <th>Year Level</th>
              <th>Score</th>
              <th>Percentage</th>
              <th>Classification</th>
              <th>Submitted</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% preResults.forEach((r) => { %>
              <tr>
                <td>
                  <strong><%= r.first_name %> <%= r.last_name || '' %></strong>
                  <span class="module-card-meta"><%= r.student_code %></span>
                </td>
                <td><%= r.grade_level || r.year_level || '-' %></td>
                <td><%= Number(r.score) %>/<%= Number(r.total_points) %></td>
                <td><%= Number(r.percentage).toFixed(1) %>%</td>
                <td>
                  <span class="res-level res-level-<%= (r.level || 'beginner').toLowerCase() %>"><%= r.level %></span>
                </td>
                <td><%= formatDateTime(r.submitted_at) %></td>
                <td>
                  <a class="btn btn-secondary btn-sm" href="/tutor/results/<%= r.id %>">View Breakdown</a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>

  <section class="panel-card">
    <div class="panel-card-head"><h3>Legacy Modules</h3></div>
    <p class="table-note">Uploaded under the previous module system. Kept so existing student records still resolve; new material lives in the Modules section above.</p>
    <div class="list-stack">
      <% if (!adminResources.length) { %><p class="empty-state">No legacy module.</p><% } %>
      <% adminResources.forEach((resource) => { %>
        <article class="list-card">
          <div>
            <strong><%= resource.title %></strong>
            <% if (resource.type_of_module) { %><span class="badge badge-info" style="margin-left:8px;"><%= resource.type_of_module %></span><% } %>
            <% if (resource.module_origin === 'ai_generated') { %><span class="badge badge-success" style="margin-left:4px;">AI Generated</span><% } %>
            <p><%= resource.description || 'No description' %></p>
            <% if (resource.file_path || resource.content_text) { %><a href="/download/module/<%= resource.id %>" target="_blank">Open Module</a><% } %>
          </div>
        </article>
      <% }) %>
    </div>
    <% if (adminResources.length && students.length) { %>
      <div style="border-top:1px solid var(--border);padding:16px;margin-top:8px;">
        <form method="post" action="/tutor/subjects/<%= subjectId %>/post-consolidated-assessment" class="stack-form" data-confirm-message="Generate and publish an AI assessment based on ALL admin modules for your students? They will be able to take it immediately.">
          <h4 style="margin:0 0 8px;">Post Assessment to Students</h4>
          <p style="margin:0 0 12px;color:var(--text-soft);font-size:13px;">This will generate a single AI assessment based on all the admin modules above.</p>
          <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
            <label style="display:flex;align-items:center;gap:8px;">Number of items
              <input type="number" name="item_count" value="10" min="5" max="50" required style="width:80px;" />
            </label>
            <button type="submit" class="btn btn-primary btn-sm">Post Assessment to Students</button>
          </div>
        </form>
      </div>
    <% } %>
  </section>

</section>
