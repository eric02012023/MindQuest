<%# ANNOTATED COPY FOR DEFENSE REVIEW | File: views/content/tutor-subject-detail.ejs | Purpose: UI template/view used by the system. %>
<section class="page-stack">
  <section class="panel-card">
    <div class="panel-card-head"><h2>Enrolled Students</h2></div>
    <div class="list-stack">
      <% if (!students.length) { %><p class="empty-state">No students under this subject yet.</p><% } %>
      <% const seenIds = new Set(); %>
      <% students.forEach((student) => { %>
        <% if (!seenIds.has(Number(student.student_id))) { seenIds.add(Number(student.student_id)); %>
          <a class="list-card compact student-link-card" href="/tutor/students/<%= student.student_id %>/analytics">
            <div>
              <strong><%= student.full_name %></strong>
              <span><%= student.year_level %> <%= student.grade_level %></span>
            </div>
          </a>
        <% } %>
      <% }) %>
    </div>
  </section>

  <section class="panel-card">
    <div class="panel-card-head"><h3>Admin Modules</h3></div>
    <div class="list-stack">
      <% if (!adminResources.length) { %><p class="empty-state">No admin modules uploaded yet.</p><% } %>
      <% adminResources.forEach((resource) => { %>
        <article class="list-card">
          <div>
            <strong><%= resource.title %></strong>
            <% if (resource.type_of_module) { %><span class="badge badge-info" style="margin-left:8px;"><%= resource.type_of_module %></span><% } %>
            <% if (resource.module_origin === 'ai_generated') { %><span class="badge badge-success" style="margin-left:4px;">AI Generated</span><% } %>
            <p><%= resource.description || 'No description' %></p>
            <% if (resource.file_path) { %><a href="<%= resource.file_path %>" target="_blank">Open file</a><% } %>
          </div>
          <form method="post" action="/tutor/subjects/<%= subjectId %>/resources/share" class="stack-form" style="min-width:320px;">
            <input type="hidden" name="resource_id" value="<%= resource.id %>" />
            <label>Post to students</label>
            <div class="list-stack" style="max-height:180px;overflow:auto;">
              <% students.forEach((student) => { %>
                <label class="checkbox-card"><input type="checkbox" name="assigned_student_ids" value="<%= student.student_id %>" /> <span><strong><%= student.full_name %></strong> - <%= student.year_level %><%= student.grade_level ? ' / ' + student.grade_level : '' %></span></label>
              <% }) %>
            </div>
            <button type="submit" class="btn btn-primary btn-sm">Post to Selected Students</button>
          </form>
        </article>
      <% }) %>
    </div>
  </section>

  <section class="panel-card">
    <div class="panel-card-head"><h3>Modules Posted to Students</h3></div>
    <div class="list-stack">
      <% if (!sharedResources.length) { %><p class="empty-state">You have not posted any admin modules to students yet.</p><% } %>
      <% sharedResources.forEach((resource) => { %>
        <article class="list-card">
          <div>
            <strong><%= resource.title %></strong>
            <p><%= resource.description || 'No description' %></p>
            <p><strong>Assigned Student:</strong> <%= resource.student_name || '-' %></p>
            <% if (resource.file_path) { %><a href="<%= resource.file_path %>" target="_blank">Open file</a><% } %>
          </div>
          <form method="post" action="/tutor/resources/<%= resource.id %>/delete">
            <button class="btn btn-secondary btn-sm" type="submit">Remove</button>
          </form>
        </article>
      <% }) %>
    </div>
  </section>
</section>
