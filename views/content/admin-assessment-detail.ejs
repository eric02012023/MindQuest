<%# ANNOTATED COPY FOR DEFENSE REVIEW | File: views/content/admin-assessment-detail.ejs | Purpose: UI template/view used by the system. %>
<section class="page-stack">
  <div class="panel-card">
    <div class="panel-card-head">
      <h2><%= assessment.title %></h2>
      <p>
        <% if (assessment.assessment_type === 'pre' || assessment.assessment_type === 'post') { %>
          <span class="badge badge-<%= assessment.assessment_type === 'pre' ? 'info' : 'success' %>"><%= assessment.assessment_type === 'pre' ? 'Pre' : 'Post' %>-Assessment</span>
        <% } else { %>
          <%= assessment.assessment_type %> assessment
        <% } %>
        for <%= assessment.first_name %> <%= assessment.last_name %>
        <% if (assessment.source_module_title) { %> — Module: <strong><%= assessment.source_module_title %></strong><% } %>
      </p>
    </div>
    <% if (assessment.result) { %>
      <div class="stat-grid assessment-result-grid">
        <article class="stat-card"><h3>Score</h3><strong><%= assessment.result.score %> / <%= assessment.result.total_questions %></strong></article>
        <article class="stat-card"><h3>Percentage</h3><strong><%= assessment.result.percentage %>%</strong></article>
        <article class="stat-card gradient"><h3>Result</h3><strong><%= assessment.result.level %></strong></article>
      </div>
      <%
        // Per-module score breakdown
        let perModuleScores = null;
        if (assessment.result.per_module_scores_json) {
          try { perModuleScores = JSON.parse(assessment.result.per_module_scores_json); } catch(e) {}
        }
        // Fallback: compute from source_module_title if available
        if (!perModuleScores && assessment.source_module_title && assessment.submittedAnswers) {
          const moduleTitle = assessment.source_module_title;
          perModuleScores = {};
          perModuleScores[moduleTitle] = { score: assessment.result.score, total: assessment.result.total_questions, percentage: assessment.result.percentage };
        }
      %>
      <% if (perModuleScores && Object.keys(perModuleScores).length) { %>
        <div class="table-wrap" style="margin-top:16px;">
          <table>
            <thead><tr><th>Module Title</th><th>Score</th><th>Percentage</th></tr></thead>
            <tbody>
              <% Object.entries(perModuleScores).forEach(([title, data]) => { %>
                <tr>
                  <td><%= title %></td>
                  <td><%= data.score %> / <%= data.total %></td>
                  <td><%= data.percentage %>%</td>
                </tr>
              <% }) %>
              <tr style="font-weight:700;background:var(--surface-muted);">
                <td>Overall</td>
                <td><%= assessment.result.score %> / <%= assessment.result.total_questions %></td>
                <td><%= assessment.result.percentage %>%</td>
              </tr>
            </tbody>
          </table>
        </div>
      <% } %>
    <% } else { %>
      <p class="empty-state">Student has not taken this assessment yet.</p>
    <% } %>
  </div>

  <section class="panel-card">
    <div class="panel-card-head"><h3>Questions</h3></div>
    <div class="list-stack">
      <% assessment.questions.forEach((question, index) => { %>
        <% const qType = String(question.question_type || 'Multiple Choice').trim(); %>
        <article class="question-view-card">
          <h4><%= index + 1 %>. <%= question.question_text %></h4>
          <small class="badge badge-info"><%= qType %></small>
          <% if (qType === 'Multiple Choice') { %>
            <ul>
              <li>A. <%= question.choice_a %></li>
              <li>B. <%= question.choice_b %></li>
              <% if (question.choice_c) { %><li>C. <%= question.choice_c %></li><% } %>
              <% if (question.choice_d) { %><li>D. <%= question.choice_d %></li><% } %>
            </ul>
          <% } else if (qType === 'True or False') { %>
            <ul>
              <li>True</li>
              <li>False</li>
            </ul>
          <% } %>
          <p><strong>Correct Answer:</strong> <%= question.correct_answer %></p>
          <% if (qType === 'Essay' && question.essay_rubric_keywords) { %>
            <p><strong>Expected Answer:</strong> <%= question.essay_rubric_keywords %></p>
          <% } %>
        </article>
      <% }) %>
    </div>
  </section>
</section>