<%# ANNOTATED COPY FOR DEFENSE REVIEW | File: views/content/admin-subjects.ejs | Purpose: UI template/view used by the system. %>
<section class="page-stack">
  <div class="toolbar-card split compact-top-actions">
    <div class="row-actions">
      <% if (currentUser.role === 'admin') { %>
        <button type="button" class="btn btn-secondary" data-modal-target="#archived-subjects">Recover</button>
        <button type="button" class="btn btn-primary" data-modal-target="#add-subject">Add Subject</button>
      <% } else { %>
        <span class="empty-state">Admin only can add or archive subjects.</span>
      <% } %>
    </div>
  </div>
  <div class="subject-grid">
    <% subjects.filter((subject) => !subject.is_archived).forEach((subject) => { %>
      <article class="subject-card"><div class="subject-card-body"><h3><a href="<%= basePath %>/subjects/<%= subject.id %>"><%= subject.name %></a></h3><p class="subject-card-meta">Manage subject details, tutors, and enrolled students.</p></div><% if (currentUser.role === 'admin') { %><div class="row-actions"><form method="post" action="<%= basePath %>/subjects/<%= subject.id %>/archive"><button class="btn btn-secondary btn-sm" type="submit">Archive</button></form></div><% } %></article>
    <% }) %>
  </div>
  <div class="global-modal" id="add-subject"><div class="global-modal-card small"><button type="button" class="modal-close" data-close-modal>&times;</button><h3>Add Subject</h3><form method="post" action="<%= basePath %>/subjects/add" class="stack-form"><label>Subject Name<input type="text" name="name" required oninput="this.value=this.value.toUpperCase()" title="Subject names are saved in uppercase" /></label><button class="btn btn-primary" type="submit">Save Subject</button></form></div></div>
  <div class="global-modal" id="archived-subjects"><div class="global-modal-card wide"><button type="button" class="modal-close" data-close-modal>&times;</button><h3>Archived Subjects</h3><div class="table-wrap"><table><thead><tr><th>Subject</th><th>View</th><th>Recover</th></tr></thead><tbody><% if (!archivedSubjects.length) { %><tr><td colspan="3">No archived subjects.</td></tr><% } %><% archivedSubjects.forEach((subject) => { %><tr><td><%= subject.name %></td><td><a class="btn btn-secondary btn-sm" href="<%= basePath %>/subjects/<%= subject.id %>">View</a></td><td><form method="post" action="<%= basePath %>/subjects/<%= subject.id %>/recover"><button class="btn btn-primary btn-sm" type="submit">Recover</button></form></td></tr><% }) %></tbody></table></div></div></div>
</section>
