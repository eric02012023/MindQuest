<%# File: views/content/admin-profile-list.ejs
    Purpose: Student Profiles and Tutor Profiles — one row list, one template.

    The two lists differ only in which role they pin and which two columns are
    worth showing (a student's year level and tutor count; a tutor's subject and
    learner count). Everything else — the toolbar, the row, the actions, the
    pager — is identical, so keeping them as two templates would have been two
    copies waiting to drift.

    Locals: listRole ('student' | 'tutor'), users, pager, archivedUsers,
            yearLevelOptions, selectedYearLevel, search, query %>
<%
  const isTutorList = listRole === 'tutor';
  const listPath = `${basePath}/${isTutorList ? 'tutors' : 'students'}`;
  const heading = isTutorList ? 'Tutor profiles' : 'Student profiles';
  const pagerState = typeof pager === 'undefined' ? null : pager;
  const currentQuery = typeof query === 'undefined' ? {} : query;
%>
<section class="mq-page">

  <form class="mq-toolbar" method="get" action="<%= listPath %>">
    <div class="mq-filters">
      <label class="mq-field mq-field-search">
        <span>Search</span>
        <input type="search" name="search" value="<%= search || '' %>"
               placeholder="<%= isTutorList ? 'Tutor name, ID or email' : 'Student name, ID or email' %>" />
      </label>

      <% if (currentUser.role === 'admin') { %>
        <label class="mq-field">
          <span>Branch</span>
          <select name="branch_id" onchange="this.form.submit()">
            <option value="all">All branches</option>
            <% branches.forEach((branch) => { %>
              <option value="<%= branch.id %>" <%= Number(effectiveBranchId) === Number(branch.id) ? 'selected' : '' %>><%= branch.name %></option>
            <% }) %>
          </select>
        </label>
      <% } %>

      <label class="mq-field">
        <span>Year level</span>
        <select name="year_level" onchange="this.form.submit()">
          <option value="all" <%= selectedYearLevel === 'all' ? 'selected' : '' %>>All levels</option>
          <% (yearLevelOptions || []).forEach((level) => { %>
            <option value="<%= level %>" <%= selectedYearLevel === level ? 'selected' : '' %>><%= level %></option>
          <% }) %>
        </select>
      </label>

      <button class="mq-btn" type="submit"><%- icon('search') %> Search</button>
    </div>

    <div class="mq-toolbar-actions">
      <button type="button" class="mq-btn" data-modal-target="#archived-profiles-modal"><%- icon('archive') %> Archive</button>
      <a class="mq-btn" href="<%= basePath %>/users"><%- icon('user') %> User management</a>
    </div>
  </form>

  <section class="mq-panel">
    <div class="mq-panel-head">
      <div>
        <h2><%= heading %></h2>
        <p><%= isTutorList
          ? 'Every tutor in scope, with the subjects and learners they carry.'
          : 'Every learner in scope, with their level and assigned tutors.' %></p>
      </div>
      <span class="mq-count"><%= pagerState ? pagerState.total : users.length %> total</span>
    </div>

    <div class="mq-table" style="--mq-cols: 120px minmax(180px, 2fr) 1fr 130px 90px 90px 96px;">
      <div class="mq-head">
        <span><%= isTutorList ? 'Tutor ID' : 'Student ID' %></span>
        <span>Name</span>
        <span>Branch</span>
        <span><%= isTutorList ? 'Expertise' : 'Year level' %></span>
        <span class="mq-num">Subjects</span>
        <span class="mq-num"><%= isTutorList ? 'Learners' : 'Tutors' %></span>
        <span style="text-align:right;">Actions</span>
      </div>

      <% if (!users.length) { %>
        <div class="mq-empty">
          <strong>No <%= isTutorList ? 'tutors' : 'students' %> found</strong>
          Try a different search term, or clear the filters above.
        </div>
      <% } %>

      <% users.forEach((person) => {
           const expertise = isTutorList
             ? [...new Set([
                 ...String(person.year_level || '').split(',').map((item) => item.trim()).filter(Boolean),
                 ...safeJsonArray(person.extra?.year_levels || [])
               ])].filter(Boolean)
             : []; %>
        <div class="mq-row">
          <span class="mq-cell mq-sub" data-label="ID"><%= person.user_id %></span>

          <span class="mq-cell mq-cell-primary" data-label="Name">
            <a class="mq-name" href="<%= basePath %>/profile/<%= person.id %>"><%= titleCaseName(person.first_name) %> <%= titleCaseName(person.last_name) %></a>
            <span class="mq-sub"><%= person.email || person.contact_number || '—' %></span>
          </span>

          <span class="mq-cell" data-label="Branch"><%= person.branch_name || '—' %></span>

          <span class="mq-cell mq-sub" data-label="<%= isTutorList ? 'Expertise' : 'Year level' %>">
            <% if (isTutorList) { %>
              <%= expertise.length ? expertise.join(', ') : '—' %>
            <% } else { %>
              <%= person.grade_level || person.year_level || '—' %>
            <% } %>
          </span>

          <span class="mq-cell mq-num" data-label="Subjects"><%= person.subject_count %></span>
          <span class="mq-cell mq-num" data-label="<%= isTutorList ? 'Learners' : 'Tutors' %>"><%= person.partner_count %></span>

          <span class="mq-cell mq-cell-actions">
            <a class="mq-icon" href="<%= basePath %>/profile/<%= person.id %>" title="Open full profile" aria-label="Open full profile"><%- icon('view') %></a>
            <a class="mq-icon" href="<%= basePath %>/analytics?search=<%= encodeURIComponent(`${person.first_name} ${person.last_name}`) %>" title="Analytics for this person" aria-label="Analytics for this person"><%- icon('chart') %></a>
            <form method="post" action="<%= basePath %>/users/<%= person.id %>/archive" data-confirm-message="Archive <%= titleCaseName(person.first_name) %> <%= titleCaseName(person.last_name) %>?">
              <button class="mq-icon mq-icon-danger" type="submit" title="Archive" aria-label="Archive"><%- icon('archive') %></button>
            </form>
          </span>
        </div>
      <% }) %>

      <% if (pagerState) { %>
        <%- include('../partials/mq-pager', { pager: pagerState, baseUrl: listPath, params: currentQuery, noun: isTutorList ? 'tutor' : 'student' }) %>
      <% } %>
    </div>
  </section>

  <div class="global-modal" id="archived-profiles-modal">
    <div class="global-modal-card wide">
      <button type="button" class="modal-close" data-close-modal>&times;</button>
      <h3>Archived <%= isTutorList ? 'tutors' : 'students' %></h3>
      <div class="mq-table" style="--mq-cols: 120px minmax(160px,2fr) 1fr 96px;">
        <div class="mq-head">
          <span>ID</span><span>Name</span><span>Branch</span><span style="text-align:right;">Recover</span>
        </div>
        <% if (!archivedUsers.length) { %>
          <div class="mq-empty">Nothing archived.</div>
        <% } %>
        <% archivedUsers.forEach((person) => { %>
          <div class="mq-row">
            <span class="mq-cell mq-sub" data-label="ID"><%= person.user_id %></span>
            <span class="mq-cell mq-name" data-label="Name"><%= titleCaseName(person.first_name) %> <%= titleCaseName(person.last_name) %></span>
            <span class="mq-cell" data-label="Branch"><%= person.branch_name || '—' %></span>
            <span class="mq-cell mq-cell-actions">
              <form method="post" action="<%= basePath %>/users/<%= person.id %>/recover" data-confirm-message="Recover this archived record?">
                <button class="mq-icon" type="submit" title="Recover" aria-label="Recover"><%- icon('restore') %></button>
              </form>
            </span>
          </div>
        <% }) %>
      </div>
    </div>
  </div>

</section>
