<%# File: views/content/student-assessment-take.ejs | Purpose: Assessment taking page with anti-cheat and auto-save %>
<section class="page-stack">
  <section class="panel-card">
    <div class="panel-card-head"><h2><%= assessment.title %></h2><p><%= assessment.assessment_origin === 'ai_generated' ? 'AI Generated' : assessment.assessment_type %> assessment</p></div>
    <% if (assessment.result) { %>
      <% const submittedAnswers = assessment.submittedAnswers || {}; %>
      <div class="stat-grid assessment-result-grid">
        <article class="stat-card"><h3>Score</h3><strong><%= assessment.result.score %> / <%= assessment.result.total_questions %></strong></article>
        <article class="stat-card"><h3>Percentage</h3><strong><%= assessment.result.percentage %>%</strong></article>
        <article class="stat-card gradient"><h3>Level</h3><strong><%= assessment.result.level %></strong></article>
      </div>

      <div style="margin:16px 0 20px;padding:12px;background:var(--bg-2);border-radius:8px;">
        <p style="margin:0;color:var(--text-soft);"><strong>✅ Assessment Completed.</strong> Each assessment can only be taken once. A follow-up review module has been generated based on your result level.</p>
      </div>

      <section class="panel-card" style="margin-top:16px;">
        <div class="panel-card-head"><h3>Answer Review</h3><p>Check your submitted answer versus the correct answer.</p></div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr><th>#</th><th>Question</th><th>Your Answer</th><th>Correct Answer</th><th>Result</th></tr>
            </thead>
            <tbody>
              <% assessment.questions.forEach((question, index) => { %>
                <% const selected = String(submittedAnswers[String(question.id)] || submittedAnswers[question.id] || '').trim(); %>
                <% const qType = String(question.question_type || 'Multiple Choice').trim(); %>
                <% const correct = String(question.correct_answer || '').trim(); %>
                <%
                  let isCorrect = false;
                  let studentDisplay = selected || 'No answer';
                  let correctDisplay = correct;

                  if (qType === 'Multiple Choice') {
                    const selectedUpper = selected.toUpperCase();
                    const correctUpper = correct.toUpperCase();
                    isCorrect = !!(selectedUpper && correctUpper && selectedUpper === correctUpper);
                    studentDisplay = selectedUpper ? (selectedUpper + '. ' + (question['choice_' + selectedUpper.toLowerCase()] || '')) : 'No answer';
                    correctDisplay = correctUpper + '. ' + (question['choice_' + correctUpper.toLowerCase()] || '');
                  } else if (qType === 'True or False') {
                    isCorrect = selected.toLowerCase() === correct.toLowerCase();
                  } else if (qType === 'Fill in the Blank') {
                    isCorrect = !!(selected && correct && selected.toLowerCase() === correct.toLowerCase());
                  } else if (qType === 'Essay') {
                    // Essay is AI graded - show as scored based on result
                    isCorrect = false; // can't easily determine from review table
                    correctDisplay = '(AI graded)';
                  } else {
                    isCorrect = selected.toLowerCase() === correct.toLowerCase();
                  }
                %>
                <tr>
                  <td><%= index + 1 %></td>
                  <td><%= question.question_text %><br><small class="badge badge-info"><%= qType %></small></td>
                  <td><%= studentDisplay %></td>
                  <td><%= correctDisplay %></td>
                  <td><span class="badge <%= isCorrect ? 'badge-success' : 'badge-danger' %>"><%= isCorrect ? 'Correct' : 'Wrong' %></span></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </section>
    <% } else { %>
      <%# Anti-cheat warning banner %>
      <div class="panel-card" style="background:linear-gradient(135deg,#ff6b35 0%,#f7c948 100%);color:#fff;padding:16px;margin-bottom:16px;border-radius:8px;">
        <h4 style="margin:0 0 8px;">⚠️ Assessment Anti-Cheat Policy</h4>
        <p style="margin:0;font-size:0.9rem;">Do <strong>NOT</strong> switch tabs, minimize the browser, or navigate away during this assessment. Violations are tracked and may result in <strong>automatic submission</strong> of your current answers.</p>
      </div>

      <form id="assessmentForm" method="post" action="/student/assessments/<%= assessment.id %>/submit" class="stack-form">
        <input type="hidden" name="time_started" value="<%= Date.now() %>" />
        <input type="hidden" name="auto_submitted" id="autoSubmittedFlag" value="0" />
        <input type="hidden" name="auto_submit_reason" id="autoSubmitReason" value="" />
        <% assessment.questions.forEach((question, index) => { %>
          <article class="question-view-card">
            <h4><%= index + 1 %>. <%= question.question_text %></h4>
            <% if (question.question_type === 'True or False') { %>
              <input type="hidden" name="question_ids[]" value="<%= question.id %>" />
              <label><input type="radio" name="answer_<%= question.id %>" value="true" /> True</label>
              <label><input type="radio" name="answer_<%= question.id %>" value="false" /> False</label>
            <% } else if (question.question_type === 'Identification' || question.question_type === 'Fill in the Blank') { %>
              <input type="hidden" name="question_ids[]" value="<%= question.id %>" />
              <label>Your Answer<input type="text" name="answer_<%= question.id %>" placeholder="Type your answer here" /></label>
            <% } else if (question.question_type === 'Essay') { %>
              <input type="hidden" name="question_ids[]" value="<%= question.id %>" />
              <label>Your Answer<textarea name="answer_<%= question.id %>" rows="4" placeholder="Write your answer here..."></textarea></label>
            <% } else { %>
              <input type="hidden" name="question_ids[]" value="<%= question.id %>" />
              <label><input type="radio" name="answer_<%= question.id %>" value="A" /> A. <%= question.choice_a %></label>
              <label><input type="radio" name="answer_<%= question.id %>" value="B" /> B. <%= question.choice_b %></label>
              <% if (question.choice_c) { %><label><input type="radio" name="answer_<%= question.id %>" value="C" /> C. <%= question.choice_c %></label><% } %>
              <% if (question.choice_d) { %><label><input type="radio" name="answer_<%= question.id %>" value="D" /> D. <%= question.choice_d %></label><% } %>
            <% } %>
          </article>
        <% }) %>
        <button class="btn btn-primary" type="submit">Submit Assessment</button>
      </form>

      <%# Tab-switch warning modal (custom, replaces browser popup) — inescapable %>
      <div class="global-modal" id="tab-switch-warning-modal" data-no-backdrop-close>
        <div class="global-modal-card small">
          <h3>⚠️ Warning: You will switch Tabs</h3>
          <p style="line-height:1.6;">When you leave the assessment, your current answers will be automatically saved. Your score will be based only on the correct answers you answered before you left.</p>
          <div class="confirm-actions" style="margin-top:16px;display:grid;gap:10px;">
            <button type="button" class="btn btn-secondary" id="tabSwitchStay" style="width:100%;">Cancel — Stay on Assessment</button>
            <button type="button" class="btn btn-primary" id="tabSwitchAccept" style="width:100%;background:#e74c3c;border-color:#e74c3c;">Accept — Auto Save</button>
          </div>
        </div>
      </div>

      <%# Auto-save loading modal %>
      <div class="global-modal" id="autosave-loading-modal" data-no-backdrop-close>
        <div class="global-modal-card small" style="text-align:center;">
          <h3>Saving your assessment...</h3>
          <div class="mqtc-dot-loader" style="display:flex;gap:8px;justify-content:center;margin:20px 0;">
            <span style="width:14px;height:14px;border-radius:50%;background:var(--primary,#1a5632);animation:mqtcDotBounce 1.2s infinite ease-in-out;"></span>
            <span style="width:14px;height:14px;border-radius:50%;background:var(--primary,#1a5632);animation:mqtcDotBounce 1.2s infinite ease-in-out;animation-delay:0.15s;"></span>
            <span style="width:14px;height:14px;border-radius:50%;background:var(--primary,#1a5632);animation:mqtcDotBounce 1.2s infinite ease-in-out;animation-delay:0.3s;"></span>
          </div>
          <p style="color:var(--text-soft);">Please wait while we save your current answers...</p>
        </div>
      </div>

      <script>
      (function() {
        var assessmentId = '<%= assessment.id %>';
        var isModalOpen = false;
        var isSubmitting = false;
        var pendingNavigationUrl = null;

        function logViolationToServer(eventType) {
          try {
            var data = JSON.stringify({
              assessment_id: assessmentId,
              event_type: eventType,
              event_detail: 'tab_switch_warning'
            });
            if (navigator.sendBeacon) {
              navigator.sendBeacon('/student/assessments/' + assessmentId + '/anti-cheat', new Blob([data], { type: 'application/json' }));
            }
          } catch(e) {}
        }

        function doAutoSave() {
          if (isSubmitting) return;
          isSubmitting = true;
          // Close warning modal, open loading modal
          var warnModal = document.getElementById('tab-switch-warning-modal');
          if (warnModal) warnModal.classList.remove('is-open');
          var loadModal = document.getElementById('autosave-loading-modal');
          if (loadModal) loadModal.classList.add('is-open');

          // Remove the beforeunload handler so we don't get browser popup
          window.onbeforeunload = null;

          // Set auto-save flags
          var flagEl = document.getElementById('autoSubmittedFlag');
          if (flagEl) flagEl.value = '1';
          var reasonEl = document.getElementById('autoSubmitReason');
          if (reasonEl) reasonEl.value = 'tab_switch_accepted';

          logViolationToServer('tab_switch_accepted');

          // Submit the form natively (this sends all form data including partial answers)
          var form = document.getElementById('assessmentForm');
          if (form) {
            // Brief delay to show loading UI
            setTimeout(function() { form.submit(); }, 500);
          }
        }

        function showTabSwitchModal(isRealTabSwitch) {
          if (isModalOpen || isSubmitting) return;
          isModalOpen = true;
          var modal = document.getElementById('tab-switch-warning-modal');
          var stayBtn = document.getElementById('tabSwitchStay');
          var title = modal ? modal.querySelector('h3') : null;
          
          if (isRealTabSwitch) {
            if (stayBtn) stayBtn.style.display = 'none';
            if (title) title.innerText = '⚠️ Tab Switch Detected';
            // Hide the form so they can't peek at questions
            var form = document.getElementById('assessmentForm');
            if (form) form.style.visibility = 'hidden';
          } else {
            if (stayBtn) stayBtn.style.display = 'block';
            if (title) title.innerText = '⚠️ Warning: You are leaving the assessment';
          }
          
          if (modal) modal.classList.add('is-open');
        }

        // Stay on assessment button
        var stayBtn = document.getElementById('tabSwitchStay');
        if (stayBtn) {
          stayBtn.addEventListener('click', function() {
            isModalOpen = false;
            pendingNavigationUrl = null;
            var modal = document.getElementById('tab-switch-warning-modal');
            if (modal) modal.classList.remove('is-open');
          });
        }

        // Accept — auto-save button
        var acceptBtn = document.getElementById('tabSwitchAccept');
        if (acceptBtn) {
          acceptBtn.addEventListener('click', function() {
            doAutoSave();
          });
        }

        // Listen for tab switch / visibility change
        document.addEventListener('visibilitychange', function() {
          if (document.hidden && !isSubmitting) {
            showTabSwitchModal(true);
          }
        });

        window.addEventListener('blur', function() {
          if (!isSubmitting) showTabSwitchModal(true);
        });

        // Use custom beforeunload that we can disable
        window.onbeforeunload = function(e) {
          if (isSubmitting) return undefined; // allow navigation during submit
          // The browser may still show its own popup for external navigation
          e.preventDefault();
          e.returnValue = '';
          return '';
        };

        // Intercept ALL link clicks (internal navigation) to show warning modal
        document.addEventListener('click', function(e) {
          if (isSubmitting) return;
          var link = e.target.closest('a[href]');
          if (link && link.getAttribute('href') && link.getAttribute('href') !== '#') {
            // Allow close-modal buttons inside the tab-switch modal itself
            if (link.closest('#tab-switch-warning-modal') || link.closest('#autosave-loading-modal')) return;
            e.preventDefault();
            e.stopPropagation();
            pendingNavigationUrl = link.getAttribute('href');
            showTabSwitchModal(false);
          }
        }, true);

        // Intercept sidebar navigation with capture phase
        document.querySelectorAll('.sidebar-nav a').forEach(function(link) {
          link.addEventListener('click', function(e) {
            if (isSubmitting) return;
            e.preventDefault();
            e.stopPropagation();
            pendingNavigationUrl = link.getAttribute('href');
            showTabSwitchModal(false);
          }, true);
        });

        // Block keyboard shortcuts (Ctrl+W, Ctrl+T, etc.) — show modal
        document.addEventListener('keydown', function(e) {
          if (isSubmitting) return;
          // Block Escape key from closing the modal
          if (e.key === 'Escape' && isModalOpen) {
            e.preventDefault();
            e.stopPropagation();
            return;
          }
        }, true);

        // Intercept browser back/forward navigation
        window.addEventListener('popstate', function(e) {
          if (isSubmitting) return;
          // Push the state back to prevent navigation
          history.pushState(null, '', window.location.href);
          showTabSwitchModal();
        });

        // Push initial state so popstate works
        history.pushState(null, '', window.location.href);
      })();
      </script>
    <% } %>
  </section>
</section>