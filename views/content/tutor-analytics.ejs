<%# File: views/content/tutor-analytics.ejs | Purpose: Analytics & Reports page for Tutors %>
<section class="page-stack">
  <div class="toolbar-card split">
    <h2>Analytics & Reports</h2>
    <form class="search-form inline-row" method="get" action="">
      <input type="text" name="search" value="<%= search || '' %>" placeholder="Search student..." />
      <button class="btn btn-primary btn-sm" type="submit">Search</button>
      <% if (search) { %><a class="btn btn-secondary btn-sm" href="/tutor/analytics">Clear</a><% } %>
    </form>
  </div>

  <div class="billing-summary-grid">
    <article class="stat-card gradient"><h3>My Students</h3><strong><%= summary.totalStudents %></strong></article>
    <article class="stat-card"><h3>Avg Score</h3><strong><%= summary.avgScore %>%</strong></article>
    <article class="stat-card"><h3>Active Learners</h3><strong><%= summary.completedStudents %></strong></article>
    <article class="stat-card"><h3>Pending Requests</h3><strong><%= summary.pendingRequests %></strong></article>
  </div>

  <section class="panel-card">
    <div class="panel-card-head"><h3>Student Progress</h3></div>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Student</th>
            <th>Subjects</th>
            <th>Level</th>
            <th>Score</th>
            <th>Modules Read</th>
            <th>Completed Cycles</th>
            <th>Current Module</th>
            <th>Violations</th>
          </tr>
        </thead>
        <tbody>
          <% if (!students.length) { %><tr><td colspan="8">No students assigned yet.</td></tr><% } %>
          <% students.forEach((student) => { %>
            <tr>
              <td><a href="/tutor/students/<%= student.id %>/analytics" class="student-name-link"><strong><%= student.full_name %></strong></a><br><small class="empty-state"><%= student.branch_name || '' %></small></td>
              <td><%= student.subjects %></td>
              <td>
                <span class="badge badge-<%= student.current_level === 'Advance' ? 'success' : student.current_level === 'Intermediate' ? 'info' : 'warning' %>">
                  <%= student.current_level %>
                </span>
              </td>
              <td><%= student.avg_score %></td>
              <td><%= student.modules_read %></td>
              <td><%= student.completed_modules %></td>
              <td><%= student.current_module %></td>
              <td>
                <% if (student.total_violations > 0) { %>
                  <span class="badge badge-danger"><%= student.total_violations %></span>
                <% } else { %>
                  —
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
</section>
