<%# File: views/content/admin-notification-archives.ejs
    Purpose: View Archived Notifications (the ☰ menu) — registrations that were
    archived, and payment updates archived from the Notifications page. Either
    can be recovered back to the Notifications page.

    Locals: archivedNotifications, archivedAlerts %>
<% const archivedUpdates = typeof archivedAlerts === 'undefined' ? [] : (archivedAlerts || []); %>
<section class="page-stack">
  <section class="panel-card">
    <div class="panel-card-head">
      <h2>Archived Registrations</h2>
      <span class="badge badge-info"><%= archivedNotifications.length %></span>
    </div>
    <div class="list-stack">
      <% if (!archivedNotifications.length) { %>
        <p class="empty-state">No archived registrations.</p>
      <% } %>
      <% archivedNotifications.forEach((item) => { %>
        <article class="list-card compact">
          <div>
            <%# The row carries notification_title; `title` never existed, so every
                archived card used to render with an empty heading. %>
            <h3><%= item.notification_title || (item.submission_type === 'tutor' ? 'Tutor Application' : 'Learner Registration') %></h3>
            <p><%= item.first_name %> <%= item.last_name %> - <%= item.branch_name || '-' %></p>
          </div>
          <form method="post" action="<%= basePath %>/notifications/<%= item.id %>/recover" data-confirm-message="Recover this registration to the Notifications page?">
            <button type="submit" class="btn btn-primary btn-sm">Recover</button>
          </form>
        </article>
      <% }) %>
    </div>
  </section>

  <section class="panel-card">
    <div class="panel-card-head">
      <h2>Archived Payment Updates</h2>
      <span class="badge badge-info"><%= archivedUpdates.length %></span>
    </div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>When</th><th data-search-col>Update</th><th>Branch</th><th>Recover</th></tr></thead>
        <tbody>
          <% if (!archivedUpdates.length) { %><tr><td colspan="4">No archived payment updates.</td></tr><% } %>
          <% archivedUpdates.forEach((alert) => { %>
            <tr>
              <td><%= formatDateTime(alert.created_at) %></td>
              <td><strong><%= alert.title %></strong><br /><small><%= alert.message || '' %></small></td>
              <td><%= alert.branch_name || 'All' %></td>
              <td>
                <form method="post" action="<%= basePath %>/alerts/<%= alert.id %>/recover">
                  <button type="submit" class="btn btn-secondary btn-sm">Recover</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
</section>
