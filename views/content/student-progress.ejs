<%# File: views/content/student-progress.ejs
    Purpose: My Progress — the student's level, modules, scores and assessment
    history in every subject they are enrolled in.

    Built from getStudentAnalytics, which reads what the system records today
    (modules opened, every submitted assessment, the level on record). It used
    to read the retired first-generation tables, so nobody's progress showed.

    Locals: subjects (one analytics record per enrolled subject, with
            .assignment), assignments %>
<%
  const subjectList = subjects || [];
  const allTaken = subjectList.flatMap((s) => (s.attempts || []).filter((row) => row.percentage != null));
  const overallAvg = allTaken.length
    ? (allTaken.reduce((sum, row) => sum + Number(row.percentage || 0), 0) / allTaken.length).toFixed(1)
    : null;
  const modulesOpened = subjectList.reduce((sum, s) => sum + Number(s.stats.totalModulesRead || 0), 0);
  const modulesTotal = subjectList.reduce((sum, s) => sum + Number(s.stats.totalModules || 0), 0);
  const levelled = subjectList.filter((s) => s.stats.preAssessment).length;
  const kindLabel = (row) => (row.assessment_type === 'pre' ? 'Pre-Assessment'
    : row.assessment_type === 'post' ? 'Post-Assessment' : 'Module activity');
  const levelClass = (level) => String(level || '').toLowerCase().replace(/\s+/g, '-');
%>
<section class="page-stack student-progress">

  <%# ---- Overview ---------------------------------------------------------- %>
  <section class="panel-card">
    <div class="panel-card-head"><h2>My Progress</h2></div>

    <div class="sp-overview">
      <article class="sp-tile sp-tile-lead">
        <span class="sp-tile-label">Overall Average</span>
        <strong class="sp-tile-value"><%= overallAvg === null ? '—' : overallAvg + '%' %></strong>
        <span class="sp-tile-foot"><%= allTaken.length %> assessment<%= allTaken.length === 1 ? '' : 's' %> taken</span>
      </article>
      <article class="sp-tile">
        <span class="sp-tile-label">Subjects</span>
        <strong class="sp-tile-value"><%= (assignments || []).length %></strong>
        <span class="sp-tile-foot">enrolled</span>
      </article>
      <article class="sp-tile">
        <span class="sp-tile-label">Modules Opened</span>
        <strong class="sp-tile-value"><%= modulesOpened %><% if (modulesTotal) { %><small> / <%= modulesTotal %></small><% } %></strong>
        <span class="sp-tile-foot">across all subjects</span>
      </article>
      <article class="sp-tile">
        <span class="sp-tile-label">Pre-Assessments Done</span>
        <strong class="sp-tile-value"><%= levelled %><small> / <%= subjectList.length %></small></strong>
        <span class="sp-tile-foot">subjects levelled</span>
      </article>
    </div>
  </section>

  <% if (!subjectList.length) { %>
    <section class="panel-card">
      <div class="sp-blank">
        <span class="sp-blank-icon" aria-hidden="true">📊</span>
        <h3>No subjects yet</h3>
        <a href="/student/subjects" class="btn btn-primary">Go to My Subjects</a>
      </div>
    </section>
  <% } %>

  <%# ---- One card per subject ---------------------------------------------- %>
  <% subjectList.forEach((s) => {
       const st = s.stats;
       const pre = st.preAssessment;
       const post = st.postAssessment;
       const done = s.completion || {};
       const modulePct = st.totalModules ? Math.round((st.totalModulesRead / st.totalModules) * 100) : 0; %>
    <section class="panel-card">
      <div class="panel-card-head">
        <h3><a href="/student/subjects/<%= s.subject.id %>"><%= s.subject.name %></a></h3>
        <span class="level-badge <%= levelClass(st.currentLevel) %>"><%= st.currentLevel %></span>
      </div>

      <div class="sp-ring-row">
        <div class="sp-ring" style="--pct: <%= pre ? Number(pre.percentage) || 0 : 0 %>">
          <div class="sp-ring-inner"><span><%= pre ? Number(pre.percentage || 0).toFixed(0) + '%' : '—' %></span></div>
        </div>
        <div class="sp-ring-label">
          <span>Pre-Assessment Score</span>
          <strong><%= pre ? `${Number(pre.score)}/${Number(pre.total_points)}` : 'Not taken yet' %></strong>
        </div>
      </div>

      <div class="sp-metric-row">
        <div class="sp-metric">
          <span class="sp-metric-num"><%= st.totalModulesRead %>/<%= st.totalModules %></span>
          <span class="sp-metric-label">Modules Opened</span>
        </div>
        <div class="sp-metric">
          <span class="sp-metric-num"><%= done.assessmentsDone || 0 %>/<%= done.assessmentsTotal || 0 %></span>
          <span class="sp-metric-label">Activities Done</span>
        </div>
        <div class="sp-metric sp-metric-accent">
          <span class="sp-metric-num"><%= st.completedAssessments ? st.avgPercentage + '%' : '—' %></span>
          <span class="sp-metric-label">Average Score</span>
        </div>
        <div class="sp-metric">
          <span class="sp-metric-num"><%= post ? Number(post.percentage).toFixed(0) + '%' : '—' %></span>
          <span class="sp-metric-label">Post-Assessment</span>
        </div>
        <div class="sp-metric <%= Number(st.totalViolations) ? 'sp-metric-warn' : '' %>">
          <span class="sp-metric-num"><%= st.totalViolations %></span>
          <span class="sp-metric-label">Violations</span>
        </div>
      </div>

      <div class="sp-progress-track" aria-label="Modules opened">
        <span class="sp-progress-fill" style="width: <%= Math.max(0, Math.min(100, modulePct)) %>%"></span>
      </div>

      <h4 class="sp-subhead">Assessment History</h4>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th data-search-col>Assessment</th><th>Type</th><th>Score</th><th>Percentage</th><th>Level</th><th>Taken</th></tr>
          </thead>
          <tbody>
            <% if (!s.assessments.length) { %>
              <tr><td colspan="6">No assessment has been taken in this subject yet.</td></tr>
            <% } %>
            <% s.assessments.forEach((a) => { %>
              <tr>
                <td>
                  <% if (a.submission_id) { %>
                    <a href="/student/results/<%= a.submission_id %>"><strong><%= a.title %></strong></a>
                  <% } else { %>
                    <a href="/student/tutor-assessments/<%= a.id %>"><strong><%= a.title %></strong></a>
                  <% } %>
                  <% if (a.source_module_title) { %><br /><small><%= a.source_module_title %></small><% } %>
                </td>
                <td><%= kindLabel(a) %></td>
                <td><%= a.score != null ? `${Number(a.score)}/${Number(a.total_questions)}` : '—' %></td>
                <td><%= a.percentage != null ? Number(a.percentage).toFixed(1) + '%' : '—' %></td>
                <td><%= a.level || '—' %></td>
                <td><%= a.taken_at ? formatDateTime(a.taken_at) : 'Not taken yet' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>
  <% }) %>
</section>

<style>
  .sp-tile-value small { font-size: .55em; font-weight: 600; opacity: .7; }
  .sp-progress-track {
    height: 8px; border-radius: 999px; background: rgba(28, 154, 34, .12);
    overflow: hidden; margin: 4px 0 14px;
  }
  .sp-progress-fill { display: block; height: 100%; border-radius: inherit; background: #1c9a22; }
  .level-badge.not-assessed { background: #eef1f4; color: #5f7084; }
</style>
