<%# File: views/content/student-progress.ejs
    Purpose: My Progress — the student's level, score and attempt history per
    subject.

    This page absorbed the old "Analytics & Reports" page. Both were built from
    the same two sources (student_subject_levels and the submissions), and both
    answered "how am I doing in this subject?", so they are one page: the level
    and Pre-Assessment score at the top, then the counters and the attempt
    history for each enrolled subject underneath. %>
<%
  const progressList = progress || [];
  const analyticsList = subjects || [];

  // Overall figures across every subject, so the page opens with an answer
  // rather than making the student add the cards up themselves.
  const allSubmissions = progressList.flatMap((p) => p.submissions || []);
  const overallAvg = allSubmissions.length
    ? (allSubmissions.reduce((sum, s) => sum + Number(s.percentage || 0), 0) / allSubmissions.length).toFixed(1)
    : null;
  const modulesRead = analyticsList.reduce((sum, s) => sum + Number(s.stats.totalModulesRead || 0), 0);
%>
<section class="page-stack student-progress">

  <%# ---- Overview ---------------------------------------------------------- %>
  <section class="panel-card">
    <div class="panel-card-head">
      <div>
        <h2>My Progress</h2>
        <p>Your level, scores and assessment history across every subject.</p>
      </div>
    </div>

    <div class="sp-overview">
      <article class="sp-tile sp-tile-lead">
        <span class="sp-tile-label">Overall Average</span>
        <strong class="sp-tile-value"><%= overallAvg === null ? '—' : overallAvg + '%' %></strong>
        <span class="sp-tile-foot"><%= allSubmissions.length %> assessment<%= allSubmissions.length === 1 ? '' : 's' %> taken</span>
      </article>
      <article class="sp-tile">
        <span class="sp-tile-label">Subjects</span>
        <strong class="sp-tile-value"><%= (assignments || []).length %></strong>
        <span class="sp-tile-foot">enrolled</span>
      </article>
      <article class="sp-tile">
        <span class="sp-tile-label">Modules Read</span>
        <strong class="sp-tile-value"><%= modulesRead %></strong>
        <span class="sp-tile-foot">across all subjects</span>
      </article>
      <article class="sp-tile">
        <span class="sp-tile-label">Levelled Subjects</span>
        <strong class="sp-tile-value"><%= progressList.length %></strong>
        <span class="sp-tile-foot">Pre-Assessment done</span>
      </article>
    </div>
  </section>

  <%# ---- Level per subject ------------------------------------------------- %>
  <% if (!progressList.length) { %>
    <section class="panel-card">
      <div class="sp-blank">
        <span class="sp-blank-icon" aria-hidden="true">📊</span>
        <h3>No progress yet</h3>
        <p>Finish the Pre-Assessment in any subject and your level, score and history appear here.</p>
        <a href="/student/subjects" class="btn btn-primary">Go to My Subjects</a>
      </div>
    </section>
  <% } else { %>
    <section class="panel-card">
      <div class="panel-card-head">
        <h3>Your Level per Subject</h3>
        <span class="badge badge-info"><%= progressList.length %></span>
      </div>

      <div class="sp-grid">
        <% progressList.forEach((p) => { %>
          <article class="sp-card">
            <div class="sp-card-head">
              <h4><%= p.subject_name %></h4>
              <span class="level-badge <%= String(p.level || '').toLowerCase() %>"><%= p.level %></span>
            </div>
            <p class="sp-card-meta">Level assigned <%= new Date(p.assigned_at).toLocaleDateString() %></p>

            <div class="sp-ring-row">
              <div class="sp-ring" style="--pct: <%= Number(p.percentage) || 0 %>">
                <div class="sp-ring-inner"><span><%= Number(p.percentage || 0).toFixed(0) %>%</span></div>
              </div>
              <div class="sp-ring-label">
                <span>Pre-Assessment Score</span>
                <strong><%= p.score || 0 %>/<%= p.total_points || 0 %></strong>
              </div>
            </div>

            <div class="sp-stats-row">
              <div class="sp-stat">
                <span class="sp-stat-num"><%= p.totalSubmissions %></span>
                <span class="sp-stat-label">Assessments Taken</span>
              </div>
              <div class="sp-stat">
                <span class="sp-stat-num"><%= p.avgScore %>%</span>
                <span class="sp-stat-label">Average Score</span>
              </div>
            </div>

            <% if (p.assignedModule) { %>
              <a href="/student/modules/<%= p.assignedModule.id %>" class="btn btn-primary btn-sm sp-card-btn">View Module</a>
            <% } %>
          </article>
        <% }) %>
      </div>
    </section>
  <% } %>

  <%# ---- Per-subject detail (the old Analytics & Reports) ------------------- %>
  <% analyticsList.forEach((subjectData) => { %>
    <section class="panel-card">
      <div class="panel-card-head">
        <h3><%= subjectData.subject.name %></h3>
        <span class="level-badge <%= String(subjectData.stats.currentLevel || '').toLowerCase() %>">
          <%= subjectData.stats.currentLevel || 'Not levelled' %>
        </span>
      </div>

      <div class="sp-metric-row">
        <div class="sp-metric">
          <span class="sp-metric-num"><%= subjectData.stats.totalModulesRead %></span>
          <span class="sp-metric-label">Modules Read</span>
        </div>
        <div class="sp-metric">
          <span class="sp-metric-num"><%= subjectData.stats.completedAssessments %>/<%= subjectData.stats.totalAssessments %></span>
          <span class="sp-metric-label">Assessments</span>
        </div>
        <div class="sp-metric sp-metric-accent">
          <span class="sp-metric-num"><%= subjectData.stats.avgPercentage %>%</span>
          <span class="sp-metric-label">Average Score</span>
        </div>
        <div class="sp-metric">
          <span class="sp-metric-num"><%= subjectData.stats.currentRound %></span>
          <span class="sp-metric-label">Round</span>
        </div>
        <div class="sp-metric <%= Number(subjectData.stats.totalViolations) ? 'sp-metric-warn' : '' %>">
          <span class="sp-metric-num"><%= subjectData.stats.totalViolations %></span>
          <span class="sp-metric-label">Violations</span>
        </div>
      </div>

      <% if (subjectData.assessments.length) { %>
        <h4 class="sp-subhead">Assessment History</h4>
        <div class="table-wrap">
          <table>
            <thead>
              <tr><th>Assessment</th><th>Score</th><th>Percentage</th><th>Level</th><th>Taken</th></tr>
            </thead>
            <tbody>
              <% subjectData.assessments.forEach((a) => { %>
                <tr>
                  <td><strong><%= a.title %></strong></td>
                  <td><%= a.score != null ? a.score + '/' + a.total_questions : '—' %></td>
                  <td><%= a.percentage != null ? Number(a.percentage).toFixed(1) + '%' : '—' %></td>
                  <td><%= a.level || '—' %></td>
                  <td><%= a.taken_at ? formatDateTime(a.taken_at) : 'Not taken' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <p class="empty-state">No assessment has been taken in this subject yet.</p>
      <% } %>

      <% if (subjectData.learningCycles.length) { %>
        <h4 class="sp-subhead">Learning Cycles</h4>
        <div class="table-wrap">
          <table>
            <thead>
              <tr><th>Round</th><th>Module</th><th>Status</th><th>Level</th><th>Started</th></tr>
            </thead>
            <tbody>
              <% subjectData.learningCycles.forEach((c) => { %>
                <tr>
                  <td><%= c.round_number %></td>
                  <td><%= c.resource_title || '—' %></td>
                  <td><span class="badge badge-<%= c.status === 'completed' ? 'success' : 'info' %>"><%= String(c.status).replace(/_/g, ' ') %></span></td>
                  <td><%= c.result_level || '—' %></td>
                  <td><%= formatDateTime(c.started_at) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>
  <% }) %>

  <% if (!analyticsList.length && progressList.length) { %>
    <section class="panel-card">
      <p class="empty-state">No enrolled subject has analytics to show yet.</p>
    </section>
  <% } %>
</section>
