<%# ANNOTATED COPY FOR DEFENSE REVIEW | File: views/content/admin-subject-detail.ejs | Purpose: UI template/view used by the system. %>
<section class="page-stack">
  <div class="toolbar-card split">
    <h2><%= subject ? subject.name : 'Subject' %></h2>
  </div>

  <section class="panel-card">
    <div class="panel-card-head"><h3>Upload Module</h3></div>
    <% if (currentUser.role === 'admin') { %>
      <form method="post" action="<%= basePath %>/subjects/<%= subject.id %>/resources" enctype="multipart/form-data" class="stack-form">
        <label>Type of Module
          <select name="type_of_module" required>
            <option value="">— Select Education Level —</option>
            <option value="Pre School Level">Pre School</option>
            <option value="Primary Level">Primary</option>
            <option value="Junior High Level">Junior High</option>
            <option value="Senior High Level">Senior High</option>
          </select>
        </label>
        <label>Module Title<input type="text" name="title" required /></label>
        <label>Description<textarea name="description" rows="3"></textarea></label>
        <label>Attachment<input type="file" name="attachment" /></label>
        <button type="submit" class="btn btn-primary">Upload Module</button>
      </form>
    <% } else { %>
      <p class="empty-state">Assistant admin can view modules only.</p>
    <% } %>
  </section>

  <section class="panel-card">
    <div class="panel-card-head"><h3>List of Modules</h3></div>
    <div class="list-stack">
      <% if (!adminResources.length) { %><p class="empty-state">No posted module yet.</p><% } %>
      <% adminResources.forEach((resource) => { %>
        <article class="list-card">
          <div>
            <strong><%= resource.title %></strong>
            <% if (resource.type_of_module) { %><span class="badge badge-info" style="margin-left:8px;"><%= resource.type_of_module %></span><% } %>
            <% if (resource.module_origin === 'ai_generated') { %><span class="badge badge-success" style="margin-left:4px;">AI Generated</span><% } %>
            <p><%= resource.description || 'No description' %></p>
            <p><strong>Posted by:</strong> <% if (resource.module_origin === 'ai_generated') { %>System<% } else if (resource.created_by_role === 'admin_template') { %>Admin<% } else { %><%= resource.tutor_name %><% } %></p>
            <% if (resource.difficulty_level) { %><p><strong>Difficulty:</strong> <%= resource.difficulty_level %></p><% } %>
            <% if (resource.file_path || resource.content_text) { %><a href="/download/module/<%= resource.id %>" target="_blank">Open Module</a><% } %>
            <% if (resource.is_archived) { %><span class="badge badge-danger" style="margin-left:8px;">Archived</span><% } %>
          </div>
          <% if (currentUser.role === 'admin') { %>
            <div class="row-actions">
              <% if (!resource.is_archived) { %>
                <form method="post" action="<%= basePath %>/subjects/<%= subject.id %>/resources/<%= resource.id %>/archive" data-confirm-message="Archive this module?">
                  <button class="btn btn-secondary btn-sm" type="submit">Archive</button>
                </form>
              <% } else { %>
                <form method="post" action="<%= basePath %>/subjects/<%= subject.id %>/resources/<%= resource.id %>/recover" data-confirm-message="Recover this module?">
                  <button class="btn btn-primary btn-sm" type="submit">Recover</button>
                </form>
              <% } %>
            </div>
          <% } %>
        </article>
      <% }) %>
    </div>
  </section>

  <% if (currentUser.role === 'admin') { %>
  <section class="panel-card">
    <div class="panel-card-head"><h3>Create Assessment</h3></div>
    <form method="post" action="<%= basePath %>/subjects/<%= subject.id %>/assessments/create" class="stack-form">
      <div class="form-grid two-col">
        <label>Assessment Type
          <select name="assessment_type" required>
            <option value="pre">Pre-Assessment</option>
            <option value="post">Post-Assessment</option>
          </select>
        </label>
      </div>
      <div class="question-stack" data-question-stack>
        <div class="assessment-question-card" data-question-card>
          <div class="question-card-head"><strong>Question 1</strong></div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:15px;margin-bottom:10px;">
            <label>Question Type
              <select name="question_type" onchange="toggleQF(this)">
                <option value="Multiple Choice">Multiple Choice</option>
                <option value="True or False">True or False</option>
                <option value="Fill in the Blank">Fill in the Blank</option>
                <option value="Essay">Essay</option>
              </select>
            </label>
            <label>Source Module (Title)
              <select name="q_source_module_title">
                <option value="">— General / No Specific Module —</option>
                <% adminResources.forEach((r) => { %>
                  <option value="<%= r.title %>"><%= r.title %></option>
                <% }) %>
              </select>
            </label>
          </div>
          <label>Question<textarea name="question_text" rows="2" required></textarea></label>
          <div class="mc-fields">
            <label>Choice A<input type="text" name="choice_a" /></label>
            <label>Choice B<input type="text" name="choice_b" /></label>
            <label>Choice C<input type="text" name="choice_c" /></label>
            <label>Choice D<input type="text" name="choice_d" /></label>
          </div>
          <label>Correct Answer<input type="text" name="correct_answer" placeholder="e.g. A, True, or the answer text" required /></label>
          <label class="essay-field" style="display:none;">Expected Answer (for AI grading)<textarea name="essay_rubric_keywords" rows="2" placeholder="Write the expected answer idea..."></textarea></label>
        </div>
      </div>
      <div class="row-actions assessment-action-row">
        <button type="button" class="btn btn-secondary" onclick="addAQ()">Add Question</button>
        <button type="submit" class="btn btn-primary">Create Assessment</button>
      </div>
    </form>
  </section>
  <% } %>

  <section class="panel-card">
    <div class="panel-card-head"><h3>Subject Assessments</h3></div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Title</th><th>Type</th><th>Module</th><th>Student</th><th>Score</th><th>Status</th><th>Action</th></tr></thead>
        <tbody>
          <% if (!(subjectAssessments || []).length) { %><tr><td colspan="7">No assessments created yet.</td></tr><% } %>
          <% (subjectAssessments || []).forEach((sa) => { %>
            <tr>
              <td><%= sa.title %></td>
              <td><span class="badge badge-<%= sa.assessment_type === 'pre' ? 'info' : 'success' %>"><%= sa.assessment_type === 'pre' ? 'Pre' : 'Post' %></span></td>
              <td><%= sa.source_module_title || '-' %></td>
              <td><%= sa.first_name ? (sa.first_name + ' ' + (sa.last_name || '')) : 'All Students' %></td>
              <td><%= sa.score != null ? sa.score + '/' + sa.result_total : '-' %></td>
              <td><% if (sa.taken_at) { %><span class="badge badge-success">Taken</span><% } else if (sa.is_published) { %><span class="badge badge-info">Published</span><% } else { %><span class="badge badge-warning">Not Published</span><% } %></td>
              <td>
                <div class="row-actions wrap-row-actions">
                  <a class="btn btn-secondary btn-sm" href="<%= basePath %>/assessments/<%= sa.id %>">View</a>
                  <% if (!sa.is_published && currentUser.role === 'admin') { %>
                    <form method="post" action="<%= basePath %>/subjects/<%= subject.id %>/assessments/<%= sa.id %>/publish" data-confirm-message="Publish this assessment? Students will be able to take it."><button class="btn btn-primary btn-sm" type="submit">Publish</button></form>
                  <% } %>
                  <% if (sa.assessment_type === 'pre' && currentUser.role === 'admin') { %>
                    <form method="post" action="<%= basePath %>/subjects/<%= subject.id %>/assessments/<%= sa.id %>/copy-as-post" data-confirm-message="Copy this Pre-Assessment and publish it as a Post-Assessment for all enrolled students?"><button class="btn btn-success btn-sm" type="submit">Copy as Post</button></form>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>

  <script>
  var qc=1;
  function toggleQF(s){var c=s.closest('.assessment-question-card');if(!c)return;var t=s.value;var m=c.querySelector('.mc-fields');var e=c.querySelector('.essay-field');if(m)m.style.display=t==='Multiple Choice'?'':'none';if(e)e.style.display=t==='Essay'?'':'none';}
  function addAQ(){qc++;var sk=document.querySelector('[data-question-stack]');if(!sk)return;var d=document.createElement('div');d.className='assessment-question-card';d.setAttribute('data-question-card','');d.innerHTML='<div class="question-card-head"><strong>Question '+qc+'</strong><button type="button" class="btn btn-secondary btn-sm" onclick="this.closest(\'.assessment-question-card\').remove()" style="margin-left:auto;">Remove</button></div><div style="display:grid;grid-template-columns:1fr 1fr;gap:15px;margin-bottom:10px;"><label>Question Type<select name="question_type" onchange="toggleQF(this)"><option value="Multiple Choice">Multiple Choice</option><option value="True or False">True or False</option><option value="Fill in the Blank">Fill in the Blank</option><option value="Essay">Essay</option></select></label><label>Source Module (Title)<select name="q_source_module_title"><option value="">— General / No Specific Module —</option><% adminResources.forEach((r) => { %><option value="<%= r.title %>"><%= r.title %></option><% }) %></select></label></div><label>Question<textarea name="question_text" rows="2" required></textarea></label><div class="mc-fields"><label>Choice A<input type="text" name="choice_a" /></label><label>Choice B<input type="text" name="choice_b" /></label><label>Choice C<input type="text" name="choice_c" /></label><label>Choice D<input type="text" name="choice_d" /></label></div><label>Correct Answer<input type="text" name="correct_answer" placeholder="e.g. A, True, or the answer text" required /></label><label class="essay-field" style="display:none;">Expected Answer<textarea name="essay_rubric_keywords" rows="2"></textarea></label>';sk.appendChild(d);}
  </script>

  <section class="panel-card">
    <div class="panel-card-head"><h3>Enrolled Students</h3></div>
    <div class="list-stack">
      <% const uniqueStudents = []; const seenStudentIds = new Set(); %>
      <% students.forEach((s) => { if (!seenStudentIds.has(Number(s.student_id || s.id))) { seenStudentIds.add(Number(s.student_id || s.id)); uniqueStudents.push(s); } }) %>
      <% if (!uniqueStudents.length) { %><p class="empty-state">No students enrolled yet.</p><% } %>
      <% uniqueStudents.forEach((student) => { %>
        <a class="list-card compact student-link-card" href="<%= basePath %>/subjects/<%= subject.id %>/students/<%= student.student_id || student.id %>/analytics">
          <div>
            <strong><%= student.full_name %></strong>
            <span><%= student.year_level || '-' %> <%= student.grade_level || '' %></span>
            <span style="margin-left:12px;"><%= student.tutor_name || 'No tutor assigned' %></span>
            <% if (student.time_slot) { %><span style="margin-left:8px;">(<%= student.time_slot %>)</span><% } %>
          </div>
        </a>
      <% }) %>
    </div>
  </section>

  <% if (tutors.length) { %>
  <section class="panel-card">
    <div class="panel-card-head"><h3>Tutors</h3></div>
    <div class="subject-member-grid">
      <% tutors.forEach((tutor) => { %>
        <% const tutorFullName = [tutor.first_name, tutor.middle_name, tutor.last_name].filter(Boolean).join(' '); %>
        <% const tutorBranchLabels = [...new Set(safeJsonArray(tutor.extra?.branch_ids || []).map((id) => { const hit = (branches || []).find((branch) => Number(branch.id) === Number(id)); return hit ? hit.name : ''; }).filter(Boolean))]; %>
        <% const tutorYearLabels = [...new Set(safeJsonArray(tutor.extra?.year_levels || (tutor.year_level || '').split(',')).map((item) => String(item || '').trim()).filter(Boolean))]; %>
        <% const assignedStudents = (students || []).filter((student) => Number(student.tutor_id || student.tutor_profile_id || 0) === Number(tutor.id)); %>
        <article class="subject-member-card">
          <div class="subject-member-card-head">
            <strong><%= tutorFullName %></strong>
            <span class="subject-role-chip">Tutor</span>
          </div>
          <div class="subject-member-meta">
            <div><span>Name</span><strong><%= tutorFullName %></strong></div>
            <div><span>Branch</span><strong><%= tutorBranchLabels.join(', ') || tutor.branch_name || '-' %></strong></div>
            <div><span>Role</span><strong>Tutor</strong></div>
            <div><span>Year Level</span><strong><%= tutorYearLabels.join(', ') || tutor.year_level || '-' %></strong></div>
            <div><span>Assign Student</span><strong><%= assignedStudents.length ? assignedStudents.map((student) => student.full_name).join(', ') : 'No assigned students yet' %></strong></div>
            <div><span>Time Schedule</span><strong><%= tutor.time_slot || tutor.available_time_slots || '-' %></strong></div>
          </div>
          <div class="subject-member-actions">
            <form method="post" action="<%= basePath %>/subjects/<%= subject.id %>/tutors/<%= tutor.id %>/archive" data-confirm-message="Archive this tutor from the subject?">
              <button class="btn btn-secondary btn-sm" type="submit">Archive</button>
            </form>
          </div>
        </article>
      <% }) %>
    </div>
  </section>
  <% } %>

  <section class="panel-card">
    <div class="panel-card-head"><h3>Archived Enrolled Users</h3></div>
    <div class="table-wrap max-modal-table">
      <table>
        <thead><tr><th>Name</th><th>Branch</th><th>Role</th><th>Year Level</th><th>Time Schedule</th><th>Recover</th></tr></thead>
        <tbody>
          <% if (!archivedAssignments.length && !archivedTutors.length) { %>
            <tr><td colspan="6">No archived enrolled users.</td></tr>
          <% } %>
          <% archivedAssignments.forEach((assignment) => { %>
            <tr>
              <td><%= assignment.first_name %> <%= assignment.last_name %></td>
              <td><%= assignment.branch_name || '-' %></td>
              <td><%= assignment.role || 'student' %></td>
              <td><%= assignment.year_level || '-' %><%= assignment.grade_level ? ' / ' + assignment.grade_level : '' %></td>
              <td><%= assignment.time_slot || '-' %></td>
              <td><form method="post" action="<%= basePath %>/subjects/assignments/<%= assignment.id %>/recover" data-confirm-message="Recover this archived enrolled user?"><button class="btn btn-primary btn-sm" type="submit">Recover</button></form></td>
            </tr>
          <% }) %>
          <% archivedTutors.forEach((tutor) => { %>
            <tr>
              <td><%= tutor.first_name %> <%= tutor.last_name %></td>
              <td><%= tutor.branch_name || '-' %></td>
              <td>tutor</td>
              <td><%= tutor.year_level || '-' %></td>
              <td><%= tutor.time_slot || '-' %></td>
              <td><form method="post" action="<%= basePath %>/subjects/<%= subject.id %>/tutors/<%= tutor.id %>/recover" data-confirm-message="Recover this archived tutor into the subject?"><button class="btn btn-primary btn-sm" type="submit">Recover</button></form></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
</section>
