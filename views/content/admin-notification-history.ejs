<%# ANNOTATED COPY FOR DEFENSE REVIEW | File: views/content/admin-notification-history.ejs | Purpose: UI template/view used by the system. %>
<section class="panel-card">
  <div class="panel-card-head">
    <h2>Notification History</h2>
  </div>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th>Type</th>
          <th>Branch</th>
          <th>Accepted At</th>
        </tr>
      </thead>
      <tbody>
        <% if (!historyNotifications.length) { %>
          <tr><td colspan="4">No accepted notifications yet.</td></tr>
        <% } %>
        <% historyNotifications.forEach((item) => { %>
          <tr>
            <td><%= item.first_name %> <%= item.last_name %></td>
            <td><%= item.submission_type %></td>
            <td><%= item.branch_name || '-' %></td>
            <td><%= formatDateTime(item.accepted_at) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>