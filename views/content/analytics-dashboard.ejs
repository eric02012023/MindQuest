<%# File: views/content/analytics-dashboard.ejs
    Purpose: Analytics & Reports — one dashboard, four scopes, in side tabs.

    Admin, Assistant Admin, Tutor and Student all open this same page. What
    differs is the DATA, and it differs because lib/analytics.js asked the
    database for less — not because this template hid anything. A student who
    reaches an admin URL is stopped by the route; a student who reaches this
    template sees only their own rows because only their own rows were fetched.

    THE TABS (css/mq-data.css 12c and 12d, public/js/main.js)
    The page used to stack every report down one long scroll. The headline
    figures stay at the top; below them each report is a tab down the left, and
    only the one clicked shows its data. The list is a narrow rail of icons
    (.mq-vtabs-rail): pointing at it opens it over the report, with every name
    and count, and it folds back when the pointer leaves. On a phone the icons
    sit in a row, the open report's name beside its icon:

      Student          Score trends · Level spread · Weak topics ·
                       My progress · My assessment history ·
                       Enrollment & progress · Auto-generated focus areas
      Tutor            Score trends · Level spread · Weak topics ·
                       Learner performance · Student progress · Recent attempts ·
                       Enrollment & progress · Auto-generated focus areas ·
                       Assessment integrity
      Admin, Assistant Score trend · Level spread · Weak topics ·
                       Learner performance · Student progress · Recent attempts ·
                       Enrollment & progress · Auto-generated focus areas ·
                       Payment collection · Assessment integrity · User registry

    STUDENT PROGRESS compares, for each learner and subject, the Pre-Assessment,
    the module activities and the Post-Assessment, with the change between them,
    and pivots it by subject and by branch. USER REGISTRY (staff only) lists every
    account — learners, tutors and assistant admins, in every branch — as one
    table, with a summary table above it that counts them by any two of their
    fields ("Accounts by Branch and Role"). Both download as CSV.

    No explanatory sentences under the headings: the user asked for the page to
    show the reports, not describe them.

    A chart is drawn the first time its tab is shown (`mq:vtab-shown`): drawn in
    a hidden tab it would have no size. The open tab is kept in the address.

    THE FILTER BAR (between the headline figures and the tabs)
    Search (staff and tutors), subject, assessment, from/to and — main admin
    only — branch. Every figure and tab below reads the filtered rows. Applying
    or clearing keeps the tab that was open (the #tab in the address).

    The role differences that remain are about what is worth SHOWING:
      - a student has no "per-learner" table (there is one learner)
      - money is staff-only, and is not even queried for a tutor or student
      - violations are a supervision concern, so students do not see the list

    Locals: analytics (from getAnalyticsDashboard, with .filters), focusHandouts,
            branches (staff), viewerRole %>
<%
  const a = analytics;
  const scope = a.scope;
  const kpis = a.kpis;
  const isStudent = scope.isStudent;
  const isTutor = scope.isTutor;
  const showMoney = !!a.financials;
  const activeFilters = a.filters || {};
  const analyticsPath = `${basePath}/analytics`;
  const datesPicked = !!(activeFilters.from || activeFilters.to);

  const meterClass = (value) => (value < 50 ? 'mq-meter-low' : value < 75 ? 'mq-meter-mid' : 'mq-meter-high');
  const nameOf = (row) => `${titleCaseName(row.first_name)} ${titleCaseName(row.last_name || '')}`.trim();
  const countOf = (list, noun) => `${(list || []).length} ${noun}${(list || []).length === 1 ? '' : 's'}`;
  // Where a learner's own page is: the admin's, or the tutor's (their subjects only).
  const learnerHref = (studentId) => (isTutor
    ? `/tutor/students/${studentId}/analytics?from=analytics`
    : `${basePath}/students/${studentId}/analytics`);

  // The student's score trend, one chart per subject: every graded attempt,
  // oldest first, labelled with the assessment it was.
  const subjectTrends = [];
  if (isStudent) {
    const bySubject = new Map();
    [...(a.submissions || [])].reverse().forEach((row) => {
      if (row.percentage == null) return;
      const key = String(row.subject_id);
      if (!bySubject.has(key)) bySubject.set(key, { id: row.subject_id, name: row.subject_name, labels: [], kinds: [], values: [] });
      const entry = bySubject.get(key);
      entry.labels.push(row.title);
      entry.kinds.push(row.assessment_kind);
      entry.values.push(Number(Number(row.percentage).toFixed(1)));
    });
    (a.subjects || []).forEach((subject) => {
      const key = String(subject.id);
      // A subject picked in the filter bar: only that subject's chart.
      if (activeFilters.subjectId && String(activeFilters.subjectId) !== 'all' && String(activeFilters.subjectId) !== key) return;
      subjectTrends.push(bySubject.get(key) || { id: subject.id, name: subject.name, labels: [], kinds: [], values: [] });
    });
  }
  const levelTotal = Object.values(a.levels || {}).reduce((s, n) => s + Number(n || 0), 0);
  const focusList = focusHandouts || [];

  // ---------------------------------------------- student progress + registry
  const progressRows = (a.progress && a.progress.rows) || [];
  const progressSummary = (a.progress && a.progress.summary) || {};
  const registry = a.registry || null;
  const showRegistry = !!registry;
  // The registry's summary table counts the accounts the Role and Status pickers
  // leave, and its title says which: "Accounts", "Learners", "Approved tutors"…
  const registryNoun = (() => {
    const noun = { 'Assistant Admin': 'Assistant admins', Tutor: 'Tutors', Student: 'Learners' }[activeFilters.registryRole] || 'Accounts';
    const status = activeFilters.registryStatus && activeFilters.registryStatus !== 'all' ? activeFilters.registryStatus : '';
    return status ? `${status} ${noun.toLowerCase()}` : noun;
  })();
  const pct =(value) => (value === null || value === undefined ? '—' : `${value}%`);
  const signed = (value) => (value === null || value === undefined ? '—' : value > 0 ? `+${value}` : String(value));
  const changeClass = (value) => (value === null || value === undefined ? '' : value > 0 ? 'mq-pos' : value < 0 ? 'mq-neg' : '');
  const progressStatusClass = (status) => ({
    'Improved': 'mq-status-paid',
    'No change': 'mq-status-partial',
    'Declined': 'mq-status-unpaid',
    'Awaiting Post-Assessment': 'mq-status-pending'
  }[status] || 'mq-status-none');
  // The filters that are on screen, as [name, value] pairs: the page's own, and
  // the User registry's role and status. The CSV links carry them all, so a file
  // matches its tab; each filter form carries the other form's, so using one
  // does not undo the other.
  const pageFilters = [['search', activeFilters.search], ['subject_id', activeFilters.subjectId], ['kind', activeFilters.kind],
    ['from', activeFilters.from], ['to', activeFilters.to], ['branch_id', activeFilters.branchId]]
    .filter((pair) => pair[1] && pair[1] !== 'all');
  const registryFilters = [['reg_role', activeFilters.registryRole], ['reg_status', activeFilters.registryStatus]]
    .filter((pair) => pair[1] && pair[1] !== 'all');
  const queryOf = (pairs) => {
    const text = new URLSearchParams(pairs).toString();
    return text ? `?${text}` : '';
  };
  const progressCsvHref = `${basePath}/analytics/progress.csv${queryOf(pageFilters)}`;
  const registryCsvHref = `${basePath}/analytics/registry.csv${queryOf([...pageFilters, ...registryFilters])}`;
  // "Change per learner": the learners whose scores moved most, either way.
  const learnerChart = (() => {
    const moved = progressRows.filter((row) => row.change !== null)
      .sort((x, y) => Math.abs(y.change) - Math.abs(x.change)).slice(0, 15)
      .sort((x, y) => y.change - x.change);
    return {
      labels: moved.map((row) => `${nameOf(row)} — ${row.subject_name}`),
      values: moved.map((row) => row.change)
    };
  })();
  const subjectChart = {
    labels: (progressSummary.bySubject || []).map((row) => row.label),
    pre: (progressSummary.bySubject || []).map((row) => row.pre),
    module: (progressSummary.bySubject || []).map((row) => row.module),
    post: (progressSummary.bySubject || []).map((row) => row.post)
  };

  // The tabs this viewer gets, in the order they asked for.
  const tabs = [
    { key: 'score-trends', label: showMoney ? 'Score trend' : 'Score trends', icon: 'trend' },
    { key: 'level-spread', label: 'Level spread', icon: 'pie' },
    { key: 'weak-topics', label: 'Weak topics', icon: 'warning', count: (a.weakTopics || []).length },
    !isStudent && { key: 'learner-performance', label: 'Learner performance', icon: 'users', count: (a.performance || []).length },
    { key: 'progress', label: isStudent ? 'My progress' : 'Student progress', icon: 'target', count: progressRows.length },
    { key: 'attempts', label: isStudent ? 'My assessment history' : 'Recent attempts', icon: 'clipboard', count: (a.submissions || []).length },
    { key: 'enrollment', label: 'Enrollment & progress', icon: 'book' },
    { key: 'focus-areas', label: 'Auto-generated focus areas', icon: 'flag', count: focusList.length },
    showMoney && { key: 'payments', label: 'Payment collection', icon: 'wallet' },
    !isStudent && { key: 'integrity', label: 'Assessment integrity', icon: 'shield', count: (a.violations || []).length },
    showRegistry && { key: 'registry', label: 'User registry', icon: 'grid', count: registry.everyone.length }
  ].filter(Boolean);
%>
<section class="mq-page">

  <div class="mq-panel">
    <div class="mq-panel-head">
      <div>
        <h2>Analytics &amp; Reports</h2>
      </div>
      <span class="mq-chip"><%= scope.label %></span>
    </div>
  </div>

  <%# ------------------------------------------------------------------ KPIs %>
  <div class="mq-kpis">
    <div class="mq-kpi">
      <span><%= isStudent ? 'Subjects' : 'Learners' %></span>
      <strong><%= kpis.learners %></strong>
      <small><%= isStudent ? 'enrolled' : 'in scope' %></small>
    </div>
    <div class="mq-kpi">
      <span>Assessments taken</span>
      <strong><%= kpis.attempts %></strong>
      <small><%= datesPicked ? 'in the selected period' : 'all time' %></small>
    </div>
    <div class="mq-kpi">
      <span>Average score</span>
      <strong><%= kpis.averageScore %>%</strong>
      <small>across all attempts</small>
    </div>
    <div class="mq-kpi">
      <span>Weak topics</span>
      <strong><%= kpis.weakTopics %></strong>
      <small>below 60%</small>
    </div>
    <% if (!isStudent) { %>
      <div class="mq-kpi">
        <span>Flagged events</span>
        <strong><%= kpis.flagged %></strong>
        <small><%= kpis.autoSubmitted %> auto-submitted</small>
      </div>
    <% } %>
    <% if (showMoney) { %>
      <div class="mq-kpi">
        <span>Collected</span>
        <strong><%= money(kpis.collected) %></strong>
        <small><%= a.financials.transactions %> transactions</small>
      </div>
      <div class="mq-kpi">
        <span>Outstanding</span>
        <strong><%= money(kpis.outstanding) %></strong>
        <small><%= a.financials.unsettledAccounts %> unsettled</small>
      </div>
    <% } %>
  </div>

  <%# --------------------------------------------------------------- filters %>
  <form class="mq-toolbar" method="get" action="<%= analyticsPath %>" data-analytics-filters>
    <%# The User registry's role and status travel with it, so a search does not undo them. %>
    <% registryFilters.forEach((pair) => { %>
      <input type="hidden" name="<%= pair[0] %>" value="<%= pair[1] %>" />
    <% }) %>
    <div class="mq-filters">
      <% if (!isStudent) { %>
        <label class="mq-field mq-field-search">
          <span>Search</span>
          <input type="search" name="search" value="<%= activeFilters.search || '' %>" placeholder="Learner name, ID or subject" />
        </label>
      <% } %>

      <label class="mq-field">
        <span>Subject</span>
        <select name="subject_id" data-autosubmit>
          <option value="all">All subjects</option>
          <% (a.subjects || []).forEach((subject) => { %>
            <option value="<%= subject.id %>" <%= String(activeFilters.subjectId) === String(subject.id) ? 'selected' : '' %>><%= subject.name %></option>
          <% }) %>
        </select>
      </label>

      <label class="mq-field">
        <span>Assessment</span>
        <select name="kind" data-autosubmit>
          <option value="all" <%= !activeFilters.kind || activeFilters.kind === 'all' ? 'selected' : '' %>>All</option>
          <option value="pre_assessment" <%= activeFilters.kind === 'pre_assessment' ? 'selected' : '' %>>Pre-Assessment</option>
          <option value="post_assessment" <%= activeFilters.kind === 'post_assessment' ? 'selected' : '' %>>Post-Assessment</option>
          <option value="tutor_assessment" <%= activeFilters.kind === 'tutor_assessment' ? 'selected' : '' %>>Module assessment</option>
        </select>
      </label>

      <label class="mq-field"><span>From</span><input type="date" name="from" value="<%= activeFilters.from || '' %>" /></label>
      <label class="mq-field"><span>To</span><input type="date" name="to" value="<%= activeFilters.to || '' %>" /></label>

      <% if (scope.canPickBranch && typeof branches !== 'undefined' && (branches || []).length) { %>
        <label class="mq-field">
          <span>Branch</span>
          <select name="branch_id" data-autosubmit>
            <option value="all">All branches</option>
            <% branches.forEach((branch) => { %>
              <option value="<%= branch.id %>" <%= String(activeFilters.branchId) === String(branch.id) ? 'selected' : '' %>><%= branch.name %></option>
            <% }) %>
          </select>
        </label>
      <% } %>

      <button class="mq-btn mq-btn-primary" type="submit"><%- icon('search') %> Apply</button>
      <a class="mq-btn" href="<%= analyticsPath %>" data-filters-clear>Clear</a>
    </div>
  </form>

  <%# A rail of icons: pointing at it (or tabbing into it) opens it over the
      report with every name and count; it folds back when the pointer leaves. %>
  <div class="mq-vtabs mq-vtabs-rail" data-vtabs data-vtab-default="score-trends">
    <nav class="mq-vtab-list" role="tablist" aria-orientation="vertical" aria-label="Analytics &amp; Reports">
      <% tabs.forEach((tab, index) => { %>
        <button type="button" class="mq-vtab<%= index === 0 ? ' is-active' : '' %>" role="tab"
                id="vtab-<%= tab.key %>" data-vtab="<%= tab.key %>" aria-controls="vpanel-<%= tab.key %>"
                aria-selected="<%= index === 0 ? 'true' : 'false' %>" tabindex="<%= index === 0 ? 0 : -1 %>">
          <%- icon(tab.icon, 20) %>
          <span class="mq-vtab-label"><%= tab.label %></span>
          <% if (tab.count !== undefined) { %><span class="mq-vtab-count"><%= tab.count %></span><% } %>
        </button>
      <% }) %>
    </nav>

    <div class="mq-vtab-panels">

      <%# ============================================================ Score trend %>
      <section class="mq-vtab-panel" role="tabpanel" id="vpanel-score-trends" data-vtab-panel="score-trends" aria-labelledby="vtab-score-trends">
        <% if (isStudent) { %>
          <%# One chart per subject — a bar for every assessment taken, the score
              in percent, so the student sees each subject's own trend. %>
          <div class="mq-chart-grid mq-subject-trends">
            <% if (!subjectTrends.length) { %>
              <section class="mq-panel">
                <div class="mq-panel-head"><h3>Score trend</h3></div>
                <div class="mq-empty">You are not enrolled in a subject yet.</div>
              </section>
            <% } %>
            <% subjectTrends.forEach((trend, index) => { %>
              <section class="mq-panel">
                <div class="mq-panel-head">
                  <h3>Score trend — <%= trend.name %></h3>
                  <span class="mq-count"><%= trend.values.length %> assessment<%= trend.values.length === 1 ? '' : 's' %></span>
                </div>
                <% if (!trend.values.length) { %>
                  <div class="mq-empty">No assessment taken in this subject yet.</div>
                <% } else { %>
                  <div class="mq-chart-box mq-chart-box-tall"><canvas id="subjectTrend<%= index %>"></canvas></div>
                <% } %>
              </section>
            <% }) %>
          </div>
        <% } else { %>
          <section class="mq-panel">
            <div class="mq-panel-head">
              <div>
                <h3>Score trend</h3>
              </div>
              <span class="mq-count">average % per month</span>
            </div>
            <% if (!(a.trend || []).length) { %>
              <div class="mq-empty">No assessments have been submitted yet.</div>
            <% } else { %>
              <div class="mq-chart-box mq-chart-box-tall"><canvas id="trendChart"></canvas></div>
            <% } %>
          </section>
        <% } %>
      </section>

      <%# =========================================================== Level spread %>
      <section class="mq-vtab-panel" role="tabpanel" id="vpanel-level-spread" data-vtab-panel="level-spread" aria-labelledby="vtab-level-spread" hidden>
        <section class="mq-panel">
          <div class="mq-panel-head">
            <div>
              <h3>Level spread</h3>
            </div>
          </div>
          <% if (!levelTotal) { %>
            <div class="mq-empty">No level has been assigned yet.</div>
          <% } else { %>
            <div class="mq-chart-box mq-chart-box-tall"><canvas id="levelChart"></canvas></div>
          <% } %>
        </section>
      </section>

      <%# ============================================================ Weak topics %>
      <section class="mq-vtab-panel" role="tabpanel" id="vpanel-weak-topics" data-vtab-panel="weak-topics" aria-labelledby="vtab-weak-topics" hidden>
        <section class="mq-panel">
          <div class="mq-panel-head">
            <div>
              <h3>Weak topics</h3>
            </div>
            <span class="mq-count"><%= countOf(a.weakTopics, 'topic') %></span>
          </div>

          <div class="mq-table" style="--mq-cols: minmax(200px, 3fr) 1fr 90px 90px minmax(120px, 1fr);">
            <div class="mq-head">
              <span>Topic</span><span>Subject</span><span class="mq-num">Correct</span>
              <span class="mq-num">Score</span><span>Mastery</span>
            </div>

            <% if (!(a.weakTopics || []).length) { %>
              <div class="mq-empty">
                <strong>Nothing to report yet</strong>
                Weak topics appear once assessments have been submitted.
              </div>
            <% } %>

            <% (a.weakTopics || []).forEach((topic) => { %>
              <div class="mq-row">
                <span class="mq-cell mq-cell-primary" data-label="Topic">
                  <span class="mq-name"><%= topic.topic %></span>
                  <% if (!isStudent) { %><span class="mq-sub"><%= topic.student_count %> learner<%= topic.student_count === 1 ? '' : 's' %></span><% } %>
                </span>
                <span class="mq-cell mq-sub" data-label="Subject"><%= topic.subject_name %></span>
                <span class="mq-cell mq-num" data-label="Correct"><%= topic.correct %>/<%= topic.total %></span>
                <span class="mq-cell mq-num" data-label="Score"><%= topic.percentage %>%</span>
                <span class="mq-cell" data-label="Mastery">
                  <span class="mq-meter <%= meterClass(topic.percentage) %>"><i style="width: <%= Math.max(2, Math.min(100, topic.percentage)) %>%"></i></span>
                </span>
              </div>
            <% }) %>
          </div>
        </section>
      </section>

      <%# ==================================================== Learner performance %>
      <% if (!isStudent) { %>
        <section class="mq-vtab-panel" role="tabpanel" id="vpanel-learner-performance" data-vtab-panel="learner-performance" aria-labelledby="vtab-learner-performance" hidden>
          <section class="mq-panel">
            <div class="mq-panel-head">
              <div>
                <h3>Learner performance</h3>
              </div>
              <span class="mq-count"><%= countOf(a.performance, 'learner') %></span>
            </div>

            <div class="mq-table" style="--mq-cols: minmax(170px, 2fr) 1fr 80px 90px 90px 130px 90px 48px;">
              <div class="mq-head">
                <span>Learner</span><span>Branch</span><span class="mq-num">Attempts</span>
                <span class="mq-num">Average</span><span class="mq-num">Best</span>
                <span>Last attempt</span><span class="mq-num">Flags</span><span></span>
              </div>

              <% if (!(a.performance || []).length) { %>
                <div class="mq-empty"><strong>No learners in scope</strong>Once learners are assigned to you they appear here.</div>
              <% } %>

              <% (a.performance || []).forEach((row) => { %>
                <div class="mq-row">
                  <span class="mq-cell mq-cell-primary" data-label="Learner">
                    <a class="mq-name" href="<%= learnerHref(row.student_id) %>"><%= nameOf(row) %></a>
                    <span class="mq-sub"><%= row.student_code %><%= row.grade_level ? ` · ${row.grade_level}` : '' %></span>
                  </span>
                  <span class="mq-cell mq-sub" data-label="Branch"><%= row.branch_name || '—' %></span>
                  <span class="mq-cell mq-num" data-label="Attempts"><%= row.attempts %></span>
                  <span class="mq-cell mq-num" data-label="Average"><%= row.average_percentage === null ? '—' : `${row.average_percentage}%` %></span>
                  <span class="mq-cell mq-num" data-label="Best"><%= row.best_percentage === null ? '—' : `${row.best_percentage}%` %></span>
                  <span class="mq-cell mq-sub" data-label="Last attempt"><%= row.last_attempt_at ? formatDate(row.last_attempt_at) : 'Never' %></span>
                  <span class="mq-cell mq-num" data-label="Flags">
                    <% if (row.violations > 0) { %>
                      <span class="mq-status mq-status-flagged"><%= row.violations %></span>
                    <% } else { %>—<% } %>
                  </span>
                  <span class="mq-cell mq-cell-actions">
                    <a class="mq-icon" href="<%= learnerHref(row.student_id) %>" title="View this learner's analytics" aria-label="View this learner's analytics"><%- icon('chart') %></a>
                  </span>
                </div>
              <% }) %>
            </div>
          </section>
        </section>
      <% } %>

      <%# ====================================================== Student progress
          Pre-Assessment, module activities and Post-Assessment side by side, for
          every learner and subject in scope (lib/analytics.js getProgressComparison).
          A tutor sees the subjects they teach the learner; a student, their own. %>
      <section class="mq-vtab-panel" role="tabpanel" id="vpanel-progress" data-vtab-panel="progress" aria-labelledby="vtab-progress" hidden>
        <section class="mq-panel">
          <div class="mq-panel-head">
            <div>
              <h3><%= isStudent ? 'My progress' : 'Student progress' %></h3>
            </div>
            <div class="mq-panel-head-actions">
              <button type="button" class="mq-btn mq-btn-sm" onclick="window.print()"><%- icon('print') %> Print</button>
              <a class="mq-btn mq-btn-sm" href="<%= progressCsvHref %>"><%- icon('download') %> Download CSV</a>
            </div>
          </div>

          <% if (!progressRows.length) { %>
            <div class="mq-empty">
              <strong>Nothing to compare yet</strong>
              <%= isStudent ? 'You are not enrolled in a subject yet.' : 'No learner in scope is enrolled in a subject that matches these filters.' %>
            </div>
          <% } else { %>
            <div class="mq-summary">
              <div class="mq-summary-item"><span><%= isStudent ? 'Subjects' : 'Learners' %></span><strong><%= isStudent ? progressRows.length : progressSummary.learners %></strong></div>
              <div class="mq-summary-item"><span>Average Pre</span><strong><%= pct(progressSummary.averagePre) %></strong></div>
              <div class="mq-summary-item"><span>Average Post</span><strong><%= pct(progressSummary.averagePost) %></strong></div>
              <div class="mq-summary-item <%= progressSummary.averageChange === null ? '' : progressSummary.averageChange >= 0 ? 'is-positive' : 'is-negative' %>">
                <span>Average change</span><strong><%= signed(progressSummary.averageChange) %></strong>
              </div>
            </div>
            <div class="mq-summary" style="margin-top: 10px;">
              <div class="mq-summary-item is-positive"><span>Improved</span><strong><%= progressSummary.improved %></strong></div>
              <div class="mq-summary-item is-negative"><span>Declined</span><strong><%= progressSummary.declined %></strong></div>
              <div class="mq-summary-item"><span>Awaiting Post</span><strong><%= progressSummary.awaiting %></strong></div>
              <div class="mq-summary-item"><span>Not yet assessed</span><strong><%= progressSummary.notAssessed %></strong></div>
            </div>
          <% } %>
        </section>

        <% if (progressRows.length) { %>
          <%# ---------------------------------------------------- comparison charts %>
          <div class="mq-chart-grid mq-progress-charts">
            <section class="mq-panel">
              <div class="mq-panel-head">
                <div>
                  <h3>Score by subject</h3>
                </div>
              </div>
              <div class="mq-chart-box mq-chart-box-tall"><canvas id="progressSubjectChart"></canvas></div>
            </section>

            <% if (!isStudent) { %>
              <section class="mq-panel">
                <div class="mq-panel-head">
                  <div>
                    <h3>Change per learner</h3>
                  </div>
                </div>
                <% if (!learnerChart.labels.length) { %>
                  <div class="mq-empty">No learner has both a Pre- and a Post-Assessment yet.</div>
                <% } else { %>
                  <div class="mq-chart-box mq-chart-box-tall"><canvas id="progressLearnerChart"></canvas></div>
                <% } %>
              </section>
            <% } %>
          </div>

          <%# --------------------------------------------------------- pivot tables %>
          <section class="mq-panel">
            <div class="mq-panel-head">
              <div>
                <h3>Average score by subject</h3>
              </div>
              <span class="mq-count"><%= countOf(progressSummary.bySubject, 'subject') %></span>
            </div>
            <div class="mq-table mq-pivot" style="--mq-min-width: 640px; --mq-cols: minmax(180px, 2fr) 90px 90px 120px 90px 100px;">
              <div class="mq-head">
                <span>Subject</span><span class="mq-num">Learners</span><span class="mq-num">Pre</span>
                <span class="mq-num">Module activities</span><span class="mq-num">Post</span><span class="mq-num">Change</span>
              </div>
              <% progressSummary.bySubject.forEach((row) => { %>
                <div class="mq-row">
                  <span class="mq-cell mq-name" data-label="Subject"><%= row.label %></span>
                  <span class="mq-cell mq-num" data-label="Learners"><%= row.learners %></span>
                  <span class="mq-cell mq-num" data-label="Pre"><%= pct(row.pre) %></span>
                  <span class="mq-cell mq-num" data-label="Module activities"><%= pct(row.module) %></span>
                  <span class="mq-cell mq-num" data-label="Post"><%= pct(row.post) %></span>
                  <span class="mq-cell mq-num <%= changeClass(row.change) %>" data-label="Change"><%= signed(row.change) %></span>
                </div>
              <% }) %>
              <div class="mq-row mq-pivot-total">
                <span class="mq-cell mq-name" data-label="Subject">All subjects</span>
                <span class="mq-cell mq-num" data-label="Learners"><%= progressSummary.learners %></span>
                <span class="mq-cell mq-num" data-label="Pre"><%= pct(progressSummary.averagePre) %></span>
                <span class="mq-cell mq-num" data-label="Module activities"><%= pct(progressSummary.averageModule) %></span>
                <span class="mq-cell mq-num" data-label="Post"><%= pct(progressSummary.averagePost) %></span>
                <span class="mq-cell mq-num <%= changeClass(progressSummary.averageChange) %>" data-label="Change"><%= signed(progressSummary.averageChange) %></span>
              </div>
            </div>
          </section>

          <% if (!isStudent && progressSummary.byBranch.length > 1) { %>
            <section class="mq-panel">
              <div class="mq-panel-head">
                <div>
                  <h3>Average score by branch</h3>
                </div>
                <span class="mq-count"><%= countOf(progressSummary.byBranch, 'branch') %></span>
              </div>
              <div class="mq-table mq-pivot" style="--mq-min-width: 640px; --mq-cols: minmax(180px, 2fr) 90px 90px 120px 90px 100px;">
                <div class="mq-head">
                  <span>Branch</span><span class="mq-num">Learners</span><span class="mq-num">Pre</span>
                  <span class="mq-num">Module activities</span><span class="mq-num">Post</span><span class="mq-num">Change</span>
                </div>
                <% progressSummary.byBranch.forEach((row) => { %>
                  <div class="mq-row">
                    <span class="mq-cell mq-name" data-label="Branch"><%= row.label %></span>
                    <span class="mq-cell mq-num" data-label="Learners"><%= row.learners %></span>
                    <span class="mq-cell mq-num" data-label="Pre"><%= pct(row.pre) %></span>
                    <span class="mq-cell mq-num" data-label="Module activities"><%= pct(row.module) %></span>
                    <span class="mq-cell mq-num" data-label="Post"><%= pct(row.post) %></span>
                    <span class="mq-cell mq-num <%= changeClass(row.change) %>" data-label="Change"><%= signed(row.change) %></span>
                  </div>
                <% }) %>
              </div>
            </section>
          <% } %>

          <% const changePivot = progressSummary.branchSubjectChange; %>
          <% if (!isStudent && changePivot.rows.length && changePivot.columns.length) { %>
            <section class="mq-panel">
              <div class="mq-panel-head">
                <div>
                  <h3>Average change by branch and subject</h3>
                </div>
              </div>
              <div class="mq-table mq-pivot" style="--mq-min-width: <%= 200 + changePivot.columns.length * 110 %>px; --mq-cols: minmax(160px, 1.6fr) repeat(<%= changePivot.columns.length %>, minmax(90px, 1fr)) 90px;">
                <div class="mq-head">
                  <span>Branch</span>
                  <% changePivot.columns.forEach((column) => { %><span class="mq-num"><%= column %></span><% }) %>
                  <span class="mq-num">All</span>
                </div>
                <% changePivot.rows.forEach((row) => { %>
                  <div class="mq-row">
                    <span class="mq-cell mq-name" data-label="Branch"><%= row.label %></span>
                    <% row.counts.forEach((value, index) => { %>
                      <span class="mq-cell mq-num <%= changeClass(value) %>" data-label="<%= changePivot.columns[index] %>"><%= signed(value) %></span>
                    <% }) %>
                    <span class="mq-cell mq-num <%= changeClass(row.total) %>" data-label="All"><%= signed(row.total) %></span>
                  </div>
                <% }) %>
                <div class="mq-row mq-pivot-total">
                  <span class="mq-cell mq-name" data-label="Branch">All branches</span>
                  <% changePivot.totals.forEach((value, index) => { %>
                    <span class="mq-cell mq-num <%= changeClass(value) %>" data-label="<%= changePivot.columns[index] %>"><%= signed(value) %></span>
                  <% }) %>
                  <span class="mq-cell mq-num <%= changeClass(changePivot.grand) %>" data-label="All"><%= signed(changePivot.grand) %></span>
                </div>
              </div>
            </section>
          <% } %>

          <%# ----------------------------------------------------- the full list %>
          <section class="mq-panel">
            <div class="mq-panel-head">
              <div>
                <h3><%= isStudent ? 'Subject by subject' : 'Learner by learner' %></h3>
              </div>
              <span class="mq-count"><%= progressRows.length %> line<%= progressRows.length === 1 ? '' : 's' %></span>
            </div>
            <div class="mq-table" style="--mq-min-width: <%= isStudent ? 760 : (scope.isAdmin ? 1060 : 960) %>px; --mq-cols: <%= isStudent
              ? 'minmax(160px, 2fr) 90px 130px 90px 90px 150px 160px'
              : (scope.isAdmin
                ? 'minmax(170px, 2fr) minmax(100px, 1fr) minmax(130px, 1.4fr) 80px 130px 80px 90px 120px 160px'
                : 'minmax(170px, 2fr) minmax(130px, 1.4fr) 80px 130px 80px 90px 120px 160px') %>;">
              <div class="mq-head">
                <% if (!isStudent) { %><span>Learner</span><% } %>
                <% if (scope.isAdmin) { %><span>Branch</span><% } %>
                <span>Subject</span>
                <span class="mq-num">Pre</span>
                <span class="mq-num">Module activities</span>
                <span class="mq-num">Post</span>
                <span class="mq-num">Change</span>
                <span>Modules opened</span>
                <span>Status</span>
              </div>
              <% progressRows.forEach((row) => { %>
                <div class="mq-row">
                  <% if (!isStudent) { %>
                    <span class="mq-cell mq-cell-primary" data-label="Learner">
                      <a class="mq-name" href="<%= learnerHref(row.student_id) %>"><%= nameOf(row) %></a>
                      <span class="mq-sub"><%= row.student_code %><%= row.grade_level ? ` · ${row.grade_level}` : '' %></span>
                    </span>
                  <% } %>
                  <% if (scope.isAdmin) { %><span class="mq-cell mq-sub" data-label="Branch"><%= row.branch_name %></span><% } %>
                  <span class="mq-cell <%= isStudent ? 'mq-name' : 'mq-sub' %>" data-label="Subject"><%= row.subject_name %></span>
                  <span class="mq-cell mq-num" data-label="Pre">
                    <%= pct(row.pre) %>
                    <% if (row.pre_level) { %><span class="mq-sub"><%= row.pre_level %></span><% } %>
                  </span>
                  <span class="mq-cell mq-num" data-label="Module activities">
                    <%= pct(row.module_average) %>
                    <% if (row.module_attempts) { %><span class="mq-sub"><%= row.module_attempts %> taken</span><% } %>
                  </span>
                  <span class="mq-cell mq-num" data-label="Post">
                    <%= pct(row.post) %>
                    <% if (row.post_level) { %><span class="mq-sub"><%= row.post_level %></span><% } %>
                  </span>
                  <span class="mq-cell mq-num <%= changeClass(row.change) %>" data-label="Change"><strong><%= signed(row.change) %></strong></span>
                  <span class="mq-cell" data-label="Modules opened">
                    <% if (row.modules_total) { %>
                      <span class="mq-sub"><%= row.modules_opened %> of <%= row.modules_total %></span>
                      <span class="mq-meter <%= meterClass((row.modules_opened / row.modules_total) * 100) %>"><i style="width: <%= Math.max(2, Math.round((row.modules_opened / row.modules_total) * 100)) %>%"></i></span>
                    <% } else { %><span class="mq-sub">—</span><% } %>
                  </span>
                  <span class="mq-cell" data-label="Status"><span class="mq-status <%= progressStatusClass(row.status) %>"><%= row.status %></span></span>
                </div>
              <% }) %>
            </div>
          </section>
        <% } %>
      </section>

      <%# ======================================================== Attempt list %>
      <section class="mq-vtab-panel" role="tabpanel" id="vpanel-attempts" data-vtab-panel="attempts" aria-labelledby="vtab-attempts" hidden>
        <section class="mq-panel">
          <div class="mq-panel-head">
            <div>
              <h3><%= isStudent ? 'My assessment history' : 'Recent attempts' %></h3>
            </div>
            <span class="mq-count"><%= (a.submissions || []).length %></span>
          </div>

          <div class="mq-table" style="--mq-cols: 130px <%= isStudent ? '' : 'minmax(160px, 2fr)' %> minmax(160px, 2fr) 130px 90px 110px;">
            <div class="mq-head">
              <span>Date</span>
              <% if (!isStudent) { %><span>Learner</span><% } %>
              <span>Assessment</span>
              <span>Subject</span>
              <span class="mq-num">Score</span>
              <span>Result</span>
            </div>

            <% if (!(a.submissions || []).length) { %>
              <div class="mq-empty"><strong>No attempts yet</strong>Submitted assessments appear here.</div>
            <% } %>

            <% (a.submissions || []).forEach((row) => { %>
              <div class="mq-row">
                <span class="mq-cell mq-sub" data-label="Date"><%= formatDate(row.submitted_at) %></span>
                <% if (!isStudent) { %>
                  <span class="mq-cell mq-cell-primary" data-label="Learner">
                    <a class="mq-name" href="<%= learnerHref(row.student_id) %>"><%= nameOf(row) %></a>
                    <span class="mq-sub"><%= row.student_code %></span>
                  </span>
                <% } %>
                <span class="mq-cell mq-cell-primary" data-label="Assessment">
                  <a class="mq-name" href="<%= basePath %>/results/<%= row.id %>"><%= row.title %></a>
                  <span class="mq-sub">
                    <%= row.assessment_kind === 'pre_assessment' ? 'Pre-Assessment'
                      : row.assessment_kind === 'post_assessment' ? 'Post-Assessment' : 'Module assessment' %>
                    <% if (Number(row.is_auto_submitted) === 1) { %> · auto-submitted<% } %>
                  </span>
                </span>
                <span class="mq-cell mq-sub" data-label="Subject"><%= row.subject_name %></span>
                <span class="mq-cell mq-num" data-label="Score"><%= Number(row.percentage).toFixed(1) %>%</span>
                <span class="mq-cell" data-label="Result">
                  <%# Coloured from the classification it is showing, not from a second
                      set of cut-offs — the bands live in config/levelThresholds.js. %>
                  <span class="mq-status mq-status-<%= row.level === 'Advance' ? 'paid' : row.level === 'Intermediate' ? 'partial' : 'unpaid' %>"><%= row.level %></span>
                </span>
              </div>
            <% }) %>
          </div>
        </section>
      </section>

      <%# ================================================ Enrollment & progress %>
      <section class="mq-vtab-panel" role="tabpanel" id="vpanel-enrollment" data-vtab-panel="enrollment" aria-labelledby="vtab-enrollment" hidden>
        <% if (showMoney) { %>
          <section class="mq-panel">
            <div class="mq-panel-head">
              <div>
                <h3>Enrollment by subject</h3>
              </div>
              <span class="mq-count"><%= countOf(a.enrolment, 'subject') %></span>
            </div>
            <%# Learners only. This page reports on how students are doing; a staff
                headcount is a User Management question. %>
            <div class="mq-table" style="--mq-cols: minmax(180px, 3fr) 90px;">
              <div class="mq-head"><span>Subject</span><span class="mq-num">Learners</span></div>
              <% if (!(a.enrolment || []).length) { %>
                <div class="mq-empty">No active enrollments.</div>
              <% } %>
              <% (a.enrolment || []).forEach((row) => { %>
                <div class="mq-row">
                  <span class="mq-cell mq-name" data-label="Subject"><%= row.subject_name %></span>
                  <span class="mq-cell mq-num" data-label="Learners"><%= row.students %></span>
                </div>
              <% }) %>
            </div>
          </section>
        <% } %>

        <section class="mq-panel">
          <div class="mq-panel-head">
            <div>
              <h3>Module completion</h3>
            </div>
            <span class="mq-count"><%= countOf(a.completion, 'subject') %></span>
          </div>

          <div class="mq-table" style="--mq-cols: minmax(200px, 3fr) 90px 90px 90px minmax(120px, 1fr);">
            <div class="mq-head">
              <span>Subject</span><span class="mq-num">Learners</span><span class="mq-num">Modules</span>
              <span class="mq-num">Opened</span><span>Completion</span>
            </div>
            <% if (!(a.completion || []).length) { %>
              <div class="mq-empty">No enrollments in scope yet.</div>
            <% } %>
            <% (a.completion || []).forEach((row) => { %>
              <div class="mq-row">
                <span class="mq-cell mq-name" data-label="Subject"><%= row.subject_name %></span>
                <span class="mq-cell mq-num" data-label="Learners"><%= row.student_count %></span>
                <span class="mq-cell mq-num" data-label="Modules"><%= row.module_count %></span>
                <span class="mq-cell mq-num" data-label="Opened"><%= row.opens %></span>
                <span class="mq-cell" data-label="Completion">
                  <span class="mq-meter <%= meterClass(row.completion) %>"><i style="width: <%= Math.max(2, Math.min(100, row.completion)) %>%"></i></span>
                  <span class="mq-sub"><%= row.completion %>%</span>
                </span>
              </div>
            <% }) %>
          </div>
        </section>
      </section>

      <%# ======================================================== Focus areas %>
      <section class="mq-vtab-panel" role="tabpanel" id="vpanel-focus-areas" data-vtab-panel="focus-areas" aria-labelledby="vtab-focus-areas" hidden>
        <section class="mq-panel">
          <div class="mq-panel-head">
            <div>
              <h3>Auto-generated focus areas</h3>
            </div>
            <span class="mq-count"><%= countOf(focusList, 'handout') %></span>
          </div>

          <div class="mq-table" style="--mq-cols: 120px minmax(160px, 2fr) minmax(200px, 3fr) 90px <%= isStudent ? '0px' : '96px' %>;">
            <div class="mq-head">
              <span>Created</span><span><%= isStudent ? 'Subject' : 'Learner' %></span>
              <span>Focus</span><span class="mq-num">Pre %</span><span></span>
            </div>
            <% if (!focusList.length) { %>
              <div class="mq-empty">
                <strong>No focus areas yet</strong>
                They are written automatically when a Pre-Assessment is submitted.
              </div>
            <% } %>
            <% focusList.forEach((handout) => { %>
              <div class="mq-row">
                <span class="mq-cell mq-sub" data-label="Created"><%= formatDate(handout.created_at) %></span>
                <span class="mq-cell mq-cell-primary" data-label="<%= isStudent ? 'Subject' : 'Learner' %>">
                  <span class="mq-name"><%= isStudent ? handout.subject_name : nameOf(handout) %></span>
                  <span class="mq-sub"><%= isStudent ? (handout.tutor_first_name ? `Tutor: ${handout.tutor_first_name} ${handout.tutor_last_name || ''}` : 'No tutor assigned') : handout.subject_name %></span>
                </span>
                <span class="mq-cell mq-sub" data-label="Focus">
                  <%= (handout.weak_topics || []).map((t) => t.topic).join(' · ') || handout.summary %>
                </span>
                <span class="mq-cell mq-num" data-label="Pre %"><%= Number(handout.overall_percentage || 0).toFixed(0) %>%</span>
                <span class="mq-cell mq-cell-actions">
                  <% if (!isStudent) { %>
                    <a class="mq-icon" href="<%= basePath %>/focus-handouts/<%= handout.id %>" title="Open focus material" aria-label="Open focus material"><%- icon('book') %></a>
                  <% } %>
                </span>
              </div>
            <% }) %>
          </div>
        </section>
      </section>

      <%# ================================================= Payment collection %>
      <% if (showMoney) { %>
        <section class="mq-vtab-panel" role="tabpanel" id="vpanel-payments" data-vtab-panel="payments" aria-labelledby="vtab-payments" hidden>
          <section class="mq-panel">
            <div class="mq-panel-head">
              <div>
                <h3>Payment collection</h3>
              </div>
              <a class="mq-btn mq-btn-sm" href="<%= basePath %>/income-report"><%- icon('receipt') %> Open Payment Collection</a>
            </div>

            <div class="mq-summary">
              <div class="mq-summary-item is-positive">
                <span>Collected</span><strong><%= money(a.financials.collected) %></strong>
              </div>
              <div class="mq-summary-item is-negative">
                <span>Outstanding</span><strong><%= money(a.financials.outstanding) %></strong>
              </div>
              <div class="mq-summary-item">
                <span>Transactions</span><strong><%= a.financials.transactions %></strong>
              </div>
              <div class="mq-summary-item">
                <span>Settled accounts</span>
                <strong><%= a.financials.settledAccounts %> / <%= a.financials.settledAccounts + a.financials.unsettledAccounts %></strong>
              </div>
            </div>
          </section>
        </section>
      <% } %>

      <%# ================================================= Assessment integrity %>
      <% if (!isStudent) { %>
        <section class="mq-vtab-panel" role="tabpanel" id="vpanel-integrity" data-vtab-panel="integrity" aria-labelledby="vtab-integrity" hidden>
          <section class="mq-panel">
            <div class="mq-panel-head">
              <div>
                <h3>Assessment integrity</h3>
              </div>
              <span class="mq-count"><%= countOf(a.violations, 'event') %></span>
            </div>

            <div class="mq-table" style="--mq-cols: 150px minmax(150px, 2fr) minmax(150px, 2fr) 150px 70px;">
              <div class="mq-head">
                <span>When</span><span>Learner</span><span>Assessment</span><span>Event</span><span class="mq-num">Strike</span>
              </div>
              <% if (!(a.violations || []).length) { %>
                <div class="mq-empty">
                  <strong>Nothing flagged</strong>
                  No suspicious activity has been recorded.
                </div>
              <% } %>
              <% (a.violations || []).forEach((violation) => { %>
                <div class="mq-row">
                  <span class="mq-cell mq-sub" data-label="When"><%= formatDateTime(violation.occurred_at) %></span>
                  <span class="mq-cell mq-cell-primary" data-label="Learner">
                    <span class="mq-name"><%= nameOf(violation) %></span>
                    <span class="mq-sub"><%= violation.student_code %></span>
                  </span>
                  <span class="mq-cell mq-sub" data-label="Assessment"><%= violation.title %> · <%= violation.subject_name %></span>
                  <span class="mq-cell" data-label="Event">
                    <span class="mq-chip"><%= String(violation.violation_type).replace(/_/g, ' ') %></span>
                  </span>
                  <span class="mq-cell mq-num" data-label="Strike"><%= violation.violation_number %></span>
                </div>
              <% }) %>
            </div>
          </section>
        </section>
      <% } %>

      <%# ============================================================ User registry
          Every account — learners, tutors and assistant admins — across the
          branches in scope (lib/analytics.js getUserRegistry). Staff only: the
          main admin sees every branch, an assistant their own.

          The Role and Status pickers narrow both tables below them. The first
          counts those accounts by any two of their fields, chosen as its rows and
          its columns; its title says what it shows ("Learners by Subject and
          Branch"). It is worked out in the browser from the accounts already on
          the page, so changing a field sends nothing. %>
      <% if (showRegistry) { %>
        <% const people = registry.everyone.filter((row) => row.role !== 'admin'); %>
        <% const fields = [['branch', 'Branch'], ['role', 'Role'], ['status', 'Status'], ['level', 'Year level'], ['gender', 'Gender'], ['subject', 'Subject']]; %>
        <section class="mq-vtab-panel" role="tabpanel" id="vpanel-registry" data-vtab-panel="registry" aria-labelledby="vtab-registry" hidden>
          <section class="mq-panel">
            <div class="mq-panel-head">
              <div>
                <h3>User registry</h3>
              </div>
              <div class="mq-panel-head-actions">
                <a class="mq-btn mq-btn-sm" href="<%= registryCsvHref %>"><%- icon('download') %> Download CSV</a>
              </div>
            </div>

            <div class="mq-summary">
              <div class="mq-summary-item"><span>Accounts</span><strong><%= registry.everyone.length %></strong></div>
              <div class="mq-summary-item"><span>Assistant admins</span><strong><%= people.filter((row) => row.role === 'admin_assistant').length %></strong></div>
              <div class="mq-summary-item"><span>Tutors</span><strong><%= people.filter((row) => row.role === 'tutor').length %></strong></div>
              <div class="mq-summary-item"><span>Learners</span><strong><%= people.filter((row) => row.role === 'student').length %></strong></div>
              <div class="mq-summary-item is-negative"><span>Archived</span><strong><%= people.filter((row) => row.status === 'Archived').length %></strong></div>
            </div>

            <form class="mq-toolbar" method="get" action="<%= analyticsPath %>" data-analytics-filters>
              <%# The page's own filters travel with it, so picking a role does not undo them. %>
              <% pageFilters.forEach((pair) => { %>
                <input type="hidden" name="<%= pair[0] %>" value="<%= pair[1] %>" />
              <% }) %>
              <div class="mq-filters">
                <label class="mq-field">
                  <span>Role</span>
                  <select name="reg_role" data-autosubmit>
                    <option value="all">All roles</option>
                    <% ['Assistant Admin', 'Tutor', 'Student'].forEach((role) => { %>
                      <option value="<%= role %>" <%= activeFilters.registryRole === role ? 'selected' : '' %>><%= role %></option>
                    <% }) %>
                  </select>
                </label>
                <label class="mq-field">
                  <span>Status</span>
                  <select name="reg_status" data-autosubmit>
                    <option value="all">All statuses</option>
                    <% ['Approved', 'Pending', 'Rejected', 'Archived'].forEach((status) => { %>
                      <option value="<%= status %>" <%= activeFilters.registryStatus === status ? 'selected' : '' %>><%= status %></option>
                    <% }) %>
                  </select>
                </label>
                <button class="mq-btn mq-btn-primary" type="submit"><%- icon('search') %> Apply</button>
                <%# Clears the role and status only; the page's filters stay. %>
                <a class="mq-btn" href="<%= analyticsPath %><%= queryOf(pageFilters) %>" data-filters-clear>Clear</a>
              </div>
            </form>
          </section>

          <%# ------------------------------------------- accounts by any two fields %>
          <section class="mq-panel" data-pivot-builder data-pivot-noun="<%= registryNoun %>">
            <div class="mq-panel-head">
              <div>
                <h3 data-pivot-title><%= registryNoun %> by Branch and Role</h3>
              </div>
            </div>
            <div class="mq-toolbar">
              <div class="mq-filters">
                <label class="mq-field">
                  <span>Rows</span>
                  <select data-pivot-rows>
                    <% fields.forEach((field) => { %>
                      <option value="<%= field[0] %>" <%= field[0] === 'branch' ? 'selected' : '' %>><%= field[1] %></option>
                    <% }) %>
                  </select>
                </label>
                <label class="mq-field">
                  <span>Columns</span>
                  <select data-pivot-cols>
                    <% fields.forEach((field) => { %>
                      <option value="<%= field[0] %>" <%= field[0] === 'role' ? 'selected' : '' %>><%= field[1] %></option>
                    <% }) %>
                  </select>
                </label>
                <button type="button" class="mq-btn" data-pivot-swap>Swap rows and columns</button>
              </div>
            </div>
            <div data-pivot-output></div>
          </section>
          <%# The accounts the Role and Status pickers leave (the main admin's own
              account is not counted), for the table above. "<" is escaped so a name
              cannot close the tag. %>
          <script type="application/json" id="registry-pivot-data"><%- JSON.stringify(registry.rows.filter((row) => row.role !== 'admin').map((row) => ({
            branch: row.branch_name, role: row.role_label, status: row.status, level: row.level_group || '', gender: row.gender || '', subjects: row.subjects || []
          }))).replace(/</g, '\\u003c') %></script>

          <%# ----------------------------------------------------- the register %>
          <section class="mq-panel">
            <div class="mq-panel-head">
              <div>
                <h3>All accounts</h3>
              </div>
              <span class="mq-count"><%= registry.rows.length %><%= registry.rows.length === registry.everyone.length ? '' : ` of ${registry.everyone.length}` %></span>
            </div>

            <div class="mq-table" style="--mq-min-width: 1180px; --mq-cols: 110px minmax(170px, 2fr) 120px minmax(110px, 1fr) minmax(120px, 1fr) minmax(170px, 1.6fr) 120px minmax(180px, 2fr) 100px 110px;">
              <div class="mq-head">
                <span>User ID</span><span>Name</span><span>Role</span><span>Branch</span><span>Year / grade</span>
                <span>Email</span><span>Contact</span><span>Subjects</span><span>Status</span><span>Joined</span>
              </div>

              <% if (!registry.rows.length) { %>
                <div class="mq-empty">
                  <strong>No account matches</strong>
                  Clear the filters to see every account in scope.
                </div>
              <% } %>

              <% registry.rows.forEach((row) => { %>
                <div class="mq-row">
                  <span class="mq-cell mq-sub" data-label="User ID"><%= row.user_id %></span>
                  <span class="mq-cell mq-cell-primary" data-label="Name">
                    <% if (row.role === 'admin') { %>
                      <span class="mq-name"><%= row.name %></span>
                    <% } else { %>
                      <a class="mq-name" href="<%= basePath %>/profile/<%= row.id %>"><%= row.name %></a>
                    <% } %>
                  </span>
                  <span class="mq-cell" data-label="Role"><span class="mq-chip mq-chip-role"><%= row.role_label %></span></span>
                  <span class="mq-cell" data-label="Branch"><%= row.branch_name %></span>
                  <span class="mq-cell mq-sub" data-label="Year / grade"><%= row.level || '—' %></span>
                  <span class="mq-cell mq-sub" data-label="Email"><%= row.email || '—' %></span>
                  <span class="mq-cell mq-sub" data-label="Contact"><%= row.contact_number || '—' %></span>
                  <span class="mq-cell mq-sub" data-label="Subjects"><%= row.subjects.length ? row.subjects.join(', ') : '—' %></span>
                  <span class="mq-cell" data-label="Status">
                    <span class="mq-status mq-status-<%= row.status === 'Approved' ? 'approved' : row.status === 'Pending' ? 'pending' : row.status === 'Archived' ? 'unpaid' : 'rejected' %>"><%= row.status %></span>
                  </span>
                  <span class="mq-cell mq-sub" data-label="Joined"><%= formatDate(row.joined_at) %></span>
                </div>
              <% }) %>
            </div>
          </section>
        </section>
      <% } %>

    </div>
  </div>

</section>

<style>
  .mq-chart-box-tall { height: 320px; }
  @media (min-width: 1300px) {
    .mq-subject-trends,
    .mq-progress-charts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>

<script>
  // The filter bar comes back to the tab that was open: the tab lives in the
  // address's #hash, which a submitted form would otherwise drop. A subject,
  // assessment or branch picked applies at once, as the Apply button does.
  (function () {
    var keepTab = function (url) { return String(url).split('#')[0] + (window.location.hash || ''); };
    document.querySelectorAll('form[data-analytics-filters]').forEach(function (form) {
      form.addEventListener('submit', function () { form.action = keepTab(form.action); });
      form.querySelectorAll('select[data-autosubmit]').forEach(function (select) {
        select.addEventListener('change', function () {
          form.action = keepTab(form.action);
          form.submit();
        });
      });
      var clear = form.querySelector('[data-filters-clear]');
      if (clear) clear.addEventListener('click', function () { clear.href = keepTab(clear.href); });
    });
  })();
</script>

<script>
  // The registry's summary table: the accounts counted by any two of their
  // fields, and a title that says which ("Learners by Subject and Branch").
  // Cells are filled with textContent, never innerHTML — a name or a subject is
  // typed by a person.
  (function () {
    var root = document.querySelector('[data-pivot-builder]');
    var dataNode = document.getElementById('registry-pivot-data');
    if (!root || !dataNode) return;
    var people = [];
    try { people = JSON.parse(dataNode.textContent || '[]'); } catch (_e) { people = []; }
    var rowsSelect = root.querySelector('[data-pivot-rows]');
    var colsSelect = root.querySelector('[data-pivot-cols]');
    var output = root.querySelector('[data-pivot-output]');
    var title = root.querySelector('[data-pivot-title]');
    var noun = root.getAttribute('data-pivot-noun') || 'Accounts';
    var LABELS = { branch: 'Branch', role: 'Role', status: 'Status', level: 'Year level', gender: 'Gender', subject: 'Subject' };
    var SEP = '\u0000';

    // What an account says for a field. A subject is many (an account can have
    // several); the others are one, or nothing (a tutor has no year-level group).
    function valuesOf(person, field) {
      if (field === 'subject') return person.subjects || [];
      return person[field] ? [person[field]] : [];
    }
    function el(tag, className, text) {
      var node = document.createElement(tag);
      if (className) node.className = className;
      if (text != null) node.textContent = text;
      return node;
    }

    function draw() {
      var rowField = rowsSelect.value;
      var colField = colsSelect.value;
      title.textContent = noun + ' by ' + LABELS[rowField] + (rowField === colField ? '' : ' and ' + LABELS[colField]);
      var cells = {};
      var rowLabels = [];
      var colLabels = [];
      people.forEach(function (person) {
        var rowValues = valuesOf(person, rowField);
        var colValues = valuesOf(person, colField);
        if (!rowValues.length || !colValues.length) return;
        rowValues.forEach(function (r) {
          colValues.forEach(function (c) {
            if (rowLabels.indexOf(r) === -1) rowLabels.push(r);
            if (colLabels.indexOf(c) === -1) colLabels.push(c);
            cells[r + SEP + c] = (cells[r + SEP + c] || 0) + 1;
          });
        });
      });
      rowLabels.sort(function (a, b) { return String(a).localeCompare(String(b)); });
      colLabels.sort(function (a, b) { return String(a).localeCompare(String(b)); });
      output.innerHTML = '';
      if (!rowLabels.length || !colLabels.length) {
        output.appendChild(el('div', 'mq-empty', 'Nothing to count.'));
        return;
      }

      var table = el('div', 'mq-table mq-pivot');
      table.style.setProperty('--mq-min-width', (220 + (colLabels.length + 1) * 100) + 'px');
      table.style.setProperty('--mq-cols', 'minmax(170px, 1.8fr) repeat(' + (colLabels.length + 1) + ', minmax(80px, 1fr))');
      var head = el('div', 'mq-head');
      head.appendChild(el('span', '', LABELS[rowField]));
      colLabels.forEach(function (c) { head.appendChild(el('span', 'mq-num', c)); });
      head.appendChild(el('span', 'mq-num', 'Total'));
      table.appendChild(head);

      var colTotals = colLabels.map(function () { return 0; });
      var grand = 0;
      rowLabels.forEach(function (r) {
        var line = el('div', 'mq-row');
        line.appendChild(el('span', 'mq-cell mq-name', r));
        var total = 0;
        colLabels.forEach(function (c, index) {
          var n = cells[r + SEP + c] || 0;
          total += n;
          colTotals[index] += n;
          line.appendChild(el('span', 'mq-cell mq-num', n ? String(n) : '—'));
        });
        grand += total;
        var totalCell = el('span', 'mq-cell mq-num');
        totalCell.appendChild(el('strong', '', String(total)));
        line.appendChild(totalCell);
        table.appendChild(line);
      });
      var foot = el('div', 'mq-row mq-pivot-total');
      foot.appendChild(el('span', 'mq-cell mq-name', 'Total'));
      colTotals.forEach(function (n) { foot.appendChild(el('span', 'mq-cell mq-num', String(n))); });
      foot.appendChild(el('span', 'mq-cell mq-num', String(grand)));
      table.appendChild(foot);
      output.appendChild(table);
    }

    rowsSelect.addEventListener('change', draw);
    colsSelect.addEventListener('change', draw);
    root.querySelector('[data-pivot-swap]').addEventListener('click', function () {
      var rows = rowsSelect.value;
      rowsSelect.value = colsSelect.value;
      colsSelect.value = rows;
      draw();
    });
    draw();
  })();
</script>

<script src="/js/vendor/chart.umd.min.js"></script>
<script src="/js/chart-zoom.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (typeof Chart === 'undefined') return;

    // A chart is drawn once, the first time its tab is on screen: drawn inside a
    // hidden tab it would measure nothing and stay blank.
    function whenShown(canvas, draw) {
      if (!canvas) return;
      var panel = canvas.closest('[data-vtab-panel]');
      if (!panel || !panel.hidden) { draw(canvas); return; }
      panel.addEventListener('mq:vtab-shown', function once() {
        panel.removeEventListener('mq:vtab-shown', once);
        draw(canvas);
      });
    }

    whenShown(document.getElementById('trendChart'), function (canvas) {
      new Chart(canvas.getContext('2d'), {
        type: 'line',
        data: {
          labels: <%- JSON.stringify((a.trend || []).map((t) => t.label)) %>,
          datasets: [{
            label: 'Average score',
            data: <%- JSON.stringify((a.trend || []).map((t) => t.average)) %>,
            borderColor: '#16a8c8',
            backgroundColor: 'rgba(22, 168, 200, 0.14)',
            borderWidth: 2,
            fill: true,
            tension: 0.3,
            pointRadius: 3
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            y: { beginAtZero: true, max: 100, ticks: { callback: function (v) { return v + '%'; }, font: { size: 11 } }, grid: { color: 'rgba(0,0,0,0.05)' } },
            x: { grid: { display: false }, ticks: { font: { size: 11 } } }
          }
        }
      });
    });

    // The student's score trend, one bar chart per subject — a bar for each
    // assessment taken, its score in percent. Long assessment names are cut on
    // the axis and shown whole in the tooltip.
    // "<" escaped so an assessment title can never close this script tag.
    var trends = <%- JSON.stringify(subjectTrends.map((t) => ({ labels: t.labels, values: t.values }))).replace(/</g, '\\u003c') %>;
    trends.forEach(function (trend, index) {
      if (!trend.values.length) return;
      whenShown(document.getElementById('subjectTrend' + index), function (canvas) {
        new Chart(canvas.getContext('2d'), {
          type: 'bar',
          data: {
            labels: trend.labels,
            datasets: [{
              label: 'Score',
              data: trend.values,
              backgroundColor: '#2ea9f4',
              hoverBackgroundColor: '#1488d6',
              borderRadius: 2,
              maxBarThickness: 46
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: { display: false },
              tooltip: {
                callbacks: {
                  title: function (items) { return items.length ? trend.labels[items[0].dataIndex] : ''; },
                  label: function (item) { return 'Score: ' + item.parsed.y + '%'; }
                }
              }
            },
            scales: {
              y: {
                min: 0, max: 100,
                ticks: { stepSize: 50, font: { size: 11 } },
                title: { display: true, text: 'Score%', font: { size: 12 } },
                grid: { color: 'rgba(0,0,0,0.06)' }
              },
              x: {
                grid: { display: false },
                ticks: {
                  maxRotation: 45, minRotation: 45, autoSkip: false, font: { size: 11 },
                  callback: function (value) {
                    var label = String(this.getLabelForValue(value) || '');
                    return label.length > 16 ? label.slice(0, 14) + '…' : label;
                  }
                }
              }
            }
          }
        });
      });
    });

    // Student progress — the average Pre-Assessment, module activities and
    // Post-Assessment of each subject, side by side.
    var subjectChart = <%- JSON.stringify(subjectChart).replace(/</g, '\\u003c') %>;
    whenShown(document.getElementById('progressSubjectChart'), function (canvas) {
      new Chart(canvas.getContext('2d'), {
        type: 'bar',
        data: {
          labels: subjectChart.labels,
          datasets: [
            { label: 'Pre-Assessment', data: subjectChart.pre, backgroundColor: '#9aa4ae', borderRadius: 2, maxBarThickness: 34 },
            { label: 'Module activities', data: subjectChart.module, backgroundColor: '#2ea9f4', borderRadius: 2, maxBarThickness: 34 },
            { label: 'Post-Assessment', data: subjectChart.post, backgroundColor: '#32a65a', borderRadius: 2, maxBarThickness: 34 }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { position: 'bottom', labels: { usePointStyle: true, boxWidth: 8, padding: 12, font: { size: 11 } } },
            tooltip: { callbacks: { label: function (item) { return item.dataset.label + ': ' + (item.parsed.y == null ? 'none yet' : item.parsed.y + '%'); } } }
          },
          scales: {
            y: { min: 0, max: 100, ticks: { stepSize: 25, callback: function (v) { return v + '%'; }, font: { size: 11 } }, grid: { color: 'rgba(0,0,0,0.06)' } },
            x: {
              grid: { display: false },
              ticks: {
                font: { size: 11 }, maxRotation: 40, minRotation: 0,
                callback: function (value) {
                  var label = String(this.getLabelForValue(value) || '');
                  return label.length > 18 ? label.slice(0, 16) + '…' : label;
                }
              }
            }
          }
        }
      });
    });

    // Student progress — how far each learner's score moved, Post minus Pre.
    var learnerChart = <%- JSON.stringify(learnerChart).replace(/</g, '\\u003c') %>;
    whenShown(document.getElementById('progressLearnerChart'), function (canvas) {
      new Chart(canvas.getContext('2d'), {
        type: 'bar',
        data: {
          labels: learnerChart.labels,
          datasets: [{
            label: 'Change (points)',
            data: learnerChart.values,
            backgroundColor: learnerChart.values.map(function (v) { return v >= 0 ? '#32a65a' : '#d54c4c'; }),
            borderRadius: 2,
            maxBarThickness: 22
          }]
        },
        options: {
          indexAxis: 'y',
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: {
              callbacks: {
                title: function (items) { return items.length ? learnerChart.labels[items[0].dataIndex] : ''; },
                label: function (item) { return (item.parsed.x > 0 ? '+' : '') + item.parsed.x + ' points'; }
              }
            }
          },
          scales: {
            x: { grid: { color: 'rgba(0,0,0,0.06)' }, ticks: { font: { size: 11 } }, title: { display: true, text: 'Points', font: { size: 11 } } },
            y: {
              grid: { display: false },
              ticks: {
                font: { size: 11 },
                callback: function (value) {
                  var label = String(this.getLabelForValue(value) || '');
                  return label.length > 26 ? label.slice(0, 24) + '…' : label;
                }
              }
            }
          }
        }
      });
    });

    whenShown(document.getElementById('levelChart'), function (canvas) {
      new Chart(canvas.getContext('2d'), {
        type: 'doughnut',
        data: {
          labels: <%- JSON.stringify(Object.keys(a.levels || {})) %>,
          datasets: [{
            data: <%- JSON.stringify(Object.values(a.levels || {})) %>,
            // Beginner, Intermediate, Advance, Not yet assessed. The last is
            // deliberately grey: it is an absence of data, not a bad result.
            backgroundColor: ['#d54c4c', '#d28a1f', '#32a65a', '#9aa4ae'],
            borderWidth: 0
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          cutout: '62%',
          plugins: { legend: { position: 'bottom', labels: { usePointStyle: true, boxWidth: 8, padding: 10, font: { size: 11 } } } }
        }
      });
    });
  });
</script>
