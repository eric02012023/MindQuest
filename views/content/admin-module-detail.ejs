<%# File: views/content/admin-module-detail.ejs
    Purpose: Admin view of a single module — the one grade level it is for, its
    number within that grade, and its handout files. Handouts are both the
    student's study material and the source text the AI writes that grade's
    Pre-Assessment from, so adding or removing one rebuilds that assessment. %>
<%
  // The numbers each grade's other modules use, for the settings form's check.
  const numbersByGrade = {};
  (siblingModules || []).forEach((m) => {
    if (!m.grade_level) return;
    (numbersByGrade[m.grade_level] = numbersByGrade[m.grade_level] || []).push({ n: Number(m.order_number), title: m.title });
  });
%>
<section class="page-stack">
  <div class="toolbar-card split">
    <div>
      <h2>Module <%= mod.order_number %> — <%= mod.title %></h2>
      <p class="module-breadcrumb">
        <a href="<%= basePath %>/subjects/<%= mod.subject_id %>"><%= mod.subject_name %></a>
        &middot; <%= mod.grade_level || 'No grade level — hidden from students' %>
      </p>
    </div>
    <div class="row-actions">
      <a class="btn btn-secondary" href="<%= basePath %>/subjects/<%= mod.subject_id %>">Back to Subject</a>
    </div>
  </div>

  <%# The build status sits directly above the upload form: uploading a handout is
      what triggers the build, so this is where its outcome belongs. %>
  <section class="panel-card">
    <%- include('../partials/pre-assessment-status', { preStatus, warmup }) %>
  </section>

  <section class="panel-card">
    <div class="panel-card-head">
      <h3>Handouts</h3>
      <span class="badge <%= handouts.length ? 'badge-success' : 'badge-warning' %>">
        <%= handouts.length %> file<%= handouts.length === 1 ? '' : 's' %>
      </span>
    </div>

    <% if (currentUser.role === 'admin') { %>
      <form method="post" action="<%= basePath %>/modules/<%= mod.id %>/handouts" enctype="multipart/form-data" class="stack-form handout-upload-form">
        <label>Handout files
          <input type="file" name="handouts" multiple accept=".pdf,.doc,.docx,.ppt,.pptx,.xls,.xlsx,.txt" required />
        </label>
        <p class="empty-state">You can select several files at once. PDF, DOC, DOCX, PPT, PPTX, XLS, XLSX or TXT, up to 25 MB each.</p>
        <button type="submit" class="btn btn-primary">Upload Handouts</button>
      </form>
    <% } else { %>
      <p class="empty-state">Assistant admin can view handouts only.</p>
    <% } %>

    <% if (!handouts.length) { %>
      <p class="empty-state">No handouts yet. The <%= mod.grade_level || '' %> Pre-Assessment for this subject is written from its grade's handouts, so it cannot be generated until at least one exists.</p>
    <% } %>

    <div class="handout-grid">
      <% handouts.forEach((handout) => { %>
        <article class="handout-card">
          <div class="handout-card-head">
            <span class="handout-ext"><%= ((handout.file_original_name || '').split('.').pop() || 'file').toUpperCase() %></span>
            <%# "Not usable" rather than "failed": a scanned PDF is a perfectly
                valid handout for students to read, it just has no text layer to
                generate questions from. The reason is spelled out below. %>
            <% if (handout.extracted_at && handout.extraction_method === 'ocr') { %>
              <span class="badge badge-success">Text ready (AI-read scan)</span>
            <% } else if (handout.extracted_at) { %>
              <span class="badge badge-success">Text ready</span>
            <% } else if (handout.extraction_error) { %>
              <span class="badge badge-warning">No text for questions</span>
            <% } else { %>
              <span class="badge badge-info">Not read yet</span>
            <% } %>
          </div>

          <h4><%= handout.file_original_name || handout.title || 'Handout' %></h4>
          <p class="handout-meta">
            <%= handout.file_size_bytes ? (Math.round(Number(handout.file_size_bytes) / 1024) + ' KB') : 'size unknown' %>
            · <%= formatDate(handout.created_at) %>
          </p>
          <% if (handout.extracted_at) { %>
            <p class="handout-meta">
              <%= (handout.extracted_text || '').length.toLocaleString() %> characters feed question generation
            </p>
          <% } %>
          <% if (handout.first_name) { %>
            <p class="handout-meta">Uploaded by <%= handout.first_name %> <%= handout.last_name || '' %></p>
          <% } %>
          <% if (handout.extraction_error) { %>
            <p class="handout-error"><%= handout.extraction_error %></p>
          <% } %>

          <div class="handout-card-foot">
            <a class="btn btn-secondary btn-sm" href="<%= handout.file_path %>" target="_blank" rel="noopener">Open</a>
            <% if (currentUser.role === 'admin') { %>
              <% if (!handout.extracted_at) { %>
                <form method="post" action="<%= basePath %>/modules/<%= mod.id %>/handouts/<%= handout.id %>/extract">
                  <button class="btn btn-primary btn-sm" type="submit">Read with AI</button>
                </form>
              <% } %>
              <form method="post" action="<%= basePath %>/modules/<%= mod.id %>/handouts/<%= handout.id %>/delete" data-confirm-message="Remove this handout? The Pre-Assessment will regenerate from the remaining handouts.">
                <button class="btn btn-secondary btn-sm" type="submit">Remove</button>
              </form>
            <% } %>
          </div>
        </article>
      <% }) %>
    </div>
  </section>

  <%# The module written again for each level (lib/levelModules.js). A level
      appears once a student of it finishes the Pre-Assessment, or when made
      here; the main admin can have one written again. %>
  <%
    const levelRows = typeof levelModules === 'undefined' ? {} : (levelModules || {});
    const levelNames = typeof levels === 'undefined' ? ['Beginner', 'Intermediate', 'Advance'] : levels;
    const levelStatus = (row) => !row ? 'Not made yet'
      : row.status === 'ready' ? (row.is_stale ? 'Ready · handouts changed since' : 'Ready')
        : row.status === 'failed' ? 'Could not be written' : 'Being written';
  %>
  <link rel="stylesheet" href="/css/level-modules.css" />
  <section class="panel-card">
    <div class="panel-card-head"><h3>Level Modules</h3></div>
    <div class="lm-level-grid">
      <% levelNames.forEach((level) => { %>
        <% const row = levelRows[level] || null; %>
        <article class="lm-level-card">
          <div class="lm-level-card-head">
            <span class="lm-level lm-level-<%= level.toLowerCase() %>"><%= level %></span>
            <span class="lm-status lm-status-<%= row ? row.status : 'none' %>"><%= levelStatus(row) %></span>
          </div>
          <% if (row) { %>
            <p class="lm-level-card-meta">
              <%= Number(row.assessment_count || 0) %> activit<%= Number(row.assessment_count || 0) === 1 ? 'y' : 'ies' %>
              <% if (Number(row.section_count || 0)) { %>&middot; <%= row.section_count %> lesson part<%= Number(row.section_count) === 1 ? '' : 's' %><% } %>
            </p>
            <% if (row.error_message) { %>
              <p class="lm-level-card-error"><%= row.error_message %></p>
            <% } %>
          <% } %>
          <div class="lm-level-card-actions">
            <% if (row) { %>
              <a class="btn btn-secondary btn-sm" href="<%= basePath %>/level-modules/<%= row.id %>">Open</a>
            <% } %>
            <% if (currentUser.role === 'admin' && (!row || row.status !== 'generating')) { %>
              <form method="post" action="<%= basePath %>/modules/<%= mod.id %>/levels/<%= level %>/make"
                    <% if (row && row.status === 'ready') { %>data-confirm-message="Write the <%= level %> lesson again from this module's handouts? It replaces the lesson students read now. Activities stay."<% } %>>
                <button class="btn btn-primary btn-sm" type="submit"><%= !row ? 'Make' : row.status === 'ready' ? 'Write Again' : 'Try Again' %></button>
              </form>
            <% } %>
          </div>
        </article>
      <% }) %>
    </div>
  </section>

  <section class="panel-card">
    <div class="panel-card-head"><h3>Module Settings</h3></div>
    <% if (currentUser.role === 'admin') { %>
      <form method="post" action="<%= basePath %>/modules/<%= mod.id %>/update" class="stack-form"
            data-module-number-form data-keep-number data-numbers-by-grade="<%= JSON.stringify(numbersByGrade) %>">
        <label class="field">
          <span class="field-label">Grade Level</span>
          <select name="grade_level" required data-module-grade>
            <option value="" <%= mod.grade_level ? '' : 'selected' %>>Choose a grade level</option>
            <% moduleTargetOptions.forEach((opt) => { %>
              <optgroup label="<%= opt.group %>">
                <% opt.grades.forEach((grade) => { %>
                  <option value="<%= grade %>" <%= mod.grade_level === grade ? 'selected' : '' %>><%= grade %></option>
                <% }) %>
              </optgroup>
            <% }) %>
          </select>
          <span class="field-hint">Only students in this grade who take <%= mod.subject_name %> see this module.</span>
        </label>
        <label class="field">
          <span class="field-label">Module Number</span>
          <input type="number" name="order_number" min="1" max="<%= maxModuleNumber %>"
                 value="<%= mod.order_number %>" required data-module-number />
          <span class="field-hint" data-module-number-hint>Numbers count within the grade level.</span>
        </label>
        <label class="field">
          <span class="field-label">Module Title</span>
          <input type="text" name="title" value="<%= mod.title %>" required />
        </label>
        <label class="field">
          <span class="field-label">Description</span>
          <textarea name="description" rows="3"><%= mod.description || '' %></textarea>
        </label>

        <div class="row-actions">
          <button type="submit" class="btn btn-primary">Save Changes</button>
        </div>
      </form>
    <% } else { %>
      <div class="module-card-targets">
        <strong>Grade level</strong>
        <div class="target-chips">
          <% if (mod.grade_level) { %>
            <span class="target-chip"><%= mod.grade_level %></span>
          <% } else { %>
            <span class="badge badge-warning">No grade level — hidden from students</span>
          <% } %>
        </div>
      </div>
    <% } %>
  </section>

  <% if (currentUser.role === 'admin') { %>
    <section class="panel-card">
      <div class="panel-card-head"><h3>Remove Module</h3></div>
      <p class="table-note">Removing this module hides it from students and stops its handouts feeding assessment generation. Existing student results are kept.</p>
      <form method="post" action="<%= basePath %>/modules/<%= mod.id %>/archive" data-confirm-message="Remove this module and all its handouts from students?">
        <button class="btn btn-secondary" type="submit">Remove Module <%= mod.order_number %></button>
      </form>
    </section>
  <% } %>
</section>
