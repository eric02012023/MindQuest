<%# File: views/content/admin-billing.ejs
    Purpose: Student Billing — the append-only payment ledger.

    WHAT CHANGED AND WHY
    The old page had an "Edit" button whose form contained a Partial Payment
    field. Saving it OVERWROTE the stored figure, so recording a second payment
    destroyed the record of the first, and nothing said who had taken either one.

    This page has no such field. Money is added with the "+" button, which opens a
    small form and APPENDS one entry to that student's ledger. The first entry is
    shown with a lock: it, like every other entry, can never be edited or removed,
    because no route exists that would do it. Corrections are made by adding an
    adjusting entry with a reason.

    "Edit billing" survives, but it now only edits the HEADER — the amount owed,
    the due date, the SOA type. Never the money received.

    Locals: billingRows (each with .entries and .totals), billingTotals, pager,
            paymentMethods, paymentPurposes, openPayStudentId, openInfoStudentId,
            openEditStudentId %>
<%
  const pagerState = typeof pager === 'undefined' ? null : pager;
  const currentQuery = typeof query === 'undefined' ? {} : query;
  const totals = billingTotals || { billed: 0, paid: 0, remaining: 0, settled: 0, accounts: 0 };
  const today = new Date().toISOString().slice(0, 10);
  const nameOf = (row) => `${titleCaseName(row.first_name)} ${titleCaseName(row.middle_name || '')} ${titleCaseName(row.last_name)}`.replace(/\s+/g, ' ').trim();
%>
<section class="mq-page">

  <div class="mq-summary">
    <div class="mq-summary-item">
      <span>Total billed</span><strong><%= money(totals.billed) %></strong>
    </div>
    <div class="mq-summary-item is-positive">
      <span>Total paid</span><strong><%= money(totals.paid) %></strong>
    </div>
    <div class="mq-summary-item is-negative">
      <span>Remaining balance</span><strong><%= money(totals.remaining) %></strong>
    </div>
    <div class="mq-summary-item">
      <span>Settled accounts</span><strong><%= totals.settled %> / <%= totals.accounts %></strong>
    </div>
  </div>

  <form class="mq-toolbar" method="get" action="<%= basePath %>/billing">
    <div class="mq-filters">
      <label class="mq-field mq-field-search">
        <span>Search</span>
        <input type="search" name="search" value="<%= search || '' %>" placeholder="Student name, ID or branch" />
      </label>
      <label class="mq-field">
        <span>Status</span>
        <select name="status" onchange="this.form.submit()">
          <option value="all" <%= selectedStatus === 'all' ? 'selected' : '' %>>All</option>
          <option value="unpaid" <%= selectedStatus === 'unpaid' ? 'selected' : '' %>>Unpaid</option>
          <option value="partial" <%= selectedStatus === 'partial' ? 'selected' : '' %>>Partial</option>
          <option value="paid" <%= selectedStatus === 'paid' ? 'selected' : '' %>>Paid</option>
        </select>
      </label>
      <% if (currentUser.role === 'admin') { %>
        <label class="mq-field">
          <span>Branch</span>
          <select name="branch_id" onchange="this.form.submit()">
            <option value="all">All branches</option>
            <% branches.forEach((branch) => { %>
              <option value="<%= branch.id %>" <%= Number(effectiveBranchId) === Number(branch.id) ? 'selected' : '' %>><%= branch.name %></option>
            <% }) %>
          </select>
        </label>
      <% } %>
      <button class="mq-btn" type="submit"><%- icon('search') %> Search</button>
    </div>

    <div class="mq-toolbar-actions">
      <a class="mq-btn" href="<%= basePath %>/income-report"><%- icon('chart') %> Income report</a>
      <a class="mq-btn" href="<%= basePath %>/payments/history"><%- icon('receipt') %> Payment history</a>
      <button type="button" class="mq-btn" data-modal-target="#reenroll-students-modal">Re-enroll</button>
    </div>
  </form>

  <section class="mq-panel">
    <div class="mq-panel-head">
      <div>
        <h2>Student payment records</h2>
        <p>Use <strong>+</strong> to add a payment. Entries are appended — nothing is ever overwritten.</p>
      </div>
      <span class="mq-count"><%= pagerState ? pagerState.total : billingRows.length %> account<%= (pagerState ? pagerState.total : billingRows.length) === 1 ? '' : 's' %></span>
    </div>

    <div class="mq-table" style="--mq-min-width: 1006px; --mq-cols: minmax(170px, 2fr) 1fr 110px 110px 110px 60px 110px 120px;">
      <div class="mq-head">
        <span>Student</span>
        <span>Branch</span>
        <span class="mq-num">Billed</span>
        <span class="mq-num">Paid</span>
        <span class="mq-num">Balance</span>
        <span class="mq-num">Pmts</span>
        <span>Status</span>
        <span style="text-align:right;">Actions</span>
      </div>

      <% if (!billingRows.length) { %>
        <div class="mq-empty">
          <strong>No billing records found</strong>
          Try a different search term, or clear the filters above.
        </div>
      <% } %>

      <% billingRows.forEach((row) => { const t = row.totals; %>
        <div class="mq-row">
          <span class="mq-cell mq-cell-primary" data-label="Student">
            <a class="mq-name" href="<%= basePath %>/profile/<%= row.student_id %>"><%= nameOf(row) %></a>
            <span class="mq-sub"><%= row.user_id %> · due <%= row.payment_due ? formatDate(row.payment_due) : 'not set' %></span>
          </span>

          <span class="mq-cell" data-label="Branch"><%= row.branch_name || '—' %></span>
          <span class="mq-cell mq-money" data-label="Billed"><%= money(t.totalBilled) %></span>
          <span class="mq-cell mq-money mq-money-paid" data-label="Paid"><%= money(t.totalPaid) %></span>
          <span class="mq-cell mq-money <%= t.remaining > 0 ? 'mq-money-due' : '' %>" data-label="Balance"><%= money(t.remaining) %></span>
          <span class="mq-cell mq-num" data-label="Payments"><%= t.paymentCount %></span>

          <span class="mq-cell" data-label="Status">
            <span class="mq-status mq-status-<%= row.payment_status %>"><%= row.payment_status %></span>
          </span>

          <span class="mq-cell mq-cell-actions">
            <button type="button" class="mq-icon mq-icon-add" onclick="openBillingModal('pay-<%= row.student_id %>')"
                    title="Add a payment" aria-label="Add a payment"><%- icon('add') %></button>
            <button type="button" class="mq-icon" onclick="openBillingModal('bill-<%= row.student_id %>')"
                    title="Payment record &amp; SOA" aria-label="Payment record and SOA"><%- icon('receipt') %></button>
            <button type="button" class="mq-icon" onclick="openBillingModal('edit-bill-<%= row.student_id %>')"
                    title="Edit the bill (amount owed, due date)" aria-label="Edit the bill"><%- icon('edit') %></button>
          </span>
        </div>
      <% }) %>

      <% if (pagerState) { %>
        <%- include('../partials/mq-pager', { pager: pagerState, baseUrl: `${basePath}/billing`, params: currentQuery, noun: 'account' }) %>
      <% } %>
    </div>
  </section>

  <%# ================================================================== modals
      One set per student on the current page: add payment, ledger + SOA, and
      the header edit. Paging keeps that bounded. %>

  <% billingRows.forEach((row) => { const t = row.totals; const name = nameOf(row); %>

    <%# ---------------------------------------------------- + Add Payment %>
    <div class="global-modal <%= String(openPayStudentId || '') === String(row.student_id) ? 'is-open' : '' %>"
         id="pay-<%= row.student_id %>"
         <%= String(openPayStudentId || '') === String(row.student_id) ? 'data-force-open="true"' : '' %>>
      <div class="global-modal-card wide">
        <button type="button" class="modal-close" data-close-modal>&times;</button>
        <h3>Add payment — <%= name %></h3>

        <div class="mq-summary" style="margin-bottom:12px;">
          <div class="mq-summary-item"><span>Total billed</span><strong><%= money(t.totalBilled) %></strong></div>
          <div class="mq-summary-item is-positive"><span>Total paid</span><strong><%= money(t.totalPaid) %></strong></div>
          <div class="mq-summary-item is-negative"><span>Remaining</span><strong><%= money(t.remaining) %></strong></div>
        </div>

        <form class="mq-form" method="post" action="<%= basePath %>/billing/<%= row.student_id %>/payments"
              data-confirm-message="Add this payment to <%= name %>'s record? Payments cannot be edited or removed afterwards.">
          <input type="hidden" name="student_id" value="<%= row.student_id %>" />

          <label>Amount received
            <input type="number" name="amount" step="0.01" min="0.01"
                   value="<%= t.remaining > 0 ? t.remaining.toFixed(2) : '' %>" required autocomplete="off" />
          </label>

          <label>Payment method
            <select name="payment_method">
              <% (paymentMethods || []).forEach((method) => { %>
                <option value="<%= method.value %>"><%= method.label %></option>
              <% }) %>
            </select>
          </label>

          <label>Purpose
            <select name="purpose">
              <% (paymentPurposes || []).forEach((purpose) => { %>
                <option value="<%= purpose %>"><%= purpose %></option>
              <% }) %>
            </select>
          </label>

          <label>Date received
            <input type="date" name="paid_at" value="<%= today %>" />
          </label>

          <label>Reference / OR number
            <input type="text" name="reference_no" placeholder="Optional" autocomplete="off" />
          </label>

          <label class="is-wide">Notes
            <textarea name="notes" rows="2" placeholder="Optional — e.g. paid at Mabuhay branch, received by front desk"></textarea>
          </label>

          <p class="mq-form-note">
            This will be recorded as payment <strong>#<%= t.paymentCount + 1 %></strong> for <%= name %>,
            logged against <strong><%= titleCaseName(currentUser.first_name) %> <%= titleCaseName(currentUser.last_name || '') %></strong>
            (<%= currentUser.role === 'admin' ? 'Admin' : 'Assistant Admin' %>) with today's date and time.
            Previous payments are not affected.
          </p>

          <div class="mq-form-foot">
            <button type="button" class="mq-btn" data-close-modal>Cancel</button>
            <button class="mq-btn mq-btn-primary" type="submit"><%- icon('check') %> Record payment</button>
          </div>
        </form>
      </div>
    </div>

    <%# --------------------------------------------- Payment record + SOA %>
    <div class="global-modal <%= String(openInfoStudentId || '') === String(row.student_id) ? 'is-open' : '' %>"
         id="bill-<%= row.student_id %>"
         <%= String(openInfoStudentId || '') === String(row.student_id) ? 'data-force-open="true"' : '' %>>
      <div class="global-modal-card extra-wide">
        <button type="button" class="modal-close" data-close-modal>&times;</button>
        <h3>Payment record — <%= name %></h3>

        <div class="bill-print-area">
          <div class="mq-detail">
            <div class="mq-detail-item"><span>Student ID</span><strong><%= row.user_id %></strong></div>
            <div class="mq-detail-item"><span>Branch</span><strong><%= row.branch_name || '—' %></strong></div>
            <div class="mq-detail-item"><span>Contact</span><strong><%= row.contact_number || '—' %></strong></div>
            <div class="mq-detail-item"><span>SOA type</span><strong><%= row.soa_type || 'Regular SOA' %></strong></div>
            <div class="mq-detail-item"><span>Payment due</span><strong><%= row.payment_due ? formatDate(row.payment_due) : 'Not set' %></strong></div>
            <div class="mq-detail-item is-wide"><span>Address</span><strong><%= row.address || '—' %></strong></div>
          </div>

          <div class="mq-summary" style="margin:0 16px 12px;">
            <div class="mq-summary-item"><span>Total billed</span><strong><%= money(t.totalBilled) %></strong></div>
            <div class="mq-summary-item is-positive"><span>Total paid</span><strong><%= money(t.totalPaid) %></strong></div>
            <div class="mq-summary-item is-negative"><span>Remaining balance</span><strong><%= money(t.remaining) %></strong></div>
            <div class="mq-summary-item"><span>Payments made</span><strong><%= t.paymentCount %></strong></div>
          </div>

          <div class="mq-panel" style="margin:0 16px 16px;">
            <div class="mq-panel-head"><h3>Payment history</h3><span class="mq-count"><%= t.paymentCount %> entr<%= t.paymentCount === 1 ? 'y' : 'ies' %></span></div>
            <div class="mq-table" style="--mq-cols: 48px 150px 110px 120px minmax(140px, 1.4fr) 110px;">
              <div class="mq-head">
                <span>#</span><span>Date &amp; time</span><span class="mq-num">Amount</span>
                <span>Method</span><span>Recorded by</span><span class="mq-num">Balance</span>
              </div>
              <% if (!row.entries.length) { %>
                <div class="mq-empty">No payments recorded yet. Use the <strong>+</strong> button to add the first one.</div>
              <% } %>
              <% row.entries.forEach((entry) => { %>
                <div class="mq-row">
                  <span class="mq-cell" data-label="#">
                    <%= entry.sequence_no %>
                    <% if (Number(entry.is_locked) === 1) { %>
                      <span title="First payment — locked" aria-label="Locked" style="color:var(--mq-text-soft);"><%- icon('lock', 12) %></span>
                    <% } %>
                  </span>
                  <span class="mq-cell mq-sub" data-label="Date"><%= formatDateTime(entry.paid_at) %></span>
                  <span class="mq-cell mq-money" data-label="Amount"><%= money(entry.amount) %></span>
                  <span class="mq-cell" data-label="Method"><span class="mq-chip"><%= entry.payment_method || 'Cash' %></span></span>
                  <span class="mq-cell mq-sub" data-label="Recorded by">
                    <%= entry.recorded_by_name
                        || (entry.recorder_first_name ? `${entry.recorder_first_name} ${entry.recorder_last_name || ''}` : 'System') %>
                    <% if (entry.recorded_by_role) { %>(<%= entry.recorded_by_role === 'admin' ? 'Admin' : entry.recorded_by_role === 'admin_assistant' ? 'Assistant' : entry.recorded_by_role %>)<% } %>
                  </span>
                  <span class="mq-cell mq-num mq-sub" data-label="Balance after"><%= money(entry.balance_after) %></span>
                </div>
              <% }) %>
            </div>
          </div>
        </div>

        <div class="mq-form-foot print-hide" style="padding:0 16px 16px;">
          <button type="button" class="mq-btn mq-btn-primary" onclick="openBillingModal('pay-<%= row.student_id %>')"><%- icon('add') %> Add payment</button>
          <form method="post" action="<%= basePath %>/billing/<%= row.student_id %>/post-soa" data-confirm-message="Post this SOA to the student's Billing Data page?">
            <input type="hidden" name="student_id" value="<%= row.student_id %>" />
            <button class="mq-btn" type="submit"><%- icon('receipt') %> Post SOA</button>
          </form>
          <button class="mq-btn" type="button" onclick="printBillModal('bill-<%= row.student_id %>')"><%- icon('print') %> Print</button>
        </div>
      </div>
    </div>

    <%# ------------------------------------------------- Edit the header %>
    <div class="global-modal <%= String(openEditStudentId || '') === String(row.student_id) ? 'is-open' : '' %>"
         id="edit-bill-<%= row.student_id %>"
         <%= String(openEditStudentId || '') === String(row.student_id) ? 'data-force-open="true"' : '' %>>
      <div class="global-modal-card wide">
        <button type="button" class="modal-close" data-close-modal>&times;</button>
        <h3>Edit bill — <%= name %></h3>

        <form class="mq-form" method="post" action="<%= basePath %>/billing/<%= row.student_id %>/update">
          <input type="hidden" name="student_id" value="<%= row.student_id %>" />
          <input type="hidden" name="billing_student_id" value="<%= row.student_id %>" />
          <input type="hidden" name="user_id" value="<%= row.user_id %>" />

          <label>Student<input type="text" value="<%= name %>" readonly /></label>
          <label>Total billed
            <input type="number" step="0.01" min="<%= t.totalPaid %>" name="full_bill" value="<%= Number(row.full_bill).toFixed(2) %>" required />
          </label>
          <label>SOA type
            <select name="soa_type">
              <option value="Regular SOA" <%= row.soa_type === 'Regular SOA' ? 'selected' : '' %>>Regular SOA</option>
              <option value="Promissory SOA" <%= row.soa_type === 'Promissory SOA' ? 'selected' : '' %>>Promissory SOA</option>
            </select>
          </label>
          <label>Payment due date
            <input type="date" name="payment_due" value="<%= toInputDate(row.payment_due) %>" />
          </label>
          <label class="is-wide">Notes
            <textarea name="notes" rows="2"><%= row.notes || '' %></textarea>
          </label>

          <p class="mq-form-note">
            This form sets what the student <em>owes</em>. Money <em>received</em> is not editable here —
            it is the sum of the <%= t.paymentCount %> ledger entr<%= t.paymentCount === 1 ? 'y' : 'ies' %>
            (<%= money(t.totalPaid) %>), so the total billed cannot be set below that.
            To record another payment, use the <strong>+</strong> button.
          </p>

          <div class="mq-form-foot">
            <button type="button" class="mq-btn" data-close-modal>Cancel</button>
            <button class="mq-btn mq-btn-primary" type="submit">Save bill</button>
          </div>
        </form>
      </div>
    </div>
  <% }) %>

  <div class="global-modal" id="reenroll-students-modal">
    <div class="global-modal-card wide modal-scroll-box" style="max-height:80vh;overflow:auto;">
      <button type="button" class="modal-close" data-close-modal>&times;</button>
      <h3>Re-enroll students</h3>
      <form method="post" action="<%= basePath %>/billing/reenroll" class="stack-form">
        <div class="list-stack">
          <% const seen = new Set(); %>
          <% if (!(paymentHistory || []).length) { %><p class="mq-empty">No students in payment history.</p><% } %>
          <% (paymentHistory || []).forEach((item) => {
               const key = String(item.student_id);
               if (seen.has(key)) return;
               seen.add(key); %>
            <label class="checkbox-card">
              <input type="checkbox" name="student_ids" value="<%= item.student_id %>" />
              <span><strong><%= titleCaseName(item.first_name) %> <%= titleCaseName(item.last_name) %></strong> — <%= item.user_id %> — <%= item.branch_name || '—' %></span>
            </label>
          <% }) %>
        </div>
        <div class="mq-form-foot" style="margin-top:12px;">
          <button class="mq-btn mq-btn-primary" type="submit">Confirm re-enroll</button>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  // Opening one billing dialog closes any other, so two stacked modals can never
  // both claim the same student's record.
  function openBillingModal(id) {
    var modal = document.getElementById(id);
    if (!modal) return;
    document.querySelectorAll('.global-modal.is-open').forEach(function (item) {
      if (item !== modal) item.classList.remove('is-open');
    });
    modal.classList.add('is-open');
    var firstField = modal.querySelector('input:not([type=hidden]):not([readonly]), select, textarea');
    if (firstField) firstField.focus();
  }
</script>
