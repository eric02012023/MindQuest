<%# File: views/forgot-password.ejs | Purpose: Forgot password form — user enters their email to receive a reset OTP. %>
<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { pageTitle, pageCss: ['/css/auth/login.css', '/css/auth/forgot-password.css'] }) %>
<body class="auth-login-page plain-page login-page design-auth-page">
  <section class="login-shell">
    <div class="login-panel login-form-panel">
      <div class="login-brand">Forgot Password</div>
      <form action="/forgot-password" method="post" class="login-form-grid">
        <p style="margin:0 0 8px;color:#d7e5f1;">Enter the email address linked to your account. We'll send a 4-digit OTP so you can reset your password.</p>
        <label>
          <span>Email <span class="required-mark">*</span></span>
          <input type="email" name="email" required />
        </label>
        <button type="submit" class="login-submit-btn">Send OTP</button>
      </form>
      <div class="login-link-row">
        <a href="/login">Back to Login</a>
      </div>
    </div>
    <div class="login-panel login-info-panel">
      <img src="/assets/logo.jpeg" alt="Logo" />
      <h1>RESET YOUR<br>PASSWORD</h1>
      <p>Don't worry — it happens to the best of us!</p>
    </div>
  </section>
  <%- include('partials/flash-modal', { flash }) %>
  <script src="/js/main.js"></script>
</body>
</html>
