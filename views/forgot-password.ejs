<%# File: views/forgot-password.ejs | Purpose: Forgot password form — user enters their email to receive a reset OTP. %>
<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { pageTitle, pageCss: '/css/auth/forgot-password.css' }) %>
<body class="forgot-pw-page">
  <div class="forgot-pw-card">
    <div class="forgot-pw-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        <circle cx="12" cy="16" r="1"/>
      </svg>
    </div>
    <h1 class="forgot-pw-title">Forgot Password?</h1>
    <p class="forgot-pw-subtitle">No worries! Enter your email and we'll send you a 4-digit OTP to reset your password.</p>
    <form action="/forgot-password" method="post" class="forgot-pw-form">
      <label class="forgot-pw-label">
        <span>Email Address <span class="required-mark">*</span></span>
        <input type="email" name="email" placeholder="Enter your registered email" required />
      </label>
      <button type="submit" class="forgot-pw-btn">Send OTP</button>
    </form>
    <div class="forgot-pw-footer">
      <a href="/login" class="forgot-pw-back">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
        Back to Login
      </a>
    </div>
  </div>
  <%- include('partials/flash-modal', { flash }) %>
  <script src="/js/main.js"></script>
</body>
</html>
