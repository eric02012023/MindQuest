<%# ANNOTATED COPY FOR DEFENSE REVIEW | File: views/shells/dashboard.ejs | Purpose: UI template/view used by the system. %>
<!DOCTYPE html>
<html lang="en">
<%
  const roleFolder = basePath === '/assistant' ? 'assistant-admin' : String(basePath || '').replace(/^\//, '') || 'public';
  // Each page's stylesheet also carries the base layout (the former global.css),
  // so a section with no sheet of its own would 404 and lose the whole shell.
  // New sections are therefore mapped onto a sheet that EXISTS FOR THAT ROLE —
  // the folders differ, so the map has to be per role, not shared. The new
  // sections' own look comes from the shared /css/mq-data.css.
  const sectionMap = {
    archive_notifications: 'notification-archives',
    notification_history: 'notification-history',
    payment_history: 'payment-history',
    income: 'dashboard'
  };
  const roleSectionMap = {
    admin: { notifications: 'notification-history' },
    'assistant-admin': { notifications: 'notification-history', students: 'users', tutors: 'users' },
    tutor: { focus: 'modules' },
    student: {}
  };
  Object.assign(sectionMap, roleSectionMap[roleFolder] || {});
  const sectionSlug = sectionMap[section] || String(section || 'dashboard').replace(/_/g, '-');
  const roleThemeCss = `/css/${roleFolder}/theme.css`;
  const shellPageCss = `/css/${roleFolder}/${sectionSlug}.css`;
  const shellPageClass = `${roleFolder}-${sectionSlug}-page`;
  const shellStyles = [roleThemeCss, shellPageCss];
%>
<%- include('../partials/head', { pageTitle, pageCss: shellStyles }) %>
<body class="dashboard-body <%= shellPageClass %>">
  <div class="dashboard-shell">
    <%# pendingPaymentCount / focusHandoutCount are passed explicitly: an include
        gets only the locals handed to it, so a badge that reads an undefined
        local would throw rather than simply not render. %>
    <%- include('../partials/sidebar', {
      basePath, section, roleName, currentUser,
      pendingPaymentCount: typeof pendingPaymentCount === 'undefined' ? 0 : pendingPaymentCount,
      focusHandoutCount: typeof focusHandoutCount === 'undefined' ? 0 : focusHandoutCount
    }) %>
    <div class="sidebar-overlay" data-sidebar-overlay></div>
    <div class="dashboard-main">
      <%- include('../partials/dashboard-topbar', {
        basePath, pageTitle, currentUser,
        notificationCount: typeof notificationCount === 'undefined' ? 0 : notificationCount,
        inboxNotifications: typeof inboxNotifications === 'undefined' ? [] : inboxNotifications,
        alerts: typeof alerts === 'undefined' ? [] : alerts
      }) %>
      <main class="dashboard-content">
        <div class="page-wrapper <%= shellPageClass %>-wrapper">
          <%- include(contentView) %>
        </div>
      </main>
    </div>
  </div>
  <%- include('../partials/flash-modal', { flash }) %>
  <script>
    window.mqtcUser = <%- JSON.stringify(currentUser || null) %>;
  </script>
  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/main.js"></script>
  <script src="/js/dashboard.js"></script>
  <script src="/js/messages.js"></script>
  <script src="/js/calls.js"></script>

  <!-- Global Loading Overlay -->
  <div id="mqtc-loading-overlay" style="display:none;">
    <div class="mqtc-loading-content">
      <div class="mqtc-dot-loader">
        <span></span><span></span><span></span>
      </div>
      <p id="mqtc-loading-text">Loading...</p>
    </div>
  </div>
  <style>
    /* Student name clickable link */
    .student-name-link {
      color: var(--primary, #1a5632);
      text-decoration: none;
      transition: all 0.2s ease;
      border-bottom: 1px dashed transparent;
    }
    .student-name-link:hover {
      color: var(--primary-dark, #0d3b1e);
      border-bottom-color: var(--primary, #1a5632);
    }
    .student-name-link strong {
      color: inherit;
    }

    /* Loading overlay */
    #mqtc-loading-overlay {
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(0,0,0,0.45);
      backdrop-filter: blur(4px);
      z-index: 99998;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .mqtc-loading-content {
      text-align: center;
      color: #fff;
    }
    .mqtc-loading-content p {
      margin-top: 16px;
      font-size: 15px;
      font-weight: 500;
      letter-spacing: 0.5px;
    }
    .mqtc-dot-loader {
      display: flex;
      gap: 8px;
      justify-content: center;
    }
    .mqtc-dot-loader span {
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background: #fff;
      animation: mqtcDotBounce 1.2s infinite ease-in-out;
    }
    .mqtc-dot-loader span:nth-child(1) { animation-delay: 0s; }
    .mqtc-dot-loader span:nth-child(2) { animation-delay: 0.15s; }
    .mqtc-dot-loader span:nth-child(3) { animation-delay: 0.3s; }
    @keyframes mqtcDotBounce {
      0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
      40% { transform: scale(1); opacity: 1; }
    }
  </style>
  <script>
    // Show loading overlay on navigation and form submission
    (function() {
      var overlay = document.getElementById('mqtc-loading-overlay');
      var loadingText = document.getElementById('mqtc-loading-text');
      if (!overlay) return;

      function showLoading(msg) {
        if (loadingText) loadingText.textContent = msg || 'Loading...';
        overlay.style.display = 'flex';
      }

      // Show loading on link clicks (internal navigation)
      document.addEventListener('click', function(e) {
        var link = e.target.closest('a[href]');
        if (link && !link.target && !link.href.startsWith('javascript') && !link.href.includes('#') && !link.getAttribute('download')) {
          var url = link.getAttribute('href');
          if (url && url.startsWith('/') && !e.ctrlKey && !e.metaKey && !e.shiftKey) {
            showLoading('Loading page...');
          }
        }
      });

      // Show loading on form submission
      document.addEventListener('submit', function(e) {
        var form = e.target;
        if (!(form instanceof HTMLFormElement)) return;
        // Skip if it has a confirm message (handled by confirm modal first)
        if (form.getAttribute('data-confirm-message') && form.dataset.confirmed !== 'true') return;
        var action = form.getAttribute('action') || '';
        if (action.includes('draft-assessment')) {
          showLoading('Drafting questions from the handouts...');
        } else if (action.includes('pre-assessment') || action.includes('post-assessment')) {
          showLoading('Preparing your assessment...');
        } else if (action.includes('submit')) {
          showLoading('Submitting...');
        } else if (action.includes('pay')) {
          showLoading('Processing payment...');
        } else {
          showLoading('Processing...');
        }
      });

      // Hide loading when page is fully loaded (for back/forward navigation)
      window.addEventListener('pageshow', function() {
        overlay.style.display = 'none';
      });
    })();
  </script>
</body>
</html>