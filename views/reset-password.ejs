<%# File: views/reset-password.ejs | Purpose: Reset password form — user enters OTP and new password. %>
<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { pageTitle, pageCss: '/css/auth/forgot-password.css' }) %>
<body class="forgot-pw-page">
  <div class="forgot-pw-card">
    <div class="forgot-pw-icon reset-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        <path d="M9 12l2 2 4-4"/>
      </svg>
    </div>
    <h1 class="forgot-pw-title">Reset Password</h1>
    <p class="forgot-pw-subtitle">Enter the OTP sent to <strong><%= email %></strong> and choose your new password.</p>
    <form action="/reset-password" method="post" class="forgot-pw-form">
      <label class="forgot-pw-label">
        <span>OTP Code <span class="required-mark">*</span></span>
        <input type="text" name="otp" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" placeholder="4-digit code" required />
      </label>
      <label class="forgot-pw-label">
        <span>New Password <span class="required-mark">*</span></span>
        <div class="password-input-wrap">
          <input type="password" name="password" minlength="6" placeholder="At least 6 characters" required data-password-toggle-target="reset-pw" />
          <button type="button" class="password-eye-btn" data-password-toggle="reset-pw" aria-label="Show password">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M1.5 12S5.5 5 12 5s10.5 7 10.5 7-4 7-10.5 7S1.5 12 1.5 12Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="12" cy="12" r="3.2" fill="none" stroke="currentColor" stroke-width="1.8"/>
            </svg>
          </button>
        </div>
      </label>
      <label class="forgot-pw-label">
        <span>Confirm Password <span class="required-mark">*</span></span>
        <div class="password-input-wrap">
          <input type="password" name="confirm_password" minlength="6" placeholder="Re-type your password" required data-password-toggle-target="reset-confirm" />
          <button type="button" class="password-eye-btn" data-password-toggle="reset-confirm" aria-label="Show password">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M1.5 12S5.5 5 12 5s10.5 7 10.5 7-4 7-10.5 7S1.5 12 1.5 12Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="12" cy="12" r="3.2" fill="none" stroke="currentColor" stroke-width="1.8"/>
            </svg>
          </button>
        </div>
      </label>
      <button type="submit" class="forgot-pw-btn">Reset Password</button>
    </form>
    <div class="forgot-pw-footer">
      <form action="/forgot-password/resend-otp" method="post" style="display:inline;">
        <button type="submit" class="forgot-pw-resend">Resend OTP</button>
      </form>
      <a href="/login" class="forgot-pw-back">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
        Back to Login
      </a>
    </div>
  </div>
  <%- include('partials/flash-modal', { flash }) %>
  <script src="/js/main.js"></script>
  <script>
    document.querySelectorAll('[data-password-toggle]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.getAttribute('data-password-toggle');
        const input = document.querySelector(`[data-password-toggle-target="${key}"]`);
        if (!input) return;
        const showing = input.type === 'text';
        input.type = showing ? 'password' : 'text';
        btn.setAttribute('aria-label', showing ? 'Show password' : 'Hide password');
      });
    });
  </script>
</body>
</html>
