<%# File: views/reset-password.ejs | Purpose: Reset password form — user enters OTP and new password. %>
<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { pageTitle, pageCss: ['/css/auth/login.css', '/css/auth/forgot-password.css'] }) %>
<body class="auth-login-page plain-page login-page design-auth-page">
  <section class="login-shell">
    <div class="login-panel login-form-panel">
      <div class="login-brand">Reset Password</div>
      <form action="/reset-password" method="post" class="login-form-grid">
        <p style="margin:0 0 8px;color:#d7e5f1;">Enter the 4-digit OTP sent to <strong><%= email %></strong> and your new password.</p>
        <label>
          <span>OTP <span class="required-mark">*</span></span>
          <input type="text" name="otp" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" required />
        </label>
        <label>
          <span>New Password <span class="required-mark">*</span></span>
          <div class="password-input-wrap">
            <input type="password" name="password" minlength="6" required data-password-toggle-target="reset-password" />
            <button type="button" class="password-eye-btn" data-password-toggle="reset-password" aria-label="Show password">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M1.5 12S5.5 5 12 5s10.5 7 10.5 7-4 7-10.5 7S1.5 12 1.5 12Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                <circle cx="12" cy="12" r="3.2" fill="none" stroke="currentColor" stroke-width="1.8"/>
              </svg>
            </button>
          </div>
        </label>
        <label>
          <span>Confirm Password <span class="required-mark">*</span></span>
          <div class="password-input-wrap">
            <input type="password" name="confirm_password" minlength="6" required data-password-toggle-target="reset-confirm" />
            <button type="button" class="password-eye-btn" data-password-toggle="reset-confirm" aria-label="Show password">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M1.5 12S5.5 5 12 5s10.5 7 10.5 7-4 7-10.5 7S1.5 12 1.5 12Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                <circle cx="12" cy="12" r="3.2" fill="none" stroke="currentColor" stroke-width="1.8"/>
              </svg>
            </button>
          </div>
        </label>
        <button type="submit" class="login-submit-btn">Reset Password</button>
      </form>
      <div class="login-link-row">
        <form action="/forgot-password/resend-otp" method="post" style="display:inline;">
          <button type="submit" class="login-submit-btn" style="padding:10px 50px;">Resend OTP</button>
        </form>
        <a href="/login">Back to Login</a>
      </div>
    </div>
    <div class="login-panel login-info-panel">
      <img src="/assets/logo.jpeg" alt="Logo" />
      <h1>NEW<br>PASSWORD</h1>
      <p>Choose a strong password to keep your account secure.</p>
    </div>
  </section>
  <%- include('partials/flash-modal', { flash }) %>
  <script src="/js/main.js"></script>
  <script>
    document.querySelectorAll('[data-password-toggle]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.getAttribute('data-password-toggle');
        const input = document.querySelector(`[data-password-toggle-target="${key}"]`);
        if (!input) return;
        const showing = input.type === 'text';
        input.type = showing ? 'password' : 'text';
        btn.setAttribute('aria-label', showing ? 'Show password' : 'Hide password');
      });
    });
  </script>
</body>
</html>
