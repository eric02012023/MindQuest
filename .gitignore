node_modules/
.env
.env.live
.env.local

# Ignore everything in uploads
public/uploads/**
# Except .gitkeep files so the empty folders stay in repo
!public/uploads/**/.gitkeep

# Local diagnostic scripts (they read secrets from .env, never hardcode them)
test-smtp.js
test-resend.js

# Database snapshots from scripts/backup-billing.js. These hold real student
# names and payment amounts — they belong on a disk, never in the repository.
backups/

# The student app (mindquest-mobile/): its installed packages and build output.
# (node_modules/ above already covers its packages; listed for clarity.)
mindquest-mobile/node_modules/
mindquest-mobile/.expo/
mindquest-mobile/dist/
mindquest-mobile/android/
mindquest-mobile/ios/
